@page "/consultations"
@layout PublicLayout
@using Microsoft.AspNetCore.Authorization
@using VFMS.Contracts.Common
@using VFMS.Contracts.Consultations
@attribute [Authorize(Roles = "Customer,Member")]
@inject SystemAdministrationApiClient Api
@implements IDisposable

<PageTitle>Trò chuyện tư vấn | Victor Fitness</PageTitle>

<section class="mx-auto max-w-5xl px-5 pb-16 pt-28">
    <header class="border-b border-[#D8D1CD] pb-5">
        <p class="text-xs font-bold tracking-wider text-[#B83A3A]">VFMS / CONSULTATION</p>
        <h1 class="mt-2 text-3xl font-black text-[#242424]">Trò chuyện với phòng gym.</h1>
        <p class="mt-2 text-sm text-[#6F6966]">Tạo cuộc tư vấn và gửi tin nhắn đến quản lý.</p>
    </header>

    @if (_error is not null)
    {
        <p role="alert" class="mt-5 rounded-lg border border-red-300 bg-red-50 p-4 text-sm text-red-900">@_error</p>
    }

    <div class="mt-6 grid gap-6 lg:grid-cols-[320px_1fr]">
        <aside class="rounded-xl border border-[#D8D1CD] bg-[#F8F5F2] p-4">
            <h2 class="text-sm font-bold">Cuộc tư vấn</h2>
            <button type="button" class="mt-3 w-full rounded-lg bg-[#B83A3A] px-3 py-2 text-xs font-bold text-white"
                    disabled="@Busy" @onclick="() => _creating = true">
                Tạo cuộc tư vấn
            </button>

            @if (_creating)
            {
                <div class="mt-4 space-y-3">
                    <label class="block text-xs font-semibold" for="chat-subject">
                        Chủ đề
                        <input id="chat-subject" class="mt-1 block w-full rounded-lg border border-[#D8D1CD] px-3 py-2 text-sm" maxlength="200" @bind="_subject" />
                    </label>
                    <label class="block text-xs font-semibold" for="chat-message">
                        Nội dung
                        <textarea id="chat-message" class="mt-1 block w-full rounded-lg border border-[#D8D1CD] px-3 py-2 text-sm" rows="4" maxlength="2000" @bind="_message"></textarea>
                    </label>
                    <button type="button" class="rounded-lg border border-[#B83A3A] px-3 py-2 text-xs font-bold text-[#B83A3A]"
                            disabled="@Busy" @onclick="CreateAsync">Gửi</button>
                    <button type="button" class="rounded-lg px-3 py-2 text-xs font-bold" @onclick="CancelCreate">Hủy</button>
                </div>
            }

            <div class="mt-4 divide-y divide-[#D8D1CD]">
                @foreach (var conversation in _conversations)
                {
                    <button type="button" class="block w-full py-3 text-left" @onclick="() => SelectAsync(conversation.Id)">
                        <span class="block text-sm font-bold">@conversation.Subject</span>
                        <span class="text-xs text-[#6F6966]">@conversation.Status</span>
                    </button>
                }
            </div>
        </aside>

        <section class="rounded-xl border border-[#D8D1CD] bg-[#F8F5F2] p-5">
            @if (_selected is null)
            {
                <p class="text-sm text-[#6F6966]">Chọn hoặc tạo một cuộc tư vấn.</p>
            }
            else
            {
                <h2 class="font-bold">@_selected.Subject</h2>
                <div class="my-4 max-h-96 space-y-3 overflow-y-auto">
                    @foreach (var chat in _selected.Messages)
                    {
                        <div class="rounded-lg border border-[#D8D1CD] bg-white p-3">
                            <p class="text-xs font-bold">@chat.SenderName</p>
                            <p class="mt-1 text-sm">@chat.Content</p>
                        </div>
                    }
                </div>
                @if (_selected.Status != "Closed")
                {
                    <form @onsubmit="SendAsync" @onsubmit:preventDefault class="flex gap-2">
                        <input class="min-w-0 flex-1 rounded-lg border border-[#D8D1CD] px-3 py-2 text-sm"
                               maxlength="2000" @bind="_reply" placeholder="Nhập tin nhắn..." />
                        <button type="submit" class="rounded-lg bg-[#B83A3A] px-4 py-2 text-sm font-bold text-white"
                                disabled="@Busy">Gửi</button>
                    </form>
                }
            }
        </section>
    </div>
</section>

@code {
    private readonly CancellationTokenSource _lifetime = new();
    private IReadOnlyCollection<ConsultationConversationResponse> _conversations = [];
    private ConsultationConversationResponse? _selected;
    private string _subject = "", _message = "", _reply = "", _error = "";
    private bool _creating, _loading, _working;
    private bool Busy => _loading || _working;

    protected override Task OnInitializedAsync() => LoadAsync();

    private async Task LoadAsync()
    {
        _loading = true;
        try
        {
            var page = await Api.GetConsultationsAsync(new(null, null, 1, 100), _lifetime.Token);
            _conversations = page.Items;
        }
        catch (AuthApiException error) { _error = error.Message; }
        finally { _loading = false; }
    }

    private async Task CreateAsync()
    {
        if (string.IsNullOrWhiteSpace(_subject) || string.IsNullOrWhiteSpace(_message))
        {
            _error = "Vui lòng nhập chủ đề và nội dung tư vấn.";
            return;
        }
        _working = true;
        try
        {
            _selected = await Api.CreateConsultationAsync(new(_subject.Trim(), _message.Trim()), _lifetime.Token);
            CancelCreate();
            await LoadAsync();
        }
        catch (AuthApiException error) { _error = error.Message; }
        finally { _working = false; }
    }

    private void CancelCreate()
    {
        _creating = false;
        _subject = "";
        _message = "";
    }

    private async Task SelectAsync(int id)
    {
        try { _selected = await Api.GetConsultationAsync(id, _lifetime.Token); _reply = ""; }
        catch (AuthApiException error) { _error = error.Message; }
    }

    private async Task SendAsync()
    {
        if (_selected is null || string.IsNullOrWhiteSpace(_reply)) return;
        _working = true;
        try
        {
            _selected = await Api.SendConsultationMessageAsync(
                _selected.Id, new(_reply.Trim()), _lifetime.Token);
            _reply = "";
        }
        catch (AuthApiException error) { _error = error.Message; }
        finally { _working = false; }
    }

    public void Dispose()
    {
        _lifetime.Cancel();
        _lifetime.Dispose();
    }
}
