@page "/membership-plans"
@layout PublicLayout
@using VFMS.Client.Components.Memberships
@using VFMS.Contracts.Common
@using VFMS.Contracts.Packages
@inject MembershipPlanApiClient PlanApi
@inject NavigationManager Navigation
@inject MembershipCart Cart

<PageTitle>Gói Tập & Hội Viên | Victor Fitness</PageTitle>

<div class="w-full min-h-screen bg-[#F2EFEC] text-[#242424] font-['Inter',sans-serif] pt-28 pb-20">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">

        <!-- ============================================================== -->
        <!-- 1. PAGE HEADER                                                 -->
        <!-- ============================================================== -->
        <header class="border-b border-[#D8D1CD] pb-8 mb-8">
            <div class="inline-flex items-center gap-2 mb-3">
                <span class="w-2.5 h-2.5 bg-[#B83A3A] inline-block rounded-full"></span>
                <p class="font-['Montserrat',sans-serif] text-[11px] font-bold tracking-[.18em] uppercase text-[#B83A3A]">
                    VICTOR FITNESS / MEMBERSHIP &amp; TRAINING
                </p>
            </div>
            <h1 class="font-['Montserrat',sans-serif] text-3xl sm:text-4xl lg:text-5xl font-black uppercase tracking-tight text-[#242424]">
                GÓI TẬP &amp; HỘI VIÊN<span class="text-[#B83A3A]">.</span>
            </h1>
            <p class="mt-3 max-w-2xl text-sm sm:text-base text-[#6F6966] leading-relaxed">
                Lựa chọn hình thức tập luyện phù hợp với mục tiêu của bạn.
            </p>
        </header>

        @if (Cart.Count > 0)
        {
            <p class="mb-4 text-right" role="status"><a href="/membership-cart" class="inline-flex min-h-[44px] items-center rounded-lg border border-vfms-primary px-4 text-sm font-bold text-vfms-primary hover:bg-vfms-primary-soft">Xem giỏ hàng (@Cart.Count gói)</a></p>
        }

        <!-- ============================================================== -->
        <!-- 2. FILTER TABS (GYM | YOGA | PT)                               -->
        <!-- ============================================================== -->
        <div id="catalog-section" class="flex flex-wrap items-center gap-3 mb-10" role="tablist" aria-label="Phân loại gói tập">
            <button type="button"
                    role="tab"
                    id="tab-gym"
                    aria-selected="@(CurrentType == "gym" ? "true" : "false")"
                    aria-current="@(CurrentType == "gym" ? "page" : null)"
                    @onclick='() => ChangeTabAsync("gym")'
                    class="min-h-[44px] px-6 sm:px-8 py-3 font-['Montserrat',sans-serif] font-bold text-xs sm:text-sm uppercase tracking-wider border rounded-lg transition-all cursor-pointer focus-visible:outline focus-visible:outline-2 focus-visible:outline-[#B83A3A] @(CurrentType == "gym" ? "bg-[#B83A3A] text-white border-[#B83A3A] shadow-sm" : "bg-[#F8F5F2] text-[#242424] border-[#D8D1CD] hover:border-[#B83A3A] hover:text-[#B83A3A]")">
                GÓI GYM
            </button>

            <button type="button"
                    role="tab"
                    id="tab-yoga"
                    aria-selected="@(CurrentType == "yoga" ? "true" : "false")"
                    aria-current="@(CurrentType == "yoga" ? "page" : null)"
                    @onclick='() => ChangeTabAsync("yoga")'
                    class="min-h-[44px] px-6 sm:px-8 py-3 font-['Montserrat',sans-serif] font-bold text-xs sm:text-sm uppercase tracking-wider border rounded-lg transition-all cursor-pointer focus-visible:outline focus-visible:outline-2 focus-visible:outline-[#B83A3A] @(CurrentType == "yoga" ? "bg-[#B83A3A] text-white border-[#B83A3A] shadow-sm" : "bg-[#F8F5F2] text-[#242424] border-[#D8D1CD] hover:border-[#B83A3A] hover:text-[#B83A3A]")">
                YOGA
            </button>

            <button type="button"
                    role="tab"
                    id="tab-pt"
                    aria-selected="@(CurrentType == "pt" ? "true" : "false")"
                    aria-current="@(CurrentType == "pt" ? "page" : null)"
                    @onclick='() => ChangeTabAsync("pt")'
                    class="min-h-[44px] px-6 sm:px-8 py-3 font-['Montserrat',sans-serif] font-bold text-xs sm:text-sm uppercase tracking-wider border rounded-lg transition-all cursor-pointer focus-visible:outline focus-visible:outline-2 focus-visible:outline-[#B83A3A] @(CurrentType == "pt" ? "bg-[#B83A3A] text-white border-[#B83A3A] shadow-sm" : "bg-[#F8F5F2] text-[#242424] border-[#D8D1CD] hover:border-[#B83A3A] hover:text-[#B83A3A]")">
                HUẤN LUYỆN PT
            </button>
        </div>

        <!-- ============================================================== -->
        <!-- 3. MAIN CATALOG CONTENT                                        -->
        <!-- ============================================================== -->
        @if (_loading)
        {
            <!-- Skeleton Cards -->
            <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6" aria-busy="true" aria-label="Đang tải danh sách gói...">
                @for (int i = 0; i < 3; i++)
                {
                    <div class="bg-[#F8F5F2] border border-[#D8D1CD] rounded-xl p-6 sm:p-7 flex flex-col justify-between animate-pulse">
                        <div>
                            <div class="w-20 h-5 bg-[#ECE8E4] rounded mb-4"></div>
                            <div class="w-3/4 h-7 bg-[#ECE8E4] rounded mb-2"></div>
                            <div class="w-1/2 h-4 bg-[#ECE8E4] rounded mb-6"></div>
                            <div class="w-2/3 h-9 bg-[#ECE8E4] rounded mb-6"></div>
                            <div class="space-y-3 pt-4 border-t border-[#D8D1CD]">
                                <div class="w-full h-4 bg-[#ECE8E4] rounded"></div>
                                <div class="w-5/6 h-4 bg-[#ECE8E4] rounded"></div>
                                <div class="w-4/6 h-4 bg-[#ECE8E4] rounded"></div>
                            </div>
                        </div>
                        <div class="w-full h-11 bg-[#ECE8E4] rounded-lg mt-8"></div>
                    </div>
                }
            </div>
        }
        else if (_errorMessage is not null)
        {
            <!-- Error State -->
            <div role="alert" class="bg-[#F8F5F2] border border-[#DC2626]/30 rounded-xl p-8 sm:p-10 text-center max-w-xl mx-auto shadow-sm">
                <div class="w-12 h-12 mx-auto mb-4 bg-red-100 text-[#DC2626] rounded-full flex items-center justify-center font-bold text-xl">
                    !
                </div>
                <h3 class="font-['Montserrat',sans-serif] text-lg font-bold text-[#242424] mb-2 uppercase">
                    Không thể tải danh sách gói lúc này
                </h3>
                <p class="text-sm text-[#6F6966] mb-6">
                    Vui lòng kiểm tra lại kết nối mạng hoặc thử tải lại trang.
                </p>
                <button type="button"
                        @onclick="() => LoadCatalogAsync(CurrentType, CurrentPage)"
                        class="min-h-[44px] px-6 py-3 bg-[#B83A3A] hover:bg-[#9F3030] text-white font-['Montserrat',sans-serif] font-bold text-xs uppercase tracking-wider rounded-lg transition-colors cursor-pointer">
                    THỬ LẠI
                </button>
            </div>
        }
        else if (_catalog is null || _catalog.Items.Count == 0)
        {
            <!-- Empty State -->
            <div class="bg-[#F8F5F2] border border-[#D8D1CD] rounded-xl p-10 sm:p-14 text-center max-w-xl mx-auto shadow-sm" role="status">
                <div class="w-12 h-12 mx-auto mb-4 bg-[#ECE8E4] text-[#6F6966] rounded-full flex items-center justify-center text-xl">
                    ℹ
                </div>
                <h3 class="font-['Montserrat',sans-serif] text-base font-bold text-[#242424] uppercase mb-2">
                    @EmptyStateMessage
                </h3>
                <p class="text-xs text-[#6F6966] leading-relaxed">
                    Hệ thống sẽ cập nhật thông tin và mở bán các gói mới trong thời gian sớm nhất.
                </p>
            </div>
        }
        else
        {
            <!-- ============================================================== -->
            <!-- 4. CARDS GRID (3 Columns Desktop, 2 Tablet, 1 Mobile)          -->
            <!-- ============================================================== -->
            <div id="catalog-grid" class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6" aria-live="polite">
                @foreach (var package in _catalog.Items)
                {
                    <article @key="package.Id" class="bg-[#F8F5F2] border border-[#D8D1CD] rounded-xl p-6 sm:p-7 flex flex-col justify-between hover:border-[#B83A3A] transition-colors duration-200 shadow-sm group">
                        <div>
                            <!-- Header / Badge -->
                            <div class="flex items-center justify-between pb-4 border-b border-[#D8D1CD]">
                                <span class="inline-block text-[10px] font-['Montserrat',sans-serif] font-bold uppercase tracking-wider text-[#B83A3A] bg-[#F3E4E2] px-2.5 py-1 rounded">
                                    @ComponentBadgeLabel(package.ComponentType)
                                </span>
                                <span class="text-[10px] font-mono text-[#8C8581]">#@package.Id</span>
                            </div>

                            <!-- Package Name -->
                            <h2 class="font-['Montserrat',sans-serif] text-xl sm:text-2xl font-black uppercase text-[#242424] mt-4 tracking-tight leading-snug">
                                @package.Name
                            </h2>

                            <!-- Optional Description -->
                            @if (!string.IsNullOrWhiteSpace(package.Description))
                            {
                                <p class="text-xs text-[#6F6966] mt-2 break-words leading-relaxed line-clamp-3">
                                    @package.Description
                                </p>
                            }
                            @if (!string.IsNullOrWhiteSpace(package.TargetAudience))
                            {
                                <p class="mt-2 break-words text-xs leading-relaxed text-vfms-text-secondary">
                                    <strong>Phù hợp với ai</strong><br />@package.TargetAudience
                                </p>
                            }

                            <!-- Price Display (VND Locale) -->
                            <div class="py-5 border-b border-[#ECE8E4]">
                                <div class="font-['Montserrat',sans-serif] text-2xl sm:text-3xl font-black text-[#242424]">
                                    @Vnd.Format(package.Price)
                                </div>
                            </div>

                            <!-- Metadata attributes depending on ComponentType -->
                            <ul class="py-5 space-y-3 text-xs text-[#242424] font-medium">
                                @if (string.Equals(package.ComponentType, "GYM", StringComparison.OrdinalIgnoreCase))
                                {
                                    <!-- GYM METADATA -->
                                    @if (package.DurationMonths is > 0)
                                    {
                                        <li class="flex items-start gap-2.5">
                                            <span class="text-[#B83A3A] font-bold">▪</span>
                                            <span><strong>Thời hạn:</strong> @package.DurationMonths tháng</span>
                                        </li>
                                    }
                                    else if (package.DurationDays is > 0)
                                    {
                                        <li class="flex items-start gap-2.5">
                                            <span class="text-[#B83A3A] font-bold">▪</span>
                                            <span><strong>Thời hạn:</strong> @package.DurationDays ngày</span>
                                        </li>
                                    }

                                    @if (package.AccessStartTime.HasValue && package.AccessEndTime.HasValue)
                                    {
                                        <li class="flex items-start gap-2.5">
                                            <span class="text-[#B83A3A] font-bold">▪</span>
                                            <span><strong>Giờ tập:</strong> @package.AccessStartTime.Value.ToString("HH:mm") – @package.AccessEndTime.Value.ToString("HH:mm")</span>
                                        </li>
                                    }

                                    <li class="flex items-start gap-2.5">
                                        <span class="text-[#B83A3A] font-bold">▪</span>
                                        <span>
                                            <strong>Bảo lưu:</strong> @MembershipDisplay.CatalogFreeze(package)
                                        </span>
                                    </li>
                                }
                                else if (string.Equals(package.ComponentType, "YOGA", StringComparison.OrdinalIgnoreCase))
                                {
                                    <!-- YOGA METADATA -->
                                    @if (package.SessionCount is > 0)
                                    {
                                        <li class="flex items-start gap-2.5">
                                            <span class="text-[#B83A3A] font-bold">▪</span>
                                            <span><strong>Quyền lợi:</strong> @package.SessionCount buổi tập Yoga</span>
                                        </li>
                                    }

                                    @if (!string.IsNullOrWhiteSpace(package.YogaClassTypeName))
                                    {
                                        <li class="flex items-start gap-2.5">
                                            <span class="text-[#B83A3A] font-bold">▪</span>
                                            <span><strong>Dòng lớp:</strong> @package.YogaClassTypeName</span>
                                        </li>
                                    }

                                    @if (package.DurationMonths is > 0)
                                    {
                                        <li class="flex items-start gap-2.5">
                                            <span class="text-[#B83A3A] font-bold">▪</span>
                                            <span><strong>Thời hạn:</strong> @package.DurationMonths tháng</span>
                                        </li>
                                    }
                                    else if (package.DurationDays is > 0)
                                    {
                                        <li class="flex items-start gap-2.5">
                                            <span class="text-[#B83A3A] font-bold">▪</span>
                                            <span><strong>Thời hạn:</strong> @package.DurationDays ngày</span>
                                        </li>
                                    }

                                    <li class="flex items-start gap-2.5">
                                        <span class="text-[#B83A3A] font-bold">▪</span>
                                        <span><strong>Bảo lưu:</strong> @MembershipDisplay.CatalogFreeze(package)</span>
                                    </li>
                                }
                                else if (string.Equals(package.ComponentType, "PT", StringComparison.OrdinalIgnoreCase))
                                {
                                    <!-- PT METADATA -->
                                    @if (package.SessionCount is > 0)
                                    {
                                        <li class="flex items-start gap-2.5">
                                            <span class="text-[#B83A3A] font-bold">▪</span>
                                            <span><strong>Quyền lợi:</strong> @package.SessionCount buổi PT 1-kèm-1</span>
                                        </li>
                                    }

                                    @if (!string.IsNullOrWhiteSpace(package.TrainerLevel))
                                    {
                                        <li class="flex items-start gap-2.5">
                                            <span class="text-[#B83A3A] font-bold">▪</span>
                                            <span><strong>Cấp bậc HLV:</strong> @package.TrainerLevel Trainer</span>
                                        </li>
                                    }

                                    @if (package.PTFreezeMinimumDays is > 0 || package.PTFreezeMaxTotalDays is > 0)
                                    {
                                        <li class="flex items-start gap-2.5">
                                            <span class="text-[#B83A3A] font-bold">▪</span>
                                            <span><strong>Bảo lưu PT:</strong> Tối thiểu @(package.PTFreezeMinimumDays ?? 0) ngày · Tối đa @(package.PTFreezeMaxTotalDays ?? 0) ngày</span>
                                        </li>
                                    }
                                }
                            </ul>
                        </div>

                        <!-- CTA Button -->
                        <div class="space-y-3 pt-5 border-t border-[#D8D1CD]">
                            @if (package.IsSingleService)
                            {
                                <a href="@PackageCatalogLinks.Detail(package.ComponentType, package.Id, CurrentPage)"
                                   aria-label="Xem chi tiết gói @package.Name"
                                   class="flex min-h-[44px] items-center justify-center rounded-lg border border-vfms-border-strong px-4 py-2 text-center text-sm font-bold text-vfms-text hover:bg-vfms-surface-alt focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-vfms-primary">
                                    Xem chi tiết
                                </a>
                            }
                            <AuthorizeView>
                                <NotAuthorized>
                                    @if (!package.IsSingleService)
                                    {
                                        <a href="@LoginUrl"
                                           class="w-full min-h-[44px] flex items-center justify-center bg-[#B83A3A] hover:bg-[#9F3030] text-white px-4 py-3 font-['Montserrat',sans-serif] font-bold text-xs uppercase tracking-wider rounded-lg transition-colors text-center shadow-sm">
                                            ĐĂNG NHẬP ĐỂ CHỌN GÓI
                                        </a>
                                    }
                                </NotAuthorized>
                                <Authorized Context="auth">
                                    @if (package.ComponentType is "GYM" or "YOGA" && (auth.User.IsInRole("Customer") || auth.User.IsInRole("Member")))
                                    {
                                        <button type="button" disabled="@(Cart.Count >= MembershipCart.MaximumItems)" aria-label="Thêm @package.Name vào giỏ"
                                                @onclick="() => Cart.Add(package.Id, package.Name, package.Price)"
                                                class="w-full min-h-[44px] bg-[#B83A3A] hover:bg-[#9F3030] text-white px-4 py-3 font-['Montserrat',sans-serif] font-bold text-xs uppercase tracking-wider rounded-lg transition-colors disabled:opacity-50">
                                            Thêm vào giỏ
                                        </button>
                                    }
                                    @if (string.Equals(package.ComponentType, "YOGA", StringComparison.OrdinalIgnoreCase))
                                    {
                                        <a href="/yoga/schedule"
                                           class="mt-2 flex min-h-[44px] items-center justify-center text-xs font-bold text-vfms-primary hover:underline">
                                            XEM LỊCH HỌC YOGA
                                        </a>
                                    }
                                    else if (string.Equals(package.ComponentType, "PT", StringComparison.OrdinalIgnoreCase))
                                    {
                                        <a href="@(package.IsSingleService ? PackageCatalogLinks.Trainers(package.Id) : "/trainers")"
                                           class="w-full min-h-[44px] flex items-center justify-center bg-[#B83A3A] hover:bg-[#9F3030] text-white px-4 py-3 font-['Montserrat',sans-serif] font-bold text-xs uppercase tracking-wider rounded-lg transition-colors text-center shadow-sm">
                                            CHỌN HUẤN LUYỆN VIÊN
                                        </a>
                                    }
                                </Authorized>
                            </AuthorizeView>
                        </div>
                    </article>
                }
            </div>

            <!-- ============================================================== -->
            <!-- 5. PAGINATION                                                  -->
            <!-- ============================================================== -->
            @if (_catalog.TotalCount > PageSize)
            {
                var totalPages = (int)Math.Ceiling((double)_catalog.TotalCount / PageSize);
                <nav aria-label="Phân trang gói tập" class="mt-12 flex flex-wrap items-center justify-center gap-3 font-['Inter',sans-serif] text-sm">
                    <button type="button"
                            class="min-h-[44px] px-4 py-2 border border-[#D8D1CD] bg-[#F8F5F2] hover:bg-[#ECE8E4] rounded-lg font-medium text-[#242424] transition-colors disabled:opacity-40 disabled:cursor-not-allowed cursor-pointer"
                            disabled="@(CurrentPage <= 1)"
                            @onclick="() => ChangePageAsync(CurrentPage - 1)">
                        ← Trang trước
                    </button>

                    <span class="px-3 py-2 text-[#6F6966] font-semibold text-xs uppercase tracking-wider">
                        Trang @CurrentPage / @totalPages (@_catalog.TotalCount gói)
                    </span>

                    <button type="button"
                            class="min-h-[44px] px-4 py-2 border border-[#D8D1CD] bg-[#F8F5F2] hover:bg-[#ECE8E4] rounded-lg font-medium text-[#242424] transition-colors disabled:opacity-40 disabled:cursor-not-allowed cursor-pointer"
                            disabled="@(CurrentPage >= totalPages)"
                            @onclick="() => ChangePageAsync(CurrentPage + 1)">
                        Trang sau →
                    </button>
                </nav>
            }
        }

    </div>
</div>

@code {
    private const int PageSize = 9;

    [SupplyParameterFromQuery(Name = "type")]
    public string? TypeQuery { get; set; }

    [SupplyParameterFromQuery(Name = "page")]
    public int? PageQuery { get; set; }

    private string CurrentType => NormalizeType(TypeQuery);
    private int CurrentPage => Math.Max(1, PageQuery ?? 1);

    private bool _loading = true;
    private string? _errorMessage;
    private PagedResponse<PackageCatalogItemResponse>? _catalog;
    private string? _loadedType;
    private int? _loadedPage;

    private string LoginUrl => $"/auth/login?returnUrl={Uri.EscapeDataString(Navigation.Uri)}";

    private string EmptyStateMessage => CurrentType switch
    {
        "yoga" => "Hiện chưa có gói Yoga đang mở bán.",
        "pt" => "Hiện chưa có gói PT đang mở bán.",
        _ => "Hiện chưa có gói Gym đang mở bán."
    };

    protected override async Task OnParametersSetAsync()
    {
        var targetType = CurrentType;
        var targetPage = CurrentPage;

        // Tránh gọi lại API nếu parameters không thay đổi
        if (_catalog is not null && _loadedType == targetType && _loadedPage == targetPage && _errorMessage is null)
        {
            return;
        }

        await LoadCatalogAsync(targetType, targetPage);
    }

    private async Task LoadCatalogAsync(string type, int page)
    {
        _loading = true;
        _errorMessage = null;

        try
        {
            _catalog = await PlanApi.GetPackagesAsync(type, page, PageSize);
            _loadedType = type;
            _loadedPage = page;
        }
        catch (Exception)
        {
            _errorMessage = "Không thể tải danh sách gói lúc này.";
            _catalog = null;
        }
        finally
        {
            _loading = false;
        }
    }

    private Task ChangeTabAsync(string newType)
    {
        if (string.Equals(CurrentType, newType, StringComparison.OrdinalIgnoreCase))
            return Task.CompletedTask;

        Navigation.NavigateTo($"/membership-plans?type={newType}&page=1");
        return Task.CompletedTask;
    }

    private Task ChangePageAsync(int newPage)
    {
        Navigation.NavigateTo($"/membership-plans?type={CurrentType}&page={newPage}");
        return Task.CompletedTask;
    }

    private static string NormalizeType(string? type) =>
        type?.Trim().ToLowerInvariant() switch
        {
            "yoga" => "yoga",
            "pt" => "pt",
            _ => "gym"
        };

    private static string ComponentBadgeLabel(string componentType) =>
        componentType.ToUpperInvariant() switch
        {
            "YOGA" => "LỚP YOGA",
            "PT" => "HUẤN LUYỆN VIÊN PT",
            _ => "GÓI GYM"
        };
}
