@page "/admin/dashboard"
@layout ManagerAdminLayout
@using Microsoft.AspNetCore.Authorization
@using VFMS.Client.Components.Dashboards
@using VFMS.Contracts.Dashboards
@attribute [Authorize(Roles = "Admin")]

<PageTitle>Tổng quan quản trị | Victor Fitness</PageTitle>
<DashboardView T="AdminOverview" Path="@($"api/dashboards/admin?days={_days}")" Title="Tổng quan quản trị"
               Description="Theo dõi tài khoản, yêu cầu chờ xử lý và các hoạt động quản trị.">
    <HeaderControl><label class="dash-date"><DashboardIcon Name="calendar" /><select aria-label="Khoảng thời gian thống kê hoạt động" @bind="_days">
        <option value="7">7 ngày gần đây</option><option value="30">30 ngày gần đây</option><option value="90">90 ngày gần đây</option>
    </select></label></HeaderControl>
    <ChildContent Context="data">
        <div class="dash-stats">
            <DashboardStat Icon="people" Label="Tổng số tài khoản" Value="@Vnd.FormatAmount(data.Accounts)" Note="@($"{data.NewAccounts} tài khoản mới trong {data.Activity.Count} ngày")" />
            <DashboardStat Icon="person" Label="Đang hoạt động" Value="@Vnd.FormatAmount(data.Active)" Note="Tài khoản có trạng thái hoạt động" />
            <DashboardStat Icon="list" Label="Yêu cầu chờ xử lý" Value="@((data.Applications + data.Proposals).ToString())" Note="@($"{data.Applications} hồ sơ ứng tuyển · {data.Proposals} đề xuất mua sắm")" />
            <DashboardStat Icon="shield" Label="Tài khoản đang khóa" Value="@data.Locked.ToString()" Note="Trạng thái khóa hiện tại" />
        </div>
        <div class="dash-grid">
            <section class="dash-panel"><header><h2>Hoạt động hệ thống</h2></header><p class="dash-sub">Số thao tác được ghi vào nhật ký mỗi ngày.</p>
                <DashboardTrend Points="data.Activity" Unit="Lượt hoạt động" /></section>
            <section class="dash-panel"><header><h2>Phân bố tài khoản theo vai trò</h2></header>
                <DashboardDonut Items="data.Roles" Center="data.Accounts" Caption="tài khoản" Label="OperationsText.RoleLabel" />
                <p class="dash-footnote">Mỗi tài khoản chỉ được tính vào một nhóm vai trò.</p></section>
            <section class="dash-panel"><header><h2>Hoạt động gần đây</h2><a href="/admin/audit-logs">Xem nhật ký →</a></header>
                @if (data.Recent.Count == 0) { <p class="dash-message">Chưa có hoạt động trong khoảng thời gian này.</p> }
                else
                {
                    <div class="dash-scroll"><table aria-label="Hoạt động gần đây"><thead><tr><th>Thời gian</th><th>Người thực hiện</th><th>Hành động</th><th>Đối tượng</th></tr></thead>
                    <tbody>@foreach (var entry in data.Recent)
                    {
                        <tr><td class="dash-number">@entry.OccurredAt.AddHours(7).ToString("dd/MM HH:mm")</td><td>@(entry.Actor ?? "Hệ thống")</td>
                        <td>@OperationsText.AuditAction(entry.Action)</td><td>@OperationsText.AuditEntity(entry.Entity, entry.EntityId)</td></tr>
                    }</tbody></table></div>
                }
            </section>
            <section id="quick-actions" class="dash-panel"><header><h2>Lối tắt quản trị</h2></header><div class="dash-actions">
                <DashboardLink Href="/admin/dashboard/accounts" Icon="people">Quản lý tài khoản</DashboardLink>
                <DashboardLink Href="/admin/dashboard/accounts?role=Staff" Icon="person">Tài khoản nhân viên</DashboardLink>
                <DashboardLink Href="/admin/dashboard/accounts?status=Locked" Icon="shield">Tài khoản đang khóa</DashboardLink>
                <DashboardLink Href="/admin/audit-logs" Icon="list">Nhật ký hệ thống</DashboardLink>
                <DashboardLink Href="/admin/banned-words" Icon="shield">Từ khóa cấm</DashboardLink>
                <DashboardLink Href="/admin/business-reports" Icon="chart">Báo cáo kinh doanh</DashboardLink>
            </div></section>
        </div>
    </ChildContent>
</DashboardView>
@code {
    private int _days = 7;

}
