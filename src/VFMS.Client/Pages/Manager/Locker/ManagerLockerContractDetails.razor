@page "/manager/locker-contracts/{Id:int}"
@layout ManagerAdminLayout
@using Microsoft.AspNetCore.Authorization
@using VFMS.Client.Components.Operations
@using VFMS.Contracts.Lockers
@attribute [Authorize(Roles = "Manager")]
@inject LockerApiClient Api
@implements IDisposable

<PageTitle>Chi tiết hợp đồng tủ | Victor Fitness</PageTitle>
<section class="workspace-page space-y-6">
    <PageHeader Overline="VFMS / QUẢN LÝ TỦ" Title="Chi tiết hợp đồng tủ" Description="Theo dõi thời hạn, phí quá hạn và các lần nhắc hội viên.">
        <a class="@Ui.Button" href="@BackUrl">← Quá hạn &amp; bảo trì</a>
    </PageHeader>
    <Alerts Error="@_error" />
    @if (_loading) { <p role="status">Đang tải…</p> }
    else if (_item is { } item)
    {
        var r = item.Rental;
        <div class="@Ui.Card space-y-4">
            <h2 class="font-heading text-lg font-bold">Tủ @r.Locker.Number · @item.MemberName</h2>
            <StatusBadge Status="@LockerText.ContractTone(r.Status)" Label="@LockerText.Contract(r.Status)" />
            <dl class="grid grid-cols-[auto_1fr] gap-x-6 gap-y-2 text-sm">
                <dt>Điện thoại</dt><dd>@item.Phone</dd><dt>Mã hợp đồng</dt><dd class="break-all">@r.ContractNumber</dd>
                <dt>Loại thuê</dt><dd>@(r.Type == "Daily" ? "Theo ngày" : $"{r.TermMonths} tháng")</dd>
                <dt>Hạn thuê</dt><dd>@(r.ExpiresAt is { } expiry ? LockerText.Local(expiry) : "—")</dd>
                <dt>Cọc đang giữ</dt><dd>@OperationsText.Money(r.DepositHeld)</dd><dt>Quá hạn</dt><dd>@r.OverdueDays ngày</dd>
                <dt>Phí quá hạn</dt><dd>@OperationsText.Money(r.OverdueFees)</dd>
                @if (r.ClearanceAfter is { } clear) { <dt>Được dọn tủ từ</dt><dd>@LockerText.Local(clear)</dd> }
                @if (r.ReminderSentAt is { } reminder) { <dt>Đã nhắc trước hạn</dt><dd>@LockerText.Local(reminder)</dd> }
                @if (r.OverdueNoticeSentAt is { } notice) { <dt>Đã báo quá hạn</dt><dd>@LockerText.Local(notice)</dd> }
            </dl>
            <a class="@Ui.Button" href="/manager/locker-clearances">Xem biên bản dọn tủ chờ xác nhận</a>
        </div>
    }
</section>

@code {
    [Parameter] public int Id { get; set; }
    [SupplyParameterFromQuery] public string? Search { get; set; }
    [SupplyParameterFromQuery] public bool OverdueOnly { get; set; } = true;
    [SupplyParameterFromQuery] public int Page { get; set; } = 1;
    private readonly CancellationTokenSource _lifetime = new();
    private LockerStaffRental? _item;
    private bool _loading = true;
    private string? _error;
    private string BackUrl => $"/manager/locker-operations?search={Uri.EscapeDataString(Search ?? "")}&overdueOnly={OverdueOnly.ToString().ToLowerInvariant()}&page={Math.Max(1, Page)}";
    protected override async Task OnParametersSetAsync()
    {
        _loading = true;
        _item = null;
        try { _item = await Api.DeskRentalDetailsAsync(Id, _lifetime.Token); _error = null; }
        catch (ApiException ex) { _error = ex.Message; }
        catch (OperationCanceledException) when (_lifetime.IsCancellationRequested) { }
        finally { _loading = false; }
    }
    public void Dispose() { _lifetime.Cancel(); _lifetime.Dispose(); }
}
