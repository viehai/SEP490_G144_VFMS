@page "/"
@layout PublicLayout
@using VFMS.Client.Components.Memberships
@inject NavigationManager Navigation
@inject IJSRuntime JS

<PageTitle>VFMS - Kỷ Luật Thép & Đỉnh Cao Thể Lực</PageTitle>

<!-- Global Styles Scoped to Home for Brutal Minimalism, Marquee & Scroll Reveal -->
<style>
    .font-heading {
        font-family: 'Montserrat', sans-serif;
        text-transform: uppercase;
        letter-spacing: 0.05em;
    }

    .font-body {
        font-family: 'Inter', sans-serif;
    }

    /* Đảm bảo tuyệt đối không bo góc theo quy chuẩn Brutal Minimalism */
    .brutal-btn, .brutal-badge {
        border-radius: 0px !important;
    }

    /* Brutal Pricing Card: Dịch chuyển lên 8px và đổ bóng đen đặc 8px 8px khi hover */
    .brutal-pricing-card {
        border-radius: 0px !important;
        transition: transform 0.2s cubic-bezier(0.16, 1, 0.3, 1), box-shadow 0.2s cubic-bezier(0.16, 1, 0.3, 1);
    }
    .brutal-pricing-card:hover {
        transform: translateY(-8px) !important;
        box-shadow: 8px 8px 0px 0px #000000 !important;
    }

    /* Brutal Equipment Card: Nảy lên -8px và đổ bóng khối đặc 6px khi hover */
    .brutal-equipment-card {
        border-radius: 0px !important;
        transition: transform 0.2s cubic-bezier(0.16, 1, 0.3, 1), box-shadow 0.2s cubic-bezier(0.16, 1, 0.3, 1);
    }
    .brutal-equipment-card:hover {
        transform: translateY(-8px) !important;
        box-shadow: 6px 6px 0px 0px #000000 !important;
    }

    /* Scroll Reveal Staggered Slide Up cho Thiết Bị */
    .equipment-reveal {
        opacity: 0;
        transform: translateY(35px);
        transition: opacity 0.5s cubic-bezier(0.16, 1, 0.3, 1), transform 0.5s cubic-bezier(0.16, 1, 0.3, 1);
        will-change: opacity, transform;
    }
    .equipment-reveal.revealed {
        opacity: 1;
        transform: translateY(0);
    }

    /* Infinite Marquee Animation - Không bị ngắt quãng */
    @@keyframes marquee {
        0% { transform: translateX(0%); }
        100% { transform: translateX(-50%); }
    }

    .animate-marquee {
        display: flex;
        width: max-content;
        animation: marquee 28s linear infinite;
    }

    .animate-marquee:hover {
        animation-play-state: paused;
    }

    /* Scroll Reveal Animation: Trượt chậm từ phải sang trái (Cinematic Slow Slide) */
    .slide-reveal-right {
        opacity: 0;
        transform: translateX(90px);
        transition: opacity 1.4s cubic-bezier(0.16, 1, 0.3, 1), transform 1.4s cubic-bezier(0.16, 1, 0.3, 1);
        will-change: opacity, transform;
    }

    .slide-reveal-right.revealed {
        opacity: 1;
        transform: translateX(0);
    }
</style>

<div class="w-full max-w-full overflow-x-hidden bg-[#FFFFFF] text-[#252525] font-body selection:bg-[#0A0A0A] selection:text-white">

    <!-- ========================================================================= -->
    <!-- 1. HERO SECTION (Chiếm toàn màn hình, Slogan mạnh mẽ, CTA hình chữ nhật)   -->
    <!-- ========================================================================= -->
    <section class="relative w-full h-screen min-h-[700px] flex items-center justify-center overflow-hidden bg-[#0A0A0A] text-white">
        
