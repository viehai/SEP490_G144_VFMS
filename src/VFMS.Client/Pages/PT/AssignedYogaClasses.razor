@page "/pt/yoga"
@layout StaffPTLayout
@attribute [Authorize(Roles = "YogaInstructor")]
@using Microsoft.AspNetCore.Authorization
@using VFMS.Client.Components.Operations
@using VFMS.Contracts.Yoga
@inject VfmsApiClient Api

<PageTitle>Lớp Yoga được phân công | Victor Fitness</PageTitle>

<div class="workspace-page space-y-8 font-['Inter',sans-serif] text-[#242424]">
    <PageHeader Overline="VFMS / YOGA" Title="Lớp được phân công" Description="Lịch dạy, phòng tập, học viên đã đặt chỗ và điểm danh.">
        <div class="flex items-center gap-2">
            <button type="button" class="@Ui.Button" @onclick="() => Move(-7)" aria-label="Tuần trước">←</button>
            <span class="text-sm font-semibold">@_from.ToString("dd/MM") – @_from.AddDays(6).ToString("dd/MM/yyyy")</span>
            <button type="button" class="@Ui.Button" @onclick="() => Move(7)" aria-label="Tuần sau">→</button>
        </div>
    </PageHeader>

    <StatusMessage Error="@_error" />

    @if (_loading)
    {
        <p role="status" class="text-sm text-[#6F6966]">Đang tải…</p>
    }
    else if (_items.Count == 0 && _error is null)
    {
        <p class="@Ui.Card text-sm text-[#6F6966]">Tuần này bạn không có buổi dạy nào.</p>
    }
    else
    {
        <div class="space-y-4">
            @foreach (var item in _items)
            {
                var s = item.Session;
                <article @key="s.Id" class="@Ui.ListCard">
                    <div class="flex flex-wrap items-center justify-between gap-3 border-b border-[#D8D1CD] bg-[#ECE8E4] px-5 py-4">
                        <div>
                            <p class="workspace-heading text-sm">@s.ClassName</p>
                            <p class="text-xs text-[#6F6966]">@VFMS.Client.Components.Memberships.YogaClassCard.DayName(s.ScheduledDate) @s.ScheduledDate.ToString("dd/MM") · @s.StartTime.ToString("HH:mm")–@s.EndTime.ToString("HH:mm") · @s.StudioName (tầng @s.FloorNumber)</p>
                        </div>
                        <div class="flex flex-wrap items-center gap-2">
                            <span class="text-xs font-semibold">@s.ConfirmedBookings/@s.MaxParticipants chỗ</span>
                            <StatusBadge Status="@s.Status" Label="@VFMS.Client.Components.Memberships.YogaClassCard.StatusName(s.Status)" />
                            @if (s.AttendanceSubmittedAt is not null)
                            {
                                <StatusBadge Status="Completed" Label="@(s.AttendanceSubmittedLate ? "Đã điểm danh · trễ" : "Đã điểm danh")" />
                            }
                            <a href="/pt/yoga/sessions/@s.Id/attendance" class="@Ui.Button">Điểm danh</a>
                        </div>
                    </div>
                    <div class="px-5 py-4">
                        @if (item.Roster.Count == 0)
                        {
                            <p class="text-xs text-[#6F6966]">Chưa có học viên đặt chỗ.</p>
                        }
                        else
                        {
                            <ul class="grid gap-2 sm:grid-cols-2 lg:grid-cols-3">
                                @foreach (var r in item.Roster)
                                {
                                    <li @key="r.BookingId" class="flex items-center justify-between gap-2 rounded-lg border border-[#D8D1CD] px-3 py-2 text-sm">
                                        <span>@(r.MatNumber is { } mat ? $"#{mat} · " : "")@r.MemberName</span><StatusBadge Status="@r.BookingStatus" Label="@VFMS.Client.Components.Memberships.YogaClassCard.StatusName(r.BookingStatus)" />
                                    </li>
                                }
                            </ul>
                        }
                    </div>
                </article>
            }
        </div>
    }
</div>

@code {
    private DateOnly _from;
    private bool _loading = true;
    private string? _error;
    private List<YogaAssignedSessionResponse> _items = [];

    protected override async Task OnInitializedAsync()
    {
        var today = DateOnly.FromDateTime(DateTime.UtcNow.AddHours(7));
        _from = today.AddDays(-(((int)today.DayOfWeek + 6) % 7));
        await Load();
    }

    private async Task Move(int days) { _from = _from.AddDays(days); await Load(); }

    private async Task Load()
    {
        _loading = true;
        _error = null;
        try { _items = await Api.GetAsync<List<YogaAssignedSessionResponse>>($"api/yoga/assigned?from={_from:yyyy-MM-dd}&to={_from.AddDays(6):yyyy-MM-dd}"); }
        catch (ApiException ex) { _error = ex.Message; }
        finally { _loading = false; }
    }
}
