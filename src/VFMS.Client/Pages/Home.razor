@page "/"
@using VFMS.Contracts.Memberships
@layout PublicLayout
@using VFMS.Client.Components.Memberships
@inject NavigationManager Navigation
@inject IJSRuntime JS

<PageTitle>VFMS - Kỷ Luật Thép & Đỉnh Cao Thể Lực</PageTitle>

<!-- Global Styles Scoped to Home for Editorial Typography, Hero Depth, Marquee & Scroll Reveal -->
<style>
    .font-heading {
        font-family: 'Montserrat', sans-serif;
        text-transform: uppercase;
    }

    .font-body {
        font-family: 'Inter', sans-serif;
    }

    /* Hero Warm Neutral Overlay — preserves natural gym photography & barbell depth */
    .hero-overlay {
        background:
            linear-gradient(
                180deg,
                rgba(242, 239, 236, 0.22) 0%,
                rgba(242, 239, 236, 0) 14%,
                rgba(242, 239, 236, 0) 80%,
                rgba(242, 239, 236, 0.65) 93%,
                #F2EFEC 100%
            ),
            linear-gradient(
                90deg,
                rgba(242, 239, 236, 0.96) 0%,
                rgba(242, 239, 236, 0.84) 24%,
                rgba(242, 239, 236, 0.38) 42%,
                rgba(242, 239, 236, 0.08) 52%,
                transparent 60%
            );
    }

    /* Hero Editorial Headline — synced with Login Montserrat 900 treatment */
    .hero-headline {
        font-family: 'Montserrat', sans-serif;
        font-weight: 900;
        text-transform: uppercase;
        line-height: 1.06;
        letter-spacing: -0.028em;
    }

    /* Accessible Focus Ring — matches Auth system */
    .home-focus:focus-visible {
        outline: 2px solid #B83A3A;
        outline-offset: 3px;
    }

    @@media (max-width: 1023px) {
        .hero-overlay {
            background:
                linear-gradient(
                    180deg,
                    rgba(242, 239, 236, 0.24) 0%,
                    rgba(242, 239, 236, 0) 14%,
                    rgba(242, 239, 236, 0) 78%,
                    rgba(242, 239, 236, 0.72) 92%,
                    #F2EFEC 100%
                ),
                linear-gradient(
                    90deg,
                    rgba(242, 239, 236, 0.96) 0%,
                    rgba(242, 239, 236, 0.86) 36%,
                    rgba(242, 239, 236, 0.45) 58%,
                    rgba(242, 239, 236, 0.12) 72%,
                    transparent 82%
                );
        }
    }

    @@media (max-width: 639px) {
        .hero-overlay {
            background:
                linear-gradient(
                    180deg,
                    rgba(242, 239, 236, 0.92) 0%,
                    rgba(242, 239, 236, 0.86) 54%,
                    rgba(242, 239, 236, 0.54) 80%,
                    #F2EFEC 100%
                );
        }
    }

    /* Scroll Reveal Staggered Slide Up cho Thiết Bị */
    .equipment-reveal {
        opacity: 0;
        transform: translateY(20px);
        transition: opacity 0.4s ease-out, transform 0.4s ease-out;
        will-change: opacity, transform;
    }
    .equipment-reveal.revealed {
        opacity: 1;
        transform: translateY(0);
    }

    /* Infinite Marquee Animation - Không bị ngắt quãng */
    @@keyframes marquee {
        0% { transform: translateX(0%); }
        100% { transform: translateX(-50%); }
    }

    .animate-marquee {
        display: flex;
        width: max-content;
        animation: marquee 32s linear infinite;
    }

    .animate-marquee:hover {
        animation-play-state: paused;
    }

    /* Scroll Reveal Animation: Trượt nhẹ sang trái */
    .slide-reveal-right {
        opacity: 0;
        transform: translateX(30px);
        transition: opacity 0.8s ease-out, transform 0.8s ease-out;
        will-change: opacity, transform;
    }

    .slide-reveal-right.revealed {
        opacity: 1;
        transform: translateX(0);
    }

    @@media (prefers-reduced-motion: reduce) {
        .animate-marquee {
            animation: none;
        }
        .equipment-reveal,
        .slide-reveal-right {
            opacity: 1;
            transform: none;
            transition: none;
        }
    }
</style>

<div class="w-full max-w-full overflow-x-hidden bg-[#F2EFEC] text-[#252323] font-body selection:bg-[#B83A3A] selection:text-white">

    <!-- ========================================================================= -->
    <!-- 1. HERO SECTION — Warm Neutral + Muted Red Athletic Editorial             -->
    <!-- ========================================================================= -->
    <section class="relative w-full min-h-[660px] lg:min-h-[720px] lg:h-screen lg:max-h-[940px] flex items-center overflow-hidden bg-[#F2EFEC] pt-24 pb-16 sm:pt-28 sm:pb-20 lg:pt-20 lg:pb-14">
        
        <!-- Background Image: natural gym photography, zero filter -->
        <div class="absolute inset-0 z-0">
            <img src="/images/hero-bg.png"
                 alt="Victor Fitness Elite Training Facility"
                 class="w-full h-full object-cover object-center" />
            <!-- Soft warm-neutral overlay + subtle bottom transition into #F2EFEC -->
            <div class="hero-overlay absolute inset-0" aria-hidden="true"></div>
        </div>

        <!-- Hero Content: editorial left column, constrained width so focal photography stays clear -->
        <div class="relative z-10 w-full max-w-[1440px] mx-auto px-6 sm:px-8 lg:px-12">
            <div class="w-full md:max-w-[520px] lg:max-w-[580px] flex flex-col justify-center">
            
                <!-- Eyebrow label: synced with Login's short muted-red rule + wide-tracked Montserrat -->
                <div class="inline-flex items-center gap-2.5 mb-5">
                    <span class="block w-7 h-[2px] bg-[#B83A3A] flex-shrink-0" aria-hidden="true"></span>
                    <span class="font-heading text-[11px] sm:text-xs font-bold tracking-[0.16em] text-[#252323]/85 uppercase">
                        V-FITNESS MANAGEMENT SYSTEM
                    </span>
                </div>

                <!-- Main Headline -->
                <h1 class="hero-headline mb-5 sm:mb-6">
                    <span class="block text-[2.125rem] sm:text-[2.85rem] md:text-[3.25rem] lg:text-[3.75rem] xl:text-[4rem] text-[#252323]">KỶ LUẬT TẠO NÊN</span>
                    <span class="block text-[2.125rem] sm:text-[2.85rem] md:text-[3.25rem] lg:text-[3.75rem] xl:text-[4rem] text-[#B83A3A]">BẢN LĨNH THÉP</span>
                </h1>

                <!-- Subtext -->
                <p class="font-body text-[15px] sm:text-base lg:text-[17px] text-[#6F6966] font-normal max-w-[470px] mb-8 sm:mb-9 leading-[1.6]">
                    Hệ thống tập luyện và huấn luyện thể hình chuẩn hiệu suất cao. Không thỏa hiệp, không đường tắt — chỉ có sự kỷ luật, khoa học và kết quả đột phá.
                </p>

                <!-- CTA Buttons -->
                <div class="flex flex-col sm:flex-row items-stretch sm:items-center gap-3 w-full sm:w-auto">
                    <!-- Primary CTA: Muted Red -->
                    <button type="button"
                            @onclick="ScrollToFeaturedClasses"
                            class="home-focus w-full sm:w-auto min-h-[48px] inline-flex items-center justify-center bg-[#B83A3A] hover:bg-[#9F3030] active:bg-[#7F2929] text-white px-7 py-3.5 font-heading font-extrabold text-xs sm:text-[13px] tracking-[0.08em] uppercase transition-colors duration-200 cursor-pointer rounded-lg">
                        KHÁM PHÁ CÁC LỚP HỌC
                    </button>

                    <!-- Secondary CTA: warm neutral surface, muted-red hover -->
                    <a href="/auth/register"
                       class="home-focus w-full sm:w-auto min-h-[48px] inline-flex items-center justify-center bg-[#F8F5F2] hover:bg-[#ECE8E4] text-[#252323] hover:text-[#B83A3A] border border-[#D8D1CD] hover:border-[#B83A3A] px-7 py-3.5 font-heading font-extrabold text-xs sm:text-[13px] tracking-[0.08em] uppercase transition-colors duration-200 text-center rounded-lg">
                        ĐĂNG KÝ HỘI VIÊN
                    </a>
                </div>

                <!-- Stats Bar: restrained editorial metrics, warm hairline dividers -->
                <div class="flex flex-wrap sm:flex-nowrap items-start gap-x-6 gap-y-4 sm:gap-0 mt-11 sm:mt-12 pt-6 border-t border-[#D8D1CD] max-w-[540px]">
                    <div class="sm:pr-7">
                        <div class="font-heading text-xl sm:text-2xl font-extrabold text-[#B83A3A] tracking-tight leading-none">100%</div>
                        <div class="font-body text-[11px] font-medium text-[#5A5451] uppercase tracking-[0.06em] mt-1.5">Chuẩn Thiết Bị Olympic</div>
                    </div>
                    <div class="sm:px-7 sm:border-l sm:border-[#D8D1CD]">
                        <div class="font-heading text-xl sm:text-2xl font-extrabold text-[#B83A3A] tracking-tight leading-none">24/7</div>
                        <div class="font-body text-[11px] font-medium text-[#5A5451] uppercase tracking-[0.06em] mt-1.5">Check-in FaceID &amp; QR</div>
                    </div>
                    <div class="sm:pl-7 sm:border-l sm:border-[#D8D1CD]">
                        <div class="font-heading text-xl sm:text-2xl font-extrabold text-[#B83A3A] tracking-tight leading-none">50+</div>
                        <div class="font-body text-[11px] font-medium text-[#5A5451] uppercase tracking-[0.06em] mt-1.5">HLV Chuyên Nghiệp</div>
                    </div>
                </div>

            </div>
        </div>

        <!-- Scroll Down Indicator -->
        <div class="hidden md:flex absolute bottom-5 left-1/2 -translate-x-1/2 z-10 flex-col items-center pointer-events-none" aria-hidden="true">
            <span class="font-heading text-[10px] font-bold tracking-[0.16em] text-[#6F6966] uppercase mb-2">CUỘN XUỐNG</span>
            <div class="w-px h-7 bg-[#B83A3A]/60"></div>
        </div>

    </section>

    <!-- ========================================================================= -->
    <!-- 2. FEATURED CLASSES SECTION — Athletic Performance                        -->
    <!-- ========================================================================= -->
    <section id="featured-classes" class="w-full bg-[#F2EFEC] text-[#252323] pt-4 sm:pt-6 pb-28 border-b border-[#D8D1CD]">
        
        <!-- Infinite Marquee: Charcoal bar with Muted Red dividers -->
        <div class="w-full max-w-full overflow-hidden bg-[#252323] py-3.5 md:py-4 cursor-default select-none relative border-y border-[#2B2928]">
            <div class="animate-marquee whitespace-nowrap flex">
                <!-- Group 1 -->
                <div class="flex items-center gap-6 sm:gap-10 font-heading text-sm sm:text-lg md:text-xl font-black uppercase tracking-[0.14em] text-[#F8F5F2] pr-6 sm:pr-10 flex-shrink-0">
                    <span>GYM &amp; STRENGTH</span>
                    <span class="text-[#B83A3A] font-normal">—</span>
                    <span>YOGA STUDIO</span>
                    <span class="text-[#B83A3A] font-normal">—</span>
                    <span>PERSONAL TRAINER</span>
                    <span class="text-[#B83A3A] font-normal">—</span>
                    <span>HIIT</span>
                    <span class="text-[#B83A3A] font-normal">—</span>
                    <span>GYM &amp; STRENGTH</span>
                    <span class="text-[#B83A3A] font-normal">—</span>
                    <span>YOGA STUDIO</span>
                    <span class="text-[#B83A3A] font-normal">—</span>
                    <span>PERSONAL TRAINER</span>
                    <span class="text-[#B83A3A] font-normal">—</span>
                    <span>HIIT</span>
                    <span class="text-[#B83A3A] font-normal">—</span>
                </div>
                <!-- Group 2 (duplicate for seamless loop) -->
                <div class="flex items-center gap-6 sm:gap-10 font-heading text-sm sm:text-lg md:text-xl font-black uppercase tracking-[0.14em] text-[#F8F5F2] pr-6 sm:pr-10 flex-shrink-0" aria-hidden="true">
                    <span>GYM &amp; STRENGTH</span>
                    <span class="text-[#B83A3A] font-normal">—</span>
                    <span>YOGA STUDIO</span>
                    <span class="text-[#B83A3A] font-normal">—</span>
                    <span>PERSONAL TRAINER</span>
                    <span class="text-[#B83A3A] font-normal">—</span>
                    <span>HIIT</span>
                    <span class="text-[#B83A3A] font-normal">—</span>
                    <span>GYM &amp; STRENGTH</span>
                    <span class="text-[#B83A3A] font-normal">—</span>
                    <span>YOGA STUDIO</span>
                    <span class="text-[#B83A3A] font-normal">—</span>
                    <span>PERSONAL TRAINER</span>
                    <span class="text-[#B83A3A] font-normal">—</span>
                    <span>HIIT</span>
                    <span class="text-[#B83A3A] font-normal">—</span>
                </div>
            </div>
        </div>

        <div class="facility-map-section w-full px-4 sm:px-6 lg:px-8 py-16 mb-16">
            <div class="w-full max-w-[1650px] mx-auto">
                <header class="facility-intro">
                    <div>
                        <p class="facility-intro__eyebrow"><span aria-hidden="true"></span>VICTOR FITNESS / KHÔNG GIAN TẬP LUYỆN</p>
                        <h2>KHÁM PHÁ <br />PHÒNG TẬP</h2>
                    </div>
                    <p class="facility-intro__description">Làm quen với không gian Victor Fitness. Chọn một khu vực trên sơ đồ bên dưới để tìm hiểu thêm.</p>
                </header>
                <FacilityMap OnZoneAction="HandleFacilityZoneAction" />
            </div>
        </div>

        <!-- Equipment Showcase -->
        <section id="explore-equipment" class="w-full max-w-[1650px] mx-auto px-4 sm:px-6 lg:px-8 mb-24 relative">
            <!-- Watermark -->
            <div class="absolute top-0 sm:top-4 lg:top-8 right-0 sm:right-6 select-none pointer-events-none font-heading font-black text-6xl sm:text-8xl md:text-[9.5rem] lg:text-[13rem] text-[#E6E0DB] uppercase tracking-tighter leading-none z-0 overflow-hidden">
                STRENGTH
            </div>

            <!-- Section Header -->
            <div class="relative z-10 flex flex-col md:flex-row md:items-end justify-between mb-8 sm:mb-10 pb-6 border-b border-[#D8D1CD]">
                <div>
                    <div class="flex items-center gap-2.5 mb-3">
                        <span class="w-6 h-[2px] bg-[#B83A3A] inline-block" aria-hidden="true"></span>
                        <span class="font-heading text-[11px] sm:text-xs font-bold tracking-[0.16em] text-[#6F6966] uppercase">
                            VFMS PRO EQUIPMENT
                        </span>
                    </div>
                    <h2 class="font-heading text-4xl sm:text-5xl lg:text-6xl font-black uppercase text-[#252323] tracking-[-0.03em] leading-[0.98]">
                        THIẾT BỊ <br />
                        PHÒNG TẬP
                    </h2>
                </div>

                <p class="font-body text-xs sm:text-sm text-[#6F6966] max-w-sm mt-4 md:mt-0 font-normal leading-relaxed text-left md:text-right">
                    Nhập khẩu tiêu chuẩn Olympic quốc tế, tối ưu từng góc chuyển động giải phẫu cơ bắp và hỗ trợ tải trọng nặng an toàn tuyệt đối.
                </p>
            </div>

            <!-- Category Filter Buttons -->
            <div class="relative z-10 flex flex-wrap items-center gap-2 sm:gap-3 mb-8 sm:mb-10">
                @foreach (var cat in EquipmentCategories)
                {
                    var isActive = SelectedEquipmentCategory == cat.Key;
                    <button type="button"
                            @onclick="() => SelectEquipmentCategory(cat.Key)"
                            class="home-focus min-h-[44px] font-heading text-xs sm:text-[13px] font-bold uppercase tracking-[0.06em] px-4 sm:px-5 py-2.5 border rounded-lg cursor-pointer transition-colors duration-150 @(isActive ? "bg-[#B83A3A] text-white border-[#B83A3A]" : "bg-[#F8F5F2] text-[#252323] border-[#D8D1CD] hover:border-[#B83A3A] hover:text-[#B83A3A]")">
                        @cat.Label
                    </button>
                }
            </div>

            <!-- Equipment Grid -->
            <div class="relative z-10">
                <div id="equipment-grid" class="grid grid-cols-2 md:grid-cols-3 lg:grid-cols-4 gap-4 sm:gap-6">
                    @for (int i = 0; i < DisplayedEquipments.Count; i++)
                    {
                        var item = DisplayedEquipments[i];
                        var delay = (i % 4) * 120;
                        <div style="transition-delay: @(delay)ms;"
                             class="equipment-reveal relative aspect-square bg-[#F8F5F2] border border-[#D8D1CD] overflow-hidden group select-none flex items-center justify-center p-6 sm:p-8 cursor-default rounded-xl hover:border-[#B83A3A] transition-colors">
                            
                            <!-- Equipment image: màu tự nhiên, nhẹ scale khi hover -->
                            <img src="@item.ImageUrl"
                                 alt="@item.Name"
                                 loading="lazy"
                                 class="w-full h-full object-contain group-hover:scale-105 transition-transform duration-300 ease-out pointer-events-none" />

                            <!-- Label: Warm surface nền nhạt, trượt lên từ dưới -->
                            <div class="absolute bottom-0 inset-x-0 bg-[#F8F5F2]/95 border-t border-[#D8D1CD] px-3.5 py-3 translate-y-full group-hover:translate-y-0 transition-transform duration-200 ease-out z-20 pointer-events-none rounded-b-xl">
                                <span class="font-heading text-[10px] sm:text-[11px] font-bold text-[#B83A3A] uppercase tracking-[0.08em] block">
                                    @item.MuscleGroup
                                </span>
                                <h4 class="font-heading font-bold text-xs sm:text-sm uppercase tracking-tight text-[#252323] truncate">
                                    @item.Name
                                </h4>
                            </div>
                        </div>
                    }
                </div>
            </div>

            <!-- View All Button -->
            <div class="relative z-10 mt-12 sm:mt-16 flex justify-center">
                <button type="button"
                        @onclick="ViewAllEquipments"
                        class="home-focus min-h-[48px] font-heading font-extrabold text-xs sm:text-[13px] uppercase tracking-[0.1em] px-8 sm:px-10 py-3.5 bg-[#B83A3A] hover:bg-[#9F3030] active:bg-[#7F2929] text-white rounded-lg inline-flex items-center gap-3 transition-colors duration-200 cursor-pointer">
                    <span>XEM TẤT CẢ THIẾT BỊ</span>
                    <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3"></path>
                    </svg>
                </button>
            </div>
        </section>

        <!-- Section Container for Featured Classes -->
        <div class="w-full max-w-[1650px] mx-auto px-4 sm:px-6 lg:px-8">
            
            <!-- Section Header -->
            <div class="flex flex-col md:flex-row md:items-end justify-between mb-12 pb-6 border-b border-[#D8D1CD]">
                <div>
                    <div class="flex items-center gap-2.5 mb-3">
                        <span class="w-6 h-[2px] bg-[#B83A3A] inline-block" aria-hidden="true"></span>
                        <span class="font-heading text-[11px] sm:text-xs font-bold tracking-[0.16em] text-[#6F6966] uppercase">
                            VFMS SIGNATURE CURRICULUM
                        </span>
                    </div>
                    <h2 class="font-heading text-4xl sm:text-5xl lg:text-6xl font-black uppercase text-[#252323] tracking-[-0.03em] leading-[0.98]">
                        CÁC LỚP HỌC <br />
                        NỔI BẬT
                    </h2>
                </div>
                
                <p class="font-body text-xs sm:text-sm text-[#6F6966] max-w-sm mt-4 md:mt-0 font-normal leading-relaxed text-left md:text-right">
                    Được thiết kế dựa trên giáo trình thể lực cường độ cao, tối ưu hóa tăng cơ, đốt mỡ và tái tạo năng lượng thể chất toàn diện.
                </p>
            </div>

            <!-- Class Cards Grid: ảnh lớn, warm surface, border nhẹ, radius 10px -->
            <div class="w-full overflow-hidden">
                <div id="classes-grid" class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-4 md:gap-5">
                    @for (int i = 0; i < FeaturedClasses.Count; i++)
                    {
                        var item = FeaturedClasses[i];
                        var delayStyle = $"transition-delay: {i * 250}ms;";

                        <div style="@delayStyle"
                             class="slide-reveal-right group relative w-full h-[68vh] min-h-[520px] max-h-[750px] overflow-hidden bg-[#ECE8E4] border border-[#D8D1CD] hover:border-[#B83A3A] rounded-xl select-none transition-all duration-300">
                            
                            <!-- Ảnh màu tự nhiên, nhẹ scale khi hover -->
                            <img src="@item.ImageUrl"
                                 alt="@item.Title"
                                 class="w-full h-full object-cover object-center group-hover:scale-105 transition-all duration-700 ease-out pointer-events-none" />

                            <!-- Muted red badge nhỏ ở góc trên -->
                            <div class="absolute top-3 left-3 z-10">
                                <span class="bg-[#B83A3A] text-white font-heading text-[10px] font-bold uppercase tracking-[0.1em] px-2.5 py-1 rounded-md">@item.Badge</span>
                            </div>

                            <!-- Info layer: xuất hiện khi hover -->
                            <div class="absolute inset-x-0 bottom-0 bg-[#F8F5F2]/95 border-t border-[#D8D1CD] p-4 translate-y-full group-hover:translate-y-0 transition-transform duration-300 ease-out pointer-events-none rounded-b-xl">
                                <span class="font-heading text-[10px] font-bold text-[#B83A3A] uppercase tracking-[0.12em] block">@item.Category</span>
                                <h4 class="font-heading font-bold text-sm text-[#252323] mt-0.5 truncate tracking-tight">@item.TitleShort</h4>
                                <p class="font-body text-xs text-[#6F6966] mt-1">@item.Duration · @item.Level</p>
                            </div>
                        </div>
                    }
                </div>
            </div>

            <!-- Bottom Information Banner -->
            <div class="mt-16 p-8 bg-[#F8F5F2] border border-[#D8D1CD] rounded-xl flex flex-col md:flex-row items-center justify-between gap-6">
                <div>
                    <h4 class="font-heading text-lg font-extrabold text-[#252323] uppercase tracking-tight">
                        CHƯA CHỌN ĐƯỢC LỘ TRÌNH PHÙ HỢP?
                    </h4>
                    <p class="font-body text-sm text-[#6F6966] mt-1 leading-relaxed">
                        Hãy để đội ngũ chuyên gia VFMS kiểm tra thể trạng và thiết kế giáo án tập luyện chuyên biệt cho bạn.
                    </p>
                </div>
                <a href="#featured-classes"
                   class="home-focus min-h-[48px] inline-flex items-center justify-center bg-[#B83A3A] hover:bg-[#9F3030] active:bg-[#7F2929] text-white px-8 py-3.5 font-heading font-extrabold text-xs uppercase tracking-[0.1em] transition-colors duration-200 whitespace-nowrap rounded-lg">
                    ĐẶT LỊCH TƯ VẤN MIỄN PHÍ
                </a>
            </div>

        </div>

    </section>

    <!-- ========================================================================= -->
    <!-- 3. PRICING & MEMBERSHIPS SECTION — Membership Plans                       -->
    <!-- ========================================================================= -->
    <section id="pricing-memberships" class="w-full bg-[#F2EFEC] text-[#252323] py-24 border-b border-[#D8D1CD]">
        <div class="w-full max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
            
            <!-- Section Header -->
            <div class="flex flex-col md:flex-row md:items-end justify-between mb-12 pb-6 border-b border-[#D8D1CD]">
                <div>
                    <div class="flex items-center gap-2.5 mb-3">
