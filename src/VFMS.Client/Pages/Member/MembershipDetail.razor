@page "/my-memberships/{MembershipId:int}"
@layout PublicLayout
@using Microsoft.AspNetCore.Authorization
@using System.Net
@using VFMS.Client.Components.Memberships
@using VFMS.Contracts.Memberships
@attribute [Authorize(Roles = "Customer,Member")]
@inject MembershipPlanApiClient Plans
@implements IDisposable

<PageTitle>Chi tiết gói hội viên | Victor Fitness</PageTitle>

<section class="mx-auto min-w-0 max-w-5xl space-y-6 px-4 sm:px-6 pb-16 pt-28 font-body" aria-labelledby="membership-title">
    <header class="space-y-2 border-b border-vfms-border pb-5">
        <a href="/my-memberships" class="inline-flex min-h-[44px] items-center gap-2 text-sm font-bold text-vfms-primary hover:underline focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-vfms-primary">
            <span aria-hidden="true">←</span> Về Gói của tôi
        </a>
        <h1 id="membership-title" class="break-words font-heading text-3xl font-extrabold text-vfms-text">
            @(_detail?.Membership.PlanName ?? "Chi tiết gói hội viên")
        </h1>
    </header>

    @if (_notFound)
    {
        <p role="status" class="rounded-xl border border-vfms-border bg-vfms-surface p-5 text-sm text-vfms-text">Không tìm thấy gói hội viên.</p>
    }
    else if (_loadError is not null)
    {
        <div class="rounded-xl border border-red-200 bg-red-50 p-4">
            <p role="alert" class="text-sm text-red-800">@_loadError</p>
            <button type="button" class="mt-3 min-h-[44px] rounded-lg border border-red-300 bg-white px-4 py-2 text-sm font-semibold text-red-800 hover:bg-red-50 focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-vfms-primary" @onclick="LoadAsync">Thử lại</button>
        </div>
    }
    else if (_detail is { } detail)
    {
        var isYoga = detail.Membership.ComponentType == MembershipPlanServiceTypes.Yoga;
        <section class="space-y-4 rounded-xl border border-vfms-border bg-vfms-surface p-5 sm:p-6" aria-labelledby="membership-term-title">
            <div class="flex flex-wrap items-baseline justify-between gap-2">
                <h2 id="membership-term-title" class="font-heading text-xl font-bold text-vfms-text">Thông tin gói</h2>
                <MembershipStatusBadge Status="@detail.Membership.Status" />
            </div>
            <MembershipTermDetails Membership="@detail.Membership" />
            @if (detail.Membership.Activation is { } window && window.EarliestDate <= window.Deadline && MembershipDisplay.Today <= window.Deadline)
            {
                <button type="button" class="min-h-[44px] rounded-lg bg-vfms-primary px-5 py-2 text-sm font-semibold text-white hover:bg-vfms-primary-hover"
                        @onclick="() => _choosing = detail.Membership">Chọn ngày kích hoạt</button>
            }
            @if ((detail.Membership.Activation is null && detail.PurchasedAt.HasValue) || detail.InvoiceNumber is not null)
            {
                <dl class="grid gap-3 border-t border-vfms-border pt-4 text-sm sm:grid-cols-3">
                    @if (detail.Membership.Activation is null && detail.PurchasedAt is { } purchasedAt)
                    {
                        <div>
                            <dt class="text-xs font-semibold text-vfms-text-secondary">Ngày mua</dt>
                            <dd class="mt-1 font-bold text-vfms-text"><MembershipDate Date="@VietnamDate(purchasedAt)" /></dd>
                        </div>
                    }
                    @if (detail.InvoiceNumber is { } invoice)
                    {
                        <div>
                            <dt class="text-xs font-semibold text-vfms-text-secondary">Số hóa đơn</dt>
                            <dd class="mt-1 break-words font-bold text-vfms-text">@invoice</dd>
                        </div>
                    }
                </dl>
            }
        </section>

        @if (!isYoga || detail.Freeze.History.Count > 0)
        {
            <section class="space-y-4 rounded-xl border border-vfms-border bg-vfms-surface p-5 sm:p-6" aria-labelledby="membership-freeze-title">
                <h2 id="membership-freeze-title" class="font-heading text-xl font-bold text-vfms-text">@(isYoga ? "Lịch sử yêu cầu bảo lưu" : "Quyền lợi bảo lưu")</h2>
                @if (!isYoga)
                {
                    <MembershipFreezeEntitlement Freeze="@detail.Freeze" />

                    @if (detail.Membership.Status == MembershipStatuses.AwaitingActivation)
                    {
                        <p class="text-sm text-vfms-text-secondary">Bạn có thể đăng ký bảo lưu sau khi gói được kích hoạt và đáp ứng các điều kiện bảo lưu.</p>
                    }
                    else
                    {
                        <AuthorizeView Roles="Member">
                            <MembershipFreezeEligibilityPanel @key="MembershipId" MembershipId="@MembershipId" Submitted="FreezeSubmitted" />
                        </AuthorizeView>
                    }
                }

                <div class="space-y-3 border-t border-vfms-border pt-4">
                    @if (!isYoga)
                    {
                        <h3 class="font-heading text-sm font-bold text-vfms-text">Lịch sử yêu cầu bảo lưu</h3>
                    }
                    @if (detail.Freeze.History.Count == 0)
                    {
                        <p class="text-sm text-vfms-text-secondary">Gói này chưa có yêu cầu bảo lưu.</p>
                    }
                    else
                    {
                        <ul class="list-none divide-y divide-vfms-border p-0">
                            @foreach (var period in detail.Freeze.History.OrderBy(period => MembershipFreezeStatusBadge.Priority(period.Status))
                                .ThenByDescending(period => period.SubmittedAt).ThenByDescending(period => period.RequestedStartDate))
                            {
                                <li class="py-3 first:pt-0 last:pb-0">
                                    <dl class="grid gap-3 text-sm sm:grid-cols-3">
                                        <div>
                                            <dt class="text-xs font-semibold text-vfms-text-secondary">Thời gian bảo lưu đề nghị</dt>
                                            <dd class="mt-1 font-semibold text-vfms-text">
                                                <MembershipDate Date="@period.RequestedStartDate" /> đến hết <MembershipDate Date="@period.RequestedEndDate" />
                                            </dd>
                                            <dd class="mt-1 text-xs text-vfms-text-secondary">@(period.RequestedDays ?? (period.RequestedEndDate.DayNumber - period.RequestedStartDate.DayNumber + 1)) ngày</dd>
                                        </div>
                                        @if (period.ActualStartDate.HasValue || period.ActualEndDate.HasValue)
                                        {
                                            <div>
                                                <dt class="text-xs font-semibold text-vfms-text-secondary">Thời gian bảo lưu thực tế</dt>
                                                <dd class="mt-1 font-semibold text-vfms-text">
                                                    @if (period.ActualStartDate is { } actualStart)
                                                    {
                                                        <MembershipDate Date="@actualStart" />
                                                    }
                                                    @if (period.ActualEndDate is { } actualEnd)
                                                    {
                                                        <span>@(period.ActualStartDate.HasValue ? " đến hết " : "Kết thúc ngày ")</span><MembershipDate Date="@actualEnd" />
                                                    }
                                                </dd>
                                            </div>
                                        }
                                        <div>
                                            <dt class="text-xs font-semibold text-vfms-text-secondary">Trạng thái yêu cầu</dt>
                                            <dd class="mt-1"><MembershipFreezeStatusBadge Status="@period.Status" /></dd>
                                        </div>
                                        @if (period.SubmittedAt is { } submittedAt)
                                        {
                                            <div>
                                                <dt class="text-xs font-semibold text-vfms-text-secondary">Ngày gửi</dt>
                                                <dd class="mt-1 font-semibold text-vfms-text"><MembershipDate Date="@VietnamDate(submittedAt)" /></dd>
                                            </div>
                                        }
                                        @if (period.Status == "Rejected" && !string.IsNullOrWhiteSpace(period.ReviewNote))
                                        {
                                            <div class="sm:col-span-3">
                                                <dt class="text-xs font-semibold text-vfms-text-secondary">Lý do từ chối</dt>
                                                <dd class="mt-1 whitespace-pre-wrap break-words text-vfms-text">@period.ReviewNote</dd>
                                            </div>
                                        }
                                    </dl>
                                </li>
                            }
                        </ul>
                    }
                </div>
            </section>
        }
    }
    else
    {
        <p role="status" class="py-8 text-sm text-vfms-text-secondary">Đang tải thông tin gói hội viên...</p>
    }
</section>

@if (_choosing is not null)
{
    <MembershipActivationDialog Membership="_choosing" Saved="ActivationSaved" Closed="CloseActivation" />
}

@code {
    [Parameter] public int MembershipId { get; set; }

    private CancellationTokenSource? _loadRequest;
    private MembershipDetailResponse? _detail;
    private MembershipSummaryResponse? _choosing;
    private string? _loadError;
    private bool _notFound;
    private int? _requestedMembershipId;

    protected override Task OnParametersSetAsync()
    {
        if (_requestedMembershipId == MembershipId) return Task.CompletedTask;
        _requestedMembershipId = MembershipId;
        _choosing = null;
        return LoadAsync();
    }

    private void ActivationSaved(MembershipDetailResponse detail) => _detail = detail;

    private void CloseActivation() => _choosing = null;

    private async Task LoadAsync()
    {
        CancelLoad();
        _loadRequest = new();
        var ct = _loadRequest.Token;
        _detail = null;
        _loadError = null;
        _notFound = false;
        try
        {
            var detail = await Plans.GetMembershipDetailAsync(MembershipId, ct);
            if (!ct.IsCancellationRequested)
                _detail = detail;
        }
        catch (AuthApiException ex)
        {
            if (ct.IsCancellationRequested)
                return;
            if (ex.StatusCode == HttpStatusCode.NotFound)
                _notFound = true;
            else
                _loadError = ex.Message;
        }
        catch (OperationCanceledException) when (ct.IsCancellationRequested)
        {
            // The route changed or the member left the page.
        }
    }

    private static DateOnly VietnamDate(DateTimeOffset timestamp) =>
        DateOnly.FromDateTime(timestamp.ToOffset(TimeSpan.FromHours(7)).DateTime);

    private void FreezeSubmitted(MembershipFreezeRequestResponse request)
    {
        if (_detail is null)
            return;

        var period = new MembershipFreezePeriodResponse(request.StartDate, request.EndDate, request.ActualStartDate,
            request.ActualEndDate, request.Status, RequestedDays: request.RequestedDays, SubmittedAt: request.SubmittedAt,
            ReviewNote: request.ReviewNote);
        _detail = _detail with { Freeze = _detail.Freeze with { History = [period, .. _detail.Freeze.History] } };
    }

    private void CancelLoad()
    {
        _loadRequest?.Cancel();
        _loadRequest?.Dispose();
    }

    public void Dispose() => CancelLoad();
}
