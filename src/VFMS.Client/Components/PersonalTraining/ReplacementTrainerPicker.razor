@* GBR-105: same-level trainers who accept new members, with one published slot per training day. *@
@inject PersonalTrainingApiClient Api

<fieldset class="trainer-stack" disabled="@Disabled">
    <legend>Huấn luyện viên mới</legend>
    <TrainerFeedback Error="@_error" />
    @if (_trainers is null) { <p role="status">Đang tải huấn luyện viên…</p> }
    else if (_trainers.Length == 0) { <p class="trainer-muted">Hiện chưa có huấn luyện viên cùng cấp đang nhận học viên mới.</p> }
    else
    {
        <label>Chọn huấn luyện viên
            <select class="trainer-input" value="@_trainerId" @onchange="SelectTrainerAsync">
                <option value="">Chọn huấn luyện viên</option>
                @foreach (var trainer in _trainers)
                {
                    <option value="@trainer.UserId">@trainer.FullName · @PTDisplay.Level(trainer.Level)</option>
                }
            </select>
        </label>
        @if (_slots.Count > 0)
        {
            <p class="trainer-muted">Chọn ca cho từng ngày muốn tập (mỗi ngày tối đa một ca).</p>
            <PTWeeklyGrid Slots="_slots.Values.SelectMany(s => s).ToArray()" SelectedIds="_chosen.Values.OfType<int>().ToArray()"
                          SlotSelected="ChooseAsync" Disabled="Disabled" />
        }
        else if (_trainerId.Length > 0) { <p class="trainer-muted">Huấn luyện viên này chưa công bố lịch tuần.</p> }
    }
</fieldset>

@code {
    [Parameter, EditorRequired] public int ContractId { get; set; }
    [Parameter] public bool Disabled { get; set; }
    /// <summary>Raised with the trainer id and the chosen weekly template ids.</summary>
    [Parameter] public EventCallback<(string TrainerId, int[] TemplateIds)> Changed { get; set; }

    private PTReplacementTrainer[]? _trainers;
    private string _trainerId = "";
    private Dictionary<DayOfWeek, PTWeeklySlot[]> _slots = [];
    private readonly Dictionary<DayOfWeek, int?> _chosen = [];
    private string? _error;

    protected override async Task OnInitializedAsync()
    {
        try { _trainers = await Api.ReplacementTrainersAsync(ContractId); }
        catch (AuthApiException ex) { _error = ex.Message; _trainers = []; }
    }

    private async Task SelectTrainerAsync(ChangeEventArgs e)
    {
        _trainerId = e.Value?.ToString() ?? "";
        _slots = [];
        _chosen.Clear();
        if (_trainerId.Length > 0)
        {
            try
            {
                _slots = (await Api.WeeklyTemplateAsync(_trainerId)).GroupBy(s => s.DayOfWeek)
                    .ToDictionary(g => g.Key, g => g.OrderBy(s => s.StartTime).ToArray());
            }
            catch (AuthApiException ex) { _error = ex.Message; }
        }
        await NotifyAsync();
    }

    private Task ChooseAsync(PTWeeklySlot slot)
    {
        _chosen[slot.DayOfWeek] = _chosen.GetValueOrDefault(slot.DayOfWeek) == slot.TemplateId ? null : slot.TemplateId;
        return NotifyAsync();
    }

    private Task NotifyAsync() => Changed.InvokeAsync((_trainerId, _chosen.Values.OfType<int>().ToArray()));
}
