@using System.Globalization
@using VFMS.Contracts.Common
@using VFMS.Contracts.Memberships
@using VFMS.Contracts.Memberships.Validators
@inject MembershipPlanApiClient Plans
@inject NavigationManager Navigation
@implements IDisposable

@if (_loading)
{
    <p role="status" class="font-body text-sm">Đang tải các gói tập...</p>
}
else if (_error is not null)
{
    <div role="alert" class="rounded-xl border border-red-200 bg-red-50 p-5 font-body text-sm text-red-900">
        <p>@_error</p>
        <button type="button" class="mt-3 font-semibold text-red-800 underline hover:text-red-950" @onclick="() => LoadAsync(_requestedPage)">Thử lại</button>
    </div>
}
else if (_page is { Items.Count: > 0 } catalog)
{
    <div class="grid grid-cols-1 gap-6 md:grid-cols-3">
        @foreach (var plan in catalog.Items)
        {
            <article @key="plan.Id" class="flex flex-col gap-5 border border-[#D8DED2] bg-white p-7 rounded-xl hover:border-[#5F6F52] transition-colors">
                <header class="border-b border-[#EEF1EA] pb-5">
                    <span class="text-[10px] font-bold uppercase tracking-widest text-[#5F6F52] block mb-1">GÓI TẬP GYM</span>
                    <h3 class="font-heading mt-1 text-2xl font-black text-[#383E43]">@plan.Name</h3>
                    <p class="mt-1 font-body text-xs text-[#69706A]">@Duration(plan)</p>
                </header>
                <p class="font-heading text-2xl font-black text-[#383E43]">@plan.Price.ToString("#,0.##", Vietnamese) <span class="text-lg font-bold text-[#5F6F52]">₫</span></p>
                @if (!string.IsNullOrWhiteSpace(plan.Description))
                {
                    <p class="whitespace-pre-line font-body text-xs text-[#69706A] leading-relaxed">@plan.Description</p>
                }
                <button type="button" disabled="@(_submitting || _cart.Count >= 50)"
                        class="mt-auto bg-[#5F6F52] hover:bg-[#4E5D44] px-4 py-3 font-heading text-xs uppercase tracking-wider font-bold text-white rounded-lg transition-colors disabled:opacity-50"
                        @onclick="() => _cart.Add(new CartLine(plan))">Thêm gói tập</button>
            </article>
        }
    </div>
    @if (catalog.TotalCount > catalog.PageSize)
    {
        <nav aria-label="Phân trang gói tập" class="mt-8 flex items-center gap-4 font-body text-sm">
            <button type="button" class="border border-[#D8DED2] px-3.5 py-2 rounded-lg hover:border-[#5F6F52] disabled:opacity-50" disabled="@(catalog.Page == 1)"
                    @onclick="() => LoadAsync(catalog.Page - 1)">Trước</button>
            <span class="text-[#69706A]">Trang @catalog.Page</span>
            <button type="button" class="border border-[#D8DED2] px-3.5 py-2 rounded-lg hover:border-[#5F6F52] disabled:opacity-50"
                    disabled="@(catalog.Page * catalog.PageSize >= catalog.TotalCount)"
                    @onclick="() => LoadAsync(catalog.Page + 1)">Sau</button>
        </nav>
    }
}
else
{
    <p role="status" class="font-body text-sm text-[#69706A]">Hiện chưa có gói tập Gym mở bán.</p>
}

@if (_cart.Count > 0)
{
    <form class="mt-10 space-y-5 border border-[#D8DED2] bg-white p-6 font-body rounded-xl shadow-sm"
          @onsubmit="CheckoutAsync" @onsubmit:preventDefault aria-labelledby="membership-cart-title">
        <h3 id="membership-cart-title" class="font-heading text-xl font-black text-[#383E43]">Giỏ gói tập (@_cart.Count)</h3>
        <fieldset class="space-y-5" disabled="@_submitting">
            @foreach (var line in _cart)
            {
                <fieldset @key="line" class="grid gap-3 border border-[#D8DED2] p-4 md:grid-cols-2 rounded-lg bg-[#F7F4EC]/50">
                    <legend class="px-2 font-heading font-bold text-[#383E43]">@line.Plan.Name · @Money(line.Plan.Price)</legend>
                    <label class="block text-xs font-medium text-[#383E43]">
                        Email người thụ hưởng (để trống nếu mua cho mình)
                        <input type="email" class="mt-1 block w-full border border-[#D8DED2] bg-white p-2 text-sm rounded-lg focus:border-[#5F6F52] focus:outline-none"
                               autocomplete="off" maxlength="256" @bind="line.BeneficiaryEmail" />
                    </label>
                    <label class="block text-xs font-medium text-[#383E43]">
                        Ngày bắt đầu (để trống để hệ thống xếp lịch)
                        <input type="date" class="mt-1 block w-full border border-[#D8DED2] bg-white p-2 text-sm rounded-lg focus:border-[#5F6F52] focus:outline-none"
                               min="@DateInput(Today)" max="@DateInput(Today.AddDays(30))" @bind="line.ActivationDate" />
                    </label>
                    <button type="button" class="justify-self-start text-xs font-bold text-[#DC2626] hover:underline"
                            @onclick="() => _cart.Remove(line)">Bỏ gói @line.Plan.Name</button>
                </fieldset>
            }
            <p class="text-xs text-[#69706A]">Gói cùng loại dịch vụ được xếp nối tiếp sau gói hiện có.</p>
            <p class="font-heading text-lg font-bold text-[#383E43]">Tạm tính: <span class="text-[#5F6F52]">@Money(_cart.Sum(line => line.Plan.Price))</span></p>
            <label class="block text-xs font-medium text-[#383E43]">
                Hình thức thanh toán
                <select class="mt-1 block border border-[#D8DED2] bg-white p-2 text-sm rounded-lg focus:border-[#5F6F52] focus:outline-none" @bind="_paymentMethod">
                    <option value="@MembershipPaymentMethods.VietQr">Chuyển khoản VietQR</option>
                    <option value="@MembershipPaymentMethods.Cash">Tiền mặt tại quầy</option>
                </select>
            </label>
            <p id="membership-voucher-next-step" class="text-sm leading-relaxed text-[#69706A]">
                <span class="font-semibold text-[#383E43]">Có mã giảm giá?</span>
                Bạn có thể nhập và áp dụng mã ở bước thanh toán tiếp theo, trước khi chuyển khoản hoặc thanh toán tại quầy.
            </p>
            <button type="submit" aria-describedby="membership-voucher-next-step" class="bg-[#5F6F52] hover:bg-[#4E5D44] px-6 py-3 font-heading text-xs font-bold uppercase tracking-wider text-white rounded-lg transition-colors">
                @(_submitting ? "Đang tạo đơn..." : "Tạo đơn thanh toán")
            </button>
        </fieldset>
        @if (_checkoutError is not null)
        {
            <p role="alert" class="text-sm text-red-800">@_checkoutError</p>
        }
    </form>
}

@code {
    private static readonly NumberFormatInfo Vietnamese = new() { NumberGroupSeparator = ".", NumberDecimalSeparator = "," };
    private static readonly MembershipPurchaseRequestValidator PurchaseValidator = new();
    private readonly CancellationTokenSource _lifetime = new();
    private readonly List<CartLine> _cart = [];
    private PagedResponse<MembershipPlanCatalogItemResponse>? _page;
    private int _requestedPage = 1;
    private bool _loading = true;
    private string? _error;
    private bool _submitting;
    private string? _checkoutError;
    private string _paymentMethod = MembershipPaymentMethods.VietQr;
    private static DateOnly Today => DateOnly.FromDateTime(DateTimeOffset.UtcNow.ToOffset(TimeSpan.FromHours(7)).DateTime);

    protected override Task OnInitializedAsync() => LoadAsync(1);

    private async Task LoadAsync(int page)
    {
        if (_lifetime.IsCancellationRequested)
            return;

        _requestedPage = page;
        _loading = true;
        _error = null;
        var cancellationToken = _lifetime.Token;
        try
        {
            _page = await Plans.ListCatalogAsync(page, cancellationToken);
            if (_page.Items.Count == 0 && page > 1)
                _page = await Plans.ListCatalogAsync(1, cancellationToken);
        }
        catch (AuthApiException ex)
        {
            _error = ex.Message;
        }
        catch (OperationCanceledException) when (cancellationToken.IsCancellationRequested)
        {
            // The user left the catalog.
        }
        finally
        {
            _loading = false;
        }
    }

    private static string Duration(MembershipPlanCatalogItemResponse plan) =>
        plan.DurationInMonths is > 0 ? $"{plan.DurationInMonths} tháng"
            : plan.DurationInDays is > 0 ? $"{plan.DurationInDays} ngày"
            : "Chưa có thời hạn";

    private async Task CheckoutAsync()
    {
        if (_submitting || _cart.Count == 0)
            return;

        _submitting = true;
        _checkoutError = null;
        var ct = _lifetime.Token;
        try
        {
            var request = new MembershipPurchaseRequest(_cart.Select(line => new MembershipPurchaseItemRequest(
                line.Plan.Id, line.BeneficiaryEmail?.Trim(), line.ActivationDate)).ToArray(), _paymentMethod);
            var validation = await PurchaseValidator.ValidateAsync(request, ct);
            if (!validation.IsValid)
            {
                _checkoutError = validation.Errors[0].ErrorMessage;
                return;
            }
            var purchase = await Plans.PurchaseAsync(request, ct);
            Navigation.NavigateTo($"/membership-purchases/{Uri.EscapeDataString(purchase.OrderNumber)}");
        }
        catch (AuthApiException ex)
        {
            _checkoutError = ex.Message;
        }
        catch (OperationCanceledException) when (ct.IsCancellationRequested)
        {
            // The user left the catalog.
        }
        finally
        {
            _submitting = false;
        }
    }

    private static string Money(decimal value) => $"{value.ToString("#,0.##", Vietnamese)} ₫";
    private static string DateInput(DateOnly date) => date.ToString("yyyy-MM-dd", CultureInfo.InvariantCulture);

    private sealed class CartLine(MembershipPlanCatalogItemResponse plan)
    {
        public MembershipPlanCatalogItemResponse Plan { get; } = plan;
        public string? BeneficiaryEmail { get; set; }
        public DateOnly? ActivationDate { get; set; }
    }

    public void Dispose()
    {
        _lifetime.Cancel();
        _lifetime.Dispose();
    }
}
