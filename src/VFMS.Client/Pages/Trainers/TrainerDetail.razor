@page "/trainers/{Id:int}"
@layout PublicLayout
@using VFMS.Contracts.PersonalTraining
@inject TrainerApiClient Api
<PageTitle>@(_detail?.Profile.FullName ?? "Hồ sơ huấn luyện viên") | Victor Fitness</PageTitle>

<section class="trainer-page trainer-public trainer-stack">
    <a class="trainer-link" href="/trainers">← Danh sách huấn luyện viên</a>
    <TrainerFeedback Error="@_error" />
    @if (_loading)
    {
        <h1>Hồ sơ huấn luyện viên</h1>
        <p role="status">Đang tải hồ sơ…</p>
    }
    else if (_detail is { } detail)
    {
        <header class="trainer-panel trainer-stack">
            <div class="trainer-row">
                <TrainerAvatar Trainer="detail.Profile" />
                <div>
                    <h1>@detail.Profile.FullName</h1>
                    <p class="trainer-muted">@detail.Profile.Specialty · @detail.Profile.Level · @detail.Profile.ExperienceYears năm kinh nghiệm</p>
                </div>
            </div>
            @if (!string.IsNullOrWhiteSpace(detail.Profile.Bio))
            {
                <p class="trainer-copy">@detail.Profile.Bio</p>
            }
            @if (detail.IsOwnProfile)
            {
                <a class="trainer-button trainer-primary" href="/pt/trainer-profile">Quản lý hồ sơ PT</a>
            }
            else
            {
                <a class="trainer-button trainer-primary" href="@(detail.HasActivePTContract ? $"/trainers/{Id}/my-pt-schedule" : "#pt-packages")">
                    @(detail.HasActivePTContract ? "Xem lịch PT của tôi" : "Khám phá gói PT")
                </a>
            }
        </header>

        <div class="trainer-grid">
            <section class="trainer-panel trainer-stack">
                <h2>Chứng chỉ đã xác minh</h2>
                @if (detail.Certificates.Count == 0)
                {
                    <p class="trainer-muted">Chưa có chứng chỉ công khai.</p>
                }
                <ul class="trainer-list">
                    @foreach (var file in detail.Certificates)
                    {
                        @if (Api.PublicAsset(file.DownloadUrl) is { } url)
                        {
                            <li><a href="@url" class="trainer-link" target="@(file.IsExternalLink ? "_blank" : null)" rel="noopener noreferrer">@file.FileName</a></li>
                        }
                    }
                </ul>
            </section>
            <section class="trainer-panel trainer-stack">
                <h2>Đánh giá hội viên</h2>
                @if (detail.Reviews.Count == 0)
                {
                    <p class="trainer-muted">Chưa có đánh giá.</p>
                }
                else
                {
                    <p class="trainer-status">Trung bình @detail.Profile.AverageRating.ToString("0.0") / 5 sao</p>
                    <ul class="trainer-list">
                        @foreach (var review in detail.Reviews)
                        {
                            <li><strong>@review.Rating / 5 sao</strong><p class="trainer-copy">@review.Comment</p></li>
                        }
                    </ul>
                }
            </section>
        </div>

        <section class="trainer-panel trainer-stack">
            <h2>Lịch khả dụng trong 14 ngày</h2>
            @if (detail.Availability.Count == 0)
            {
                <p class="trainer-muted">Huấn luyện viên chưa công bố lịch.</p>
            }
            else
            {
                <div class="trainer-scroll">
                    <table class="trainer-table">
                        <thead><tr><th>Ngày</th><th>Ca tập</th><th>Trạng thái</th></tr></thead>
                        <tbody>
                            @foreach (var slot in detail.Availability)
                            {
                                <tr><td>@slot.Date.ToString("dd/MM/yyyy")</td><td>@slot.StartTime.ToString("HH:mm") – @slot.EndTime.ToString("HH:mm")</td><td><TrainerStatus Status="@slot.Status" /></td></tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
        </section>
        @if (!detail.IsOwnProfile)
        {
            <section id="pt-packages" class="trainer-panel trainer-stack" style="scroll-margin-top: 6rem">
                <h2>Gói PT phù hợp</h2>
                @if (_packages is null && _packageError is null)
                {
                    <p role="status">Đang tải gói PT…</p>
                }
                <TrainerFeedback Error="@_packageError" />
                @if (_packages is { Length: 0 })
                {
                    <p class="trainer-muted">Chưa có gói đang mở bán cho cấp @detail.Profile.Level.</p>
                }
                else if (_packages is { } packages)
                {
                    <div class="trainer-grid">
                        @foreach (var package in packages)
                        {
                            <article class="trainer-panel trainer-stack">
                                <h3>@package.Name</h3>
                                <p>@package.Credits buổi · @package.ValidityDays ngày</p>
                                <strong>@package.Price.ToString("N0") đ</strong>
                                @if (!string.IsNullOrWhiteSpace(package.Description))
                                {
                                    <p class="trainer-copy trainer-muted">@package.Description</p>
                                }
                            </article>
                        }
                    </div>
                }
            </section>
        }
    }
    else
    {
        <h1>Hồ sơ huấn luyện viên</h1>
    }
</section>

@code {
    [Parameter] public int Id { get; set; }
    private TrainerPublicDetail? _detail;
    private PTPackageResponse[]? _packages;
    private bool _loading;
    private string? _error, _packageError;
    private int _requestVersion;

    protected override async Task OnParametersSetAsync()
    {
        var version = ++_requestVersion;
        _loading = true;
        _detail = null;
        _packages = null;
        _error = _packageError = null;
        try
        {
            var detail = await Api.DetailAsync(Id);
            if (version != _requestVersion) return;
            _detail = detail;
            _loading = false;
            if (detail.IsOwnProfile) return;
            StateHasChanged();
            try
            {
                var packages = await Api.PackagesAsync();
                if (version == _requestVersion)
                    _packages = packages.Where(p => p.IsActive && p.TrainerLevel == detail.Profile.Level).ToArray();
            }
            catch (AuthApiException ex) { if (version == _requestVersion) _packageError = ex.Message; }
        }
        catch (AuthApiException ex) { if (version == _requestVersion) _error = ex.Message; }
        finally { if (version == _requestVersion) _loading = false; }
    }
}
