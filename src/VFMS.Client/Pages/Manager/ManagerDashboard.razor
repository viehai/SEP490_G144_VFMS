@page "/manager/dashboard"
@layout ManagerAdminLayout
@using Microsoft.AspNetCore.Authorization
@using VFMS.Client.Components.Dashboards
@using VFMS.Contracts.Dashboards
@attribute [Authorize(Roles = "Manager")]

<PageTitle>Tổng quan quản lý | Victor Fitness</PageTitle>
<DashboardView T="ManagerOverview" Path="@_path" Title="Tổng quan quản lý" Description="Theo dõi hoạt động kinh doanh, hội viên và vận hành phòng tập.">
    <HeaderControl><span class="dash-date"><DashboardIcon Name="calendar" />Hôm nay, @PTDisplay.Today.ToString("dd/MM/yyyy")</span></HeaderControl>
    <ChildContent Context="data">
        <div class="dash-stats">
            <DashboardStat Icon="money" Label="Doanh thu hôm nay" Value="@Vnd.Format(data.RevenueToday)" Note="@($"Hôm qua {Vnd.Format(data.RevenueYesterday)}")" />
            <DashboardStat Icon="people" Label="Hội viên đang hoạt động" Value="@data.ActiveMembers.ToString()" Note="Có ít nhất một gói đang hiệu lực" />
            <DashboardStat Icon="orders" Label="Đơn gói chờ thanh toán" Value="@data.PendingOrders.ToString()" Note="Gym, Yoga và PT" />
            <DashboardStat Icon="calendar" Label="Lịch PT trong ngày" Value="@($"{data.PTSessions} buổi")" />
        </div>
        <div class="dash-grid">
            <section class="dash-panel"><header><h2>Doanh thu</h2><div class="dash-tabs" role="group" aria-label="Khoảng thời gian doanh thu">
                @foreach (var days in Ranges) { <button type="button" aria-pressed="@(_range == days && !_custom ? "true" : "false")" @onclick="() => SetRange(days, data.Today)">@days ngày</button> }
                <button type="button" aria-pressed="@(_custom ? "true" : "false")" @onclick="() => _custom = true">Tùy chọn</button>
            </div></header>
            @if (_custom)
            {
                <form class="dash-dates" @onsubmit="ApplyDates" @onsubmit:preventDefault>
                    <label>Từ ngày<input type="date" @bind="_from" max="@Iso(data.Today)" required /></label>
                    <label>Đến ngày<input type="date" @bind="_to" min="@Iso(_from)" max="@Iso(data.Today)" required /></label>
                    <button type="submit">Áp dụng</button>
                </form>
                @if (_validation is not null) { <p class="dash-error" role="alert">@_validation</p> }
            }
            <DashboardTrend Points="data.Revenue" Bars="true" Unit="Doanh thu (₫)" /></section>
            <section class="dash-panel"><header><h2>Tình hình hội viên</h2></header>
                <DashboardDonut Items="data.Memberships" Center="data.ActiveMembers" Caption="hội viên đang hoạt động" Label="MemberLabel" /></section>
            <section class="dash-panel"><header><h2>Đơn hàng gần đây</h2></header><DashboardOrders Rows="data.Recent" ShowMethod="true" /></section>
            <section class="dash-panel"><header><h2>Chờ thu tiền tại quầy</h2><DashboardIcon Name="money" /></header>
                @if (data.Counter.Count == 0) { <p class="dash-message">Không có đơn gói chờ thu tiền mặt.</p> }
                else { <ul class="dash-list">@foreach (var order in data.Counter) {
                    <li><div><strong>@order.Number</strong><small>@order.Customer · @order.Product</small></div><b>@(order.Amount is { } amount ? Vnd.Format(amount) : "—")</b></li>
                }</ul> }
                <div id="quick-actions" class="dash-inset-actions"><h2>Truy cập nhanh</h2><div class="dash-actions">
                <DashboardLink Href="/manager/business-reports" Icon="chart">Báo cáo kinh doanh</DashboardLink>
                <DashboardLink Href="/manager/membership-plans" Icon="list">Gói hội viên</DashboardLink>
                <DashboardLink Href="/manager/promotions" Icon="tag">Khuyến mãi &amp; Voucher</DashboardLink>
                <DashboardLink Href="/manager/membership-freeze-requests" Icon="calendar">Duyệt bảo lưu</DashboardLink>
                <DashboardLink Href="/manager/purchase-proposals" Icon="orders">Đề xuất mua sắm</DashboardLink>
                <DashboardLink Href="/manager/lockers" Icon="grid">Danh mục tủ &amp; bảng giá</DashboardLink>
                <DashboardLink Href="/manager/locker-clearances" Icon="check">Xác nhận dọn tủ</DashboardLink>
                <DashboardLink Href="/manager/feedback" Icon="chat">Phản hồi khách hàng</DashboardLink>
                </div></div>
            </section>
        </div>
    </ChildContent>
</DashboardView>
@code {
    private static readonly int[] Ranges = [7,30,90];
    private int _range = 7;
    private bool _custom;
    private DateOnly _from = PTDisplay.Today.AddDays(-6), _to = PTDisplay.Today;
    private string _path = "api/dashboards/manager";
    private string? _validation;
    private static string Iso(DateOnly d) => d.ToString("yyyy-MM-dd", System.Globalization.CultureInfo.InvariantCulture);
    private static string MemberLabel(string category) => category switch {
        "Active" => "Đang hoạt động (> 7 ngày)", "Expiring" => "Sắp hết hạn (≤ 7 ngày)", "Frozen" => "Đang bảo lưu",
        "Scheduled" => "Chờ kích hoạt", "Suspended" => "Tạm ngưng", _ => "Đã hết hạn"
    };
    private void SetRange(int days, DateOnly today)
    {
        if (!_custom && days == _range && _to == today) return;
        _range = days;
        _custom = false;
        _to = today;
        _from = today.AddDays(1-days);
        ApplyDates();
    }
    private void ApplyDates()
    {
        _validation = _to < _from || _to.DayNumber - _from.DayNumber >= 93 || _to > PTDisplay.Today
            ? "Chọn tối đa 93 ngày, kết thúc không muộn hơn hôm nay." : null;
        if (_validation is null) _path = $"api/dashboards/manager?from={Iso(_from)}&to={Iso(_to)}";
    }
}
