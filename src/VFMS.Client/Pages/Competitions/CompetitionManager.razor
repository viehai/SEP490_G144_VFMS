@page "/manager/competitions"
@layout ManagerAdminLayout
@using VFMS.Client.Components.Operations
@inject CompetitionApiClient Api
@inject IJSRuntime JS

<PageTitle>Quản lý cuộc thi | Victor Fitness</PageTitle>

<div class="workspace-page space-y-8 font-['Inter',sans-serif] text-[#252525]">
    <header class="flex flex-col justify-between gap-5 border-b border-[#D8D1CD] pb-7 md:flex-row md:items-end">
        <div>
            <p class="workspace-heading mb-3 text-[10px] font-bold tracking-[.18em] text-[#8C8581]">VFMS / MODULE 06 / MANAGER</p>
            <h1 class="workspace-heading text-3xl font-extrabold uppercase tracking-tight text-[#252323] sm:text-4xl">Quản lý cuộc thi<span class="text-[#B83A3A]">.</span></h1>
        </div>
        <div class="flex flex-wrap gap-3">
            <button type="button" @onclick="ReloadAsync" disabled="@_loading" class="workspace-heading rounded-lg border border-[#D8D1CD] bg-white px-3 py-2 text-[10px] font-bold uppercase tracking-wider text-[#252323] hover:border-[#B83A3A] hover:text-[#B83A3A]">Làm mới ↻</button>
            <button type="button" @onclick="() => _showCreate = !_showCreate" class="workspace-heading rounded-lg bg-[#B83A3A] px-3 py-2 text-[10px] font-bold uppercase tracking-wider text-white hover:bg-[#9F3030]">+ Tạo cuộc thi</button>
        </div>
    </header>

    @if (_error is not null && _panel is Panel.None)
    {
        <div class="border-2 border-[#EF4444] bg-red-50 p-4 text-sm text-red-800" role="alert">@_error</div>
    }

    @if (_showCreate)
    {
        <section class="rounded-2xl border border-[#D8D1CD] bg-white p-6 shadow-sm" aria-labelledby="create-title">
            <h2 id="create-title" class="workspace-heading mb-5 text-sm font-extrabold uppercase tracking-wider">Tạo cuộc thi mới</h2>
            <div class="grid gap-4 md:grid-cols-2">
                <div class="md:col-span-2">
                    <label for="c-name" class="workspace-heading mb-2 block text-[10px] font-bold uppercase tracking-wider">TÊN CUỘC THI *</label>
                    <input id="c-name" class="w-full border border-[#CFCFCF] px-3 py-2 text-sm" @bind="_formName" />
                </div>
                <div class="md:col-span-2">
                    <label for="c-desc" class="workspace-heading mb-2 block text-[10px] font-bold uppercase tracking-wider">MÔ TẢ</label>
                    <textarea id="c-desc" rows="2" class="w-full border border-[#CFCFCF] px-3 py-2 text-sm" @bind="_formDescription"></textarea>
                </div>
                <div>
                    <label for="c-reg-start" class="workspace-heading mb-2 block text-[10px] font-bold uppercase tracking-wider">BẮT ĐẦU ĐĂNG KÝ (GIỜ VIỆT NAM) *</label>
                    <input id="c-reg-start" type="datetime-local" class="w-full border border-[#CFCFCF] px-3 py-2 text-sm" @bind="_formRegistrationStart" />
                </div>
                <div>
                    <label for="c-reg-end" class="workspace-heading mb-2 block text-[10px] font-bold uppercase tracking-wider">KẾT THÚC ĐĂNG KÝ (GIỜ VIỆT NAM) *</label>
                    <input id="c-reg-end" type="datetime-local" class="w-full border border-[#CFCFCF] px-3 py-2 text-sm" @bind="_formRegistrationEnd" />
                </div>
                <div>
                    <label for="c-start" class="workspace-heading mb-2 block text-[10px] font-bold uppercase tracking-wider">BẮT ĐẦU THI (GIỜ VIỆT NAM) *</label>
                    <input id="c-start" type="datetime-local" class="w-full border border-[#CFCFCF] px-3 py-2 text-sm" @bind="_formStart" />
                </div>
                <div>
                    <label for="c-end" class="workspace-heading mb-2 block text-[10px] font-bold uppercase tracking-wider">KẾT THÚC THI (GIỜ VIỆT NAM) *</label>
                    <input id="c-end" type="datetime-local" class="w-full border border-[#CFCFCF] px-3 py-2 text-sm" @bind="_formEnd" />
                </div>
                <div>
                    <label for="c-max" class="workspace-heading mb-2 block text-[10px] font-bold uppercase tracking-wider">TỐI ĐA NGƯỜI THAM GIA</label>
                    <input id="c-max" type="number" min="1" class="w-full border border-[#CFCFCF] px-3 py-2 text-sm" @bind="_formMaxParticipants" />
                </div>
            </div>
            <div class="mt-6 flex flex-wrap gap-3">
                <button type="button" @onclick="CreateAsync" disabled="@_busy" class="workspace-heading rounded-lg bg-[#B83A3A] px-5 py-3 text-xs font-bold uppercase tracking-wider text-white hover:bg-[#9F3030] disabled:opacity-50">Tạo cuộc thi ↗</button>
                <button type="button" @onclick="() => _showCreate = false" class="workspace-heading rounded-lg border border-[#D8D1CD] bg-white px-5 py-3 text-xs font-bold uppercase tracking-wider text-[#383E43] hover:border-[#B83A3A] hover:text-[#B83A3A]">Hủy</button>
            </div>
        </section>
    }

    <section class="rounded-2xl border border-[#D8DED2] bg-white p-5 shadow-sm sm:p-6" aria-labelledby="manager-competition-filter-title">
        <div class="mb-5">
            <h2 id="manager-competition-filter-title" class="workspace-heading text-sm font-extrabold text-[#383E43]">Lọc cuộc thi</h2>
            <p class="mt-1 text-xs text-[#69706A]">Tìm theo tên hoặc mô tả, hoặc chọn trạng thái. Cuộc thi không tự đổi trạng thái theo lịch; sau khi đến giờ bắt đầu, quản lý có thể chủ động kết thúc để duyệt kết quả.</p>
        </div>
        <form class="grid items-end gap-4 md:grid-cols-2 xl:grid-cols-[minmax(0,1.2fr)_minmax(0,1fr)_auto]" @onsubmit="ApplyFiltersAsync" @onsubmit:preventDefault>
            <div>
                <label for="manager-comp-search" class="workspace-heading mb-2 block text-[10px] font-bold uppercase tracking-wider text-[#69706A]">Tìm kiếm</label>
                <input id="manager-comp-search" class="w-full rounded-xl border border-[#D8DED2] bg-[#FAFAF8] px-4 py-3 text-sm text-[#383E43] placeholder:text-[#9AA098] focus:border-[#5F6F52] focus:bg-white focus:outline-none focus:ring-2 focus:ring-[#5F6F52]/15" @bind="_search" @bind:event="oninput" placeholder="Tên hoặc mô tả cuộc thi" />
            </div>
            <div>
                <label for="manager-comp-status" class="workspace-heading mb-2 block text-[10px] font-bold uppercase tracking-wider text-[#69706A]">Trạng thái</label>
                <select id="manager-comp-status" class="w-full rounded-xl border border-[#D8DED2] bg-[#FAFAF8] px-4 py-3 text-sm text-[#383E43] focus:border-[#5F6F52] focus:bg-white focus:outline-none focus:ring-2 focus:ring-[#5F6F52]/15" @bind="_status">
                    <option value="">Tất cả trạng thái</option>
                    <option value="Draft">Bản nháp</option>
                    <option value="Published">Đã phát hành</option>
                    <option value="Ongoing">Đang diễn ra</option>
                    <option value="Completed">Đã kết thúc</option>
                    <option value="Cancelled">Đã hủy</option>
                </select>
            </div>
            <div class="flex flex-wrap gap-2 md:col-span-2 xl:col-span-1">
                <button type="submit" disabled="@_loading" class="workspace-heading min-h-11 flex-1 rounded-xl bg-[#5F6F52] px-5 py-3 text-xs font-bold uppercase tracking-wider text-white transition-colors hover:bg-[#4E5D44] disabled:opacity-50">Lọc cuộc thi</button>
                <button type="button" @onclick="ClearFiltersAsync" disabled="@_loading" class="workspace-heading min-h-11 rounded-xl border border-[#D8DED2] bg-white px-4 py-3 text-xs font-bold text-[#383E43] transition-colors hover:bg-[#EEF1EA] disabled:opacity-50">Xóa lọc</button>
            </div>
        </form>
    </section>

    <section class="overflow-hidden rounded-2xl border border-[#D8DED2] bg-white shadow-sm" aria-labelledby="mgr-list-title" aria-live="polite">
        <div class="flex flex-wrap items-center justify-between gap-3 border-b border-[#D8DED2] bg-[#EEF1EA]/40 px-5 py-5 sm:px-6">
            <h2 id="mgr-list-title" class="workspace-heading text-sm font-extrabold uppercase tracking-wider">Danh sách cuộc thi</h2>
            <span class="text-xs text-[#71717A]">@_total mục</span>
        </div>
        @if (_loading)
        {
            <p role="status" class="px-6 py-10 text-center text-sm text-[#69706A]">Đang tải cuộc thi...</p>
        }
        else if (_items.Count == 0)
        {
            <p class="px-6 py-10 text-center text-sm text-[#71717A]">
                @(HasFilters ? "Không tìm thấy cuộc thi phù hợp với bộ lọc." : "Chưa có cuộc thi nào. Bấm nút Tạo cuộc thi để bắt đầu.")
            </p>
        }
        else
        {
            <div class="overflow-x-auto">
                <table class="workspace-table w-full min-w-[900px] table-fixed text-left text-sm">
                    <thead class="workspace-heading text-[10px] uppercase tracking-wider">
                        <tr><th class="w-[30%] px-4 py-4">Cuộc thi</th><th class="w-[18%] px-4 py-4">Thi</th><th class="w-[10%] px-4 py-4">Người</th><th class="w-[14%] px-4 py-4">Trạng thái</th><th class="w-[28%] px-4 py-4">Thao tác</th></tr>
                    </thead>
                    <tbody class="divide-y divide-[#EEF1EA]">
                        @foreach (var item in _items)
                        {
                            <tr class="hover:bg-[#FAFAF7]">
                                <th scope="row" class="break-words px-4 py-4 font-semibold">@item.Name</th>
                                <td class="whitespace-nowrap px-4 py-4 text-xs text-[#69706A]">@FormatVietnamDate(item.StartDate) - @FormatVietnamDate(item.EndDate)</td>
                                <td class="workspace-heading whitespace-nowrap px-4 py-4 text-xs font-bold">@item.ParticipantCount@(item.MaxParticipants is { } max ? $" / {max}" : "")</td>
                                <td class="px-4 py-4"><span class="@StatusClass(item.Status)">@CompetitionStatusLabel(item.Status)</span></td>
                                <td class="px-4 py-4">
                                    <div class="flex flex-wrap gap-2">
                                        @if (item.Status == "Draft")
                                        {
                                            <button type="button" @onclick='() => PublishAsync(item.Id)' class="workspace-heading rounded-lg border border-[#A9B79D] bg-[#EEF1EA] px-2.5 py-1.5 text-[10px] font-bold uppercase text-[#4E5D44]">Phát hành</button>
                                        }
                                        @if (item.Status is "Draft" or "Published" or "Ongoing")
                                        {
                                            <button type="button" @onclick='() => CancelAsync(item.Id)' disabled="@_busy" class="workspace-heading rounded-lg border border-red-200 bg-red-50 px-2.5 py-1.5 text-[10px] font-bold uppercase text-red-700 disabled:opacity-50">Hủy</button>
                                        }
                                        @if (CanCompleteManually(item))
                                        {
                                            <button type="button" @onclick='() => CompleteAsync(item.Id)' disabled="@_busy" class="workspace-heading rounded-lg border border-amber-200 bg-amber-50 px-2.5 py-1.5 text-[10px] font-bold uppercase text-amber-800 disabled:opacity-50">Kết thúc</button>
                                        }
                                        <button type="button" @onclick='() => OpenParticipantsAsync(item.Id)' class="workspace-heading rounded-lg border border-[#D8DED2] bg-white px-2.5 py-1.5 text-[10px] font-bold uppercase text-[#383E43] hover:bg-[#EEF1EA]">Người tham gia</button>
                                        <button type="button" @onclick='() => OpenResultsAsync(item.Id)' class="workspace-heading rounded-lg bg-[#5F6F52] px-2.5 py-1.5 text-[10px] font-bold uppercase text-white hover:bg-[#4E5D44]">Kết quả</button>
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
            @if (_total > 0)
            {
                <Pager Page="_page" PageSize="PageSize" TotalCount="_total" Noun="cuộc thi" AriaLabel="Phân trang cuộc thi" Disabled="@(_loading || _busy)" OnPage="LoadPageAsync" />
            }
        }
    </section>

    @if (_panel is Panel.Participants)
    {
        <WorkspaceModal Open="true" Eyebrow="VFMS / MODULE 06 / UC-60" Title="@($"Người tham gia · {_selectedCompetitionName}")" OnClose="CloseDetailsAsync">
            @if (_notice is not null)
            {
                <div class="m-4 rounded-xl border border-emerald-200 bg-emerald-50 p-4 text-sm text-emerald-800" role="status">@_notice</div>
            }
            @if (_error is not null)
            {
                <div class="m-4 border-2 border-[#EF4444] bg-red-50 p-4 text-sm text-red-800" role="alert">@_error</div>
            }
            @if (_participants.Count == 0)
            {
                <p class="px-6 py-8 text-center text-sm text-[#71717A]">Chưa có người tham gia.</p>
            }
            else
            {
                <div class="overflow-x-auto">
                    <table class="workspace-table w-full min-w-[800px] text-left text-sm">
                        <thead class="workspace-heading bg-[#F7F7F7] text-[10px] uppercase tracking-wider">
                            <tr><th class="px-6 py-4">Hội viên</th><th class="px-6 py-4">Đăng ký</th><th class="px-6 py-4">Điểm</th><th class="px-6 py-4">Hạng</th><th class="px-6 py-4">Trạng thái</th><th class="px-6 py-4">Thao tác</th></tr>
                        </thead>
                        <tbody class="divide-y divide-[#CFCFCF]">
                            @foreach (var row in _participants)
                            {
                                <tr class="hover:bg-[#F7F7F7]">
                                    <th scope="row" class="px-6 py-5">
                                        <span class="block font-medium">@row.MemberName</span>
                                        <span class="mt-1 block text-xs text-[#71717A]">@row.MemberEmail</span>
                                    </th>
                                    <td class="px-6 py-5 text-xs text-[#545454]">@FormatVietnamDateTime(row.RegisteredAt)</td>
                                    <td class="workspace-heading px-6 py-5 text-xs font-bold">@(row.Score?.ToString("0.##") ?? "-")</td>
                                    <td class="workspace-heading px-6 py-5 text-xs font-bold">@(row.Rank?.ToString() ?? "-")</td>
                                    <td class="px-6 py-5"><span class="@StatusClass(row.Status)">@ParticipantStatusLabel(row.Status)</span></td>
                                    <td class="px-6 py-5">
                                        <div class="flex flex-wrap gap-2">
                                            @if (row.Status == "Disqualified")
                                            {
                                                <button type="button" @onclick='() => ReinstateAsync(row.Id)' class="workspace-heading rounded-lg border border-[#A7C7B0] bg-emerald-50 px-2.5 py-1.5 text-[10px] font-bold uppercase text-[#047857]">Khôi phục</button>
                                            }
                                            else if (row.Status != "Completed")
                                            {
                                                <button type="button" @onclick='() => DisqualifyAsync(row.Id)' class="workspace-heading rounded-lg border border-[#D7A7A7] bg-[#F7EAEA] px-2.5 py-1.5 text-[10px] font-bold uppercase text-[#9F3030]">Loại</button>
                                            }
                                            @if (row.Status != "Completed" && row.Status != "Disqualified")
                                            {
                                                <button type="button" @onclick='() => OpenRecordResult(row)' class="workspace-heading rounded-lg border border-[#D8D1CD] bg-white px-2.5 py-1.5 text-[10px] font-bold uppercase text-[#383E43] hover:border-[#B83A3A] hover:text-[#B83A3A]">Ghi điểm</button>
                                            }
                                            @if (CanConfirmResult(row))
                                            {
                                                <button type="button" @onclick='() => ConfirmResultAsync(row.Id, row.Rank)' disabled="@_busy" class="workspace-heading rounded-lg bg-[#5F6F52] px-2.5 py-1.5 text-[10px] font-bold uppercase text-white hover:bg-[#4E5D44] disabled:opacity-50">Duyệt kết quả</button>
                                            }
                                        </div>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
        </WorkspaceModal>
    }

    @if (_panel is Panel.RecordResult)
    {
        <WorkspaceModal Open="true" Eyebrow="VFMS / MODULE 06 / UC-61" Title="@($"Ghi điểm · {_resultMemberName}")" OnClose="CloseDetailsAsync">
            @if (_error is not null)
            {
                <div class="m-4 border-2 border-[#EF4444] bg-red-50 p-4 text-sm text-red-800" role="alert">@_error</div>
            }
            <div class="grid gap-4 p-6 sm:grid-cols-2">
                <div>
                    <label for="competition-result-score" class="workspace-heading mb-2 block text-[10px] font-bold uppercase tracking-wider">ĐIỂM</label>
                    <InputNumber id="competition-result-score" @bind-Value="_resultScore" min="0" step="any" class="w-full border border-[#CFCFCF] px-3 py-2 text-sm" />
                </div>
                <div>
                    <label for="competition-result-rank" class="workspace-heading mb-2 block text-[10px] font-bold uppercase tracking-wider">HẠNG</label>
                    <InputNumber id="competition-result-rank" @bind-Value="_resultRank" min="1" class="w-full border border-[#CFCFCF] px-3 py-2 text-sm" />
                </div>
                <div class="sm:col-span-2">
                    <label for="competition-result-note" class="workspace-heading mb-2 block text-[10px] font-bold uppercase tracking-wider">GHI CHÚ</label>
                    <textarea id="competition-result-note" @bind="_resultNote" rows="3" class="w-full border border-[#CFCFCF] px-3 py-2 text-sm"></textarea>
                </div>
            </div>
            <div class="flex flex-wrap gap-3 border-t border-[#CFCFCF] px-6 py-4">
                <button type="button" @onclick="SaveResultAsync" disabled="@_busy" class="workspace-heading rounded-lg bg-[#B83A3A] px-5 py-3 text-xs font-bold uppercase tracking-wider text-white hover:bg-[#9F3030] disabled:opacity-50">Lưu điểm ↗</button>
                <button type="button" @onclick="CloseDetailsAsync" class="workspace-heading rounded-lg border border-[#D8D1CD] bg-white px-5 py-3 text-xs font-bold uppercase tracking-wider text-[#383E43] hover:border-[#B83A3A] hover:text-[#B83A3A]">Hủy</button>
            </div>
        </WorkspaceModal>
    }

    @if (_panel is Panel.Results)
    {
        <WorkspaceModal Open="true" Eyebrow="VFMS / MODULE 06 / UC-61 · UC-62" Title="@($"Kết quả · {_selectedCompetitionName}")" OnClose="CloseDetailsAsync">
            @if (_notice is not null)
            {
                <div class="m-4 rounded-xl border border-emerald-200 bg-emerald-50 p-4 text-sm text-emerald-800" role="status">@_notice</div>
            }
            @if (_error is not null)
            {
                <div class="m-4 border-2 border-[#EF4444] bg-red-50 p-4 text-sm text-red-800" role="alert">@_error</div>
            }
            <div class="flex flex-wrap items-center justify-between gap-3 border-b border-[#D8DED2] bg-[#EEF1EA]/40 px-5 py-4 sm:px-6">
                <div>
                    <h3 class="workspace-heading text-sm font-extrabold uppercase tracking-wider">Bảng kết quả</h3>
                    @if (SelectedCompetitionStatus != "Completed")
                    {
                        <p class="mt-1 text-xs text-[#69706A]">Chỉ có thể duyệt sau khi cuộc thi kết thúc.</p>
                    }
                    else if (PendingUnrankedResultCount > 0 && PendingResultCount == 0)
                    {
                        <p class="mt-1 text-xs text-[#69706A]">@PendingUnrankedResultCount kết quả đang chờ bổ sung hạng trước khi duyệt.</p>
                    }
                    else if (PendingResultCount == 0)
                    {
                        <p class="mt-1 text-xs text-[#69706A]">Không còn kết quả có hạng cần duyệt.</p>
                    }
                    else
                    {
                        <p class="mt-1 text-xs text-[#69706A]">@PendingResultCount kết quả có hạng đang chờ duyệt.</p>
                        <p class="mt-1 max-w-2xl text-xs text-[#69706A]">Duyệt từng kết quả trong danh sách người tham gia để cấp voucher theo giải (nếu có); “Duyệt tất cả” chỉ xác nhận trạng thái các kết quả còn lại.</p>
                    }
                </div>
                <button type="button" @onclick='() => ConfirmAllAsync(_selectedCompetitionId!.Value)' disabled="@(!CanConfirmAllResults)" class="workspace-heading rounded-lg bg-[#5F6F52] px-4 py-2.5 text-[10px] font-bold uppercase tracking-wider text-white hover:bg-[#4E5D44] disabled:cursor-not-allowed disabled:opacity-50">Duyệt tất cả (@PendingResultCount)</button>
            </div>
            @if (_leaderboard.Count == 0)
            {
                <p class="px-6 py-10 text-center text-sm text-[#69706A]">
                    @(_participants.Count == 0
                        ? "Chưa có người tham gia."
                        : "Chưa có kết quả được nhập. Vào Người tham gia để nhập điểm và hạng.")
                </p>
            }
            else
            {
                <div class="overflow-x-auto">
                    <table class="workspace-table w-full min-w-[760px] table-fixed text-left text-sm">
                        <thead class="workspace-heading text-[10px] uppercase tracking-wider">
                            <tr><th class="w-[8%] px-4 py-4">Hạng</th><th class="w-[20%] px-4 py-4">Hội viên</th><th class="w-[10%] px-4 py-4">Điểm</th><th class="w-[24%] px-4 py-4">Ghi chú</th><th class="w-[15%] px-4 py-4">Trạng thái</th><th class="w-[23%] px-4 py-4">Phần thưởng</th></tr>
                        </thead>
                        <tbody class="divide-y divide-[#EEF1EA]">
                            @foreach (var row in _leaderboard)
                            {
                                <tr class="hover:bg-[#FAFAF7]">
                                    <th scope="row" class="workspace-heading px-4 py-4 text-base font-extrabold text-[#5F6F52]">@(row.Rank?.ToString() ?? "-")</th>
                                    <td class="break-words px-4 py-4 font-medium">@row.MemberName</td>
                                    <td class="workspace-heading px-4 py-4 text-xs font-bold">@(row.Score?.ToString("0.##") ?? "-")</td>
                                    <td class="whitespace-pre-line break-words px-4 py-4 text-xs text-[#545454]">@(string.IsNullOrWhiteSpace(row.Note) ? "-" : row.Note)</td>
                                    <td class="px-4 py-4"><span class="@StatusClass(row.Status)">@ParticipantStatusLabel(row.Status)</span></td>
                                    <td class="break-words px-4 py-4 text-xs">
                                        @if (!string.IsNullOrWhiteSpace(row.PrizeName))
                                        {
                                            <span class="block font-semibold">@row.PrizeName</span>
                                            @if (!string.IsNullOrWhiteSpace(row.VoucherCode))
                                            {
                                                <span class="workspace-heading mt-1 block text-[10px] font-bold text-[#B83A3A]">@row.VoucherCode</span>
                                            }
                                        }
                                        else
                                        {
                                            <span class="text-[#71717A]">-</span>
                                        }
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
