@page "/pt/yoga"
@layout StaffPTLayout
@using VFMS.Contracts.Yoga
@inject VfmsApiClient Api

<PageTitle>Lớp Yoga được phân công | Victor Fitness</PageTitle>

<div class="workspace-page space-y-8 font-['Inter',sans-serif] text-[#252525]">
    <header class="flex flex-col justify-between gap-5 border-b-2 border-black pb-7 md:flex-row md:items-end">
        <div>
            <p class="workspace-heading mb-3 text-[10px] font-bold tracking-[.18em] text-[#71717A]">VFMS / YOGA</p>
            <h1 class="workspace-heading text-3xl font-extrabold uppercase tracking-tight sm:text-4xl">Lớp được phân công<span>.</span></h1>
            <p class="mt-3 text-sm text-[#545454]">Lịch dạy, phòng tập và danh sách học viên đã đặt chỗ.</p>
        </div>
        <div class="flex items-center gap-2">
            <button type="button" class="border-2 border-black px-4 py-2 text-xs font-bold rounded-none" @onclick="() => Move(-7)" aria-label="Tuần trước">←</button>
            <span class="text-sm font-semibold">@_from.ToString("dd/MM") – @_from.AddDays(6).ToString("dd/MM/yyyy")</span>
            <button type="button" class="border-2 border-black px-4 py-2 text-xs font-bold rounded-none" @onclick="() => Move(7)" aria-label="Tuần sau">→</button>
        </div>
    </header>

    @if (_error is not null)
    {
        <p role="alert" class="border-2 border-[#EF4444] bg-red-50 px-4 py-3 text-sm text-[#B91C1C] rounded-none">@_error</p>
    }
    else if (_loading)
    {
        <p class="text-sm text-[#545454]">Đang tải…</p>
    }
    else if (_items.Count == 0)
    {
        <p class="border-2 border-black bg-white px-5 py-6 text-sm rounded-none">No matching records found.</p>
    }
    else
    {
        <div class="space-y-4">
            @foreach (var item in _items)
            {
                var s = item.Session;
                <article class="border-2 border-black bg-white rounded-none">
                    <div class="flex flex-wrap items-center justify-between gap-3 px-5 py-4">
                        <div>
                            <p class="workspace-heading text-sm font-extrabold uppercase">@s.ClassName</p>
                            <p class="text-xs text-[#545454]">@s.ScheduledDate.ToString("dddd dd/MM") · @s.StartTime.ToString("HH:mm")–@s.EndTime.ToString("HH:mm") · @s.StudioName (tầng @s.FloorNumber)</p>
                        </div>
                        <div class="flex items-center gap-2"><span class="text-xs font-semibold">@s.ConfirmedBookings/@s.MaxParticipants</span><StatusBadge Status="@s.Status" /></div>
                    </div>
                    <div class="border-t border-[#CFCFCF] px-5 py-3">
                        @if (item.Roster.Count == 0)
                        {
                            <p class="text-xs text-[#545454]">Chưa có học viên đặt chỗ.</p>
                        }
                        else
                        {
                            <ul class="grid gap-2 sm:grid-cols-2 lg:grid-cols-3">
                                @foreach (var r in item.Roster)
                                {
                                    <li class="flex items-center justify-between border border-[#CFCFCF] px-3 py-2 text-sm rounded-none">
                                        <span>@(r.MatNumber is { } mat ? $"#{mat} · " : "")@r.MemberName</span><StatusBadge Status="@r.BookingStatus" />
                                    </li>
                                }
                            </ul>
                        }
                    </div>
                </article>
            }
        </div>
    }
</div>

@code {
    private DateOnly _from;
    private bool _loading = true;
    private string? _error;
    private List<YogaAssignedSessionResponse> _items = [];

    protected override async Task OnInitializedAsync()
    {
        var today = DateOnly.FromDateTime(DateTime.UtcNow.AddHours(7));
        _from = today.AddDays(-(((int)today.DayOfWeek + 6) % 7));
        await Load();
    }

    private async Task Move(int days) { _from = _from.AddDays(days); await Load(); }

    private async Task Load()
    {
        _loading = true;
        _error = null;
        try { _items = await Api.GetAsync<List<YogaAssignedSessionResponse>>($"api/yoga/assigned?from={_from:yyyy-MM-dd}&to={_from.AddDays(6):yyyy-MM-dd}"); }
        catch (ApiException ex) { _error = ex.Message; }
        finally { _loading = false; }
    }
}
