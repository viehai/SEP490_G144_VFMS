@page "/pt/trainer-profile"
@layout StaffPTLayout
@attribute [Authorize(Roles = "PT,YogaInstructor")]
@using VFMS.Contracts.Users
@using VFMS.Contracts.Common
@using VFMS.Client.Components.Operations
@inject TrainerApiClient Api
<PageTitle>Hồ sơ của tôi | Victor Fitness</PageTitle>

<section class="workspace-page trainer-page trainer-stack">
    <PageHeader Overline="VFMS / HUẤN LUYỆN VIÊN" Title="Hồ sơ của tôi"
                Description="Cập nhật giới thiệu, ảnh đại diện và chứng chỉ; PT quản lý thêm trạng thái nhận học viên." />
    <TrainerFeedback Error="@_error" Message="@_message" />
    @if (_loading) { <p role="status">Đang tải hồ sơ…</p> }
    else if (_profile is { } detail)
    {
        <div class="trainer-split">
            <section id="pt-basic-profile" class="trainer-panel trainer-stack trainer-anchor">
                <div class="trainer-row">
                    <TrainerAvatar Trainer="detail.Profile" />
                    <div><h2>@detail.Profile.FullName</h2><p class="trainer-muted">@detail.Profile.TrainerRole · @detail.Profile.Specialty · @detail.Profile.Level · @detail.Profile.ExperienceYears năm kinh nghiệm</p>
                    <p class="trainer-muted">@(detail.Profile.AverageRating > 0 ? $"{detail.Profile.AverageRating:0.0} / 5 sao" : "Chưa có đánh giá")</p></div>
                </div>
                @* UC 4.12: accepting status belongs to Trainer Role PT only. *@
                @if (detail.Profile.TrainerRole == "PT")
                {
                <div class="trainer-row trainer-between">
                    <div>
                        <strong>@(detail.Profile.IsAcceptingNewMembers ? "Đang nhận học viên mới" : "Không nhận học viên mới")</strong>
                        @if (!detail.Profile.IsAcceptingNewMembers && detail.Profile.NotAcceptingSince is { } since)
                        {
                            <p class="trainer-muted">Từ ngày @since.ToString("dd/MM/yyyy"). Quá 60 ngày liên tục sẽ mất quyền PT khi không còn hợp đồng đang chạy.</p>
                        }
                    </div>
                    <button type="button" class="trainer-button" disabled="@_saving" @onclick="ToggleReadinessAsync">
                        @(detail.Profile.IsAcceptingNewMembers ? "Ngừng nhận học viên" : "Sẵn sàng nhận học viên")
                    </button>
                </div>
                }
                <form class="trainer-stack" @onsubmit="SaveAsync" @onsubmit:preventDefault>
                    <fieldset class="trainer-stack" disabled="@_saving">
                        <label>Giới thiệu<textarea class="trainer-input" rows="5" maxlength="4000" @bind="_bio"></textarea></label>
                        <BannedWordPreview Text="@_bio" Words="_bannedWords" />
                        <label>Đổi ảnh đại diện (JPG hoặc PNG, tối đa 5 MB)
                            <InputFile @key="_avatarVersion" class="trainer-input" accept=".jpg,.jpeg,.png" OnChange="AvatarAsync" />
                        </label>
                        @if (_avatar is { } avatar) { <p>Tệp đã chọn: @avatar.FileName</p> }
                        <button class="trainer-button trainer-primary">Lưu hồ sơ</button>
                    </fieldset>
                </form>
                <h3>Chứng chỉ đã công bố</h3>
                @if (detail.Certificates.Count == 0) { <p class="trainer-muted">Chưa có chứng chỉ công khai.</p> }
                <ul class="trainer-list">
                    @foreach (var certificate in detail.Certificates)
                    {
                        @if (Api.PublicAsset(certificate.DownloadUrl) is { } url)
                        {
                            <li><a href="@url" class="trainer-link trainer-copy" target="@(certificate.IsExternalLink ? "_blank" : null)" rel="noopener noreferrer">@(certificate.IsExternalLink ? $"Chứng chỉ tại {certificate.FileName} ↗" : certificate.FileName)</a></li>
                        }
                    }
                </ul>
            </section>

            <section id="pt-credentials" class="trainer-panel trainer-stack trainer-anchor">
                <h2>Cập nhật chuyên môn và chứng chỉ</h2>
                @if (_account is null)
                {
                    <p class="trainer-feedback trainer-error" role="alert">Không tải được thông tin tài khoản. Tải lại trang để gửi hồ sơ chứng chỉ.</p>
                }
                else if (_identity is null)
                {
                    <p class="trainer-feedback trainer-error" role="alert">Tài khoản cần có hồ sơ ứng tuyển đã tuyển để xác minh CCCD trước khi cập nhật chứng chỉ.</p>
                }
                else
                {
                    <p class="trainer-muted">Manager duyệt trước khi thay đổi được công bố.</p>
                    <div class="trainer-row">
                        <button type="button" class="trainer-button" aria-pressed="@(_editingCredentials && _replacement is null)"
                                @onclick="() => OpenCredentials(null)">Thêm chứng chỉ mới</button>
                        @foreach (var certificate in detail.Certificates.Where(item => item.Id != "legacy"))
                        {
                            <button type="button" class="trainer-button" aria-pressed="@(_editingCredentials && _replacement?.Id == certificate.Id)"
                                    @onclick="() => OpenCredentials(certificate)">Thay @certificate.FileName</button>
                        }
                    </div>
                    @if (_editingCredentials)
                    {
                        <TrainerApplicationForm @key="_credentialFormVersion" Profile="detail.Profile" Identity="_identity"
                            Published="detail.Certificates" Replacement="_replacement"
                            Email="@_account.Email" Phone="@_account.PhoneNumber" Submitted="ReloadHistoryAsync" />
                    }
                }
            </section>
        </div>

        <section id="pt-credential-history" class="trainer-panel trainer-stack trainer-anchor">
            <h2>Lịch sử yêu cầu cập nhật chứng chỉ</h2>
            <TrainerFeedback Error="@_historyError" />
            @if (_historyLoading) { <p role="status">Đang tải lịch sử…</p> }
            else if (_history is { TotalCount: 0 }) { <p>Chưa có hồ sơ cập nhật chứng chỉ.</p> }
            else if (_history is { } history)
            {
                <div class="trainer-scroll">
                    <table class="workspace-table">
                        <thead><tr><th>Mã theo dõi</th><th>Lần nộp</th><th>Trạng thái</th><th>Ghi chú xét duyệt</th></tr></thead>
                        <tbody>
                            @foreach (var item in history.Items)
                            {
                                <tr><td class="trainer-copy">@item.TrackingCode</td><td>@item.SubmissionAttempt</td><td><TrainerStatus Status="@item.Status" /></td><td class="trainer-copy">@item.ReviewNote</td></tr>
                            }
                        </tbody>
                    </table>
                </div>
                <Pager Page="history.Page" PageSize="history.PageSize" TotalCount="history.TotalCount" Noun="hồ sơ" OnPage="HistoryAsync" />
            }
        </section>
    }
</section>
@code {
    private TrainerPublicDetail? _profile;
    private UserProfileResponse? _account;
    private TrainerApplicationResponse? _identity;
    private PagedResponse<TrainerApplicationResponse>? _history;
    private TrainerFileInput? _avatar;
    private TrainerDocumentResponse? _replacement;
    private bool _editingCredentials;
    private int _credentialFormVersion;
    private string _bio = "";
    private IReadOnlyList<string> _bannedWords = [];
    private int _avatarVersion;
    private bool _loading = true, _saving, _historyLoading;
    private string? _error, _message, _historyError;

    protected override async Task OnInitializedAsync()
    {
        try
        {
            await LoadProfileAsync();
            _account = await Api.AccountAsync();
            var recruitment = await Api.ApplicationsAsync(new(Status: "Hired", ApplicationType: "Recruitment"), mine: true);
            _identity = recruitment.Items.FirstOrDefault(item => item.HiredUserId == _account.UserId);
        }
        catch (AuthApiException ex) { _error = ex.Message; }
        finally { _loading = false; }
        if (_profile is not null)
            await HistoryAsync(1);
    }

    private async Task LoadProfileAsync()
    {
        _profile = await Api.MineAsync();
        _bio = _profile.Profile.Bio ?? "";
    }

    private Task ReloadHistoryAsync() => HistoryAsync(1);

    private void OpenCredentials(TrainerDocumentResponse? replacement)
    {
        _replacement = replacement;
        _editingCredentials = true;
        _credentialFormVersion++;
    }

    private async Task HistoryAsync(int page)
    {
        if (_historyLoading) return;
        _historyLoading = true;
        _historyError = null;
        try { _history = await Api.ApplicationsAsync(new(Page: page, ApplicationType: "ProfileUpdate"), mine: true); }
        catch (AuthApiException ex) { _historyError = ex.Message; }
        finally { _historyLoading = false; }
    }

    private async Task AvatarAsync(InputFileChangeEventArgs args)
    {
        _saving = true;
        _error = _message = null;
        _avatar = null;
        try
        {
            await using var stream = args.File.OpenReadStream(5 * 1024 * 1024);
            using var buffer = new MemoryStream();
            await stream.CopyToAsync(buffer);
            var avatar = new TrainerFileInput(args.File.Name, buffer.ToArray());
            if (TrainerFileRules.ContentType(avatar, avatar: true) is null)
                _error = "Chọn ảnh JPG hoặc PNG hợp lệ.";
            else
                _avatar = avatar;
        }
        catch (Exception ex) when (ex is IOException or JSException)
        {
            _error = "Không đọc được ảnh. Dung lượng tối đa là 5 MB.";
        }
        finally
        {
            _avatarVersion++;
            _saving = false;
        }
    }

    private async Task SaveAsync()
    {
        if (_saving || _profile is not { } profile) return;
        _error = _message = null;
        var bio = _bio.Trim();
        var request = new UpdateTrainerProfileRequest(bio == (profile.Profile.Bio ?? "") ? null : bio, _avatar);
        if (!new TrainerProfileValidator().Validate(request).IsValid)
        {
            _error = "Nhập giới thiệu hợp lệ hoặc chọn ảnh đại diện mới.";
            return;
        }
        _saving = true;
        _bannedWords = [];
        try
        {
            await Api.UpdateAsync(request);
            _avatar = null;
            _message = "Đã lưu hồ sơ PT.";
            await LoadProfileAsync();
        }
        catch (AuthApiException ex)
        {
            _bannedWords = TrainerContentRules.ProhibitedWords(ex.ErrorCode, ex.Message);
            _error = _bannedWords.Count > 0 ? "Giới thiệu có từ ngữ không được phép. Sửa các từ được tô đỏ rồi lưu lại." : ex.Message;
        }
        finally { _saving = false; }
    }

    private async Task ToggleReadinessAsync()
    {
        if (_saving || _profile is not { } detail) return;
        _saving = true;
        _error = _message = null;
        try
        {
            var status = await Api.SetReadinessAsync(!detail.Profile.IsAcceptingNewMembers);
            await LoadProfileAsync();
            _message = status.IsAcceptingNewMembers ? "Đã chuyển sang nhận học viên mới."
                : status.ContractsNotified > 0
                    ? $"Đã ngừng nhận học viên mới. {status.ContractsNotified} hội viên chưa bắt đầu tập được mời đổi huấn luyện viên trong 1 tuần."
                    : "Đã ngừng nhận học viên mới.";
        }
        catch (AuthApiException ex) { _error = ex.Message; }
        finally { _saving = false; }
    }
}
