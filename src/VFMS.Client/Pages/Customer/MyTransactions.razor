@page "/my-transactions"
@layout PublicLayout
@using Microsoft.AspNetCore.Authorization
@using System.Net
@using VFMS.Client.Components.Memberships
@using VFMS.Client.Components.Operations
@using VFMS.Contracts.Common
@using VFMS.Contracts.Memberships
@attribute [Authorize(Roles = "Customer,Member")]
@inject MembershipPlanApiClient Plans
@implements IDisposable

<PageTitle>Lịch sử giao dịch | Victor Fitness</PageTitle>

<section class="mx-auto min-w-0 max-w-5xl space-y-6 px-[20px] pb-16 pt-28 font-body" aria-labelledby="transactions-title" aria-busy="@_loading.ToString().ToLowerInvariant()">
    <header class="space-y-2 border-b border-vfms-border pb-5">
        <h1 id="transactions-title" class="font-heading text-3xl font-extrabold text-vfms-text">Lịch sử giao dịch</h1>
        <p class="text-sm text-vfms-text-secondary">Giao dịch mới nhất hiển thị trước, tối đa @PageSize giao dịch mỗi trang.</p>
    </header>

    @if (_loading)
    {
        <p role="status" class="py-8 text-sm text-vfms-text-secondary">Đang tải lịch sử giao dịch...</p>
    }
    else if (_loadError is not null)
    {
        <div class="space-y-3 rounded-xl border border-red-200 bg-red-50 p-[20px]">
            <p role="alert" class="text-sm text-red-800">@_loadError</p>
            @if (_sessionExpired)
            {
                <a href="/auth/login?returnUrl=%2Fmy-transactions" class="@ActionClass">Đăng nhập lại</a>
            }
            else
            {
                <button type="button" class="@ActionClass" @onclick="() => LoadAsync(_page)">Thử lại</button>
            }
        </div>
    }
    else if (_history is null || _history.TotalCount == 0)
    {
        <div class="space-y-3 rounded-xl border border-vfms-border bg-vfms-surface p-8 text-center">
            <p role="status" class="text-sm text-vfms-text-secondary">Không tìm thấy dữ liệu phù hợp. (MSG-01)</p>
            <a href="/#pricing-memberships" class="@ActionClass">Khám phá gói hội viên</a>
        </div>
    }
    else
    {
        <div class="min-w-0 overflow-hidden rounded-xl border border-vfms-border bg-vfms-surface">
            @if (_history.TotalCount > PageSize)
            {
                <Pager Page="@_history.Page" PageSize="@_history.PageSize" TotalCount="@_history.TotalCount" Noun="giao dịch" AriaLabel="Phân trang lịch sử giao dịch" OnPage="LoadAsync" />
            }
            <ul class="m-0 list-none divide-y divide-vfms-border p-0" aria-label="Các giao dịch gói hội viên">
                @foreach (var transaction in _history.Items)
                {
                    <li @key="transaction.OrderId" class="min-w-0 space-y-4 p-[20px] sm:p-6">
                        <div class="flex min-w-0 flex-wrap items-start justify-between gap-3">
                            <div class="min-w-0 flex-1 basis-48">
                                <h2 class="break-all font-heading text-base font-bold text-vfms-text">@transaction.OrderNumber</h2>
                                <p class="mt-1 text-xs text-vfms-text-secondary"><time datetime="@transaction.CreatedAt.ToString("O")">@TransactionDisplay.Date(transaction.CreatedAt)</time> (UTC+7)</p>
                            </div>
                            <div class="flex flex-wrap items-center gap-2 text-xs text-vfms-text-secondary"><span>Đơn hàng</span><TransactionStatusBadge Status="@transaction.OrderStatus" /></div>
                        </div>
                        <p class="break-words text-sm font-semibold text-vfms-text">@(transaction.IsRenewal ? "Gia hạn gói hội viên" : "Mua gói hội viên") · @transaction.PurchaseSummary@(transaction.ItemCount > 1 ? $" (+{transaction.ItemCount - 1} gói khác)" : "")</p>
                        <dl class="grid min-w-0 gap-4 text-sm sm:grid-cols-2 lg:grid-cols-4">
                            <div class="min-w-0">
                                <dt class="text-xs text-vfms-text-secondary">Tổng thanh toán</dt>
                                <dd class="m-0 mt-1 break-words font-bold tabular-nums text-vfms-text">@TransactionDisplay.Money(transaction.AmountDue)</dd>
                            </div>
                            <div class="min-w-0">
                                <dt class="text-xs text-vfms-text-secondary">Phương thức</dt>
                                <dd class="m-0 mt-1 break-words text-vfms-text">@TransactionDisplay.Method(transaction.PaymentMethod)</dd>
                            </div>
                            <div class="min-w-0">
                                <dt class="text-xs text-vfms-text-secondary">Thanh toán</dt>
                                <dd class="m-0 mt-1"><TransactionStatusBadge Status="@transaction.PaymentStatus" /></dd>
                            </div>
                            <div class="min-w-0">
                                <dt class="text-xs text-vfms-text-secondary">Số hóa đơn</dt>
                                <dd class="m-0 mt-1 break-all text-vfms-text">@(transaction.InvoiceNumber ?? "Chưa có hóa đơn")</dd>
                            </div>
                        </dl>
                        <a href="/my-transactions/@transaction.OrderId" class="@ActionClass" aria-label="@($"Xem chi tiết giao dịch {transaction.OrderNumber}")">Xem chi tiết</a>
                    </li>
                }
            </ul>
            <Pager Page="@_history.Page" PageSize="@_history.PageSize" TotalCount="@_history.TotalCount" Noun="giao dịch" AriaLabel="Phân trang lịch sử giao dịch" OnPage="LoadAsync" />
        </div>
    }
</section>

@code {
    private const int PageSize = 10;
    private const string ActionClass = "inline-flex min-h-[44px] items-center rounded-lg border border-vfms-primary px-4 py-2 text-sm font-semibold text-vfms-primary hover:bg-vfms-primary-soft focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-vfms-primary";
    private readonly CancellationTokenSource _lifetime = new();
    private PagedResponse<MembershipTransactionSummaryResponse>? _history;
    private bool _loading;
    private bool _sessionExpired;
    private string? _loadError;
    private int _page = 1;

    protected override Task OnInitializedAsync() => LoadAsync(1);

    private async Task LoadAsync(int page)
    {
        if (_loading)
            return;
        var ct = _lifetime.Token;
        _loading = true;
        _loadError = null;
        _sessionExpired = false;
        _page = page;
        try
        {
            var history = await Plans.ListTransactionsAsync(page, PageSize, ct);
            if (!ct.IsCancellationRequested)
                _history = history;
        }
        catch (AuthApiException ex)
        {
            _sessionExpired = ex.StatusCode == HttpStatusCode.Unauthorized;
            _loadError = _sessionExpired ? "Phiên đăng nhập đã hết hạn. Vui lòng đăng nhập lại. (MSG-11)" : ex.Message;
        }
        catch (OperationCanceledException) when (ct.IsCancellationRequested) { }
        finally
        {
            _loading = false;
        }
    }

    public void Dispose()
    {
        _lifetime.Cancel();
        _lifetime.Dispose();
    }
}
