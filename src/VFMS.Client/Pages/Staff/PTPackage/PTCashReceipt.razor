@page "/staff/pt-cash-receipt"
@layout StaffPTLayout
@using Microsoft.AspNetCore.Authorization
@attribute [Authorize(Roles = "Staff")]
@using VFMS.Contracts.PersonalTraining
@using VFMS.Client.Components.Operations
@using VFMS.Client.Components.Trainers
@using static VFMS.Client.Services.PTDisplay
@inject PersonalTrainingApiClient Api

<PageTitle>Xác nhận tiền mặt gói PT | Victor Fitness</PageTitle>
<section class="workspace-page trainer-page trainer-stack">
    <PageHeader Overline="VFMS / GÓI PT" Title="Xác nhận tiền mặt gói PT"
                Description="Hội viên đã chọn thanh toán tại quầy. Nhập mã đơn hội viên đọc và số tiền thực nhận; lịch tập được xác nhận ngay." />
    <TrainerFeedback Error="@_error" />
    <EditForm Model="this" class="trainer-panel trainer-stack" style="max-width: 28rem" OnValidSubmit="ConfirmAsync">
        <fieldset class="trainer-stack" disabled="@_busy">
            <label>Mã đơn<input class="trainer-input" @bind="_orderNumber" required maxlength="50" placeholder="VD: ORD-20261117-..." /></label>
            <div>
                <label for="pt-cash-amount">Số tiền đã nhận (₫)
                    <InputVnd id="pt-cash-amount" class="trainer-input" WholeUnits="true" required @bind-Value="_amount"
                              ParsingErrorMessage="Nhập số tiền nguyên theo VND." aria-describedby="pt-cash-amount-error" />
                </label>
                <div id="pt-cash-amount-error"><ValidationMessage For="@(() => _amount)" /></div>
            </div>
            <button type="submit" class="trainer-button trainer-primary">@(_busy ? "Đang xác nhận…" : "Xác nhận đã nhận tiền")</button>
        </fieldset>
    </EditForm>
    @if (_confirmed is { } order)
    {
        <div class="trainer-panel trainer-stack" role="status">
            <div class="trainer-row trainer-between"><h2>Đơn @order.OrderNumber</h2><TrainerStatus Status="@order.Status" /></div>
            <p>Đã nhận @Money(order.AmountDue) · Hóa đơn <strong>@order.InvoiceNumber</strong>. Lịch tập của hội viên đã được xác nhận.</p>
        </div>
    }
</section>

@code {
    private string _orderNumber = "";
    private decimal? _amount;
    private bool _busy;
    private string? _error;
    private PTCheckoutResponse? _confirmed;

    private async Task ConfirmAsync()
    {
        if (_busy || string.IsNullOrWhiteSpace(_orderNumber)) return;
        if (_amount is not >= 1)
        {
            _error = "Số tiền đã nhận phải từ 1 ₫.";
            return;
        }
        _busy = true;
        _error = null;
        _confirmed = null;
        try
        {
            _confirmed = await Api.ConfirmCashAsync(_orderNumber.Trim().ToUpperInvariant(), new(_amount.Value), default);
            _orderNumber = "";
            _amount = null;
        }
        catch (AuthApiException ex) { _error = ex.Message; }
        finally { _busy = false; }
    }
}
