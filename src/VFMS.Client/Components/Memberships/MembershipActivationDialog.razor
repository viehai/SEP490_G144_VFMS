@using VFMS.Contracts.Memberships
@inject MembershipPlanApiClient Plans
@implements IDisposable

<div class="activation-dialog">
    <WorkspaceModal Open="true" Title="@(_saved is null ? "Chọn ngày kích hoạt" : MembershipDisplay.Status(_saved.Membership.Status))" OnClose="CloseAsync">
        @if (_saved is { } saved && saved.Membership.StartDate is { } scheduled)
        {
            <p role="status" tabindex="-1" @ref="_notice" class="m-0 rounded-lg bg-green-50 p-3 text-sm font-semibold text-green-900">
                Gói @Membership.PlanName @(saved.Membership.Status == MembershipStatuses.Active ? "đã có hiệu lực từ" : "sẽ có hiệu lực từ") ngày <MembershipDate Date="@scheduled" />.
            </p>
            <div class="activation-actions">
                <button type="button" class="activation-primary" @onclick="CloseAsync">Đóng</button>
            </div>
        }
        else if (Membership.Activation is { } window)
        {
            <form @onsubmit="SaveAsync" @onsubmit:preventDefault>
                <fieldset disabled="@_saving" aria-label="Chọn ngày kích hoạt gói @Membership.PlanName">
                    <p class="m-0 font-semibold text-vfms-text">@Membership.PlanName</p>
                    <p class="mt-1 mb-4 text-sm text-vfms-text-secondary">Ngày mua <MembershipDate Date="@window.PurchasedOn" /></p>
                    <label for="membership-activation-date" class="text-sm font-semibold text-vfms-text">
                        Ngày kích hoạt <span class="text-red-700" aria-hidden="true">*</span>
                    </label>
                    <input id="membership-activation-date" type="date" @ref="_dateInput" @bind="_startDate" required
                           aria-describedby="@(_error is null ? "activation-window" : "activation-window activation-error")"
                           min="@MembershipDisplay.DateInput(window.EarliestDate)" max="@MembershipDisplay.DateInput(window.Deadline)" />
                    <p id="activation-window" class="mt-1 mb-0 text-sm text-vfms-text-secondary">
                        Chọn từ <MembershipDate Date="@window.EarliestDate" /> đến <MembershipDate Date="@window.Deadline" />.
                    </p>
                    @if (_error is not null)
                    {
                        <p id="activation-error" role="alert" class="mt-2 mb-0 rounded-lg bg-red-50 p-3 text-sm text-red-800">@_error</p>
                    }
                    <div class="activation-actions">
                        <button type="button" @onclick="CloseAsync">Hủy</button>
                        <button type="submit" class="activation-primary">@(_saving ? "Đang lưu..." : "Xác nhận kích hoạt")</button>
                    </div>
                </fieldset>
            </form>
        }
    </WorkspaceModal>
</div>

@code {
    [Parameter, EditorRequired] public MembershipSummaryResponse Membership { get; set; } = default!;
    [Parameter] public EventCallback<MembershipDetailResponse> Saved { get; set; }
    [Parameter] public EventCallback Closed { get; set; }

    private readonly CancellationTokenSource _lifetime = new();
    private DateOnly? _startDate;
    private MembershipDetailResponse? _saved;
    private bool _saving;
    private bool _focusNotice;
    private string? _error;
    private ElementReference _dateInput;
    private ElementReference _notice;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender && Membership.Activation is not null)
            await _dateInput.FocusAsync();
        if (_focusNotice)
        {
            _focusNotice = false;
            await _notice.FocusAsync();
        }
    }

    private async Task SaveAsync()
    {
        if (_saving || _saved is not null || Membership.Activation is not { } window) return;
        if (_startDate is not { } date || date < window.EarliestDate || date > window.Deadline)
        {
            _error = "Chọn ngày kích hoạt trong khoảng cho phép.";
            return;
        }

        _saving = true;
        _error = null;
        var ct = _lifetime.Token;
        try
        {
            _saved = await Plans.ScheduleMembershipActivationAsync(Membership.MembershipId, date, ct);
            if (!ct.IsCancellationRequested)
            {
                _focusNotice = true;
                await Saved.InvokeAsync(_saved);
            }
        }
        catch (AuthApiException error) when (!ct.IsCancellationRequested) { _error = error.Message; }
        catch (OperationCanceledException) when (ct.IsCancellationRequested) { }
        finally { _saving = false; }
    }

    private Task CloseAsync() => _saving ? Task.CompletedTask : Closed.InvokeAsync();

    public void Dispose()
    {
        _lifetime.Cancel();
        _lifetime.Dispose();
    }
}
