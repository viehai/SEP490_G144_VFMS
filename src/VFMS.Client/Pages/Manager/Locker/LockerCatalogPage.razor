@page "/manager/lockers"
@layout ManagerAdminLayout
@using Microsoft.AspNetCore.Authorization
@using VFMS.Client.Components.Operations
@using VFMS.Client.Components.Lockers
@using VFMS.Contracts.Lockers
@attribute [Authorize(Roles = "Manager")]
@inject LockerApiClient Api
@inject ToastService Toasts
@implements IDisposable

<PageTitle>Khu và tủ | Victor Fitness</PageTitle>
<section class="workspace-page locker-page space-y-6" aria-labelledby="locker-catalog-title" aria-busy="@_loading.ToString().ToLowerInvariant()">
    <PageHeader Overline="VFMS / QUẢN LÝ TỦ" Title="Khu và tủ" Description="Thêm khu tự động, quản lý tủ theo khu và nội quy tủ.">
        <div class="flex flex-wrap gap-2">
            <a href="/manager/locker-pricing" class="@Ui.PrimaryButton">Bảng giá thuê tủ</a>
            <a href="/manager/locker-clearances" class="@Ui.Button">Xác nhận dọn tủ</a>
        </div>
    </PageHeader>
    <Alerts Error="@_error" />
    @if (_loading)
    {
        <p role="status">Đang tải…</p>
    }
    else if (_catalog is { } catalog)
    {
        <div class="locker-layout">
            <div class="space-y-6">
                <form class="@Ui.Card space-y-3" @onsubmit="() => _confirmAddZone = true" @onsubmit:preventDefault>
                    <h2 class="text-lg font-bold">Thêm khu</h2>
                    <p class="text-sm text-vfms-text-secondary">Hệ thống tự đặt tên Khu A, B, C… Sau Z là AA, AB…</p>
                    <button type="submit" class="@Ui.PrimaryButton" disabled="@_busy">Thêm khu tự động</button>
                </form>
                <form class="@Ui.Card space-y-3" @onsubmit="AddLockerAsync" @onsubmit:preventDefault>
                    <h2 class="text-lg font-bold">Thêm tủ</h2>
                    <div class="locker-form-fields">
                        <label class="@Ui.Label">Khu thêm tủ
                            <select class="@Ui.Field" @bind="_lockerZone" @bind:after="ZoneChanged" disabled="@_busy">
                                <option value="0">Chọn khu</option>
                                @foreach (var zone in catalog.Zones) { <option value="@zone.Id">Khu @zone.Name</option> }
                            </select>
                        </label>
                        <label class="@Ui.Label">Số tủ<input class="@Ui.Field" placeholder="Ví dụ A01" maxlength="20" @bind="_lockerNumber" disabled="@_busy" /></label>
                    </div>
                    @if (_numberError is not null) { <p role="alert" class="text-sm text-red-700">@_numberError</p> }
                    <button type="submit" class="@Ui.PrimaryButton" disabled="@(_busy || _lockerZone == 0 || string.IsNullOrWhiteSpace(_lockerNumber))">Thêm tủ</button>
                </form>
                <div class="@Ui.Card space-y-4">
                    <div class="flex flex-wrap items-center justify-between gap-3">
                        <h2 class="text-lg font-bold">Sơ đồ @(SelectedZone is { } diagramZone ? $"Khu {diagramZone.Name}" : "tủ")</h2>
                        @if (SelectedZone is { CanDelete: true } emptyZone)
                        {
                            <button type="button" class="@Ui.DangerButton" disabled="@_busy" @onclick="() => _deleteZone = emptyZone">Xóa khu</button>
                        }
                    </div>
                    @if (SelectedZone is { } selectedZone)
                    {
                        <LockerGrid Slots="selectedZone.Lockers" SelectedId="_selected?.Id" OnSelect="s => _selected = s" />
                    }
                    else
                    {
                        <p class="text-sm text-vfms-text-secondary">Thêm khu hoặc chọn khu ở form Thêm tủ để xem sơ đồ.</p>
                    }
                    @if (_selected is { } slot)
                    {
                        <div class="flex flex-wrap items-center justify-between gap-3 text-sm">
                            <span>Tủ <strong>@slot.Number</strong> · @LockerText.Slot(slot.Status)</span>
                            <button type="button" class="@Ui.DangerButton" disabled="@(_busy || slot.Status is not ("Available" or "Maintenance"))" @onclick="() => DeactivateAsync(slot)">Ngừng dùng tủ</button>
                        </div>
                    }
                </div>
            </div>
            <LockerRulesPanel Text="@_rules" KeyDeposit="@(catalog.Prices.FirstOrDefault()?.Deposit ?? 100_000)">
                <details>
                    <summary class="text-sm font-semibold">Chỉnh sửa nội quy</summary>
                    <form class="mt-3 space-y-3" @onsubmit="SaveRulesAsync" @onsubmit:preventDefault>
                        <label class="@Ui.Label">Nội dung nội quy<textarea class="@Ui.Field" rows="7" maxlength="4000" @bind="_rules" disabled="@_busy"></textarea></label>
                        <p class="text-xs text-vfms-text-secondary">Phí cọc chìa tự lấy từ bảng giá.</p>
                        <button type="submit" class="@Ui.PrimaryButton" disabled="@_busy">Lưu nội quy</button>
                    </form>
                </details>
            </LockerRulesPanel>
        </div>
    }
    @if (_confirmAddZone)
    {
        <WorkspaceModal Open="true" Title="Xác nhận thêm khu" Eyebrow="VFMS / KHU VÀ TỦ" OnClose="() => _confirmAddZone = false">
            <div class="space-y-4 p-6">
                <Alerts Error="@_error" />
                <p>Thêm khu mới? Hệ thống sẽ tự đặt tên khu tiếp theo.</p>
                <div class="flex gap-3">
                    <button type="button" class="@Ui.Button" disabled="@_busy" @onclick="() => _confirmAddZone = false">Hủy</button>
                    <button type="button" class="@Ui.PrimaryButton" disabled="@_busy" @onclick="AddZoneAsync">Xác nhận thêm khu</button>
                </div>
            </div>
        </WorkspaceModal>
    }
    @if (_deleteZone is { } deleting)
    {
        <WorkspaceModal Open="true" Title="Xác nhận xóa khu" Eyebrow="VFMS / KHU VÀ TỦ" OnClose="() => _deleteZone = null">
            <div class="space-y-4 p-6">
                <Alerts Error="@_error" />
                <p>Xóa Khu @deleting.Name? Khu này chưa có tủ.</p>
                <div class="flex gap-3">
                    <button type="button" class="@Ui.Button" disabled="@_busy" @onclick="() => _deleteZone = null">Hủy</button>
                    <button type="button" class="@Ui.DangerButton" disabled="@_busy" @onclick="() => DeleteZoneAsync(deleting)">Xác nhận xóa</button>
                </div>
            </div>
        </WorkspaceModal>
    }
</section>

@code {
    private readonly CancellationTokenSource _lifetime = new();
    private LockerCatalog? _catalog;
    private LockerCatalogZone? _deleteZone;
    private LockerSlot? _selected;
    private string _lockerNumber = "", _rules = LockerRuleDefaults.Text;
    private int _lockerZone;
    private string? _error, _numberError;
    private bool _loading = true, _busy, _confirmAddZone;
    private LockerCatalogZone? SelectedZone => _catalog?.Zones.FirstOrDefault(z => z.Id == _lockerZone);

    protected override async Task OnInitializedAsync()
    {
        await LoadAsync(true);
        _loading = false;
    }

    private async Task LoadAsync(bool fillRules = false)
    {
        try
        {
            _catalog = await Api.CatalogAsync(_lifetime.Token);
            if (!_catalog.Zones.Any(z => z.Id == _lockerZone))
                _lockerZone = _catalog.Zones.FirstOrDefault()?.Id ?? 0;
            _selected = SelectedZone?.Lockers.FirstOrDefault(s => s.Id == _selected?.Id);
            if (fillRules) _rules = _catalog.Rules;
        }
        catch (ApiException ex) { _error = ex.Message; Toasts.ShowError(ex.Message); }
        catch (OperationCanceledException) when (_lifetime.IsCancellationRequested) { }
    }

    private void ZoneChanged() { _selected = null; _numberError = null; }

    private async Task RunAsync(Func<Task> work)
    {
        if (_busy) return;
        _busy = true;
        _error = _numberError = null;
        try { await work(); }
        catch (ApiException ex) when (ex.ErrorCode == "LOCKER_NUMBER_DUPLICATE") { _numberError = ex.Message; Toasts.ShowError(ex.Message); }
        catch (ApiException ex) { _error = ex.Message; Toasts.ShowError(ex.Message); }
        catch (OperationCanceledException) when (_lifetime.IsCancellationRequested) { }
        finally { _busy = false; }
    }

    private Task AddZoneAsync() => RunAsync(async () =>
    {
        var zone = await Api.AddZoneAsync(new(), _lifetime.Token);
        _confirmAddZone = false;
        _lockerZone = zone.Id;
        _selected = null;
        await LoadAsync();
        Toasts.Show($"Đã tạo Khu {zone.Name} thành công.");
    });

    private Task DeleteZoneAsync(LockerCatalogZone zone) => RunAsync(async () =>
    {
        await Api.DeleteZoneAsync(zone.Id, _lifetime.Token);
        _deleteZone = null;
        _selected = null;
        await LoadAsync();
        Toasts.Show($"Đã xóa Khu {zone.Name} thành công.");
    });

    private Task AddLockerAsync() => RunAsync(async () =>
    {
        await Api.AddLockerAsync(new(_lockerZone, _lockerNumber.Trim()), _lifetime.Token);
        _lockerNumber = "";
        await LoadAsync();
        Toasts.Show("Đã tạo tủ thành công.");
    });

    private Task DeactivateAsync(LockerSlot slot) => RunAsync(async () =>
    {
        await Api.DeactivateLockerAsync(slot.Id, _lifetime.Token);
        _selected = null;
        await LoadAsync();
        Toasts.Show($"Đã cập nhật tủ {slot.Number} thành công.");
    });

    private Task SaveRulesAsync() => RunAsync(async () =>
    {
        _rules = (await Api.SaveRulesAsync(new(_rules), _lifetime.Token)).Text;
        Toasts.Show("Đã cập nhật nội quy tủ thành công.");
    });

    public void Dispose() { _lifetime.Cancel(); _lifetime.Dispose(); }
}
