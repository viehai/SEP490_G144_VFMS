@using VFMS.Contracts.Common
@using VFMS.Contracts.Memberships
@inject MembershipPlanApiClient Plans
@inject NavigationManager Navigation
@inject MembershipCart Cart
@implements IDisposable

@if (Cart.Count > 0)
{
    <p class="mb-4 text-right" role="status"><a href="/membership-cart" class="inline-flex min-h-[44px] items-center rounded-lg border border-vfms-primary px-4 text-sm font-bold text-vfms-primary hover:bg-vfms-primary-soft">Xem giỏ hàng (@Cart.Count gói)</a></p>
}

@if (_loading)
{
    <p role="status" class="font-body text-sm">Đang tải các gói tập...</p>
}
else if (_error is not null)
{
    <div role="alert" class="rounded-xl border border-red-200 bg-red-50 p-5 font-body text-sm text-red-900">
        <p>@_error</p>
        <button type="button" class="mt-3 font-semibold text-red-800 underline hover:text-red-950" @onclick="() => LoadAsync(_requestedPage)">Thử lại</button>
    </div>
}
else if (_page is { Items.Count: > 0 } catalog)
{
    <div class="grid grid-cols-1 gap-6 md:grid-cols-3">
        @foreach (var plan in catalog.Items)
        {
            var text = PlanDescription.Parse(plan.Description);
            var saving = Saving(catalog.Items, plan);
            <article @key="plan.Id" class="flex flex-col justify-between bg-[#F8F5F2] border border-[#D8D1CD] p-8 rounded-xl hover:border-[#B83A3A] transition-colors">
                <div>
                    <header class="pb-6 border-b border-[#D8D1CD]">
                        <span class="font-heading text-xs font-bold uppercase tracking-widest text-[#6F6966] block mb-1">
                            @(IsYoga(plan.ServiceType) ? "GÓI YOGA" : "GÓI TẬP GYM")@if (IsYoga(plan.ServiceType) && plan.YogaDifficultyLevel is { } level)
                            {
                                <span> · @VFMS.Contracts.Yoga.Validators.YogaRules.LevelLabel(level).ToUpperInvariant()</span>
                            }@if (saving > 0)
                            {
                                <span class="text-[#B83A3A]"> · TIẾT KIỆM @saving%</span>
                            }
                        </span>
                        <h3 class="font-heading text-2xl font-black uppercase text-[#242424]"><a href="@PackageCatalogLinks.Detail(plan.ServiceType, plan.Id)" class="hover:text-[#B83A3A] hover:underline">@plan.Name</a></h3>
                        @if (text.Tagline is not null)
                        {
                            <p class="font-body text-xs text-[#6F6966] mt-1">@text.Tagline</p>
                        }
                    </header>
                    <div class="py-6 border-b border-[#ECE8E4]">
                        <p class="font-heading text-3xl sm:text-4xl font-black text-[#242424]">
                            @Vnd.FormatAmount(plan.Price) <span class="text-lg font-bold text-[#B83A3A]">₫</span>
                        </p>
                        <span class="font-body text-xs text-[#6F6966]">@Duration(plan)</span>
                        @if (plan is { DurationUnit: MembershipDurationUnit.Month, DurationValue: > 1 })
                        {
                            <p class="mt-1 font-body text-xs text-[#6F6966]">Tương đương @Vnd.Format(Math.Round(plan.Price / plan.DurationValue.Value, 0)) / tháng</p>
                        }
                    </div>
                    @if (text.Features.Count > 0)
                    {
                        <ul class="py-6 space-y-3.5 font-body text-xs text-[#242424]">
                            @foreach (var feature in text.Features)
                            {
                                <li class="flex items-start gap-2.5">
                                    <span aria-hidden="true" class="w-4 h-4 bg-[#F3E4E2] rounded-full flex items-center justify-center flex-shrink-0 mt-0.5">
                                        <span class="text-[#B83A3A] text-[9px] font-bold">✓</span>
                                    </span>
                                    <span>@feature</span>
                                </li>
                            }
                        </ul>
                    }
                    @if (!string.IsNullOrWhiteSpace(plan.TargetAudience))
                    {
                        <p class="mt-4 break-words font-body text-sm text-vfms-text-secondary"><strong>Phù hợp với ai</strong><br />@plan.TargetAudience</p>
                    }
                </div>
                <div class="mt-6 space-y-3">
                    @if (plan.IsSingleService)
                    {
                        <a href="@PackageCatalogLinks.Detail(plan.ServiceType, plan.Id)" aria-label="Xem chi tiết gói @plan.Name"
                           class="flex min-h-[44px] items-center justify-center rounded-lg border border-vfms-border-strong px-4 py-2 text-center text-sm font-bold text-vfms-text hover:bg-vfms-surface-alt focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-vfms-primary">
                            Xem chi tiết
                        </a>
                    }
                    <AuthorizeView Roles="Customer,Member" Context="buyer">
                        <Authorized>
                            <button type="button" disabled="@(Cart.Count >= MembershipCart.MaximumItems)" aria-label="Thêm @plan.Name vào giỏ"
                                    class="w-full bg-[#B83A3A] hover:bg-[#9F3030] py-4 font-heading text-xs uppercase tracking-wider font-bold text-white rounded-lg transition-colors disabled:opacity-50"
                                    @onclick="() => Cart.Add(plan.Id, plan.Name, plan.Price)">Thêm vào giỏ</button>
                        </Authorized>
                        <NotAuthorized>
                            @if (buyer.User.Identity?.IsAuthenticated == true)
                            {
                                <p class="font-body text-xs text-[#6F6966]">Chỉ tài khoản khách hàng hoặc hội viên mua được gói tập.</p>
                            }
                            else
                            {
                                <a href="/auth/register" class="block w-full bg-[#B83A3A] hover:bg-[#9F3030] py-4 text-center font-heading text-xs uppercase tracking-wider font-bold text-white rounded-lg transition-colors">Tạo tài khoản</a>
                                <p class="mt-3 text-center font-body text-xs text-[#6F6966]">Đã có tài khoản? <a href="@LoginUrl" class="font-bold text-[#B83A3A] underline">Đăng nhập để mua</a></p>
                            }
                        </NotAuthorized>
                    </AuthorizeView>
                </div>
            </article>
        }
    </div>
    @if (catalog.TotalCount > catalog.PageSize)
    {
        <nav aria-label="Phân trang gói tập" class="mt-8 flex items-center gap-4 font-body text-sm">
            <button type="button" class="border border-[#D8D1CD] px-3.5 py-2 rounded-lg hover:border-[#B83A3A] disabled:opacity-50" disabled="@(catalog.Page == 1)"
                    @onclick="() => LoadAsync(catalog.Page - 1)">Trước</button>
            <span class="text-[#6F6966]">Trang @catalog.Page</span>
            <button type="button" class="border border-[#D8D1CD] px-3.5 py-2 rounded-lg hover:border-[#B83A3A] disabled:opacity-50"
                    disabled="@(catalog.Page * catalog.PageSize >= catalog.TotalCount)"
                    @onclick="() => LoadAsync(catalog.Page + 1)">Sau</button>
        </nav>
    }
}
else
{
    <p role="status" class="font-body text-sm text-[#6F6966]">@(IsYoga(ServiceType) ? "Hiện chưa có gói Yoga mở bán." : "Hiện chưa có gói tập Gym mở bán.")</p>
}

@code {
    /// <summary>GYM or YOGA: which plans this catalog sells. Null lists every plan.</summary>
    [Parameter] public string? ServiceType { get; set; }

    // Back to the price list after signing in.
    private string LoginUrl => $"/auth/login?returnUrl={Uri.EscapeDataString("/" + Navigation.ToBaseRelativePath(Navigation.Uri).Split('#')[0])}";

    private static int Saving(IEnumerable<MembershipPlanCatalogItemResponse> plans, MembershipPlanCatalogItemResponse plan)
    {
        if (plan.DurationValue is not > 0)
            return 0;

        var comparison = plans.Where(p => p.DurationValue is > 0 && p.DurationUnit == plan.DurationUnit && p.ServiceType == plan.ServiceType);
        var dearest = comparison.Max(p => p.Price / p.DurationValue!.Value);
        return dearest <= 0 ? 0 : (int)Math.Floor((dearest - plan.Price / plan.DurationValue.Value) / dearest * 100);
    }

    private static bool IsYoga(string? type) => string.Equals(type, MembershipPlanServiceTypes.Yoga, StringComparison.OrdinalIgnoreCase);

    private readonly CancellationTokenSource _lifetime = new();
    private PagedResponse<MembershipPlanCatalogItemResponse>? _page;
    private int _requestedPage = 1;
    private bool _loading = true;
    private string? _error;

    protected override Task OnInitializedAsync() => LoadAsync(1);

    private async Task LoadAsync(int page)
    {
        if (_lifetime.IsCancellationRequested)
            return;

        _requestedPage = page;
        _loading = true;
        _error = null;
        var cancellationToken = _lifetime.Token;
        try
        {
            _page = await Plans.ListCatalogAsync(page, cancellationToken, ServiceType);
            if (_page.Items.Count == 0 && page > 1)
                _page = await Plans.ListCatalogAsync(1, cancellationToken, ServiceType);
        }
        catch (AuthApiException ex)
        {
            _error = ex.Message;
        }
        catch (OperationCanceledException) when (cancellationToken.IsCancellationRequested)
        {
            // The user left the catalog.
        }
        finally
        {
            _loading = false;
        }
    }

    private static string Duration(MembershipPlanCatalogItemResponse plan) =>
        plan.DurationValue is > 0 ? $"{plan.DurationValue} {(plan.DurationUnit == MembershipDurationUnit.Month ? "tháng" : "ngày")}"
            : "Chưa có thời hạn";

    public void Dispose()
    {
        _lifetime.Cancel();
        _lifetime.Dispose();
    }
}
