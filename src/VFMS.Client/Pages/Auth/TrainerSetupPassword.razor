@page "/auth/trainer-setup"
@layout AuthLayout
@using VFMS.Client.Components.Trainers
@using VFMS.Contracts.Trainers
@inject TrainerApiClient Api
@inject AuthSession Session
@inject NavigationManager Navigation
<PageTitle>Thiết lập mật khẩu huấn luyện viên | Victor Fitness</PageTitle>
<section class="trainer-page trainer-stack">
    <h1>Thiết lập mật khẩu huấn luyện viên</h1>
    <TrainerFeedback Error="@_error" Message="@(_done ? "Đã thiết lập mật khẩu cho tài khoản huấn luyện viên. Dùng email nhận liên kết này để đăng nhập." : null)" />
    @if (_done)
    {
        <AuthorizeView>
            <Authorized Context="auth">
                <p class="trainer-muted">Trình duyệt đang đăng nhập bằng tài khoản @auth.User.Identity?.Name.</p>
                <button type="button" class="trainer-button trainer-primary" disabled="@_busy" @onclick="SignOutAndContinueAsync">
                    @(_busy ? "Đang đăng xuất…" : "Đăng xuất và chuyển sang đăng nhập huấn luyện viên")
                </button>
            </Authorized>
            <NotAuthorized>
                <a href="/auth/login" class="trainer-button trainer-primary">Đăng nhập tài khoản huấn luyện viên</a>
            </NotAuthorized>
        </AuthorizeView>
    }
    else if (string.IsNullOrWhiteSpace(Token))
    {
        <p class="trainer-feedback trainer-error" role="alert">Liên kết thiếu mã thiết lập. Hãy mở lại liên kết trong email.</p>
    }
    else
    {
        <p class="trainer-muted">Mật khẩu này dùng cho tài khoản huấn luyện viên được mời qua email.</p>
        <AuthorizeView>
            <Authorized Context="auth">
                <p class="trainer-muted">Phiên đăng nhập hiện tại của @auth.User.Identity?.Name vẫn hoạt động sau khi lưu.</p>
            </Authorized>
        </AuthorizeView>
        <form class="trainer-stack" @onsubmit="SetupAsync" @onsubmit:preventDefault>
            <fieldset class="trainer-stack" disabled="@_busy">
                <label>Mật khẩu mới<input type="password" autocomplete="new-password" class="trainer-input" required minlength="8" maxlength="32" @bind="_password" @bind:event="oninput" /></label>
                <label>Nhập lại mật khẩu<input type="password" autocomplete="new-password" class="trainer-input" required maxlength="32" @bind="_confirmation" @bind:event="oninput" /></label>
                <p class="trainer-muted">Dùng 8–32 ký tự, gồm chữ hoa, chữ thường, số và ký tự đặc biệt.</p>
                <button class="trainer-button trainer-primary">@(_busy ? "Đang lưu…" : "Lưu mật khẩu")</button>
            </fieldset>
        </form>
    }
</section>
@code {
    [SupplyParameterFromQuery(Name = "token")] public string? Token { get; set; }
    private string _password = "", _confirmation = "";
    private string? _error;
    private bool _busy, _done;

    private async Task SignOutAndContinueAsync()
    {
        if (_busy) return;
        _busy = true;
        try
        {
            await Session.SignOutAsync();
            Navigation.NavigateTo("/auth/login", replace: true);
        }
        finally { _busy = false; }
    }

    private async Task SetupAsync()
    {
        if (_busy || string.IsNullOrWhiteSpace(Token)) return;
        _error = null;
        if (_password != _confirmation)
        {
            _error = "Hai mật khẩu chưa khớp.";
            return;
        }
        var request = new TrainerSetupRequest(Token, _password);
        if (!new TrainerSetupValidator().Validate(request).IsValid)
        {
            _error = "Kiểm tra lại liên kết và yêu cầu về mật khẩu.";
            return;
        }
        _busy = true;
        try
        {
            _done = await Api.SetupAsync(request);
            _password = _confirmation = "";
        }
        catch (AuthApiException ex)
        {
            _error = ex.ErrorCode == "TRAINER_SETUP_INVALID" ? "Liên kết đã hết hạn, đã được dùng hoặc không hợp lệ." : ex.Message;
        }
        finally { _busy = false; }
    }
}
