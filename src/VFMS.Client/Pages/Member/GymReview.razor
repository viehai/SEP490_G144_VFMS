@page "/gym-review"
@layout PublicLayout
@using VFMS.Client.Components.Operations
@using VFMS.Contracts.Common
@using VFMS.Contracts.Feedback
@inject SystemAdministrationApiClient Api
@implements IDisposable

<PageTitle>Đánh giá phòng gym | Victor Fitness</PageTitle>

<section class="mx-auto max-w-5xl px-5 pb-16 pt-28">
    <header class="border-b border-[#D8D1CD] pb-5">
        <p class="text-xs font-bold tracking-wider text-[#B83A3A]">VFMS / REVIEW GYM &amp; SERVICES</p>
        <h1 class="mt-2 text-3xl font-black text-[#242424]">Đánh giá dịch vụ.</h1>
        <p class="mt-2 text-sm text-[#6F6966]">Mọi người đều có thể xem đánh giá. Đánh giá sẽ được hiển thị ngay sau khi gửi.</p>
        <a href="/membership-plans" class="mt-2 inline-flex min-h-[44px] items-center text-sm font-bold text-vfms-primary hover:underline">Chọn gói tập để đánh giá</a>
    </header>

    @if (_notice is not null)
    {
        <p role="status" class="mt-5 rounded-lg border border-emerald-300 bg-emerald-50 p-4 text-sm text-emerald-900">@_notice</p>
    }
    @if (_error is not null)
    {
        <p role="alert" class="mt-5 rounded-lg border border-red-300 bg-red-50 p-4 text-sm text-red-900">@_error</p>
    }

    <div class="mt-6 grid gap-6 lg:grid-cols-[380px_1fr]">
        <AuthorizeView Roles="Customer,Member">
            <Authorized>
                <section class="rounded-xl border border-[#D8D1CD] bg-[#F8F5F2] p-5 shadow-sm">
                    <h2 class="text-sm font-bold text-[#242424]">Gửi đánh giá</h2>
                    <fieldset disabled="@Busy" class="mt-4 space-y-4">
                        <fieldset class="block text-xs font-semibold text-[#242424]" aria-label="Số sao">
                            <legend>Điểm đánh giá</legend>
                            <div class="mt-2 flex gap-1">
                                @for (var star = 1; star <= 5; star++)
                                {
                                    var value = star;
                                    <button type="button"
                                            class="rounded px-1 text-3xl leading-none transition-colors @(value <= _rating ? "text-[#B83A3A]" : "text-[#C9C0BB]")"
                                            aria-label="@value sao"
                                            @onclick="() => _rating = value">@(_rating >= value ? "★" : "☆")</button>
                                }
                            </div>
                        </fieldset>

                        <label class="block text-xs font-semibold text-[#242424]" for="review-comment">
                            Nội dung đánh giá
                            <textarea id="review-comment" class="mt-1 block w-full rounded-lg border border-[#D8D1CD] bg-white px-3 py-2 text-sm" rows="5" maxlength="1000"
                                      placeholder="Chia sẻ trải nghiệm của bạn..." @bind="_comment"></textarea>
                        </label>

                        <button type="button" class="rounded-lg bg-[#B83A3A] px-4 py-2.5 text-sm font-bold text-white hover:bg-[#9F3030] disabled:opacity-60"
                                disabled="@Busy" @onclick="SubmitAsync">
                            @(_working ? "Đang gửi..." : "Gửi đánh giá")
                        </button>
                    </fieldset>
                </section>
            </Authorized>
            <NotAuthorized>
                <section class="rounded-xl border border-[#D8D1CD] bg-[#F8F5F2] p-5 shadow-sm">
                    <h2 class="text-sm font-bold text-[#242424]">Chia sẻ đánh giá</h2>
                    <p class="mt-3 text-sm text-[#6F6966]">Đăng nhập để gửi đánh giá và quản lý bình luận của bạn.</p>
                    <a href="/auth/login?returnUrl=%2Fgym-review" class="mt-4 inline-flex rounded-lg bg-[#B83A3A] px-4 py-2.5 text-sm font-bold text-white">Đăng nhập</a>
                </section>
            </NotAuthorized>
        </AuthorizeView>

        <section class="overflow-hidden rounded-xl border border-[#D8D1CD] bg-[#F8F5F2] shadow-sm" aria-busy="@Busy">
            <div class="border-b border-[#D8D1CD] px-5 py-4">
                <h2 class="text-sm font-bold text-[#242424]">Đánh giá của hội viên</h2>
            </div>
            <form @onsubmit="ApplyFiltersAsync" @onsubmit:preventDefault class="flex flex-wrap items-end gap-3 border-b border-[#D8D1CD] p-4">
                <label class="text-xs font-semibold text-[#242424]">Tìm kiếm
                    <input type="search" placeholder="Tên hội viên, gói tập hoặc nội dung"
                           class="mt-1 block rounded-lg border border-[#D8D1CD] px-3 py-2 text-sm"
                           @bind="_search" @bind:event="oninput" />
                </label>
                <label class="text-xs font-semibold text-[#242424]">Số sao
                    <select class="mt-1 block rounded-lg border border-[#D8D1CD] px-3 py-2 text-sm" @bind="_ratingFilter">
                        <option value="">Tất cả</option>
                        @for (var rating = 5; rating >= 1; rating--)
                        {
                            <option value="@rating">@rating sao</option>
                        }
                    </select>
                </label>
                <button type="submit" class="rounded-lg border border-[#C9C0BB] px-3 py-2 text-xs font-bold" disabled="@Busy">Lọc</button>
            </form>
            @if (_loading)
            {
                <p role="status" class="p-5 text-sm">Đang tải đánh giá...</p>
            }
            else if (_reviews is { Items.Count: > 0 } page)
            {
                <div class="divide-y divide-[#E2DDD9]">
                    @foreach (var review in page.Items)
                    {
                        <article @key="review.Id" class="p-5">
                            <div class="flex flex-wrap items-start justify-between gap-3">
                                <div>
                                    <p class="text-sm font-bold text-[#242424]">@(review.PackageName ?? "Đánh giá phòng gym")</p>
                                    <p class="mt-1 text-xs text-[#8C8581]">@review.MemberName · @review.CreatedAt.ToLocalTime().ToString("dd/MM/yyyy HH:mm")</p>
                                    <p class="mt-1 text-sm text-[#B83A3A]">@Stars(review.Rating)</p>
                                </div>
                                @if (review.IsMine && _editingId != review.Id && _confirmDeleteId != review.Id)
                                {
                                    <div class="flex gap-2">
                                        <button type="button" class="rounded-lg border border-[#C9C0BB] px-3 py-2 text-xs font-bold" disabled="@Busy" @onclick="() => BeginEdit(review)">Sửa</button>
                                        <button type="button" class="rounded-lg border border-red-300 px-3 py-2 text-xs font-bold text-red-700" disabled="@Busy" @onclick="() => _confirmDeleteId = review.Id">Xóa</button>
                                    </div>
                                }
                            </div>
                            <p class="mt-2 text-sm text-[#6F6966]">@(review.Comment ?? "Không có nhận xét.")</p>
                            @if (!string.IsNullOrWhiteSpace(review.ManagerReply))
                            {
                                <p class="mt-3 rounded-lg border border-[#D8D1CD] bg-[#F3EDEA] p-3 text-sm">
                                    <b>Phản hồi phòng tập:</b> @review.ManagerReply
                                </p>
                            }
                            @if (_confirmDeleteId == review.Id)
                            {
                                <div class="mt-3 flex items-center gap-3 text-sm">
                                    <span>Bạn chắc chắn muốn xóa đánh giá này?</span>
                                    <button type="button" class="font-bold text-red-700" disabled="@Busy" @onclick="() => DeleteAsync(review)">Xác nhận xóa</button>
                                    <button type="button" class="font-semibold" @onclick="() => _confirmDeleteId = null">Hủy</button>
                                </div>
                            }
                            @if (_editingId == review.Id)
                            {
                                <div class="mt-4 space-y-3 rounded-lg border border-[#D8D1CD] p-3">
                                    <fieldset disabled="@Busy">
                                        <legend class="text-xs font-semibold">Điểm đánh giá</legend>
                                        <div class="mt-1 flex gap-1">
                                            @for (var star = 1; star <= 5; star++)
                                            {
                                                var value = star;
                                                <button type="button" class="text-2xl @(_editRating >= value ? "text-[#B83A3A]" : "text-[#C9C0BB]")" aria-label="@value sao" @onclick="() => _editRating = value">@(_editRating >= value ? "★" : "☆")</button>
                                            }
                                        </div>
                                        <textarea class="mt-2 block w-full rounded-lg border border-[#D8D1CD] bg-white px-3 py-2 text-sm" rows="3" maxlength="1000" @bind="_editComment"></textarea>
                                    </fieldset>
                                    <div class="flex gap-2">
                                        <button type="button" class="rounded-lg bg-[#B83A3A] px-3 py-2 text-xs font-bold text-white" disabled="@Busy" @onclick="() => UpdateAsync(review)">Lưu</button>
                                        <button type="button" class="rounded-lg border px-3 py-2 text-xs font-bold" @onclick="CancelEdit">Hủy</button>
                                    </div>
                                </div>
                            }
                        </article>
                    }
                </div>
                <Pager Page="page.Page" PageSize="page.PageSize" TotalCount="page.TotalCount"
                       Noun="đánh giá" Disabled="@Busy" OnPage="LoadAsync" />
            }
            else if (_reviews is { } emptyPage)
            {
                <div class="p-5 text-sm text-[#6F6966]">
                    @if (!string.IsNullOrWhiteSpace(_search) || _ratingFilter.HasValue)
                    {
                        <p role="status">Không tìm thấy đánh giá phù hợp với bộ lọc.</p>
                        <button type="button" class="mt-2 font-bold text-vfms-primary hover:underline"
                                disabled="@Busy" @onclick="ClearFiltersAsync">Xóa bộ lọc</button>
                    }
                    else
                    {
                        <p role="status">Chưa có đánh giá nào được gửi.</p>
                    }
                </div>
                <Pager Page="emptyPage.Page" PageSize="emptyPage.PageSize" TotalCount="emptyPage.TotalCount"
                       Noun="đánh giá" Disabled="@Busy" OnPage="LoadAsync" />
            }
            else
            {
                <p role="status" class="p-5 text-sm text-[#6F6966]">Chưa có đánh giá nào được gửi.</p>
            }
        </section>
    </div>
</section>

@code {
    private readonly CancellationTokenSource _lifetime = new();
    private PagedResponse<PublicFeedbackResponse>? _reviews;
    private string _search = "";
    private string _comment = "";
    private string _editComment = "";
    private int? _ratingFilter;
    private int _rating = 5;
    private int _editRating = 5;
    private int? _editingId, _confirmDeleteId;
    private string? _notice, _error;
    private bool _loading, _working;
    private bool Busy => _loading || _working;

    protected override async Task OnInitializedAsync()
    {
        await LoadAsync();
    }

    private async Task LoadAsync(int page = 1)
    {
        _loading = true;
        try
        {
            _reviews = await Api.GetPublicFeedbackAsync(new(
                string.IsNullOrWhiteSpace(_search) ? null : _search.Trim(),
                null, _ratingFilter, page, 5), _lifetime.Token);
        }
        catch (AuthApiException error) { _error = error.Message; }
        catch (OperationCanceledException) when (_lifetime.IsCancellationRequested) { }
        finally { _loading = false; }
    }

    private Task ApplyFiltersAsync() => LoadAsync(1);

    private async Task ClearFiltersAsync()
    {
        _search = "";
        _ratingFilter = null;
        await LoadAsync(1);
    }

    private async Task SubmitAsync()
    {
        _working = true;
        _notice = _error = null;
        try
        {
            await Api.SubmitFeedbackAsync(
                new(null, _rating, string.IsNullOrWhiteSpace(_comment) ? null : _comment.Trim()),
                _lifetime.Token);
            _notice = "Đã gửi đánh giá và hiện đã được công khai.";
            _comment = "";
            _rating = 5;
            await LoadAsync();
        }
        catch (AuthApiException error) { _error = error.Message; }
        catch (OperationCanceledException) when (_lifetime.IsCancellationRequested) { }
        finally { _working = false; }
    }

    private static string Stars(int rating) =>
        new string('★', rating) + new string('☆', 5 - rating);

    private void BeginEdit(PublicFeedbackResponse review)
    {
        _editingId = review.Id;
        _editRating = review.Rating;
        _editComment = review.Comment ?? "";
        _confirmDeleteId = null;
        _error = null;
    }

    private void CancelEdit() => _editingId = null;

    private async Task UpdateAsync(PublicFeedbackResponse review)
    {
        await RunAsync(async () =>
        {
            await Api.UpdateFeedbackAsync(review.Id, new(_editRating, _editComment), _lifetime.Token);
            _editingId = null;
            _notice = "Đã cập nhật đánh giá.";
            await LoadAsync(_reviews?.Page ?? 1);
        });
    }

    private async Task DeleteAsync(PublicFeedbackResponse review)
    {
        await RunAsync(async () =>
        {
            await Api.DeleteFeedbackAsync(review.Id, _lifetime.Token);
            _confirmDeleteId = null;
            _notice = "Đã xóa đánh giá.";
            await LoadAsync(_reviews?.Page ?? 1);
        });
    }

    private async Task RunAsync(Func<Task> action)
    {
        _working = true;
        _notice = _error = null;
        try { await action(); }
        catch (AuthApiException error) { _error = error.Message; }
        catch (OperationCanceledException) when (_lifetime.IsCancellationRequested) { }
        finally { _working = false; }
    }

    public void Dispose()
    {
        _lifetime.Cancel();
        _lifetime.Dispose();
    }
}
