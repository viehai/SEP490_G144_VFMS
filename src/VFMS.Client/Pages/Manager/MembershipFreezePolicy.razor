@page "/manager/membership-freeze-policy"
@layout ManagerAdminLayout
@using Microsoft.AspNetCore.Authorization
@using VFMS.Client.Components.Memberships
@using VFMS.Contracts.Memberships
@attribute [Authorize(Roles = "Manager")]

<PageTitle>Chính sách bảo lưu gói Gym | Victor Fitness</PageTitle>

<div class="workspace-page max-w-5xl space-y-6">
    <header class="space-y-2 border-b border-vfms-border pb-5">
        <h1 class="workspace-heading text-3xl text-vfms-text">Chính sách bảo lưu gói Gym</h1>
        <p class="text-sm leading-6 text-vfms-text-secondary">Thiết lập điều kiện và quyền lợi bảo lưu mặc định cho gói Gym.</p>
    </header>

    @if (_loading)
    {
        <p class="rounded-xl border border-vfms-border bg-vfms-surface p-5 text-sm text-vfms-text-secondary" role="status">
            Đang tải chính sách bảo lưu...
        </p>
    }
    else if (_loadError is not null)
    {
        <div class="space-y-3 rounded-xl border border-red-200 bg-red-50 p-5">
            <p class="text-sm text-red-800" role="alert">@_loadError</p>
            <button type="button" class="@SecondaryButton" @onclick="LoadAsync">Tải lại</button>
        </div>
    }
    else if (_form is { } form && _editContext is { } editContext)
    {
        @if (!_configured)
        {
            <p class="rounded-xl border border-vfms-border bg-vfms-muted p-4 text-sm text-vfms-text">
                Chưa thiết lập quyền lợi mặc định. Nhập số lượt bảo lưu cho gói Gym và thời gian áp dụng cho mỗi lượt.
            </p>
        }
        @if (_success)
        {
            <p role="status" tabindex="-1" @ref="_successNotice" class="rounded-xl border border-emerald-200 bg-emerald-50 p-4 text-sm text-emerald-900">
                Đã cập nhật chính sách bảo lưu hội viên thành công.
            </p>
        }

        <EditForm @key="editContext" EditContext="editContext" OnValidSubmit="SaveAsync" OnInvalidSubmit="FocusErrors" novalidate>
            @if (editContext.GetValidationMessages().Any() || _saveError is not null)
            {
                <div role="alert" tabindex="-1" @ref="_errorNotice" class="mb-4 space-y-1 rounded-xl border border-red-200 bg-red-50 p-4 text-sm text-red-900">
                    <p class="font-semibold">@(_saveError ?? "Vui lòng kiểm tra các giá trị được đánh dấu.")</p>
                    <ValidationSummary />
                </div>
            }

            <fieldset disabled="@_saving" aria-busy="@(_saving ? "true" : "false")"
                      class="min-w-0 space-y-5 rounded-xl border border-vfms-border bg-vfms-surface p-4 sm:p-6">
                <legend class="sr-only">Cấu hình chính sách bảo lưu</legend>
                <section class="space-y-4" aria-labelledby="freeze-eligibility-title">
                    <h2 id="freeze-eligibility-title" class="workspace-heading text-base">Điều kiện bảo lưu</h2>
                    <div class="grid min-w-0 gap-4 sm:grid-cols-2">
                        <MembershipDurationInput Id="freeze-eligibility-days" Label="Thời gian tối thiểu kể từ ngày kích hoạt"
                                                 @bind-Value="form.EligibilityPaidDays" @bind-Unit="form.EligibilityPaidDaysUnit" Required ShowFreezeConversion
                                                 HelpText="Gói phải được kích hoạt đủ thời gian này trước khi hội viên được gửi yêu cầu bảo lưu. Nhập 0 nếu không yêu cầu." />
                        <MembershipDurationInput Id="freeze-notice-days" Label="Thời gian báo trước tối thiểu"
                                                 @bind-Value="form.MinimumRequestDays" @bind-Unit="form.MinimumRequestDaysUnit" Required ShowFreezeConversion
                                                 HelpText="Khoảng thời gian tối thiểu từ ngày gửi yêu cầu đến ngày bắt đầu bảo lưu." />
                    </div>
                </section>

                <section class="space-y-4 border-t border-vfms-border pt-5" aria-labelledby="freeze-duration-title">
                    <h2 id="freeze-duration-title" class="workspace-heading text-base">Giới hạn mỗi lần bảo lưu</h2>
                    <div class="grid min-w-0 gap-4 sm:grid-cols-2">
                        <MembershipDurationInput Id="freeze-min-days" Label="Thời gian bảo lưu tối thiểu mỗi lần"
                                                 @bind-Value="form.MinimumFreezeDays" @bind-Unit="form.MinimumFreezeDaysUnit" Minimum="1" Required ShowFreezeConversion />
                        <MembershipDurationInput Id="freeze-max-days" Label="Thời gian bảo lưu tối đa mỗi lần"
                                                 @bind-Value="form.MaximumFreezeDays" @bind-Unit="form.MaximumFreezeDaysUnit" Minimum="1" Required ShowFreezeConversion />
                    </div>
                    <p class="text-xs leading-relaxed text-vfms-text-secondary">Mỗi yêu cầu bảo lưu phải nằm trong khoảng thời gian quy định đã áp dụng cho gói.</p>
                </section>

                <section class="space-y-4 border-t border-vfms-border pt-5" aria-labelledby="freeze-default-title">
                    <h2 id="freeze-default-title" class="workspace-heading text-base">Quyền lợi bảo lưu mặc định</h2>
                    <div class="max-w-lg">
                        <label for="freeze-default-count" class="block text-sm font-semibold">Số lượt bảo lưu mặc định của gói Gym
                            <InputNumber id="freeze-default-count" @bind-Value="form.DefaultMaxFreezeCount" min="0" required class="block w-full rounded-lg border p-2" />
                        </label>
                        <ValidationMessage For="@(() => form.DefaultMaxFreezeCount)" />
                        <p class="mb-3 text-xs text-vfms-text-secondary">Áp dụng khi gói Gym để trống số lượt. Nhập 0 để tắt bảo lưu theo mặc định.</p>
                    </div>
                </section>

                <button type="submit" class="min-h-[44px] rounded-lg bg-vfms-primary px-5 py-2 text-sm font-semibold text-white hover:bg-vfms-primary-hover">
                    @(_saving ? "Đang lưu..." : _configured ? "Cập nhật chính sách" : "Lưu chính sách")
                </button>
            </fieldset>
        </EditForm>
    }
</div>
