@page "/manager/general-policies"
@layout ManagerAdminLayout
@using Microsoft.AspNetCore.Authorization
@using VFMS.Contracts.SystemAdministration
@using VFMS.Contracts.SystemAdministration.Validators
@attribute [Authorize]
@inject SystemAdministrationApiClient Api
@implements IDisposable

<PageTitle>Chính sách chung | Victor Fitness</PageTitle>

<div class="workspace-page space-y-6">
    <header class="flex flex-wrap items-end justify-between gap-4 border-b border-[#D8DED2] pb-6">
        <div>
            <p class="mb-2 text-xs font-bold tracking-wider text-[#5F6F52]">VFMS / SYSTEM CONFIGURATION</p>
            <h1 class="text-3xl font-extrabold tracking-tight text-[#383E43] sm:text-4xl">Chính sách chung<span class="text-[#5F6F52]">.</span></h1>
            <p class="mt-2 text-sm text-[#69706A]">Thông tin phòng tập, giờ mở cửa và trạng thái nhận hội viên mới.</p>
        </div>
        @if (_settings is not null)
        {
            <p class="text-xs text-[#69706A]">Cập nhật: @_settings.UpdatedAt.ToLocalTime().ToString("dd/MM/yyyy HH:mm")</p>
        }
    </header>

    @if (_notice is not null)
    {
        <p role="status" class="rounded-xl border border-emerald-300 bg-emerald-50 p-4 text-sm text-emerald-900">@_notice</p>
    }
    @if (_error is not null)
    {
        <p role="alert" class="rounded-xl border border-red-300 bg-red-50 p-4 text-sm text-red-900">@_error</p>
    }

    @if (_loading)
    {
        <p role="status" class="text-sm">Đang tải thông tin phòng tập...</p>
    }
    else if (_settings is not null)
    {
        <section class="rounded-xl border border-[#D8DED2] bg-white p-5 sm:p-6 shadow-sm" aria-labelledby="gym-settings-title">
            <h2 id="gym-settings-title" class="text-base font-bold text-[#383E43]">Thông tin phòng tập</h2>
            @if (!_canEdit)
            {
                <p class="mt-2 text-xs text-[#69706A]">Chỉ Manager được chỉnh sửa.</p>
            }
            <EditForm Model="_model" OnValidSubmit="SaveAsync" class="mt-4" novalidate>
                <ContractValidation TRequest="GymSettingsRequest" Validator="_validator" CreateRequest="CreateRequest" @ref="_validation" />
                <ValidationSummary />
                <fieldset disabled="@(_working || !_canEdit)" class="mt-4 grid gap-4 sm:grid-cols-2">
                    <label class="text-xs font-semibold text-[#383E43] sm:col-span-2" for="gym-name">
                        Tên phòng tập
                        <InputText id="gym-name" class="@Field" @bind-Value="_model.GymName" maxlength="256" required />
                    </label>
                    <label class="text-xs font-semibold text-[#383E43] sm:col-span-2" for="gym-address">
                        Địa chỉ
                        <InputText id="gym-address" class="@Field" @bind-Value="_model.Address" maxlength="500" />
                    </label>
                    <label class="text-xs font-semibold text-[#383E43]" for="gym-phone">
                        Số điện thoại
                        <InputText id="gym-phone" class="@Field" @bind-Value="_model.PhoneNumber" maxlength="20" />
                    </label>
                    <label class="text-xs font-semibold text-[#383E43]" for="gym-email">
                        Email
                        <InputText id="gym-email" class="@Field" @bind-Value="_model.Email" maxlength="256" />
                    </label>
                    <label class="text-xs font-semibold text-[#383E43]" for="gym-open">
                        Giờ mở cửa
                        <InputDate id="gym-open" Type="InputDateType.Time" class="@Field" @bind-Value="_model.OpenTime" />
                    </label>
                    <label class="text-xs font-semibold text-[#383E43]" for="gym-close">
                        Giờ đóng cửa
                        <InputDate id="gym-close" Type="InputDateType.Time" class="@Field" @bind-Value="_model.CloseTime" />
                    </label>
                    <label class="flex items-center gap-3 text-sm font-semibold text-[#383E43] sm:col-span-2">
                        <InputCheckbox @bind-Value="_model.IsAcceptingMembers" /> Đang nhận hội viên mới
                    </label>
                    @if (_canEdit)
                    {
                        <div class="flex flex-wrap gap-3 sm:col-span-2">
                            <button type="submit" class="@PrimaryButton">@(_working ? "Đang lưu..." : "Lưu thay đổi")</button>
                            <button type="button" class="@Button" @onclick="Reset">Hoàn tác</button>
                        </div>
                    }
                </fieldset>
            </EditForm>
        </section>
    }
</div>

@code {
    private const string Field = "mt-1 block w-full rounded-lg border border-[#D8DED2] bg-white px-3 py-2 text-sm font-normal text-[#383E43] focus:border-[#5F6F52] focus:ring-2 focus:ring-[#5F6F52]/20 outline-none";
    private const string Button = "rounded-lg border border-[#D8DED2] bg-white px-3 py-1.5 text-xs font-semibold text-[#383E43] hover:bg-[#EEF1EA] transition";
    private const string PrimaryButton = "rounded-lg bg-[#5F6F52] px-4 py-2 text-sm font-semibold text-white hover:bg-[#4E5D44] transition shadow-sm";

    [CascadingParameter] private Task<AuthenticationState> AuthState { get; set; } = default!;
    private readonly CancellationTokenSource _lifetime = new();
    private readonly GymSettingsModel _model = new();
    private readonly GymSettingsRequestValidator _validator = new();
    private ContractValidation<GymSettingsRequest>? _validation;
    private GymSettingsResponse? _settings;
    private string? _notice, _error;
    private bool _loading = true, _working, _canEdit;

    protected override async Task OnInitializedAsync()
    {
        _canEdit = (await AuthState).User.IsInRole("Manager");
        try
        {
            _settings = await Api.GetGymSettingsAsync(_lifetime.Token);
            Reset();
        }
        catch (AuthApiException error) { _error = error.Message; }
        catch (OperationCanceledException) when (_lifetime.IsCancellationRequested) { }
        finally { _loading = false; }
    }

    private GymSettingsRequest CreateRequest() => new(_model.GymName.Trim(), Blank(_model.Address), Blank(_model.PhoneNumber),
        Blank(_model.Email), _model.OpenTime, _model.CloseTime, _model.IsAcceptingMembers);

    private static string? Blank(string? value) => string.IsNullOrWhiteSpace(value) ? null : value.Trim();

    private async Task SaveAsync()
    {
        if (_working) return;
        _working = true;
        _notice = _error = null;
        try
        {
            _settings = await Api.UpdateGymSettingsAsync(CreateRequest(), _lifetime.Token);
            Reset();
            _notice = "Đã lưu chính sách chung.";
        }
        catch (AuthApiException error)
        {
            _error = error.Message;
            _validation?.ShowErrors(error.Errors);
        }
        catch (OperationCanceledException) when (_lifetime.IsCancellationRequested) { }
        finally { _working = false; }
    }

    private void Reset()
    {
        if (_settings is not { } settings) return;
        _model.GymName = settings.GymName;
        _model.Address = settings.Address;
        _model.PhoneNumber = settings.PhoneNumber;
        _model.Email = settings.Email;
        _model.OpenTime = settings.OpenTime;
        _model.CloseTime = settings.CloseTime;
        _model.IsAcceptingMembers = settings.IsAcceptingMembers;
    }

    public void Dispose()
    {
        _lifetime.Cancel();
        _lifetime.Dispose();
    }

    private sealed class GymSettingsModel
    {
        public string GymName { get; set; } = string.Empty;
        public string? Address { get; set; }
        public string? PhoneNumber { get; set; }
        public string? Email { get; set; }
        public TimeOnly? OpenTime { get; set; }
        public TimeOnly? CloseTime { get; set; }
        public bool IsAcceptingMembers { get; set; }
    }
}
