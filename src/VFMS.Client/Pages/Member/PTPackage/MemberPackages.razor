@page "/my-pt-packages"
@page "/trainers/{Id:int}/my-pt-schedule"
@layout AccountLayout
@attribute [Authorize(Roles = "Customer,Member")]
@using VFMS.Client.Components.Operations
@using VFMS.Contracts.Common
@inject PersonalTrainingApiClient Api
@inject TrainerApiClient Trainers
<PageTitle>Gói và lịch PT của tôi | Victor Fitness</PageTitle>

<section class="workspace-page trainer-page trainer-stack">
    <a class="trainer-back" href="/trainers">← Tìm huấn luyện viên</a>
    <PageHeader Overline="VFMS / GÓI PT" Title="@(Id.HasValue ? "Lịch PT của tôi" : "Gói PT của tôi")"
                Description="Theo dõi tiến độ, đổi lịch, bảo lưu và đánh giá huấn luyện viên." />
    <TrainerFeedback Error="@_error" />
    <div class="trainer-row" role="group" aria-label="Loại hợp đồng">
        <button type="button" class="trainer-button" aria-pressed="@(_completed ? "false" : "true")" disabled="@_loading"
                @onclick="() => SwitchAsync(false)">Hợp đồng hiện tại</button>
        <button type="button" class="trainer-button" aria-pressed="@(_completed ? "true" : "false")" disabled="@_loading"
                @onclick="() => SwitchAsync(true)">Hợp đồng đã hoàn thành</button>
    </div>
    @if (_loading) { <p role="status">Đang tải hợp đồng…</p> }
    else if (_contracts is null && _selected is null) { <button class="trainer-button" @onclick="() => LoadAsync()">Tải lại</button> }
    else if (_contracts is { TotalCount: 0 } && _selected is null && _completed) { <p class="trainer-panel">Chưa có hợp đồng PT đã hoàn thành.</p> }
    else if (_contracts is { TotalCount: 0 } && _selected is null) { <p class="trainer-panel">Chưa có hợp đồng PT để hiển thị. <a class="trainer-link" href="/trainers">Khám phá gói PT</a></p> }
    else
    {
        <div class="pt-workspace">
            <nav class="trainer-panel trainer-stack" aria-label="Hợp đồng PT">
                @foreach (var item in _contracts?.Items ?? [])
                {
                    <button type="button" class="trainer-button pt-wide-choice" aria-pressed="@(item.Id == _selected?.Id ? "true" : "false")"
                            disabled="@_loading" @onclick="() => _selected = item">@Label(item) · @Status(item.Status)</button>
                }
                @if (_contracts is { } page)
                {
                    <Pager Page="page.Page" PageSize="page.PageSize" TotalCount="page.TotalCount" Noun="hợp đồng" OnPage="LoadPageAsync" />
                }
            </nav>
            @if (_selected is { } selected)
            {
                <div class="trainer-stack">
                    <div class="trainer-row">
                        <a class="trainer-button" href="@($"/my-pt-packages/{selected.Id}/reschedule")">Xin đổi lịch</a>
                        <a class="trainer-button" href="@($"/my-pt-packages/{selected.Id}/freeze")">Bảo lưu PT</a>
                    </div>
                    <ContractPanel @key="selected.Id" Contract="selected" TrainerName="@(selected.TrainerName ?? "Huấn luyện viên")" Changed="ReloadAsync"
                                   OpenReview="_completed" />
                </div>
            }
        </div>
    }
</section>

@code {
    [Parameter] public int? Id { get; set; }
    [SupplyParameterFromQuery(Name = "contract")] public int? ContractId { get; set; }
    private PagedResponse<PTContractResponse>? _contracts;
    private PTContractResponse? _selected;
    private bool _loading, _completed;
    private int _loadVersion;
    private string? _error;

    // UC 4.10: opening 'My PT Packages' shows the review modal for a completed contract not reviewed yet.
    protected override Task OnParametersSetAsync() => LoadAsync(selectedId: ContractId, findReview: ContractId is null);
    private Task SwitchAsync(bool completed) { _completed = completed; return LoadAsync(); }
    private Task ReloadAsync() => LoadAsync(_contracts?.Page ?? 1, _selected?.Id, showLoading: false);
    private Task LoadPageAsync(int page) => LoadAsync(page);

    private async Task LoadAsync(int page = 1, int? selectedId = null, bool showLoading = true, bool findReview = false)
    {
        var version = ++_loadVersion;
        _loading = showLoading;
        _error = null;
        if (showLoading) { _contracts = null; _selected = null; }
        try
        {
            var trainerId = Id is { } id ? (await Trainers.DetailAsync(id)).Profile.UserId : null;
            if (findReview)
            {
                var done = await Api.ContractPageAsync(1, trainerId, true);
                if (done.Items.FirstOrDefault(item => item.CanReview && !item.HasReview) is { } pending && version == _loadVersion)
                {
                    (_completed, _contracts, _selected) = (true, done, pending);
                    return;
                }
            }
            var contracts = await Api.ContractPageAsync(page, trainerId, _completed);
            var selected = contracts.Items.FirstOrDefault(item => item.Id == selectedId);
            if (selected is null && selectedId is { } contractId)
            {
                try
                {
                    selected = (await Api.ContractsAsync(contractId)).FirstOrDefault(item =>
                        trainerId is null || item.TrainerId == trainerId);
                }
                catch (AuthApiException ex) when (ex.StatusCode == System.Net.HttpStatusCode.NotFound) { }
            }
            if (version != _loadVersion) return;
            _contracts = contracts;
            _selected = selected ?? contracts.Items.FirstOrDefault();
        }
        catch (AuthApiException ex) when (version == _loadVersion) { _error = ex.Message; }
        catch (AuthApiException) { }
        finally { if (version == _loadVersion) _loading = false; }
    }

    private static string Label(PTContractResponse item) => item.PackageName ?? $"Hợp đồng #{item.Id}";
}
