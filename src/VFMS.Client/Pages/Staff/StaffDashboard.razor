@page "/staff/dashboard"
@layout StaffPTLayout

<PageTitle>Staff Dashboard | Victor Fitness</PageTitle>

<div class="workspace-page space-y-8 font-['Inter',sans-serif] text-[#383E43]">
    <header class="flex flex-col justify-between gap-5 border-b border-[#D8DED2] pb-6 lg:flex-row lg:items-end">
        <div>
            <p class="workspace-heading mb-2 text-[10px] font-bold tracking-[0.18em] text-[#5F6F52]">VFMS / FRONT DESK OPERATIONS</p>
            <h1 class="workspace-heading text-3xl font-extrabold tracking-tight text-[#383E43] sm:text-4xl">STAFF DASHBOARD</h1>
            <p class="mt-2 max-w-xl text-sm leading-relaxed text-[#69706A]">Nắm bắt tình hình phòng tập, hỗ trợ hội viên và xử lý công việc tại quầy.</p>
        </div>
        <div class="flex flex-wrap items-center gap-3">
            <span class="workspace-heading border border-[#D8DED2] bg-white px-3.5 py-2 text-[10px] font-bold rounded-lg text-[#383E43]">CA SÁNG · 07:00–15:00</span>
            <span class="border border-[#D8DED2] bg-[#EEF1EA] px-3.5 py-2 text-xs text-[#69706A] rounded-lg">Dữ liệu minh họa</span>
        </div>
    </header>

    <section class="grid gap-4 lg:grid-cols-3" aria-label="Thống kê vận hành">
        @foreach (var stat in _stats)
        {
            <article class="group flex min-h-[180px] flex-col justify-between border border-[#D8DED2] bg-white p-6 transition-all hover:border-[#5F6F52] rounded-xl">
                <div class="flex items-start justify-between gap-4">
                    <p class="workspace-heading max-w-[190px] text-xs font-bold leading-relaxed text-[#383E43]">@stat.Label</p>
                    <span class="workspace-heading text-xs font-bold text-[#8A9089]">@stat.Index</span>
                </div>
                <div class="mt-6 flex items-end justify-between gap-4">
                    <p class="workspace-heading text-5xl font-extrabold leading-none tracking-tight text-[#5F6F52]">@stat.Value.ToString("00")</p>
                    <span class="text-right text-xs text-[#69706A]">@stat.Note</span>
                </div>
            </article>
        }
    </section>

    <section id="quick-actions" aria-labelledby="staff-actions-title" class="space-y-4">
        <div class="flex flex-wrap items-end justify-between gap-3">
            <div>
                <p class="workspace-heading mb-1 text-[10px] font-bold tracking-[0.18em] text-[#5F6F52]">WORKSPACE / 01</p>
                <h2 id="staff-actions-title" class="workspace-heading text-base font-extrabold text-[#383E43]">QUICK ACTIONS</h2>
            </div>
            <span class="text-xs text-[#69706A]">Chọn công việc để xem danh sách minh họa</span>
        </div>
        <div class="grid gap-3 lg:grid-cols-3">
            <AuthorizeView Roles="Staff">
                <a href="/staff/membership-cash-receipt"
                   class="flex min-h-[100px] items-center border border-[#D8DED2] bg-white p-5 text-sm font-bold text-[#383E43] hover:border-[#5F6F52] hover:bg-[#EEF1EA] rounded-xl transition-all">
                    Xác nhận tiền mặt mua gói tập
                </a>
            </AuthorizeView>
            @foreach (var action in _actions)
            {
                var active = _selectedAction == action.Id;
                <button type="button" @onclick="() => _selectedAction = action.Id" aria-pressed="@(active ? "true" : "false")"
                        class="flex min-h-[100px] items-center justify-between gap-4 border p-5 text-left transition-all rounded-xl cursor-pointer @(active ? "border-[#5F6F52] bg-[#E8EDE3] text-[#5F6F52]" : "border-[#D8DED2] bg-white text-[#383E43] hover:border-[#5F6F52] hover:bg-[#EEF1EA]")">
                    <span><span class="workspace-heading block text-xs font-extrabold">@action.Title</span><span class="mt-1.5 block text-xs text-[#69706A]">@action.Description</span></span>
                    <span class="text-xl" aria-hidden="true">↗</span>
                </button>
            }
        </div>
    </section>

    <section class="overflow-hidden border border-[#D8DED2] bg-white rounded-xl shadow-sm" aria-labelledby="staff-list-title" aria-live="polite">
        <div class="flex flex-wrap items-center justify-between gap-3 border-b border-[#D8DED2] p-5 sm:px-6">
            <div>
                <h2 id="staff-list-title" class="workspace-heading text-sm font-extrabold text-[#383E43]">@SelectedTitle</h2>
                <p class="mt-1 text-xs text-[#69706A]">@SelectedDescription</p>
            </div>
            <span class="workspace-heading border border-[#D8DED2] bg-[#EEF1EA] px-3 py-1 text-[10px] font-bold rounded-lg text-[#69706A]">@_demoDate.ToString("dd / MM / yyyy")</span>
        </div>
        <div class="overflow-x-auto">
            @if (_selectedAction == "customers")
            {
                <table class="workspace-table w-full min-w-[640px] text-left text-sm">
                    <caption class="sr-only">Khách hàng cần hỗ trợ đăng ký tài khoản</caption>
                    <thead class="workspace-heading bg-[#EEF1EA] text-[10px] tracking-wider text-[#383E43]"><tr><th scope="col" class="px-6 py-4">KHÁCH HÀNG</th><th scope="col" class="px-6 py-4">LIÊN HỆ</th><th scope="col" class="px-6 py-4">NHU CẦU</th><th scope="col" class="px-6 py-4">TRẠNG THÁI</th></tr></thead>
                    <tbody class="divide-y divide-[#EEF1EA]">
                        @foreach (var customer in _customers)
                        {
                            <tr class="hover:bg-[#FAFAF7]"><th scope="row" class="px-6 py-4 font-semibold text-[#383E43]">@customer.Name</th><td class="px-6 py-4 text-xs text-[#69706A]">@customer.Email</td><td class="px-6 py-4 text-xs">@customer.Interest</td><td class="px-6 py-4"><span class="inline-flex border border-amber-200 bg-amber-50 px-2.5 py-1 text-[10px] font-bold text-[#D97706] rounded-full">Chờ tư vấn</span></td></tr>
                        }
                    </tbody>
                </table>
            }
            else if (_selectedAction == "lockers")
            {
                <table class="workspace-table w-full min-w-[640px] text-left text-sm">
                    <caption class="sr-only">Tủ đồ cần xử lý</caption>
                    <thead class="workspace-heading bg-[#EEF1EA] text-[10px] tracking-wider text-[#383E43]"><tr><th scope="col" class="px-6 py-4">TỦ ĐỒ</th><th scope="col" class="px-6 py-4">HỘI VIÊN</th><th scope="col" class="px-6 py-4">NGÀY HẾT HẠN</th><th scope="col" class="px-6 py-4">TRẠNG THÁI</th></tr></thead>
                    <tbody class="divide-y divide-[#EEF1EA]">
                        @foreach (var locker in _lockers)
                        {
                            <tr class="hover:bg-[#FAFAF7]"><th scope="row" class="workspace-heading px-6 py-4 font-bold text-[#383E43]">@locker.Code</th><td class="px-6 py-4 text-xs text-[#69706A]">@locker.Member</td><td class="px-6 py-4 text-xs text-[#69706A]">@locker.ExpiredOn.ToString("dd/MM/yyyy")</td><td class="px-6 py-4"><span class="inline-flex border border-red-200 bg-red-50 px-2.5 py-1 text-[10px] font-bold text-[#DC2626] rounded-full">Quá hạn @locker.OverdueDays ngày</span></td></tr>
                        }
                    </tbody>
                </table>
            }
            else
            {
                <table class="workspace-table w-full min-w-[640px] text-left text-sm">
                    <caption class="sr-only">Hoạt động check-in gần đây</caption>
                    <thead class="workspace-heading bg-[#EEF1EA] text-[10px] tracking-wider text-[#383E43]"><tr><th scope="col" class="px-6 py-4">HỘI VIÊN</th><th scope="col" class="px-6 py-4">MÃ THẺ</th><th scope="col" class="px-6 py-4">GIỜ VÀO</th><th scope="col" class="px-6 py-4">TRẠNG THÁI</th></tr></thead>
                    <tbody class="divide-y divide-[#EEF1EA]">
                        @foreach (var checkIn in _checkIns)
                        {
                            <tr class="hover:bg-[#FAFAF7]"><th scope="row" class="px-6 py-4 font-semibold text-[#383E43]">@checkIn.Name</th><td class="workspace-heading px-6 py-4 text-xs font-bold text-[#69706A]">@checkIn.MemberCode</td><td class="px-6 py-4 text-xs text-[#69706A]">@checkIn.Time</td><td class="px-6 py-4"><span class="inline-flex border border-emerald-200 bg-emerald-50 px-2.5 py-1 text-[10px] font-bold text-[#16A34A] rounded-full">Đang tập</span></td></tr>
                        }
                    </tbody>
                </table>
            }
        </div>
        <p class="border-t border-[#D8DED2] bg-[#FAFAF7] px-6 py-4 text-xs leading-relaxed text-[#69706A]">Bản xem trước giao diện. Các thao tác tạo tài khoản, check-in và quản lý tủ sẽ được kết nối với màn hình nghiệp vụ tương ứng.</p>
    </section>
</div>

@code {
    private readonly DateOnly _demoDate = new(2026, 11, 6);
    private string _selectedAction = "checkin";
    private readonly StatItem[] _stats =
    [
        new("01", "KHÁCH ĐANG CHECK-IN", 42, "Trong phòng tập"),
        new("02", "TỦ ĐỒ QUÁ HẠN", 3, "Cần liên hệ hội viên"),
        new("03", "THIẾT BỊ BÁO HỎNG", 5, "Chờ tiếp nhận xử lý")
    ];
    private readonly ActionItem[] _actions =
    [
        new("customers", "CREATE CUSTOMER ACCOUNT", "Tiếp nhận và hỗ trợ khách hàng mới"),
        new("checkin", "MANUAL CHECK-IN", "Theo dõi lượt vào phòng tập"),
        new("lockers", "MANAGE LOCKERS", "Kiểm tra tủ đồ cần xử lý")
    ];
    private readonly CheckInItem[] _checkIns =
    [
        new("Nguyễn Minh Anh", "VF-000128", "09:42"),
        new("Trần Quốc Bảo", "VF-000256", "09:38"),
        new("Lê Hoàng Nam", "VF-000314", "09:35"),
        new("Phạm Ngọc Linh", "VF-000407", "09:28")
    ];
    private readonly CustomerItem[] _customers =
    [
        new("Vũ Gia Huy", "giahuy@example.com", "Gói Gym 3 tháng"),
        new("Đỗ Mai Chi", "maichi@example.com", "Yoga Studio"),
        new("Bùi Thanh Sơn", "thanhson@example.com", "Personal Training")
    ];
    private readonly LockerItem[] _lockers =
    [
        new("A-012", "Nguyễn Minh Anh", new DateOnly(2026, 11, 4), 2),
        new("A-028", "Lê Hoàng Nam", new DateOnly(2026, 11, 3), 3),
        new("B-006", "Đỗ Mai Chi", new DateOnly(2026, 11, 5), 1)
    ];
    private string SelectedTitle => _selectedAction switch { "customers" => "KHÁCH HÀNG CẦN HỖ TRỢ", "lockers" => "TỦ ĐỒ CẦN XỬ LÝ", _ => "CHECK-IN GẦN ĐÂY" };
    private string SelectedDescription => _selectedAction switch { "customers" => "03 khách hàng mẫu đang chờ tư vấn tại quầy.", "lockers" => "03 tủ đồ mẫu đã quá ngày hết hạn.", _ => "04 lượt vào mẫu trong ca làm việc." };
    private sealed record StatItem(string Index, string Label, int Value, string Note);
    private sealed record ActionItem(string Id, string Title, string Description);
    private sealed record CheckInItem(string Name, string MemberCode, string Time);
    private sealed record CustomerItem(string Name, string Email, string Interest);
    private sealed record LockerItem(string Code, string Member, DateOnly ExpiredOn, int OverdueDays);
}
