@using VFMS.Contracts.Memberships

<span class="inline-block rounded-full px-2.5 py-1 text-xs font-semibold @StatusClass">@MembershipDisplay.Status(Status)</span>

@code {
    [Parameter, EditorRequired] public string Status { get; set; } = "";

    private string StatusClass => Status switch
    {
        MembershipStatuses.Active => "bg-green-50 text-green-800",
        MembershipStatuses.Scheduled => "bg-blue-50 text-blue-800",
        MembershipStatuses.AwaitingActivation or MembershipStatuses.Frozen => "bg-amber-50 text-amber-800",
        MembershipStatuses.Expired => "bg-red-50 text-red-800",
        _ => "bg-gray-100 text-gray-700"
    };
}
