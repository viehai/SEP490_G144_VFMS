@page "/staff/dashboard"
@layout StaffPTLayout
@using Microsoft.AspNetCore.Authorization
@using VFMS.Client.Components.Dashboards
@using VFMS.Contracts.Dashboards
@attribute [Authorize(Roles = "Staff")]

<PageTitle>Tổng quan lễ tân | Victor Fitness</PageTitle>
<DashboardView T="StaffOverview" Path="api/dashboards/staff" Title="Tổng quan lễ tân" Description="Theo dõi hoạt động tại quầy và xử lý tác vụ hằng ngày.">
    <HeaderControl><span class="dash-date"><DashboardIcon Name="calendar" />Hôm nay, @PTDisplay.Today.ToString("dd/MM/yyyy")</span></HeaderControl>
    <ChildContent Context="data">
        <div class="dash-stats">
            <DashboardStat Icon="check" Label="Lượt check-in hôm nay" Value="@data.Visits.ToString()" Note="@($"Hôm qua {data.YesterdayVisits} lượt")" />
            <DashboardStat Icon="orders" Label="Đơn gói chờ thanh toán" Value="@data.PendingOrders.ToString()" />
            <DashboardStat Icon="people" Label="Hội viên mới" Value="@data.NewMembers.ToString()" Note="Đơn gói đầu tiên thanh toán hôm nay" />
            <DashboardStat Icon="chat" Label="Yêu cầu tư vấn" Value="@data.OpenConsultations.ToString()" Note="Cuộc tư vấn đang mở" />
        </div>
        <div class="dash-grid dash-even">
            <section class="dash-panel"><header><h2><DashboardIcon Name="people" />Khách đến gần đây</h2><a href="/staff/check-ins">Check-in / Check-out →</a></header>
                @if (data.Arrivals.Count == 0) { <p class="dash-message">Hôm nay chưa có lượt check-in.</p> }
                else { <div class="dash-scroll"><table aria-label="Khách đến gần đây"><thead><tr><th>Thời gian</th><th>Hội viên</th><th>Trạng thái</th></tr></thead>
                    <tbody>@foreach (var visit in data.Arrivals) { <tr><td>@visit.ArrivedAt.AddHours(7).ToString("HH:mm")</td><td>@visit.Member</td>
                        <td><span class="dash-badge @(visit.CheckedOut ? "" : "positive")">@(visit.CheckedOut ? "Đã check-out" : "Đã check-in")</span></td></tr> }</tbody></table></div> }
            </section>
            <section class="dash-panel"><header><h2><DashboardIcon Name="list" />Đơn gói cần xử lý</h2><a href="/staff/membership-cash-receipt">Xem tất cả →</a></header>
                <DashboardOrders Rows="data.Orders" StaffLinks="true" Empty="Không có đơn gói chờ thanh toán." /></section>
            <section class="dash-panel"><header><h2><DashboardIcon Name="calendar" />Lịch lớp trong ngày</h2><a href="/staff/yoga">Xem lịch →</a></header>
                <DashboardSchedule Rows="data.Schedule" YogaOnly="true" Empty="Hôm nay chưa có lịch lớp Yoga." Label="Lịch lớp Yoga hôm nay" /></section>
            <section id="quick-actions" class="dash-panel"><header><h2>Thao tác nhanh</h2></header><div class="dash-actions dash-actions-staff">
                <DashboardLink Href="/staff/membership-cash-receipt" Icon="money">Xác nhận thanh toán tại quầy</DashboardLink>
                <DashboardLink Href="/staff/check-ins" Icon="check">Check-in / Check-out</DashboardLink>
                <DashboardLink Href="/staff/customers/create" Icon="person">Tạo tài khoản khách hàng</DashboardLink>
                <DashboardLink Href="/staff/yoga" Icon="yoga">Điểm danh Yoga</DashboardLink>
                <DashboardLink Href="/staff/supplement-orders" Icon="orders">Đơn sản phẩm bổ sung</DashboardLink>
                <DashboardLink Href="/staff/consultations" Icon="chat">Tư vấn khách hàng</DashboardLink>
                <DashboardLink Href="/staff/equipment-issues" Icon="tool">Xử lý sự cố thiết bị</DashboardLink>
                <DashboardLink Href="/staff/lockers" Icon="grid">Sơ đồ tủ</DashboardLink>
                <DashboardLink Href="/staff/locker-contracts" Icon="list">Hợp đồng tủ</DashboardLink>
            </div></section>
        </div>
    </ChildContent>
</DashboardView>
