@page "/yoga/schedule"
@layout PublicLayout
@using VFMS.Client.Components.Operations
@using VFMS.Contracts.Yoga
@using Microsoft.AspNetCore.Components.Authorization
@inject VfmsApiClient Api
@inject IJSRuntime JS

<PageTitle>Lịch Yoga | Victor Fitness</PageTitle>

<div class="mx-auto max-w-6xl space-y-8 px-4 py-28 font-['Inter',sans-serif] text-[#242424] sm:px-6">
    <header class="border-b border-[#D8D1CD] pb-7">
        <p class="mb-3 text-[10px] font-bold tracking-[.18em] text-[#B83A3A]">VICTOR FITNESS / YOGA</p>
        <h1 class="font-['Montserrat'] text-3xl font-extrabold uppercase tracking-tight text-[#242424] sm:text-4xl">Thời khóa biểu Yoga<span class="text-[#B83A3A]">.</span></h1>
        <p class="mt-3 max-w-2xl text-sm leading-6 text-[#6F6966]">Lịch các buổi yoga đã công bố và số chỗ còn trống.</p>
    </header>

    <section class="flex flex-wrap items-end gap-3" aria-label="Bộ lọc">
        <button type="button" class="border border-[#D8D1CD] bg-[#F8F5F2] hover:bg-[#ECE8E4] px-4 py-2 text-xs font-bold uppercase rounded-lg text-[#242424] transition-colors" @onclick="() => Move(-7)" aria-label="Tuần trước">←</button>
        <p class="min-w-48 text-sm font-semibold text-[#242424]">@_from.ToString("dd/MM/yyyy") – @_from.AddDays(6).ToString("dd/MM/yyyy")</p>
        <button type="button" class="border border-[#D8D1CD] bg-[#F8F5F2] hover:bg-[#ECE8E4] px-4 py-2 text-xs font-bold uppercase rounded-lg text-[#242424] transition-colors" @onclick="() => Move(7)" aria-label="Tuần sau">→</button>
        <label class="text-xs font-semibold text-[#242424]">Độ khó
            <select class="ml-2 border border-[#D8D1CD] bg-[#F8F5F2] px-3 py-2 text-sm rounded-lg text-[#242424] focus:border-[#B83A3A] outline-none" @bind="_difficulty" @bind:after="Load">
                <option value="">Tất cả</option><option value="Beginner">Cơ bản</option><option value="Intermediate">Trung bình</option><option value="Advanced">Nâng cao</option>
            </select>
        </label>
        <label class="text-xs font-semibold text-[#242424]">Huấn luyện viên
            <select class="ml-2 border border-[#D8D1CD] bg-[#F8F5F2] px-3 py-2 text-sm rounded-lg text-[#242424] focus:border-[#B83A3A] outline-none" @bind="_instructor" @bind:after="Load">
                <option value="">Tất cả</option>
                @foreach (var i in _instructors) { <option value="@i.UserId">@i.FullName</option> }
            </select>
        </label>
    </section>

    @if (_error is not null)
    {
        <StatusMessage Error="@_error" />
    }
    else if (_loading)
    {
        <p class="text-sm text-[#6F6966]">Đang tải…</p>
    }
    else
    {
        <div class="flex flex-wrap items-center gap-x-4 gap-y-2 text-xs text-[#6F6966]" aria-label="Chú thích">
            <span class="flex items-center gap-1.5"><span class="h-3 w-3 rounded-sm border border-[#D8D1CD] bg-white"></span>Còn chỗ</span>
            <span class="flex items-center gap-1.5"><span class="h-3 w-3 rounded-sm border border-amber-200 bg-amber-50"></span>Hết chỗ (vào danh sách chờ)</span>
            @if (_isMember)
            {
                <span class="flex items-center gap-1.5"><span class="h-3 w-3 rounded-sm border border-[#B83A3A] bg-[#F3E4E2]"></span>Lớp bạn đã đặt hoặc đang chờ: không đặt lại được</span>
            }
        </div>

        @* Desktop: a week timetable, one row per start time. *@
        <div class="hidden overflow-hidden rounded-xl border border-[#D8D1CD] bg-[#F8F5F2] shadow-sm md:block" aria-live="polite">
            <table class="w-full table-fixed border-collapse text-left text-xs">
                <caption class="sr-only">Thời khóa biểu yoga tuần @_from.ToString("dd/MM") – @_from.AddDays(6).ToString("dd/MM")</caption>
                <thead>
                    <tr class="bg-[#ECE8E4]">
                        <th scope="col" class="w-16 border-b border-[#D8D1CD] px-2 py-3 text-[#6F6966]">Giờ</th>
                        @foreach (var day in Week)
                        {
                            <th scope="col" class="@($"border-b border-l border-[#D8D1CD] px-2 py-3 {(day == _today ? "bg-[#F3E4E2] text-[#B83A3A]" : "text-[#242424]")}")">
                                <span class="block font-['Montserrat'] font-extrabold uppercase">@DayName(day)</span>
                                <span class="font-normal text-[#6F6966]">@day.ToString("dd/MM")</span>
                            </th>
                        }
                    </tr>
                </thead>
                <tbody>
                    @foreach (var slot in _sessions.Select(x => x.StartTime).Distinct().Order())
                    {
                        <tr>
                            <th scope="row" class="border-t border-[#D8D1CD] px-2 py-3 align-top font-semibold text-[#242424]">@slot.ToString("HH:mm")</th>
                            @foreach (var day in Week)
                            {
                                <td class="@($"border-l border-t border-[#D8D1CD] p-1.5 align-top {(day == _today ? "bg-[#F3E4E2]/40" : "")}")">
                                    @foreach (var x in _sessions.Where(x => x.ScheduledDate == day && x.StartTime == slot))
                                    {
                                        @SessionCard(x)
                                    }
                                </td>
                            }
                        </tr>
                    }
                    @if (_sessions.Count == 0)
                    {
                        <tr>
                            <th scope="row" class="border-t border-[#D8D1CD] px-2 py-3 align-top font-semibold text-[#8C8581]">–</th>
                            @foreach (var day in Week)
                            {
                                <td class="@($"h-24 border-l border-t border-[#D8D1CD] {(day == _today ? "bg-[#F3E4E2]/40" : "")}")"></td>
                            }
                        </tr>
                    }
                </tbody>
            </table>
        </div>

        @* Phones: the same sessions, one day after another. *@
        <div class="space-y-4 md:hidden">
            @foreach (var day in Week)
            {
                var daySessions = _sessions.Where(x => x.ScheduledDate == day).ToList();
                <section>
                    <h2 class="@($"mb-2 font-['Montserrat'] text-xs font-extrabold uppercase tracking-wider {(day == _today ? "text-[#B83A3A]" : "text-[#242424]")}")">@DayName(day) @day.ToString("dd/MM")</h2>
                    <div class="space-y-2">
                        @foreach (var x in daySessions) { @SessionCard(x) }
                        @if (daySessions.Count == 0)
                        {
                            <p class="rounded-lg border border-dashed border-[#D8D1CD] px-3 py-2 text-xs text-[#8C8581]">Không có buổi học</p>
                        }
                    </div>
                </section>
            }
        </div>
    }
</div>

@* UC-38 Book Yoga Class & Reserve Mat. Booking is per class: one booking holds the mat for every session of the class. *@
@if (_booking is { } b)
{
    <div class="fixed inset-0 z-50 flex items-center justify-center bg-[#252323]/50 p-4" role="dialog" aria-modal="true" aria-labelledby="book-title" @onkeydown="CloseOnEscape">
        <div class="@Ui.Card w-full max-w-lg space-y-4">
            <div>
                <p class="text-[10px] font-bold tracking-[.18em] text-[#B83A3A]">@(b.FreeSeats > 0 ? "ĐẶT CHỖ" : "DANH SÁCH CHỜ")</p>
                <h2 id="book-title" class="font-['Montserrat'] text-xl font-extrabold text-[#242424]">@b.ClassName</h2>
                <p class="mt-1 text-xs text-[#6F6966]">@b.TypeName · @b.StudioName (tầng @b.FloorNumber) · @b.InstructorName</p>
            </div>
            <p class="rounded-lg border border-[#D8D1CD] bg-[#ECE8E4] px-3 py-2 text-xs text-[#242424]">Một lần đặt chỗ giữ thảm của bạn cho <b>mọi buổi</b> của lớp này. Hủy trong vòng 2 giờ trước buổi học sẽ tính là vắng mặt.</p>

            @if (_bookingResult is { } result)
            {
                <StatusMessage Notice="@result" />
                <div class="flex justify-end gap-2">
                    <a href="/yoga/my-bookings" class="@Ui.PrimaryButton">Lịch yoga của tôi</a>
                    <button type="button" class="@Ui.Button" @onclick="CloseBooking">Đóng</button>
                </div>
            }
            else
            {
                @if (b.FreeSeats > 0)
                {
                    <fieldset>
                        <legend class="@Ui.Label">Chọn thảm (không bắt buộc)</legend>
                        @if (_mats is null)
                        {
                            <p class="mt-2 text-xs text-[#6F6966]">Đang tải sơ đồ thảm…</p>
                        }
                        else
                        {
                            <div class="mt-2 grid grid-cols-6 gap-2 sm:grid-cols-8">
                                @for (var n = 1; n <= _mats.MatCount; n++)
                                {
                                    var mat = n;
                                    var taken = _mats.TakenMats.Contains(mat);
                                    <button type="button" disabled="@taken" aria-pressed="@(_mat == mat)" aria-label="@($"Thảm {mat}{(taken ? ", đã có người" : "")}")"
                                            class="@MatClass(taken, _mat == mat)" @onclick="() => _mat = _mat == mat ? null : mat">@mat</button>
                                }
                            </div>
                            <p class="mt-2 text-xs text-[#6F6966]">@(_mat is { } chosen ? $"Đã chọn thảm {chosen}." : "Không chọn: hệ thống giữ thảm trống có số nhỏ nhất.")</p>
                        }
                    </fieldset>
                }
                else
                {
                    <p class="text-sm text-[#242424]">Lớp đã đủ chỗ. Bạn sẽ được vào danh sách chờ miễn phí và được báo khi có chỗ trống.</p>
                }
                <StatusMessage Error="@_bookingError" />
                <div class="flex justify-end gap-2">
                    <button type="button" class="@Ui.Button" @onclick="CloseBooking">Hủy</button>
                    <button type="button" class="@Ui.PrimaryButton disabled:opacity-50" disabled="@_bookingBusy" @onclick="ConfirmBooking">
                        @(_bookingBusy ? "Đang gửi…" : b.FreeSeats > 0 ? "Xác nhận đặt chỗ" : "Vào danh sách chờ")
                    </button>
                </div>
            }
        </div>
    </div>
}

@code {
    private YogaSessionResponse? _booking;
    private YogaMatMapResponse? _mats;
    private int? _mat;
    private string? _bookingResult, _bookingError;
    private bool _bookingBusy;

    private async Task OpenBooking(YogaSessionResponse session)
    {
        _booking = session;
        _mats = null;
        _mat = null;
        _bookingResult = _bookingError = null;
        if (session.FreeSeats == 0) return;
        try { _mats = await Api.GetAsync<YogaMatMapResponse>($"api/yoga/bookings/classes/{session.YogaClassId}/mats"); }
        catch (ApiException ex) { _bookingError = ex.Message; }
    }

    private async Task ConfirmBooking()
    {
        if (_booking is null || _bookingBusy) return;
        _bookingBusy = true;
        _bookingError = null;
        try
        {
            var r = await Api.PostAsync<YogaBookingResponse>("api/yoga/bookings", new YogaBookingRequest(_booking.YogaClassId, _mat));
            _bookingResult = r.Status == "Waitlisted"
                ? $"Bạn đang ở vị trí {r.WaitlistPosition} trong danh sách chờ của lớp {r.ClassName}."
                : $"Đã đặt chỗ lớp {r.ClassName}{(r.MatNumber is { } mat ? $", thảm {mat}" : "")}.";
            await Task.WhenAll(Load(), LoadMine());
        }
        catch (ApiException ex) { _bookingError = BookingError(ex); }
        finally { _bookingBusy = false; }
    }

    private static string BookingError(ApiException ex) => ex.ErrorCode switch
    {
        "MEMBERSHIP_REQUIRED" => "Bạn cần gói hội viên còn hiệu lực có bao gồm yoga để đặt lớp này.",
        "YOGA_BOOKING_SUSPENDED" => "Bạn tạm thời bị khóa đặt yoga vì vắng 3 buổi trong 30 ngày.",
        "ALREADY_BOOKED" => "Bạn đã đặt lớp này rồi. Mỗi lớp chỉ giữ một chỗ cho bạn.",
        "ALREADY_WAITLISTED" => "Bạn đã ở trong danh sách chờ của lớp này.",
        "MAT_TAKEN" => "Thảm này vừa có người đặt. Hãy chọn thảm khác.",
        "REGISTRATION_CLOSED" => "Lớp này đã đóng đăng ký.",
        _ => ex.Message
    };

    private static string MatClass(bool taken, bool selected) =>
        "h-9 rounded-lg border text-xs font-semibold transition " + (taken
            ? "cursor-not-allowed border-[#D8D1CD] bg-[#ECE8E4] text-[#8C8581] line-through"
            : selected ? "border-[#B83A3A] bg-[#B83A3A] text-white" : "border-[#C9C0BB] bg-[#F8F5F2] text-[#242424] hover:bg-[#F3E4E2]");

    private void CloseBooking() => _booking = null;

    private void CloseOnEscape(KeyboardEventArgs e)
    {
        if (e.Key == "Escape") _booking = null;
    }
}

@code {
    [CascadingParameter] private Task<AuthenticationState>? AuthState { get; set; }

    // The member's own classes, by class id. A booking is per class (GBR-79), so every session of a booked class is taken.
    private Dictionary<int, MyYogaBookingResponse> _booked = [];
    private Dictionary<int, MyYogaWaitlistResponse> _waiting = [];
    private bool _isMember;

    private (string Status, string Label, bool CanBook, bool Mine) State(YogaSessionResponse s)
    {
        if (_booked.TryGetValue(s.YogaClassId, out var b))
            return ("Confirmed", b.MatNumber is { } mat ? $"Đã đặt · thảm {mat}" : "Đã đặt", false, true);
        if (_waiting.TryGetValue(s.YogaClassId, out var w))
            return w.SeatOffered ? ("Available", "Có chỗ cho bạn", true, true) : ("Waitlisted", $"Đang chờ · #{w.Position}", false, true);
        return s.FreeSeats > 0 ? ("Available", $"Còn {s.FreeSeats} chỗ", true, false) : ("Full", "Hết chỗ", true, false);
    }

    private RenderFragment SessionCard(YogaSessionResponse s)
    {
        var (status, label, canBook, mine) = State(s);
        var tone = (s.YogaClassId == ClassId ? "ring-2 ring-[#B83A3A] ring-offset-1 " : "") + (mine ? "border-[#B83A3A] bg-[#F3E4E2]" : s.FreeSeats > 0 ? "border-[#D8D1CD] bg-white" : "border-amber-200 bg-amber-50");
        return @<article data-yoga-class="@s.YogaClassId" class="@($"mb-1.5 space-y-1.5 rounded-lg border p-2 last:mb-0 {tone}")" aria-label="@($"{s.ClassName}, {DayName(s.ScheduledDate)} {s.StartTime:HH:mm}, {label}")">
            <p class="font-semibold leading-tight text-[#242424]">@s.ClassName</p>
            <p class="text-[11px] leading-snug text-[#6F6966]">@s.StartTime.ToString("HH:mm")–@s.EndTime.ToString("HH:mm") · @VFMS.Client.Components.Memberships.YogaClassCard.LevelName(s.DifficultyLevel)<br />@s.StudioName (tầng @s.FloorNumber) · @s.InstructorName</p>
            <StatusBadge Status="@status" Label="@label" />
            @if (_isMember)
            {
                @if (canBook)
                {
                    <button type="button" class="@($"block w-full rounded-lg px-2 py-1.5 text-xs font-semibold transition {(s.FreeSeats > 0 || mine ? "bg-[#B83A3A] text-white hover:bg-[#9F3030]" : "border border-[#C9C0BB] bg-[#F8F5F2] text-[#242424] hover:bg-[#ECE8E4]")}")" @onclick="() => OpenBooking(s)">
                        @(mine || s.FreeSeats > 0 ? "Đặt chỗ" : "Vào danh sách chờ")
                    </button>
                }
                else
                {
                    <a href="/yoga/my-bookings" class="block text-[11px] font-semibold text-[#B83A3A] underline underline-offset-2">Xem trong lịch của tôi</a>
                }
            }
        </article>;
    }

    private IEnumerable<DateOnly> Week => Enumerable.Range(0, 7).Select(_from.AddDays);

    private static string DayName(DateOnly d) => VFMS.Client.Components.Memberships.YogaClassCard.DayName(d);

    private async Task LoadMine()
    {
        if (!_isMember) return;
        try
        {
            var mine = await Api.GetAsync<MyYogaBookingsResponse>("api/yoga/bookings/mine");
            _booked = mine.Upcoming.GroupBy(b => b.YogaClassId).ToDictionary(g => g.Key, g => g.First());
            _waiting = mine.Waitlist.GroupBy(w => w.YogaClassId).ToDictionary(g => g.Key, g => g.First());
        }
        catch (ApiException) { /* no marks; the API still refuses a second booking (ALREADY_BOOKED). VfmsApiClient logged the call. */ }
    }
}

@code {
    // Set by links from a class card or "my bookings": open the timetable on that class's week and highlight it.
    [SupplyParameterFromQuery(Name = "date")] public string? Date { get; set; }
    [SupplyParameterFromQuery(Name = "classId")] public int? ClassId { get; set; }

    private DateOnly _from, _today;
    private string _difficulty = string.Empty, _instructor = string.Empty;
    private bool _loading = true;
    private string? _error;
    private List<YogaSessionResponse> _sessions = [];
    private List<YogaInstructorResponse> _instructors = [];

    protected override async Task OnInitializedAsync()
    {
        _today = DateOnly.FromDateTime(DateTime.UtcNow.AddHours(7));
        var start = DateOnly.TryParseExact(Date, "yyyy-MM-dd", out var d) ? d : _today;
        _from = start.AddDays(-(((int)start.DayOfWeek + 6) % 7));
        _isMember = AuthState is not null && (await AuthState).User.IsInRole("Member");
        try { _instructors = await Api.GetAsync<List<YogaInstructorResponse>>("api/yoga/instructors"); }
        catch (ApiException) { /* filter stays empty; VfmsApiClient already logged which call failed */ }
        await Task.WhenAll(Load(), LoadMine());
    }

    private bool _scrolled;

    // Bring the linked class into view once, on whichever layout (desktop grid or phone list) is showing.
    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (_scrolled || ClassId is not { } id || _loading || !_sessions.Any(x => x.YogaClassId == id)) return;
        _scrolled = true;
        await JS.InvokeVoidAsync("eval",
            $"[...document.querySelectorAll('[data-yoga-class=\"{id}\"]')].find(e => e.offsetParent)?.scrollIntoView({{ behavior: 'smooth', block: 'center' }})");
    }

    private async Task Move(int days) { _from = _from.AddDays(days); await Load(); }

    private async Task Load()
    {
        _loading = true;
        _error = null;
        try
        {
            var query = $"api/yoga/schedule?from={_from:yyyy-MM-dd}&to={_from.AddDays(6):yyyy-MM-dd}" +
                        (_difficulty.Length > 0 ? $"&difficultyLevel={_difficulty}" : "") +
                        (_instructor.Length > 0 ? $"&instructorUserId={Uri.EscapeDataString(_instructor)}" : "");
            _sessions = await Api.GetAsync<List<YogaSessionResponse>>(query);
        }
        catch (ApiException ex) { _error = ex.Message; }
        finally { _loading = false; }
    }
}
