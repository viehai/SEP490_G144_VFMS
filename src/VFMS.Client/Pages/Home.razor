            </div>
        </div>

        <!-- ========================================================================= -->
        <!-- 1.5. KHÁM PHÁ THIẾT BỊ PHÒNG TẬP (EXPLORE EQUIPMENT)                      -->
        <!-- ========================================================================= -->
        <section id="explore-equipment" class="w-full max-w-[1650px] mx-auto px-4 sm:px-6 lg:px-8 mb-24 relative">
            <!-- Background Watermark STRENGTH Khổng Lồ Mờ Ảo Tinh Tế -->
            <div class="absolute top-0 sm:top-4 lg:top-8 right-0 sm:right-6 select-none pointer-events-none font-heading font-black text-6xl sm:text-8xl md:text-[9.5rem] lg:text-[13rem] text-neutral-100 uppercase tracking-tighter leading-none z-0 overflow-hidden">
                STRENGTH
            </div>

            <!-- Section Header (Tiêu đề THIẾT BỊ PHÒNG TẬP cỡ lớn) -->
            <div class="relative z-10 flex flex-col md:flex-row md:items-end justify-between mb-8 sm:mb-10 pb-6 border-b-2 border-black">
                <div>
                    <div class="flex items-center gap-2 mb-3">
                        <span class="w-2.5 h-2.5 bg-black inline-block"></span>
                        <span class="font-heading text-xs font-bold tracking-widest text-[#7D7D7D] uppercase">
                            VFMS PRO EQUIPMENT
                        </span>
                    </div>
                    <h2 class="font-heading text-4xl sm:text-5xl lg:text-7xl font-black uppercase text-black tracking-tighter leading-[0.95]">
                        THIẾT BỊ <br />
                        PHÒNG TẬP
                    </h2>
                </div>

                <p class="font-body text-xs sm:text-sm text-neutral-600 max-w-sm mt-4 md:mt-0 font-medium leading-relaxed text-left md:text-right">
                    Nhập khẩu tiêu chuẩn Olympic quốc tế, tối ưu từng góc chuyển động giải phẫu cơ bắp và hỗ trợ tải trọng nặng an toàn tuyệt đối.
                </p>
            </div>

            <!-- Bộ Lọc Nhóm Cơ (Muscle Group Category Filter Buttons) -->
            <div class="relative z-10 flex flex-wrap items-center gap-2 sm:gap-3 mb-8 sm:mb-10">
                @foreach (var cat in EquipmentCategories)
                {
                    var isActive = SelectedEquipmentCategory == cat.Key;
                    <button type="button"
                            @onclick="() => SelectEquipmentCategory(cat.Key)"
                            class="font-heading text-xs sm:text-sm font-black uppercase tracking-wider px-4 sm:px-6 py-2.5 sm:py-3 border-2 border-black rounded-none cursor-pointer transition-colors duration-150 @(isActive ? "bg-black text-white" : "bg-white text-black hover:bg-black hover:text-white")">
                        @cat.Label
                    </button>
                }
            </div>

            <!-- Lưới Thiết Bị (Giới hạn tối đa 8 item = 4 cột x 2 hàng, không bị thừa ô trống) -->
            <div class="relative z-10">
                <div id="equipment-grid" class="grid grid-cols-2 md:grid-cols-3 lg:grid-cols-4 gap-4 sm:gap-6">
                    @for (int i = 0; i < DisplayedEquipments.Count; i++)
                    {
                        var item = DisplayedEquipments[i];
                        var delay = (i % 4) * 120;
                        <div style="transition-delay: @(delay)ms;"
                             class="equipment-reveal brutal-equipment-card relative aspect-square bg-[#FAFAFA] border-2 border-black overflow-hidden group select-none flex items-center justify-center p-6 sm:p-8 cursor-default">
                            
                            <!-- Bức ảnh máy tập: Đen trắng mặc định, hover mất filter grayscale và nảy kích thước -->
                            <img src="@item.ImageUrl"
                                 alt="@item.Name"
                                 loading="lazy"
                                 class="w-full h-full object-contain grayscale contrast-115 group-hover:grayscale-0 group-hover:scale-110 transition-all duration-300 ease-out pointer-events-none" />

                            <!-- Nhãn Tên Máy Tập: Nền đen đặc (tuyệt đối không dùng opacity), chữ trắng, trượt từ dưới lên -->
                            <div class="absolute bottom-0 inset-x-0 bg-[#0A0A0A] text-white px-3.5 py-3 border-t-2 border-black translate-y-full group-hover:translate-y-0 transition-transform duration-200 ease-out z-20 pointer-events-none">
                                <span class="font-heading text-[10px] sm:text-[11px] font-bold text-neutral-400 uppercase tracking-wider block">
                                    @item.MuscleGroup
                                </span>
                                <h4 class="font-heading font-black text-xs sm:text-sm uppercase tracking-tight text-white truncate">
                                    @item.Name
                                </h4>
                            </div>
                        </div>
                    }
                </div>
            </div>

            <!-- Nút Xem Tất Cả (View All Button Căn Giữa) -->
            <div class="relative z-10 mt-12 sm:mt-16 flex justify-center">
                <button type="button"
                        @onclick="ViewAllEquipments"
                        class="font-heading font-black text-xs sm:text-sm uppercase tracking-widest px-8 sm:px-12 py-4 bg-white text-black border-2 border-black rounded-none inline-flex items-center gap-3 transition-all duration-200 hover:-translate-y-1 hover:shadow-[6px_6px_0px_0px_rgba(0,0,0,1)] active:translate-y-0 active:shadow-none cursor-pointer">
                    <span>XEM TẤT CẢ THIẾT BỊ</span>
                    <svg class="w-4 h-4 stroke-[3]" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="square" stroke-linejoin="miter" d="M14 5l7 7m0 0l-7 7m7-7H3"></path>
                    </svg>
                </button>
            </div>
        </section>

        <!-- Section Container khổ lớn đạt chuẩn tỷ lệ ảnh tham chiếu -->
        <div class="w-full max-w-[1650px] mx-auto px-4 sm:px-6 lg:px-8">
            
            <!-- ================================================================= -->
            <!-- B. SECTION HEADER (Tiêu đề chữ đen xếp 2 tầng trên nền trắng)      -->
            <!-- ================================================================= -->
            <div class="flex flex-col md:flex-row md:items-end justify-between mb-12 pb-6 border-b border-[#CFCFCF]">
                <div>
                    <div class="flex items-center gap-2 mb-3">
                        <span class="w-2.5 h-2.5 bg-[#0A0A0A] inline-block"></span>
                        <span class="font-heading text-xs font-bold tracking-widest text-[#7D7D7D] uppercase">
                            VFMS SIGNATURE CURRICULUM
                        </span>
                    </div>
                    <h2 class="font-heading text-4xl sm:text-5xl lg:text-7xl font-black uppercase text-[#252525] tracking-tighter leading-[0.95]">
                        CÁC LỚP HỌC <br />
                        NỔI BẬT
                    </h2>
                </div>
                
                <p class="font-body text-xs sm:text-sm text-[#7D7D7D] max-w-sm mt-4 md:mt-0 font-normal leading-relaxed text-left md:text-right">
                    Được thiết kế dựa trên giáo trình thể lực cường độ cao, tối ưu hóa tăng cơ, đốt mỡ và tái tạo năng lượng thể chất toàn diện.
                </p>
            </div>

            <!-- ================================================================= -->
            <!-- C. LƯỚI 4 BỨC ẢNH KHỔ LỚN (HOÀN TOÀN TRỐNG TRƠN, KHÔNG CHỮ, KHÔNG CLICK) -->
            <!-- ================================================================= -->
            <div class="w-full overflow-hidden">
                <div id="classes-grid" class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-2 md:gap-3">
                    @for (int i = 0; i < FeaturedClasses.Count; i++)
                    {
                        var item = FeaturedClasses[i];
                        var delayStyle = $"transition-delay: {i * 250}ms;";

                        <!-- Cột ảnh: Chiều cao chuẩn 68vh (min 520px), vuông vức, chỉ hiển thị ảnh, không click -->
                        <div style="@delayStyle"
                             class="slide-reveal-right group relative w-full h-[68vh] min-h-[520px] max-h-[750px] overflow-hidden bg-neutral-900 border border-neutral-300 hover:border-black rounded-none select-none transition-all duration-300">
                            
                            <!-- Bức ảnh chụp cận cảnh sắc nét, Grayscale tương phản cao, HOÀN TOÀN TRỐNG TRƠN -->
                            <img src="@item.ImageUrl"
                                 alt="@item.Title"
                                 class="w-full h-full object-cover object-center grayscale contrast-125 brightness-95 group-hover:grayscale-0 group-hover:scale-105 group-hover:brightness-105 transition-all duration-700 ease-out rounded-none pointer-events-none" />

                            <!-- Viền sắc nét khi hover -->
                            <div class="absolute inset-0 border-2 border-transparent group-hover:border-black transition-colors z-10 pointer-events-none"></div>

                        </div>
                    }
                </div>
            </div>

            <!-- Bottom Information Banner (Nền xám sáng, viền mỏng) -->
            <div class="mt-16 p-8 bg-[#F7F7F7] border border-[#CFCFCF] flex flex-col md:flex-row items-center justify-between gap-6">
                <div>
                    <h4 class="font-heading text-lg font-extrabold text-[#252525] uppercase tracking-wide">
                        CHƯA CHỌN ĐƯỢC LỘ TRÌNH PHÙ HỢP?
                    </h4>
                    <p class="font-body text-sm text-[#7D7D7D] mt-1">
                        Hãy để đội ngũ chuyên gia VFMS kiểm tra thể trạng và thiết kế giáo án tập luyện chuyên biệt cho bạn.
                    </p>
                </div>
                <a href="#featured-classes"
                   class="brutal-btn bg-[#0A0A0A] text-white hover:bg-neutral-800 border border-black px-8 py-3.5 font-heading font-bold text-xs uppercase tracking-widest transition-colors duration-200 whitespace-nowrap rounded-none inline-block">
                    ĐẶT LỊCH TƯ VẤN MIỄN PHÍ
                </a>
            </div>

        </div>

    </section>

    <!-- ========================================================================= -->
    <!-- 3. PRICING & MEMBERSHIPS SECTION (Gói Thẻ & Lịch Tập)                     -->
    <!-- ========================================================================= -->
    <section id="pricing-memberships" class="w-full bg-[#FFFFFF] text-[#252525] py-24 border-b border-[#CFCFCF]">
        <div class="w-full max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
            
            <!-- Section Header -->
            <div class="flex flex-col md:flex-row md:items-end justify-between mb-12 pb-6 border-b border-[#CFCFCF]">
                <div>
                    <div class="flex items-center gap-2 mb-3">
                        <span class="w-2.5 h-2.5 bg-[#0A0A0A] inline-block"></span>
                        <span class="font-heading text-xs font-bold tracking-widest text-[#7D7D7D] uppercase">
                            VFMS PRICING &amp; MEMBERSHIP TIERS
                        </span>
                    </div>
                    <h2 class="font-heading text-4xl sm:text-5xl lg:text-6xl font-black uppercase text-[#252525] tracking-tight">
                        GÓI THẺ &amp; LỊCH TẬP
                    </h2>
                </div>
                <p class="font-body text-xs sm:text-sm text-[#7D7D7D] max-w-md mt-4 md:mt-0 font-normal leading-relaxed">
                    Minh bạch tuyệt đối, tự động bảo lưu trực tuyến theo quy chế và công khai lịch biểu huấn luyện cố định.
                </p>
            </div>

            <!-- 3 Tabs Navigation Buttons -->
            <div class="flex flex-wrap gap-3 mb-12">
                <button @onclick='() => ActivePricingTab = "GYM"'
                        class="px-6 sm:px-8 py-3.5 font-heading font-black text-xs sm:text-sm uppercase tracking-wider border-2 border-black transition-all cursor-pointer rounded-none @(ActivePricingTab == "GYM" ? "bg-black text-white shadow-[4px_4px_0px_0px_#000000]" : "bg-white text-black hover:bg-neutral-100")">
                    GYM MEMBERSHIP
