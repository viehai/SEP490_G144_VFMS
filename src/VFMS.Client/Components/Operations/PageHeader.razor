<header class="flex flex-wrap items-end justify-between gap-4 border-b border-vfms-border pb-6">
    <div>
        <p class="mb-2 text-xs font-bold uppercase tracking-wider text-vfms-primary">@Overline</p>
        <h1 class="font-heading text-3xl font-extrabold tracking-tight text-vfms-text sm:text-4xl">@Title<span class="text-vfms-primary">.</span></h1>
        <p class="mt-2 text-sm text-vfms-text-secondary">@Description</p>
    </div>
    @ChildContent
</header>

@code {
    [Parameter] public string Overline { get; set; } = "";
    [Parameter] public string Title { get; set; } = "";
    [Parameter] public string Description { get; set; } = "";
    [Parameter] public RenderFragment? ChildContent { get; set; }
}
