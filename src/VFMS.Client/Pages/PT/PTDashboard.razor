@page "/pt/dashboard"
@layout StaffPTLayout
@using VFMS.Client.Components.Dashboards
@using VFMS.Contracts.Dashboards
@attribute [Authorize(Roles = "PT")]

<PageTitle>Tổng quan huấn luyện | Victor Fitness</PageTitle>
<DashboardView T="TrainerOverview" Path="api/dashboards/pt" Title="Tổng quan huấn luyện" Description="Theo dõi lịch giảng dạy và tiến độ huấn luyện hội viên.">
    <ChildContent Context="data">
        <div class="dash-stats">
            <DashboardStat Icon="people" Label="Hội viên đang phụ trách" Value="@data.Members.ToString()" />
            <DashboardStat Icon="training" Label="Buổi PT hôm nay" Value="@data.PTCount.ToString()" />
            <DashboardStat Icon="yoga" Label="Lớp Yoga hôm nay" Value="@data.YogaCount.ToString()" />
            <DashboardStat Icon="calendar" Label="Buổi PT sắp tới" Value="@data.Upcoming.ToString()" />
        </div>
        <div class="dash-grid">
            <section class="dash-panel"><header><h2><DashboardIcon Name="calendar" />Lịch huấn luyện hôm nay</h2><a href="/pt/teaching-schedule">Xem lịch PT →</a></header>
                <DashboardSchedule Rows="data.Schedule" /></section>
            <section class="dash-panel"><header><h2><DashboardIcon Name="chart" />Tiến độ hội viên</h2><a href="/pt/assigned-members">Xem tất cả →</a></header>
                @if (data.Progress.Count == 0) { <p class="dash-message">Bạn chưa có hội viên được phân công.</p> }
                else { <ul class="dash-progress">@foreach (var row in data.Progress) {
                    var used = Math.Clamp(row.Total - row.Remaining, 0, Math.Max(0, row.Total));
                    var percent = row.Total > 0 ? (int)Math.Round(100d * used / row.Total) : 0;
                    <li><span class="dash-avatar" aria-hidden="true">@Initials(row.Member)</span>
                        <a href="@($"/pt/assigned-members/{row.ContractId}")"><strong>@row.Member</strong><small>@row.Package</small></a>
                        <div><span>@used / @row.Total buổi <b>@percent%</b></span><progress value="@used" max="@Math.Max(1,row.Total)" aria-label="@($"Tiến độ của {row.Member}")">@percent%</progress></div></li>
                }</ul> }
            </section>
            <section id="quick-actions" class="dash-panel dash-wide"><header><h2>Truy cập nhanh</h2></header><div class="dash-actions dash-actions-pt">
                <AuthorizeView Roles="YogaInstructor"><DashboardLink Href="/pt/yoga" Icon="yoga">Điểm danh lớp Yoga</DashboardLink></AuthorizeView>
                <DashboardLink Href="/pt/teaching-schedule" Icon="training">Lịch huấn luyện PT</DashboardLink>
                <DashboardLink Href="/pt/assigned-members" Icon="chart">Tiến độ hội viên</DashboardLink>
                <DashboardLink Href="/pt/availability" Icon="calendar">Thiết lập lịch nhận học viên</DashboardLink>
            </div></section>
        </div>
    </ChildContent>
</DashboardView>
@code {
    private static string Initials(string name) => string.Concat(name.Split(' ', StringSplitOptions.RemoveEmptyEntries)
        .TakeLast(2).Select(word => char.ToUpperInvariant(word[0])));
}
