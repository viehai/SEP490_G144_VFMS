                   class="brutal-btn w-full sm:w-auto bg-transparent text-white hover:bg-white hover:text-black border-2 border-white/80 px-10 py-4 font-heading font-extrabold text-sm tracking-wider uppercase transition-colors duration-200 text-center inline-block">
                    ĐĂNG KÝ HỘI VIÊN NGAY
                </a>
            </div>

            <!-- Stats Bar (Brutal Minimalist metrics) -->
            <div class="grid grid-cols-3 gap-6 sm:gap-12 mt-16 pt-8 border-t border-white/20 w-full max-w-2xl">
                <div>
                    <div class="font-heading text-2xl sm:text-3xl font-extrabold text-white">100%</div>
                    <div class="font-body text-xs text-neutral-400 uppercase tracking-wider mt-1">Chuẩn Thiết Bị Olympic</div>
                </div>
                <div>
                    <div class="font-heading text-2xl sm:text-3xl font-extrabold text-white">24/7</div>
                    <div class="font-body text-xs text-neutral-400 uppercase tracking-wider mt-1">Check-in FaceID &amp; QR</div>
                </div>
                <div>
