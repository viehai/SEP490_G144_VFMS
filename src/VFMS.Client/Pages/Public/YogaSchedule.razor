@page "/yoga/schedule"
@layout PublicLayout
@using VFMS.Client.Components.Operations
@using VFMS.Contracts.Yoga
@inject VfmsApiClient Api

<PageTitle>Lịch Yoga | Victor Fitness</PageTitle>

<div class="mx-auto max-w-6xl space-y-8 px-4 py-28 font-['Inter',sans-serif] text-[#242424] sm:px-6">
    <header class="border-b border-[#D8D1CD] pb-7">
        <p class="mb-3 text-[10px] font-bold tracking-[.18em] text-[#B83A3A]">VICTOR FITNESS / YOGA</p>
        <h1 class="font-['Montserrat'] text-3xl font-extrabold uppercase tracking-tight text-[#242424] sm:text-4xl">Thời khóa biểu Yoga<span class="text-[#B83A3A]">.</span></h1>
        <p class="mt-3 max-w-2xl text-sm leading-6 text-[#6F6966]">Lịch các buổi yoga đã công bố và số chỗ còn trống.</p>
    </header>

    <section class="flex flex-wrap items-end gap-3" aria-label="Bộ lọc">
        <button type="button" class="border border-[#D8D1CD] bg-[#F8F5F2] hover:bg-[#ECE8E4] px-4 py-2 text-xs font-bold uppercase rounded-lg text-[#242424] transition-colors" @onclick="() => Move(-7)" aria-label="Tuần trước">←</button>
        <p class="min-w-48 text-sm font-semibold text-[#242424]">@_from.ToString("dd/MM/yyyy") – @_from.AddDays(6).ToString("dd/MM/yyyy")</p>
        <button type="button" class="border border-[#D8D1CD] bg-[#F8F5F2] hover:bg-[#ECE8E4] px-4 py-2 text-xs font-bold uppercase rounded-lg text-[#242424] transition-colors" @onclick="() => Move(7)" aria-label="Tuần sau">→</button>
        <label class="text-xs font-semibold text-[#242424]">Độ khó
            <select class="ml-2 border border-[#D8D1CD] bg-[#F8F5F2] px-3 py-2 text-sm rounded-lg text-[#242424] focus:border-[#B83A3A] outline-none" @bind="_difficulty" @bind:after="Load">
                <option value="">Tất cả</option><option>Beginner</option><option>Intermediate</option><option>Advanced</option>
            </select>
        </label>
        <label class="text-xs font-semibold text-[#242424]">Huấn luyện viên
            <select class="ml-2 border border-[#D8D1CD] bg-[#F8F5F2] px-3 py-2 text-sm rounded-lg text-[#242424] focus:border-[#B83A3A] outline-none" @bind="_instructor" @bind:after="Load">
                <option value="">Tất cả</option>
                @foreach (var i in _instructors) { <option value="@i.UserId">@i.FullName</option> }
            </select>
        </label>
    </section>

    @if (_error is not null)
    {
        <p role="alert" class="border border-red-200 bg-red-50 px-4 py-3 text-sm text-[#DC2626] rounded-xl">@_error</p>
    }
    else if (_loading)
    {
        <p class="text-sm text-[#6F6966]">Đang tải…</p>
    }
    else if (_sessions.Count == 0)
    {
        <p class="border border-[#D8D1CD] bg-[#F8F5F2] px-5 py-6 text-sm rounded-xl text-[#6F6966]">Không tìm thấy buổi học phù hợp.</p>
    }
    else
    {
        <div class="grid gap-4 md:grid-cols-2 lg:grid-cols-3" aria-live="polite">
            @foreach (var day in _sessions.GroupBy(s => s.ScheduledDate))
            {
                <section class="border border-[#D8D1CD] bg-[#F8F5F2] rounded-xl overflow-hidden shadow-sm">
                    <h2 class="border-b border-[#D8D1CD] bg-[#ECE8E4] px-4 py-3 font-['Montserrat'] text-xs font-extrabold uppercase tracking-wider text-[#242424]">@day.Key.ToString("dddd dd/MM")</h2>
                    <ul class="divide-y divide-[#D8D1CD]">
                        @foreach (var s in day)
                        {
                            <li class="px-4 py-4 hover:bg-[#F3EDEA] transition-colors">
                                <div class="flex items-start justify-between gap-3">
                                    <div>
                                        <p class="font-semibold text-[#242424]">@s.ClassName</p>
                                        <p class="text-xs text-[#6F6966]">@s.StartTime.ToString("HH:mm")–@s.EndTime.ToString("HH:mm") · @s.TypeName · @s.DifficultyLevel</p>
                                        <p class="text-xs text-[#6F6966]">@s.StudioName (tầng @s.FloorNumber) · @s.InstructorName</p>
                                    </div>
                                    @if (s.FreeSeats > 0)
                                    {
                                        <StatusBadge Status="Available" Label="@($"Còn {s.FreeSeats} chỗ")" />
                                    }
                                    else
                                    {
                                        <StatusBadge Status="Full" Label="Hết chỗ · Waitlist" />
                                    }
                                </div>
                                <AuthorizeView Roles="Member">
                                    <button type="button" class="mt-3 @(s.FreeSeats > 0 ? Ui.PrimaryButton : Ui.Button)" @onclick="() => OpenBooking(s)">
                                        @(s.FreeSeats > 0 ? "Đặt chỗ" : "Vào danh sách chờ (miễn phí)")
                                    </button>
                                </AuthorizeView>
                            </li>
                        }
                    </ul>
                </section>
            }
        </div>
    }
</div>

@* UC-38 Book Yoga Class & Reserve Mat. Booking is per class: one booking holds the mat for every session of the class. *@
@if (_booking is { } b)
{
    <div class="fixed inset-0 z-50 flex items-center justify-center bg-[#252323]/50 p-4" role="dialog" aria-modal="true" aria-labelledby="book-title" @onkeydown="CloseOnEscape">
        <div class="@Ui.Card w-full max-w-lg space-y-4">
            <div>
                <p class="text-[10px] font-bold tracking-[.18em] text-[#B83A3A]">@(b.FreeSeats > 0 ? "ĐẶT CHỖ" : "DANH SÁCH CHỜ")</p>
                <h2 id="book-title" class="font-['Montserrat'] text-xl font-extrabold text-[#242424]">@b.ClassName</h2>
                <p class="mt-1 text-xs text-[#6F6966]">@b.TypeName · @b.StudioName (tầng @b.FloorNumber) · @b.InstructorName</p>
            </div>
            <p class="rounded-lg border border-[#D8D1CD] bg-[#ECE8E4] px-3 py-2 text-xs text-[#242424]">Một lần đặt chỗ giữ thảm của bạn cho <b>mọi buổi</b> của lớp này. Hủy trong vòng 2 giờ trước buổi học sẽ tính là vắng mặt.</p>

            @if (_bookingResult is { } result)
            {
                <p role="status" class="@Ui.Notice">@result</p>
                <div class="flex justify-end gap-2">
                    <a href="/yoga/my-bookings" class="@Ui.PrimaryButton">Lịch yoga của tôi</a>
                    <button type="button" class="@Ui.Button" @onclick="CloseBooking">Đóng</button>
                </div>
            }
            else
            {
                @if (b.FreeSeats > 0)
                {
                    <fieldset>
                        <legend class="@Ui.Label">Chọn thảm (không bắt buộc)</legend>
                        @if (_mats is null)
                        {
                            <p class="mt-2 text-xs text-[#6F6966]">Đang tải sơ đồ thảm…</p>
                        }
                        else
                        {
                            <div class="mt-2 grid grid-cols-6 gap-2 sm:grid-cols-8">
                                @for (var n = 1; n <= _mats.MatCount; n++)
                                {
                                    var mat = n;
                                    var taken = _mats.TakenMats.Contains(mat);
                                    <button type="button" disabled="@taken" aria-pressed="@(_mat == mat)" aria-label="@($"Thảm {mat}{(taken ? ", đã có người" : "")}")"
                                            class="@MatClass(taken, _mat == mat)" @onclick="() => _mat = _mat == mat ? null : mat">@mat</button>
                                }
                            </div>
                            <p class="mt-2 text-xs text-[#6F6966]">@(_mat is { } chosen ? $"Đã chọn thảm {chosen}." : "Không chọn: hệ thống giữ thảm trống có số nhỏ nhất.")</p>
                        }
                    </fieldset>
                }
                else
                {
                    <p class="text-sm text-[#242424]">Lớp đã đủ chỗ. Bạn sẽ được vào danh sách chờ miễn phí và được báo khi có chỗ trống.</p>
                }
                <Alerts Error="@_bookingError" />
                <div class="flex justify-end gap-2">
                    <button type="button" class="@Ui.Button" @onclick="CloseBooking">Hủy</button>
                    <button type="button" class="@Ui.PrimaryButton disabled:opacity-50" disabled="@_bookingBusy" @onclick="ConfirmBooking">
                        @(_bookingBusy ? "Đang gửi…" : b.FreeSeats > 0 ? "Xác nhận đặt chỗ" : "Vào danh sách chờ")
                    </button>
                </div>
            }
        </div>
    </div>
}

@code {
    private YogaSessionResponse? _booking;
    private YogaMatMapResponse? _mats;
    private int? _mat;
    private string? _bookingResult, _bookingError;
    private bool _bookingBusy;

    private async Task OpenBooking(YogaSessionResponse session)
    {
        _booking = session;
        _mats = null;
        _mat = null;
        _bookingResult = _bookingError = null;
        if (session.FreeSeats == 0) return;
        try { _mats = await Api.GetAsync<YogaMatMapResponse>($"api/yoga/bookings/classes/{session.YogaClassId}/mats"); }
        catch (ApiException ex) { _bookingError = ex.Message; }
    }

    private async Task ConfirmBooking()
    {
        if (_booking is null || _bookingBusy) return;
        _bookingBusy = true;
        _bookingError = null;
        try
        {
            var r = await Api.PostAsync<YogaBookingResponse>("api/yoga/bookings", new YogaBookingRequest(_booking.YogaClassId, _mat));
            _bookingResult = r.Status == "Waitlisted"
                ? $"Bạn đang ở vị trí {r.WaitlistPosition} trong danh sách chờ của lớp {r.ClassName}."
                : $"Đã đặt chỗ lớp {r.ClassName}{(r.MatNumber is { } mat ? $", thảm {mat}" : "")}.";
            await Load();
        }
        catch (ApiException ex) { _bookingError = BookingError(ex); }
        finally { _bookingBusy = false; }
    }

    private static string BookingError(ApiException ex) => ex.ErrorCode switch
    {
        "MEMBERSHIP_REQUIRED" => "Bạn cần gói hội viên còn hiệu lực có bao gồm yoga để đặt lớp này.",
        "YOGA_BOOKING_SUSPENDED" => "Bạn tạm thời bị khóa đặt yoga vì vắng 3 buổi trong 30 ngày.",
        "ALREADY_BOOKED" => "Bạn đã có lớp hoặc buổi tập khác trùng khung giờ này.",
        "ALREADY_WAITLISTED" => "Bạn đã ở trong danh sách chờ của lớp này.",
        "MAT_TAKEN" => "Thảm này vừa có người đặt. Hãy chọn thảm khác.",
        "REGISTRATION_CLOSED" => "Lớp này đã đóng đăng ký.",
        _ => ex.Message
    };

    private static string MatClass(bool taken, bool selected) =>
        "h-9 rounded-lg border text-xs font-semibold transition " + (taken
            ? "cursor-not-allowed border-[#D8D1CD] bg-[#ECE8E4] text-[#8C8581] line-through"
            : selected ? "border-[#B83A3A] bg-[#B83A3A] text-white" : "border-[#C9C0BB] bg-[#F8F5F2] text-[#242424] hover:bg-[#F3E4E2]");

    private void CloseBooking() => _booking = null;

    private void CloseOnEscape(KeyboardEventArgs e)
    {
        if (e.Key == "Escape") _booking = null;
    }
}

@code {
    private DateOnly _from;
    private string _difficulty = string.Empty, _instructor = string.Empty;
    private bool _loading = true;
    private string? _error;
    private List<YogaSessionResponse> _sessions = [];
    private List<YogaInstructorResponse> _instructors = [];

    protected override async Task OnInitializedAsync()
    {
        var today = DateOnly.FromDateTime(DateTime.UtcNow.AddHours(7));
        _from = today.AddDays(-(((int)today.DayOfWeek + 6) % 7));
        try { _instructors = await Api.GetAsync<List<YogaInstructorResponse>>("api/yoga/instructors"); }
        catch (ApiException) { /* filter stays empty; VfmsApiClient already logged which call failed */ }
        await Load();
    }

    private async Task Move(int days) { _from = _from.AddDays(days); await Load(); }

    private async Task Load()
    {
        _loading = true;
        _error = null;
        try
        {
            var query = $"api/yoga/schedule?from={_from:yyyy-MM-dd}&to={_from.AddDays(6):yyyy-MM-dd}" +
                        (_difficulty.Length > 0 ? $"&difficultyLevel={_difficulty}" : "") +
                        (_instructor.Length > 0 ? $"&instructorUserId={Uri.EscapeDataString(_instructor)}" : "");
            _sessions = await Api.GetAsync<List<YogaSessionResponse>>(query);
        }
        catch (ApiException ex) { _error = ex.Message; }
        finally { _loading = false; }
    }
}
