    private async Task SelectEquipmentCategory(string categoryKey)
    {
        SelectedEquipmentCategory = categoryKey;
        StateHasChanged();
        await Task.Delay(40);
        try
        {
            await JS.InvokeVoidAsync("eval", @"
                (function() {
                    const items = document.querySelectorAll('.equipment-reveal:not(.revealed)');
                    items.forEach((el, idx) => {
                        setTimeout(() => el.classList.add('revealed'), idx * 70);
                    });
                })();
            ");
        }
        catch { }
    }

    private async Task ViewAllEquipments()
    {
        await SelectEquipmentCategory("ALL");
    }

    // =========================================================================
    // SCROLL REVEAL BẰNG INTERSECTION OBSERVER API TRONG BLAZOR
    // =========================================================================
    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            await JS.InvokeVoidAsync("eval", @"
                (function() {
                    const setupObserver = (selector, threshold = 0.15) => {
                        const items = document.querySelectorAll(selector);
                        if (!items.length) return;

                        const observer = new IntersectionObserver((entries, obs) => {
                            entries.forEach(entry => {
                                if (entry.isIntersecting) {
                                    entry.target.classList.add('revealed');
                                    obs.unobserve(entry.target);
                                }
                            });
                        }, { root: null, rootMargin: '0px 0px -40px 0px', threshold });

                        items.forEach(el => observer.observe(el));
                    };

                    setupObserver('.slide-reveal-right', 0.15);
                    setupObserver('.equipment-reveal', 0.1);
                })();
            ");
        }
    }

