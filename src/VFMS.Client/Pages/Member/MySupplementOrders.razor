@page "/my-supplement-orders"
@layout PublicLayout
@using Microsoft.AspNetCore.Authorization
@using VFMS.Client.Components.Operations
@using VFMS.Contracts.Common
@using VFMS.Contracts.Supplements
@attribute [Authorize(Roles = "Customer,Member")]
@inject OperationsApiClient Api
@implements IDisposable

<PageTitle>Đơn hàng của tôi | Victor Fitness</PageTitle>

<section class="mx-auto min-w-0 max-w-4xl space-y-6 px-[20px] pb-16 pt-28 font-body" aria-labelledby="orders-title" aria-busy="@_loading.ToString().ToLowerInvariant()">
    <header class="flex flex-wrap items-end justify-between gap-4 border-b border-vfms-border pb-6">
        <div class="space-y-2">
            <p class="flex items-center gap-3 text-[11px] font-bold uppercase tracking-[0.18em] text-vfms-primary"><span class="h-px w-8 bg-vfms-primary" aria-hidden="true"></span>Cửa hàng / Đơn hàng</p>
            <h1 id="orders-title" class="font-heading text-3xl font-extrabold text-vfms-text">Đơn hàng của tôi</h1>
            <p class="text-sm text-vfms-text-secondary">Theo dõi đơn thực phẩm bổ sung. Đơn đang chờ xử lý có thể hủy.</p>
        </div>
        <a href="/supplements" class="inline-flex items-center gap-1 rounded-lg border border-vfms-border-strong px-4 py-2 text-xs font-bold uppercase tracking-wide text-vfms-text hover:border-vfms-primary hover:text-vfms-primary"><span aria-hidden="true">←</span> Tiếp tục mua sắm</a>
    </header>

    <Alerts Notice="@_notice" Error="@_error" />

    <div class="flex flex-wrap items-end justify-between gap-3 border-b border-vfms-border">
        <div class="flex gap-6" role="tablist" aria-label="Loại đơn">
            <button type="button" role="tab" aria-selected="@_ongoing.ToString().ToLowerInvariant()" class="@Tab(_ongoing)" @onclick="() => SwitchAsync(true)">Đang xử lý</button>
            <button type="button" role="tab" aria-selected="@((!_ongoing).ToString().ToLowerInvariant())" class="@Tab(!_ongoing)" @onclick="() => SwitchAsync(false)">Lịch sử</button>
        </div>
        @if (!_ongoing)
        {
            <div class="mb-2 flex flex-wrap items-center gap-2">
            <select aria-label="Khoảng thời gian" class="rounded-lg border border-vfms-border bg-vfms-surface px-3 py-1.5 text-xs font-semibold text-vfms-text outline-none focus:border-vfms-primary" value="@_period" @onchange="args => PeriodAsync(args.Value?.ToString() ?? string.Empty)">
                @foreach (var (key, label) in Periods) { <option value="@key">@label</option> }
            </select>
            @if (_period == CustomPeriod)
            {
                <label class="flex items-center gap-1 text-xs text-vfms-text-secondary">Từ
                    <input type="date" class="rounded-lg border border-vfms-border bg-vfms-surface px-3 py-1.5 text-xs font-semibold text-vfms-text outline-none focus:border-vfms-primary" max="@Iso(_to ?? Today)" @bind="_from" @bind:after="DatesChangedAsync" />
                </label>
                <label class="flex items-center gap-1 text-xs text-vfms-text-secondary">đến
                    <input type="date" class="rounded-lg border border-vfms-border bg-vfms-surface px-3 py-1.5 text-xs font-semibold text-vfms-text outline-none focus:border-vfms-primary" min="@Iso(_from)" max="@Iso(Today)" @bind="_to" @bind:after="DatesChangedAsync" />
                </label>
            }
            <select class="rounded-lg border border-vfms-border bg-vfms-surface px-3 py-1.5 text-xs font-semibold text-vfms-text outline-none focus:border-vfms-primary" aria-label="Lọc trạng thái" @bind="_status" @bind:after="() => LoadAsync(1)">
                <option value="">Mọi trạng thái</option>
                @foreach (var status in OperationsText.OrderStatuses) { <option value="@status">@OperationsText.Label(status)</option> }
            </select>
            </div>
        }
    </div>

    @if (_loading)
    {
        <p role="status" class="py-8 text-sm text-vfms-text-secondary">Đang tải đơn hàng...</p>
    }
    else if (_page is { Items.Count: > 0 } list)
    {
        <div class="min-w-0 overflow-hidden rounded-[12px] border border-vfms-border bg-vfms-surface">
            <ul class="m-0 list-none divide-y divide-vfms-border p-0" aria-label="Đơn thực phẩm bổ sung">
                @foreach (var order in list.Items)
                {
                    <li @key="order.Id" class="min-w-0 space-y-4 p-[20px] sm:p-6">
                        <div class="flex min-w-0 flex-wrap items-start justify-between gap-3">
                            <div class="min-w-0">
                                <h2 class="break-all font-heading text-base font-bold text-vfms-text">@order.OrderNumber</h2>
                                <p class="mt-1 text-xs text-vfms-text-secondary">@OperationsText.Local(order.PlacedAt) · @OperationsText.Label(order.FulfillmentType)</p>
                            </div>
                            <span class="@OperationsText.Badge(order.Status)">@OperationsText.Label(order.Status)</span>
                        </div>
                        <OrderLines Order="order" />
                        @if (order.Delivery is { CourierName: { } courier } delivery)
                        {
                            <p class="rounded-lg bg-vfms-surface-alt px-3 py-2 text-xs text-vfms-text-secondary">Vận chuyển: <strong class="text-vfms-text">@courier</strong> · Mã vận đơn <strong class="text-vfms-text">@delivery.TrackingCode</strong></p>
                        }
                        @if (order.CanCancel)
                        {
                            <div class="flex flex-wrap items-center justify-end gap-2">
                                @if (_confirmCancelId == order.Id)
                                {
                                    <span class="text-sm text-vfms-text-secondary">Hủy đơn này? Đơn chưa thanh toán nên không phát sinh hoàn tiền.</span>
                                    <button type="button" class="@Ui.DangerButton" disabled="@_working" @onclick="() => CancelAsync(order)">Xác nhận hủy</button>
                                    <button type="button" class="@Ui.Button" @onclick="() => _confirmCancelId = null">Không</button>
                                }
                                else
                                {
                                    <button type="button" class="@Ui.DangerButton" disabled="@_working" @onclick="() => _confirmCancelId = order.Id">Hủy đơn</button>
                                }
                            </div>
                        }
                    </li>
                }
            </ul>
            <div class="border-t border-vfms-border">
                <Pager Page="list.Page" PageSize="list.PageSize" TotalCount="list.TotalCount" Noun="đơn" AriaLabel="Phân trang đơn hàng" Disabled="_loading" OnPage="LoadAsync" />
            </div>
        </div>
    }
    else
    {
        <div class="space-y-3 rounded-[12px] border border-vfms-border bg-vfms-surface p-8 text-center">
            <p role="status" class="text-sm text-vfms-text-secondary">@(_ongoing ? "Không có đơn nào đang xử lý." : HistoryFiltered ? "Không có đơn nào trong khoảng thời gian hoặc trạng thái đã chọn." : "Chưa có đơn hàng.")</p>
            <a href="/supplements" class="@Ui.PrimaryButton inline-block">Đến cửa hàng</a>
        </div>
    }
</section>

@code {
    private const int PageSize = 10;
    private readonly CancellationTokenSource _lifetime = new();
    private PagedResponse<SupplementOrderResponse>? _page;
    private string _status = "";
    private const string CustomPeriod = "custom";

    /// <summary>History periods. Dates are Vietnam dates; the API treats "to" as the whole day.</summary>
    private static readonly (string Key, string Label)[] Periods =
    [
        ("", "Mọi thời gian"),
        ("30", "30 ngày qua"),
        ("90", "3 tháng qua"),
        ("365", "12 tháng qua"),
        (CustomPeriod, "Chọn ngày..."),
    ];

    private string _period = "";
    private DateOnly? _from, _to;
    private static DateOnly Today => DateOnly.FromDateTime(DateTime.UtcNow.AddHours(7));
    private bool HistoryFiltered => _status != "" || _from.HasValue || _to.HasValue;

    private static string? Iso(DateOnly? date) => date?.ToString("yyyy-MM-dd");

    private Task PeriodAsync(string period)
    {
        _period = period;
        if (int.TryParse(period, out var days))
        {
            _from = Today.AddDays(-days + 1);
            _to = null;
        }
        else if (period != CustomPeriod)
        {
            _from = _to = null;
        }
        return LoadAsync(1);
    }

    private Task DatesChangedAsync()
    {
        // Swap a reversed range instead of showing an error: the shopper clearly meant the days in between.
        if (_from > _to) (_from, _to) = (_to, _from);
        return LoadAsync(1);
    }
    private string? _notice, _error;
    private int? _confirmCancelId;
    private bool _ongoing = true, _loading, _working;

    /// <summary>Underline tab: muted red for the selected tab (frontend guidelines 6.B).</summary>
    private static string Tab(bool active) => active
        ? "-mb-px border-b-2 border-vfms-primary px-1 pb-3 font-heading text-xs font-bold uppercase tracking-wide text-vfms-primary"
        : "-mb-px border-b-2 border-transparent px-1 pb-3 font-heading text-xs font-bold uppercase tracking-wide text-vfms-text-secondary hover:text-vfms-text";

    protected override Task OnInitializedAsync() => LoadAsync(1);

    private Task SwitchAsync(bool ongoing)
    {
        _ongoing = ongoing;
        _status = _period = "";
        _from = _to = null;
        return LoadAsync(1);
    }

    private async Task LoadAsync(int page)
    {
        _loading = true;
        try
        {
            _page = _ongoing
                ? await Api.GetOngoingOrdersAsync(page, PageSize, _lifetime.Token)
                : await Api.GetOrdersAsync(new(string.IsNullOrEmpty(_status) ? null : _status, _from, _to, Page: page, PageSize: PageSize), mine: true, _lifetime.Token);
        }
        catch (AuthApiException error) { _error = error.Message; }
        catch (OperationCanceledException) when (_lifetime.IsCancellationRequested) { }
        finally { _loading = false; }
    }

    private async Task CancelAsync(SupplementOrderResponse order)
    {
        if (_working) return;
        _working = true;
        _notice = _error = null;
        try
        {
            var saved = await Api.OrderActionAsync(order.Id, "cancel", ct: _lifetime.Token);
            _notice = $"Đã hủy đơn {saved.OrderNumber}.";
            _confirmCancelId = null;
            await LoadAsync(_page?.Page ?? 1);
        }
        catch (AuthApiException error) { _error = error.Message; }
        catch (OperationCanceledException) when (_lifetime.IsCancellationRequested) { }
        finally { _working = false; }
    }

    public void Dispose()
    {
        _lifetime.Cancel();
        _lifetime.Dispose();
    }
}
