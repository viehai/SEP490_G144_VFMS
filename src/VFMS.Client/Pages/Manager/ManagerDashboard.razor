@page "/manager/dashboard"
@layout ManagerAdminLayout
@using System.Globalization

<PageTitle>Manager Dashboard | Victor Fitness</PageTitle>

<div class="workspace-page space-y-8 font-['Inter',sans-serif] text-[#383E43]">
    <header class="flex flex-col justify-between gap-5 border-b border-[#D8DED2] pb-6 md:flex-row md:items-end">
        <div>
            <p class="workspace-heading mb-2 text-[10px] font-bold tracking-[.18em] text-[#5F6F52]">VFMS / OPERATIONS OVERVIEW</p>
            <h1 class="workspace-heading text-3xl font-extrabold uppercase tracking-tight text-[#383E43] sm:text-4xl">Manager Dashboard<span class="text-[#5F6F52]">.</span></h1>
            <p class="mt-2 max-w-2xl text-sm leading-6 text-[#69706A]">Theo dõi hiệu quả kinh doanh, hội viên và các yêu cầu cần xử lý.</p>
        </div>
        <span class="workspace-heading inline-flex w-fit items-center gap-2 border border-[#D8DED2] bg-white px-3.5 py-2 text-[10px] font-bold uppercase tracking-wider rounded-lg text-[#69706A]"><span class="h-2 w-2 rounded-full bg-[#5F6F52]" aria-hidden="true"></span>Dữ liệu minh họa</span>
    </header>

    <section class="grid gap-4 lg:grid-cols-3" aria-label="Thống kê hoạt động kinh doanh">
        <button type="button" @onclick='() => _activeAction = "reports"' class="group border border-[#D8DED2] bg-white p-6 text-left transition-all hover:border-[#5F6F52] rounded-xl cursor-pointer">
            <div class="flex items-start justify-between"><span class="workspace-heading text-[11px] font-bold uppercase tracking-wider text-[#69706A]">Doanh thu tháng</span><span class="text-xl text-[#5F6F52]" aria-hidden="true">↗</span></div>
            <p class="workspace-heading mt-6 text-3xl font-extrabold tracking-tight text-[#5F6F52] lg:text-xl xl:text-3xl 2xl:text-4xl">@Money(_monthlyRevenue)<span class="ml-1 text-base">₫</span></p>
            <p class="mt-2 text-xs text-[#69706A]">Tháng mẫu · Tổng giá trị thanh toán thành công</p>
        </button>
        <button type="button" @onclick='() => _activeAction = "members"' class="group border border-[#D8DED2] bg-white p-6 text-left transition-all hover:border-[#5F6F52] rounded-xl cursor-pointer">
            <div class="flex items-start justify-between"><span class="workspace-heading text-[11px] font-bold uppercase tracking-wider text-[#69706A]">Hội viên Active</span><span class="text-xl text-[#5F6F52]" aria-hidden="true">↗</span></div>
            <p class="workspace-heading mt-6 text-4xl font-extrabold tracking-tight text-[#5F6F52]">@_activeMembers.ToString("N0", _numberFormat)</p>
            <p class="mt-2 text-xs text-[#69706A]">Hội viên có gói tập đang hoạt động</p>
        </button>
        <button type="button" @onclick='() => _activeAction = "pending"' class="group border border-[#D8DED2] bg-white p-6 text-left transition-all hover:border-[#5F6F52] rounded-xl cursor-pointer">
            <div class="flex items-start justify-between"><span class="workspace-heading text-[11px] font-bold uppercase tracking-wider text-[#69706A]">Yêu cầu Pending</span><span class="text-xl text-[#5F6F52]" aria-hidden="true">↗</span></div>
            <p class="workspace-heading mt-6 text-4xl font-extrabold tracking-tight text-[#D97706]">@(_freezeRequests + _purchaseProposals)</p>
            <p class="mt-2 text-xs text-[#69706A]">@_freezeRequests bảo lưu · @_purchaseProposals đề xuất mua sắm</p>
        </button>
    </section>

    <section id="quick-actions" aria-labelledby="manager-actions-title">
        <div class="mb-4 flex flex-wrap items-center justify-between gap-2"><h2 id="manager-actions-title" class="workspace-heading text-sm font-extrabold uppercase tracking-wider text-[#383E43]">Truy cập nhanh</h2><span class="text-xs text-[#69706A]">Chọn tác vụ để xem dữ liệu mẫu</span></div>
        <div class="grid gap-3 lg:grid-cols-3">
            <AuthorizeView Roles="Manager">
                <a href="/manager/promotions" class="flex min-h-24 items-center justify-between gap-5 border border-[#D8DED2] bg-white p-5 text-left text-[#383E43] transition-all hover:border-[#5F6F52] hover:bg-[#EEF1EA] rounded-xl">
                    <span><span class="workspace-heading block text-xs font-extrabold uppercase tracking-wider">Marketing / Khuyến mãi</span><span class="mt-1.5 block text-xs text-[#69706A]">Quản lý mã giảm giá và chiến dịch</span></span>
                    <span class="text-xl text-[#5F6F52]" aria-hidden="true">↗</span>
                </a>
                <a href="/manager/membership-plans" class="flex min-h-24 items-center justify-between gap-5 border border-[#D8DED2] bg-white p-5 text-left text-[#383E43] transition-all hover:border-[#5F6F52] hover:bg-[#EEF1EA] rounded-xl">
                    <span><span class="workspace-heading block text-xs font-extrabold uppercase tracking-wider">Membership Plans</span><span class="mt-1.5 block text-xs text-[#69706A]">Quản lý danh mục gói hội viên</span></span>
                    <span class="text-xl text-[#5F6F52]" aria-hidden="true">↗</span>
                </a>
            </AuthorizeView>
            @foreach (var action in _actions)
            {
                var active = _activeAction == action.Id;
                <button type="button" @onclick="() => _activeAction = action.Id" aria-pressed="@(active ? "true" : "false")"
                        class="flex min-h-24 items-center justify-between gap-5 border p-5 text-left transition-all rounded-xl cursor-pointer @(active ? "border-[#5F6F52] bg-[#E8EDE3] text-[#5F6F52]" : "border-[#D8DED2] bg-white text-[#383E43] hover:border-[#5F6F52] hover:bg-[#EEF1EA]")">
                    <span><span class="workspace-heading block text-xs font-extrabold uppercase tracking-wider">@action.Name</span><span class="mt-1.5 block text-xs text-[#69706A]">@action.Description</span></span>
                    <span class="text-xl" aria-hidden="true">↗</span>
                </button>
            }
        </div>
    </section>

    <section class="overflow-hidden border border-[#D8DED2] bg-white rounded-xl shadow-sm" aria-labelledby="manager-table-title" aria-live="polite">
        <div class="flex flex-wrap items-center justify-between gap-3 border-b border-[#D8DED2] px-6 py-4"><h2 id="manager-table-title" class="workspace-heading text-sm font-extrabold uppercase tracking-wider text-[#383E43]">@ActiveTitle</h2><span class="text-xs text-[#69706A]">Bản xem trước · Không thay đổi dữ liệu thật</span></div>
        @if (_activeAction == "reports")
        {
            <div class="overflow-x-auto"><table class="workspace-table w-full min-w-[650px] text-left text-sm"><thead class="workspace-heading bg-[#EEF1EA] text-[10px] uppercase tracking-wider"><tr><th class="px-6 py-4">Nguồn doanh thu</th><th class="px-6 py-4">Giao dịch</th><th class="px-6 py-4">Doanh thu mẫu</th><th class="px-6 py-4">Tỷ trọng</th></tr></thead><tbody>
                @foreach (var row in _revenueRows)
                {
                    <tr class="border-t border-[#EEF1EA]"><td class="px-6 py-4 font-semibold text-[#383E43]">@row.Service</td><td class="px-6 py-4 text-[#69706A]">@row.Transactions</td><td class="workspace-heading px-6 py-4 text-xs font-bold text-[#5F6F52]">@Money(row.Amount) ₫</td><td class="px-6 py-4"><div class="flex items-center gap-3"><div class="h-2 w-20 bg-[#EEF1EA] rounded-full overflow-hidden" aria-hidden="true"><div class="h-full bg-[#5F6F52] rounded-full" style="@($"width: {row.Amount / _monthlyRevenue * 100m:0}%")"></div></div><span class="text-xs text-[#69706A]">@((row.Amount / _monthlyRevenue).ToString("P0", _numberFormat))</span></div></td></tr>
                }
            </tbody></table></div>
        }
        else if (_activeAction == "feedback")
        {
            <div class="divide-y divide-[#EEF1EA]">
                @foreach (var feedback in _feedback)
                {
                    <article class="flex flex-col justify-between gap-4 px-6 py-4 sm:flex-row hover:bg-[#FAFAF7]"><div><p class="text-sm font-semibold text-[#383E43]">@feedback.Member <span class="ml-2 text-xs font-normal text-[#8A9089]">@feedback.Category</span></p><p class="mt-1.5 max-w-2xl text-sm leading-6 text-[#69706A]">@feedback.Content</p></div><span class="h-fit whitespace-nowrap border border-amber-200 bg-amber-50 px-2.5 py-1 text-[10px] font-bold uppercase text-[#D97706] rounded-full">Chờ phản hồi</span></article>
                }
            </div>
        }
        else if (_activeAction == "members")
        {
            <div class="grid gap-0 divide-y divide-[#EEF1EA] lg:grid-cols-3 md:divide-x md:divide-y-0">
                @foreach (var group in _memberGroups)
                {
                    <div class="p-6"><p class="workspace-heading text-xs font-bold uppercase tracking-wider text-[#69706A]">@group.Service</p><p class="workspace-heading mt-4 text-4xl font-extrabold text-[#5F6F52]">@group.Members</p><p class="mt-2 text-xs leading-5 text-[#69706A]">Hội viên hoạt động trong dữ liệu mẫu</p></div>
                }
            </div>
        }
        else
        {
            <div class="overflow-x-auto"><table class="workspace-table w-full min-w-[650px] text-left text-sm"><thead class="workspace-heading bg-[#EEF1EA] text-[10px] uppercase tracking-wider"><tr><th class="px-6 py-4">Mã yêu cầu</th><th class="px-6 py-4">Loại</th><th class="px-6 py-4">Nội dung</th><th class="px-6 py-4">Trạng thái</th></tr></thead><tbody>
                @foreach (var request in _pending)
                {
                    <tr class="border-t border-[#EEF1EA]"><td class="workspace-heading px-6 py-4 text-xs font-bold text-[#383E43]">@request.Code</td><td class="px-6 py-4 text-xs text-[#69706A]">@request.Type</td><td class="px-6 py-4 text-[#69706A]">@request.Description</td><td class="px-6 py-4"><span class="inline-block border border-amber-200 bg-amber-50 px-2.5 py-1 text-[10px] font-bold uppercase text-[#D97706] rounded-full">Đang chờ</span></td></tr>
                }
            </tbody></table></div>
        }
    </section>
</div>

@code {
    private static readonly NumberFormatInfo _numberFormat = new()
    {
        NumberGroupSeparator = ".",
        NumberDecimalSeparator = ",",
        PercentPositivePattern = 1
    };
    private string _activeAction = "reports";
    private readonly decimal _monthlyRevenue = 356_800_000m;
    private readonly int _activeMembers = 842;
    private readonly int _freezeRequests = 7;
    private readonly int _purchaseProposals = 5;
    private readonly List<QuickAction> _actions =
    [
        new("reports", "Business Reports", "Tổng quan doanh thu và dịch vụ"),
        new("feedback", "Feedback Management", "Lắng nghe phản hồi hội viên")
    ];
    private readonly List<RevenueRow> _revenueRows =
    [
        new("Gym Membership", 136, 214_800_000m),
        new("Personal Training", 42, 92_000_000m),
        new("Yoga Studio", 38, 50_000_000m)
    ];
    private readonly List<MemberGroup> _memberGroups = [new("GYM", 578), new("YOGA", 168), new("PT", 96)];
    private readonly List<FeedbackRow> _feedback =
    [
        new("Nguyễn Minh Anh", "Thiết bị", "Mong phòng tập bổ sung hướng dẫn sử dụng tại khu máy cáp."),
        new("Trần Hoàng Nam", "Yoga Studio", "Khung giờ yoga cuối tuần phù hợp; mong có thêm lớp vào buổi sáng."),
        new("Lê Bảo Ngọc", "Dịch vụ", "Đề xuất bổ sung móc treo đồ tại khu thay đồ.")
    ];
    private readonly List<PendingRow> _pending =
    [
        new("FRZ-024", "Bảo lưu gói", "Hội viên đề nghị bảo lưu 7 ngày"),
        new("PR-018", "Mua sắm", "Đề xuất bổ sung dây kéo và thảm tập"),
        new("FRZ-025", "Bảo lưu PT", "Yêu cầu bảo lưu lịch huấn luyện cá nhân"),
        new("PR-019", "Mua sắm", "Đề xuất thay linh kiện máy chạy bộ")
    ];

    private static string Money(decimal amount) => amount.ToString("N0", _numberFormat);
    private string ActiveTitle => _activeAction switch { "reports" => "Tổng quan doanh thu tháng mẫu", "feedback" => "Phản hồi cần theo dõi", "members" => "Phân bổ hội viên hoạt động", _ => "Yêu cầu đang chờ xử lý" };
    private sealed record QuickAction(string Id, string Name, string Description);
    private sealed record RevenueRow(string Service, int Transactions, decimal Amount);
    private sealed record MemberGroup(string Service, int Members);
    private sealed record FeedbackRow(string Member, string Category, string Content);
    private sealed record PendingRow(string Code, string Type, string Description);
}
