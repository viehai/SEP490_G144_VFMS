@page "/membership-plans/{Type}/{PackageId:int}"
@layout PublicLayout
@using System.Net
@using VFMS.Client.Components.Memberships
@using VFMS.Contracts.Memberships
@using VFMS.Contracts.Packages
@inject MembershipPlanApiClient Plans
@inject MembershipCart Cart
@implements IDisposable

<PageTitle>@($"{_detail?.Package.Name ?? "Chi tiết gói tập"} | Victor Fitness")</PageTitle>

<section class="mx-auto max-w-6xl space-y-8 px-4 pb-16 pt-28 font-body text-vfms-text sm:px-6 lg:px-8" aria-labelledby="package-title">
    <header class="space-y-2 border-b border-vfms-border pb-6">
        <a href="@CatalogUrl" class="@BackLink"><span aria-hidden="true">←</span> Về danh mục gói tập</a>
        @if (_detail is { } current)
        {
            <p class="text-sm font-semibold text-vfms-primary">@ServiceLabel(current.Package.ComponentType)</p>
        }
        <h1 id="package-title" class="break-words font-heading text-3xl font-extrabold sm:text-4xl">@(_detail?.Package.Name ?? "Chi tiết gói tập")</h1>
        @if (_detail != null)
        {
            <a href="@ReviewUrl" class="@BackLink">Xem đánh giá của hội viên</a>
        }
    </header>

    @if (_loading)
    {
        <p role="status" class="@Panel">Đang tải chi tiết gói tập…</p>
    }
    else if (_notFound)
    {
        <p role="status" class="@Panel">Gói tập này hiện không có trong danh mục mở bán.</p>
    }
    else if (_loadFailed)
    {
        <div class="@Panel">
            <p role="alert" class="text-sm text-vfms-text-secondary">Chưa tải được chi tiết gói tập. Bạn có thể thử lại.</p>
            <button type="button" class="@SecondaryAction mt-3" @onclick="LoadAsync">Thử lại</button>
        </div>
    }
    else if (_detail is { } detail)
    {
        var package = detail.Package;
        var isPt = package.ComponentType == "PT";
        <div class="grid items-start gap-6 lg:grid-cols-[minmax(0,2fr)_minmax(0,1fr)]">
            <div class="min-w-0 space-y-6">
                <section class="@Panel" aria-labelledby="package-info-title">
                    <h2 id="package-info-title" class="font-heading text-lg font-bold">Thông tin gói</h2>
                    <dl class="mt-4 grid gap-x-8 gap-y-4 text-sm sm:grid-cols-2">
                        @if (Duration(package) is { } duration)
                        {
                            <div><dt class="text-vfms-text-secondary">Thời hạn</dt><dd class="mt-1 font-semibold">@duration</dd></div>
                        }
                        @if (package.SessionCount is > 0)
                        {
                            <div><dt class="text-vfms-text-secondary">Số buổi</dt><dd class="mt-1 font-semibold">@SessionLabel(package)</dd></div>
                        }
                        @if (!string.IsNullOrWhiteSpace(package.TrainerLevel))
                        {
                            <div><dt class="text-vfms-text-secondary">Cấp huấn luyện viên</dt><dd class="mt-1 font-semibold">@package.TrainerLevel</dd></div>
                        }
                        @if (package.AccessStartTime is { } start && package.AccessEndTime is { } end)
                        {
                            <div><dt class="text-vfms-text-secondary">Giờ tập</dt><dd class="mt-1 font-semibold">@start.ToString("HH:mm") – @end.ToString("HH:mm")</dd></div>
                        }
                        @if (!string.IsNullOrWhiteSpace(package.YogaClassTypeName))
                        {
                            <div><dt class="text-vfms-text-secondary">Dòng lớp Yoga</dt><dd class="mt-1 font-semibold">@package.YogaClassTypeName</dd></div>
                        }
                        @if (FreezeLabel(package) is { } freeze)
                        {
                            <div><dt class="text-vfms-text-secondary">Bảo lưu</dt><dd class="mt-1 font-semibold">@freeze</dd></div>
                        }
                    </dl>
                </section>

                @if (!string.IsNullOrWhiteSpace(package.Description))
                {
                    <section class="@Panel" aria-labelledby="package-description-title">
                        <h2 id="package-description-title" class="font-heading text-lg font-bold">Mô tả gói</h2>
                        <div class="mt-3 whitespace-pre-wrap break-words text-sm leading-7 text-vfms-text-secondary">@package.Description</div>
                    </section>
                }

                @if (!isPt)
                {
                    <section class="@Panel" aria-labelledby="package-terms-title">
                        <h2 id="package-terms-title" class="font-heading text-lg font-bold">Điều khoản kích hoạt</h2>
                        <p class="mt-2 text-sm leading-6 text-vfms-text-secondary">@MembershipPurchaseMessages.ActivationTerms</p>
                    </section>
                }
            </div>

            <aside class="@Panel space-y-4" aria-label="Đăng ký gói tập">
                <dl>
                    <dt class="text-sm font-semibold text-vfms-text-secondary">Giá gói</dt>
                    <dd class="mt-1 break-words font-heading text-3xl font-extrabold text-vfms-primary">@Vnd.Format(package.Price)</dd>
                </dl>
                @if (isPt)
                {
                    <a href="@PackageCatalogLinks.Trainers(package.Id)" class="@PrimaryAction w-full">Chọn huấn luyện viên</a>
                }
                else
                {
                    <AuthorizeView Roles="Customer,Member">
                        <Authorized>
                            <button type="button" class="@PrimaryAction w-full" disabled="@(Cart.Count >= MembershipCart.MaximumItems)"
                                    @onclick="() => AddToCart(package)">Thêm vào giỏ</button>
                            @if (Cart.Count > 0)
                            {
                                <a href="/membership-cart" class="@SecondaryAction mt-3 w-full">Xem giỏ hàng (@Cart.Count)</a>
                            }
                            @if (_addedToCart)
                            {
                                <p role="status" class="mt-3 text-sm text-vfms-text-secondary">Đã thêm gói vào giỏ hàng. Giỏ có @Cart.Count gói.</p>
                            }
                            @if (Cart.Count >= MembershipCart.MaximumItems)
                            {
                                <p class="mt-3 text-sm text-vfms-text-secondary">Giỏ hàng đã có tối đa @MembershipCart.MaximumItems gói.</p>
                            }
                        </Authorized>
                        <NotAuthorized>
                            @if (context.User.Identity?.IsAuthenticated != true)
                            {
                                <a href="@LoginUrl" class="@PrimaryAction w-full">Đăng nhập để mua gói</a>
                            }
                        </NotAuthorized>
                    </AuthorizeView>
                }
            </aside>
        </div>

        <PackageReviews @key="package.Id" PackageId="package.Id" ServiceType="@package.ComponentType" LoginUrl="@ReviewLoginUrl" />

        @if (detail.Recommendations.Count > 0)
        {
            <section class="space-y-4" aria-labelledby="package-recommendations-title">
                <h2 id="package-recommendations-title" class="font-heading text-xl font-bold">Gói gợi ý</h2>
                <ul class="grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
                    @foreach (var recommendation in detail.Recommendations)
                    {
                        <li @key="recommendation.Id">
                            <a href="@PackageCatalogLinks.Detail(recommendation.ComponentType, recommendation.Id)"
                               class="@Panel @FocusRing block h-full transition-colors hover:border-vfms-primary">
                                <p class="text-xs font-semibold text-vfms-primary">@ServiceLabel(recommendation.ComponentType)</p>
                                <h3 class="mt-2 break-words font-heading font-bold">@recommendation.Name</h3>
                                @if ((Duration(recommendation) ?? SessionLabel(recommendation)) is { } term)
                                {
                                    <p class="mt-1 text-sm text-vfms-text-secondary">@term</p>
                                }
                                <p class="mt-3 text-base font-bold text-vfms-text">@Vnd.Format(recommendation.Price)</p>
                            </a>
                        </li>
                    }
                </ul>
            </section>
        }
    }
</section>

@code {
    private const string FocusRing = "focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-vfms-primary";
    private const string Panel = "rounded-xl border border-vfms-border bg-vfms-surface p-5 sm:p-6";
    private const string BackLink = "inline-flex min-h-[44px] items-center gap-2 text-sm font-bold text-vfms-primary hover:underline " + FocusRing;
    private const string PrimaryAction = "inline-flex min-h-[44px] items-center justify-center rounded-lg bg-vfms-primary px-4 py-2 text-center text-sm font-bold text-white hover:bg-vfms-primary-hover disabled:opacity-60 " + FocusRing;
    private const string SecondaryAction = "inline-flex min-h-[44px] items-center justify-center rounded-lg border border-vfms-border-strong px-4 py-2 text-center text-sm font-bold text-vfms-text hover:bg-vfms-surface-alt " + FocusRing;

    [Parameter] public string Type { get; set; } = "";
    [Parameter] public int PackageId { get; set; }
    [SupplyParameterFromQuery(Name = "page")] public int? CatalogPage { get; set; }

    private PackageDetailResponse? _detail;
    private CancellationTokenSource? _load;
    private bool _loading;
    private bool _notFound;
    private bool _loadFailed;
    private bool _addedToCart;
    private string PackageType => Type.ToLowerInvariant();
    private string CatalogUrl => PackageType is "gym" or "yoga" or "pt" ? PackageCatalogLinks.Catalog(PackageType, CatalogPage) : "/membership-plans";
    private string LoginUrl => $"/auth/login?returnUrl={Uri.EscapeDataString(PackageCatalogLinks.Detail(PackageType, PackageId, CatalogPage))}";
    private string ReviewUrl => PackageCatalogLinks.Detail(PackageType, PackageId, CatalogPage) + "#package-reviews";
    private string ReviewLoginUrl => $"/auth/login?returnUrl={Uri.EscapeDataString(ReviewUrl)}";

    protected override Task OnParametersSetAsync() => LoadAsync();

    private async Task LoadAsync()
    {
        Dispose();
        _detail = null;
        _addedToCart = _loadFailed = false;
        _notFound = PackageId <= 0 || PackageType is not ("gym" or "yoga" or "pt");
        _loading = !_notFound;
        if (_notFound) return;

        _load = new();
        var ct = _load.Token;
        try
        {
            var detail = await Plans.GetPackageDetailAsync(PackageType, PackageId, ct);
            if (!ct.IsCancellationRequested) _detail = detail;
        }
        catch (OperationCanceledException) when (ct.IsCancellationRequested) { }
        catch (AuthApiException error) when (!ct.IsCancellationRequested)
        {
            _notFound = error.StatusCode == HttpStatusCode.NotFound;
            _loadFailed = !_notFound;
        }
        finally
        {
            if (!ct.IsCancellationRequested) _loading = false;
        }
    }

    private void AddToCart(PackageCatalogItemResponse package)
    {
        if (Cart.Count >= MembershipCart.MaximumItems) return;
        Cart.Add(package.Id, package.Name, package.Price);
        _addedToCart = true;
    }

    private static string ServiceLabel(string componentType) => componentType switch
    {
        "PT" => "PT",
        "YOGA" => "Yoga",
        _ => "Gym"
    };

    private static string? Duration(PackageCatalogItemResponse package) => package.DurationMonths is > 0 ? $"{package.DurationMonths} tháng"
        : package.DurationDays is > 0 ? $"{package.DurationDays} ngày" : null;

    private static string? SessionLabel(PackageCatalogItemResponse package) => package.SessionCount is > 0
        ? $"{package.SessionCount} buổi{(package.ComponentType == "PT" ? " PT 1 kèm 1" : " Yoga")}" : null;

    private static string? FreezeLabel(PackageCatalogItemResponse package)
    {
        if (package.ComponentType == "PT")
        {
            var minimum = package.PTFreezeMinimumDays is > 0 ? $"Tối thiểu {package.PTFreezeMinimumDays} ngày" : null;
            var total = package.PTFreezeMaxTotalDays is > 0 ? $"Tổng tối đa {package.PTFreezeMaxTotalDays} ngày" : null;
            return minimum is null ? total : total is null ? minimum : $"{minimum} · {total}";
        }

        if (!package.AllowFreeze) return "Không áp dụng bảo lưu";
        var perRequest = package.MaxFreezeDaysPerRequest is > 0 ? $"Tối đa {package.MaxFreezeDaysPerRequest} ngày/lần" : "Có hỗ trợ";
        return package.MaxFreezeCount is > 0 ? $"{perRequest} · Tối đa {package.MaxFreezeCount} lần" : perRequest;
    }

    public void Dispose()
    {
        _load?.Cancel();
        _load?.Dispose();
        _load = null;
    }
}
