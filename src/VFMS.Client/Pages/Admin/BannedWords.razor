@page "/admin/banned-words"
@layout ManagerAdminLayout
@using VFMS.Client.Components.Operations
@using Microsoft.AspNetCore.Authorization
@using VFMS.Contracts.Common
@using VFMS.Contracts.SystemAdministration
@using VFMS.Contracts.SystemAdministration.Validators
@attribute [Authorize(Roles = "Admin")]
@inject SystemAdministrationApiClient Api
@implements IDisposable

<PageTitle>Từ khóa cấm | Victor Fitness</PageTitle>

<div class="workspace-page space-y-6">
    <header class="border-b border-vfms-border pb-6">
        <p class="mb-2 text-xs font-bold tracking-wider text-vfms-primary">VFMS / CONTENT MODERATION</p>
        <h1 class="text-3xl font-extrabold tracking-tight text-vfms-text sm:text-4xl">Từ khóa cấm<span class="text-vfms-primary">.</span></h1>
        <p class="mt-2 text-sm text-vfms-text-secondary">Danh sách từ ngữ bị chặn trong đánh giá và phản hồi của người dùng.</p>
    </header>

    @if (_notice is not null)
    {
        <p role="status" class="rounded-[10px] border border-emerald-300 bg-emerald-50 p-4 text-sm text-emerald-900">@_notice</p>
    }
    @if (_error is not null)
    {
        <p role="alert" class="rounded-[10px] border border-red-300 bg-red-50 p-4 text-sm text-red-900">@_error</p>
    }

    <section class="rounded-[12px] border border-vfms-border bg-vfms-surface p-5 sm:p-6 shadow-sm" aria-labelledby="word-form-title">
        <h2 id="word-form-title" class="text-base font-bold text-vfms-text">@(_editingId is null ? "Thêm từ khóa" : "Sửa từ khóa")</h2>
        <EditForm Model="_form" OnValidSubmit="SaveAsync" class="mt-4" novalidate>
            <OperationsValidation TRequest="BannedWordRequest" Validator="_validator" CreateRequest="CreateRequest" @ref="_validation" />
            <ValidationSummary />
            <fieldset disabled="@_working" class="mt-4 flex flex-wrap items-end gap-3">
                <label class="min-w-[240px] flex-1 text-xs font-semibold text-vfms-text" for="word-input">
                    Từ khóa <span class="text-vfms-primary" aria-hidden="true">*</span>
                    <InputText id="word-input" class="@Field" @bind-Value="_form.Word" maxlength="100" required />
                </label>
                <button type="submit" class="@PrimaryButton">@(_editingId is null ? "Thêm" : "Lưu")</button>
                @if (_editingId is not null)
                {
                    <button type="button" class="@Button" @onclick="CancelEdit">Hủy</button>
                }
            </fieldset>
        </EditForm>
    </section>

    <section class="rounded-[12px] border border-vfms-border bg-vfms-surface shadow-sm overflow-hidden" aria-labelledby="word-list-title" aria-busy="@(_loading || _working)">
        <div class="border-b border-vfms-border p-5 bg-vfms-surface-alt/40">
            <h2 id="word-list-title" class="mb-3 text-sm font-bold text-vfms-text">Danh sách</h2>
            <form @onsubmit="() => LoadAsync(1)" @onsubmit:preventDefault>
                <fieldset disabled="@_working" class="flex flex-wrap items-end gap-3">
                    <label class="w-full text-xs font-semibold text-vfms-text sm:w-64" for="word-search">
                        Tìm kiếm
                        <input id="word-search" type="search" @bind="_search" @bind:event="oninput" @bind:after="SearchTypedAsync" class="@Field" maxlength="100" />
                    </label>
                    <label class="text-xs font-semibold text-vfms-text" for="word-status">
                        Trạng thái
                        <select id="word-status" @bind="_status" @bind:after="() => LoadAsync(1)" class="@Field">
                            <option value="">Tất cả</option>
                            <option value="true">Đang chặn</option>
                            <option value="false">Đã tắt</option>
                        </select>
                    </label>
                </fieldset>
            </form>
        </div>
        @if (_loading && _page is null)
        {
            <p role="status" class="p-5 text-sm">Đang tải danh sách từ khóa...</p>
        }
        else if (_page is { Items.Count: > 0 } list)
        {
            <div class="overflow-x-auto">
                <table class="workspace-table min-w-[680px]">
                    <thead>
                        <tr><th scope="col">Từ khóa</th><th scope="col">Trạng thái</th><th scope="col">Người tạo</th><th scope="col">Ngày tạo</th><th scope="col">Thao tác</th></tr>
                    </thead>
                    <tbody>
                        @foreach (var row in list.Items)
                        {
                            <tr @key="row.Id">
                                <th scope="row" class="max-w-56 break-words">@row.Word</th>
                                <td><span class="inline-block whitespace-nowrap rounded-md border px-2.5 py-1 text-[11px] font-semibold @(row.IsActive ? "border-red-200 bg-red-50 text-red-800" : "border-vfms-border bg-vfms-surface-alt text-vfms-text-secondary")">@(row.IsActive ? "Đang chặn" : "Đã tắt")</span></td>
                                <td>@(row.CreatedByName ?? "—")</td>
                                <td class="whitespace-nowrap">@row.CreatedAt.ToLocalTime().ToString("dd/MM/yyyy")</td>
                                <td>
                                    <div class="flex flex-nowrap whitespace-nowrap gap-2">
                                        <button type="button" class="@Button" disabled="@ListDisabled" aria-label="Sửa @row.Word" @onclick="() => StartEdit(row)">Sửa</button>
                                        <button type="button" class="@Button" disabled="@ListDisabled" @onclick="() => ToggleAsync(row)">@(row.IsActive ? "Tắt" : "Bật")</button>
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
            <nav aria-label="Phân trang từ khóa" class="flex flex-wrap items-center justify-between gap-3 border-t border-vfms-border p-4 text-xs font-medium text-vfms-text-secondary">
                <p>Trang @list.Page / @PageCount(list) · @list.TotalCount từ khóa</p>
                <div class="flex gap-2">
                    <button type="button" class="@Button" disabled="@(ListDisabled || list.Page <= 1)" @onclick="() => LoadAsync(list.Page - 1)">Trang trước</button>
                    <button type="button" class="@Button" disabled="@(ListDisabled || list.Page >= PageCount(list))" @onclick="() => LoadAsync(list.Page + 1)">Trang sau</button>
                </div>
            </nav>
        }
        else
        {
            <p role="status" class="p-5 text-sm text-vfms-text-secondary">Không tìm thấy từ khóa phù hợp.</p>
        }
    </section>
</div>

@code {
    private const int PageSize = 10;
    private const string Field = "mt-1 block w-full rounded-lg border border-vfms-border bg-vfms-surface px-3 py-2 text-sm font-normal text-vfms-text focus:border-vfms-primary focus:ring-2 focus:ring-vfms-primary/20 outline-none";
    private const string Button = "rounded-lg border border-vfms-border-strong bg-vfms-surface px-3 py-1.5 text-xs font-semibold text-vfms-text hover:bg-[#F3EDEA] transition";
    private const string PrimaryButton = "rounded-lg bg-vfms-primary px-4 py-2 text-sm font-semibold text-white hover:bg-vfms-primary-hover active:bg-vfms-primary-dark transition shadow-sm";

    private readonly CancellationTokenSource _lifetime = new();
    private readonly WordModel _form = new();
    private readonly BannedWordRequestValidator _validator = new();
    private OperationsValidation<BannedWordRequest>? _validation;
    private PagedResponse<BannedWordResponse>? _page;
    private int? _editingId;
    private string _search = string.Empty, _status = string.Empty;
    private string? _notice, _error;
    private bool _loading, _working;
    private bool ListDisabled => _loading || _working;

    protected override Task OnInitializedAsync() => LoadAsync(1);

    private BannedWordRequest CreateRequest() => new(_form.Word.Trim());

    // Filters apply as they change: dropdowns and dates at once, text boxes after a short pause in typing.
    private LiveQuery Live => _live ??= new(_lifetime.Token);
    private LiveQuery? _live;

    private Task LoadAsync(int page) => Live.NowAsync(token => FetchAsync(page, token));

    private Task SearchTypedAsync() => Live.AfterTypingAsync(token => FetchAsync(1, token));

    private async Task FetchAsync(int page, CancellationToken token)
    {
        _loading = true;
        try
        {
            bool? isActive = _status switch { "true" => true, "false" => false, _ => null };
            _page = await Api.GetBannedWordsAsync(new(_search, isActive, page, PageSize), token);
        }
        catch (AuthApiException error) { _error = error.Message; }
        finally { if (!token.IsCancellationRequested) _loading = false; }
    }

    private Task SaveAsync() => RunActionAsync(async () =>
    {
        var saved = _editingId is { } id
            ? await Api.UpdateBannedWordAsync(id, CreateRequest(), _lifetime.Token)
            : await Api.CreateBannedWordAsync(CreateRequest(), _lifetime.Token);
        _notice = _editingId is null ? $"Đã thêm từ khóa \"{saved.Word}\"." : $"Đã cập nhật từ khóa \"{saved.Word}\".";
        CancelEdit();
        await LoadAsync(_page?.Page ?? 1);
    });

    private Task ToggleAsync(BannedWordResponse word) => RunActionAsync(async () =>
    {
        var saved = await Api.SetBannedWordActiveAsync(word.Id, !word.IsActive, _lifetime.Token);
        _notice = saved.IsActive ? $"Đã bật chặn \"{saved.Word}\"." : $"Đã tắt chặn \"{saved.Word}\".";
        await LoadAsync(_page?.Page ?? 1);
    });

    private async Task RunActionAsync(Func<Task> action)
    {
        if (_working || _loading) return;
        _working = true;
        _notice = _error = null;
        try { await action(); }
        catch (AuthApiException error)
        {
            _error = error.Message;
            _validation?.ShowErrors(error.Errors);
        }
        catch (OperationCanceledException) when (_lifetime.IsCancellationRequested) { }
        finally { _working = false; }
    }

    private void StartEdit(BannedWordResponse word)
    {
        _editingId = word.Id;
        _form.Word = word.Word;
    }

    private void CancelEdit()
    {
        _editingId = null;
        _form.Word = string.Empty;
    }

    private static int PageCount(PagedResponse<BannedWordResponse> page) => Math.Max(1, (int)Math.Ceiling((double)page.TotalCount / page.PageSize));

    public void Dispose()
    {
        _lifetime.Cancel();
        _live?.Dispose();
        _lifetime.Dispose();
    }

    private sealed class WordModel
    {
        public string Word { get; set; } = string.Empty;
    }
}
