@inherits LayoutComponentBase
@inject NavigationManager Navigation

<WorkspaceShell Variant="@Variant" IsPreview="@IsPreview">@Body</WorkspaceShell>

@code {
    private string Variant => Navigation.ToBaseRelativePath(Navigation.Uri).StartsWith("pt/", StringComparison.OrdinalIgnoreCase) ? "pt" : "staff";
    private static readonly string[] LivePages =
    [
        "staff/dashboard", "staff/customers/create", "staff/membership-cash-receipt", "staff/pt-cash-receipt",
        "staff/equipment-issues", "staff/purchase-proposals", "staff/supplement-orders",
        "staff/check-ins", "staff/yoga", "pt/yoga", "pt/dashboard",
        "pt/trainer-profile", "pt/availability", "pt/assigned-members", "pt/teaching-schedule"
    ];

    // A live page's sub-pages (e.g. staff/yoga/sessions/5/attendance) are live too.
    private bool IsPreview
    {
        get
        {
            var path = Navigation.ToBaseRelativePath(Navigation.Uri).Split('?', '#')[0].TrimEnd('/');
            return !LivePages.Any(p => path.Equals(p, StringComparison.OrdinalIgnoreCase) || path.StartsWith(p + "/", StringComparison.OrdinalIgnoreCase));
        }
    }
}
