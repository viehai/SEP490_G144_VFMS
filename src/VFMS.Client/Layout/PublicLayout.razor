@inherits LayoutComponentBase
@inject IJSRuntime JS
@inject NavigationManager Navigation
@implements IAsyncDisposable

<div class="min-h-screen flex flex-col bg-white text-[#252525] font-['Inter',sans-serif] w-full max-w-full overflow-x-hidden">
    
    <!-- ============================================================== -->
    <!-- PUBLIC NAVBAR (Sage Green text, Frosted Warm Ivory on scroll)    -->
    <!-- ============================================================== -->
    <header id="vfms-navbar" @ref="_navbar" class="public-navbar">
        
        <!-- Brand Logo -->
        <a href="/" class="public-navbar__logo flex items-center gap-2.5 flex-shrink-0 group whitespace-nowrap" aria-label="Victor Fitness - Trang chủ">
            <img src="/brand/logo-dark.png" alt="Victor Fitness" class="w-24 sm:w-32 h-10 object-contain transition-opacity duration-300 group-hover:opacity-80" />
        </a>

        <!-- Menu Links -->
        <nav class="public-navbar__nav hidden xl:flex items-center font-['Montserrat',sans-serif] text-[11px] 2xl:text-xs font-bold uppercase tracking-wider whitespace-nowrap" aria-label="Điều hướng chính">
            <a href="/#featured-classes" class="@NavLinkCls">LỚP HỌC NỔI BẬT</a>
            <a href="/#pricing-memberships" class="@NavLinkCls">GÓI HỘI VIÊN</a>
            <a href="/" class="@NavLinkCls">LỊCH TẬP YOGA</a>
            <a href="/" class="@NavLinkCls">HUẤN LUYỆN VIÊN</a>
            <a href="/#explore-equipment" class="@NavLinkCls">TIỆN ÍCH &amp; DỊCH VỤ</a>
        </nav>

        <!-- Action Buttons -->
        <div class="public-navbar__actions flex items-center whitespace-nowrap">
            <AuthorizeView>
                <Authorized Context="auth">
                    @if (auth.User.IsInRole("Manager"))
                    {
                        <a href="/manager/membership-plans" class="@ManagerLinkClass" aria-label="Quản lý gói hội viên">Quản lý</a>
                    }
                    @if (auth.User.IsInRole("Member"))
                    {
                        <NavLink href="/my-memberships" Match="NavLinkMatch.Prefix" ActiveClass="text-[#5F6F52] underline underline-offset-4"
                                 class="@MyMembershipsClass">
                            Gói của tôi
                        </NavLink>
                    }
                    @if (auth.User.IsInRole("Member") || auth.User.IsInRole("Customer"))
                    {
                        <NavLink href="/supplements" Match="NavLinkMatch.Prefix" ActiveClass="text-[#5F6F52] underline underline-offset-4"
                                 class="@MyMembershipsClass">
                            Cửa hàng
                        </NavLink>
                    }
                    @if (auth.User.IsInRole("Member"))
                    {
                        <NavLink href="/equipment-issues" Match="NavLinkMatch.All" ActiveClass="text-[#5F6F52] underline underline-offset-4"
                                 class="@MyMembershipsClass">
                            Báo hỏng
                        </NavLink>
                    }
                    <NavLink href="/profile" Match="NavLinkMatch.All" ActiveClass="text-[#5F6F52] underline underline-offset-4"
                             class="@ProfileLinkClass"
                             title="@auth.User.Identity?.Name" aria-label="Hồ sơ cá nhân">
                        <span class="hidden xl:inline">Chào, @auth.User.Identity?.Name</span><span class="xl:hidden">HỒ SƠ</span>
                    </NavLink>
                    <LogoutButton Class="@LogoutBtnClass" />
                </Authorized>
                <NotAuthorized>
                    <a href="/auth/login"
                       class="@LoginLinkClass">
                        ĐĂNG NHẬP
                    </a>
                    <a href="/auth/register"
                       class="@RegisterLinkClass">
                        THAM GIA NGAY
                    </a>
                </NotAuthorized>
            </AuthorizeView>
        </div>
    </header>

    <!-- Main Content Area -->
    <main class="flex-grow w-full max-w-full min-w-0 overflow-x-hidden">
        @Body
    </main>

    <!-- Footer: Dark Olive — một trong số ít vị trí được phép dùng dark surface -->
    <footer class="w-full bg-[#3F493A] text-white pt-16 pb-12 border-t border-[#4E5D44]">
        <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
            <div class="grid grid-cols-1 md:grid-cols-4 gap-10 pb-12 border-b border-[#4E5D44]/60">
                <!-- Brand Info -->
                <div class="space-y-4">
                    <div class="flex items-center gap-2">
                        <img src="/brand/logo-remove.png" alt="Victor Fitness" class="h-10 object-contain" />
                    </div>
                    <p class="text-sm text-[#C8D5C0] font-['Inter',sans-serif] leading-relaxed">
                        Hệ thống quản lý phòng gym và huấn luyện thể lực chuyên nghiệp. Kỷ luật — Khoa học — Kết quả.
                    </p>
                    <p class="text-xs text-[#8A9089] font-mono">
                        VFMS v2.0 · .NET 8 &amp; Tailwind CSS
                    </p>
                </div>

                <!-- Column 1 -->
                <div>
                    <h5 class="font-['Montserrat',sans-serif] text-xs font-bold uppercase tracking-wider text-[#E8EDE3] mb-4">
                        DỊCH VỤ &amp; TẬP LUYỆN
                    </h5>
                    <ul class="space-y-2.5 text-sm text-[#A8B9A0] font-['Inter',sans-serif]">
                        <li><a href="#" class="hover:text-white transition-colors">Gói Hội Viên Classic &amp; VIP</a></li>
                        <li><a href="#" class="hover:text-white transition-colors">Huấn Luyện Viên Cá Nhân (PT 1-1)</a></li>
                        <li><a href="#" class="hover:text-white transition-colors">Lớp Yoga &amp; Pilates Studio</a></li>
                        <li><a href="#" class="hover:text-white transition-colors">Khu Vực Powerlifting &amp; Olympic</a></li>
                        <li><a href="#" class="hover:text-white transition-colors">Tủ Locker &amp; Phòng Xông Hơi</a></li>
                    </ul>
                </div>

                <!-- Column 2 -->
                <div>
                    <h5 class="font-['Montserrat',sans-serif] text-xs font-bold uppercase tracking-wider text-[#E8EDE3] mb-4">
                        QUY ĐỊNH &amp; CHÍNH SÁCH
                    </h5>
                    <ul class="space-y-2.5 text-sm text-[#A8B9A0] font-['Inter',sans-serif]">
                        <li><a href="#" class="hover:text-white transition-colors">Chính Sách Bảo Lưu Thẻ (Freeze)</a></li>
                        <li><a href="#" class="hover:text-white transition-colors">Nội Quy Phòng Tập VFMS</a></li>
                        <li><a href="#" class="hover:text-white transition-colors">Quy Định Đặt Lớp &amp; Hủy Lớp</a></li>
                        <li><a href="#" class="hover:text-white transition-colors">Cam Kết Bảo Mật FaceID &amp; PDPL</a></li>
                        <li><a href="#" class="hover:text-white transition-colors">Chính Sách Hoàn Tiền Cọc Locker</a></li>
                    </ul>
                </div>

                <!-- Column 3 -->
                <div>
                    <h5 class="font-['Montserrat',sans-serif] text-xs font-bold uppercase tracking-wider text-[#E8EDE3] mb-4">
                        ĐĂNG KÝ BẢN TIN THỂ LỰC
                    </h5>
                    <p class="text-sm text-[#A8B9A0] mb-4 leading-relaxed">
                        Nhận giáo án luyện tập, thực đơn dinh dưỡng và thông báo ưu đãi độc quyền.
                    </p>
                    <div class="flex rounded-lg overflow-hidden border border-[#5F6F52]">
                        <input type="email" placeholder="Email của bạn..." class="w-full bg-[#2E3A2A] text-white border-0 px-3 py-2.5 text-sm font-['Inter',sans-serif] focus:outline-none placeholder:text-[#8A9089]" />
                        <button class="bg-[#5F6F52] hover:bg-[#4E5D44] text-white px-4 py-2 font-['Montserrat',sans-serif] font-bold text-xs uppercase tracking-wider transition-colors whitespace-nowrap">
                            GỬI
                        </button>
                    </div>
                </div>
            </div>

            <!-- Bottom Copyright -->
            <div class="pt-8 flex flex-col sm:flex-row items-center justify-between text-xs text-[#8A9089] font-['Inter',sans-serif]">
                <p>© @DateTime.Now.Year VFMS · V-FITNESS MANAGEMENT SYSTEM</p>
                <div class="flex gap-4 mt-4 sm:mt-0 font-['Montserrat',sans-serif] text-[10px] tracking-wider uppercase text-[#A8B9A0]">
                    <a href="#" class="hover:text-white transition-colors">ĐIỀU KHOẢN SỬ DỤNG</a>
                    <span class="text-[#5F6F52]">•</span>
                    <a href="#" class="hover:text-white transition-colors">CHÍNH SÁCH BẢO MẬT</a>
                    <span class="text-[#5F6F52]">•</span>
                    <a href="#" class="hover:text-white transition-colors">HỆ THỐNG KIOSK</a>
                </div>
            </div>
        </div>
    </footer>

</div>

@code {
    private ElementReference _navbar;
    private IJSObjectReference? _navigationModule;
    private readonly string _navigationId = Guid.NewGuid().ToString("N");
    private bool _disposed;
    private bool IsHome => string.IsNullOrEmpty(Navigation.ToBaseRelativePath(Navigation.Uri).Split('?', '#')[0].Trim('/'));
    private string NavLinkCls => "text-[#383E43] hover:text-[#5F6F52] font-bold transition-colors";
    private string ManagerLinkClass => "text-[10px] font-bold uppercase text-[#383E43] hover:text-[#5F6F52] transition-colors";
    private string MyMembershipsClass => "max-w-12 whitespace-normal text-center text-[10px] font-bold uppercase leading-tight text-[#383E43] hover:text-[#5F6F52] transition-colors focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-4 sm:max-w-none sm:whitespace-nowrap sm:text-[11px]";
    private string ProfileLinkClass => "inline-block max-w-40 truncate font-['Montserrat',sans-serif] text-[10px] sm:text-[11px] font-bold uppercase tracking-wider text-[#383E43] hover:text-[#5F6F52] transition-colors focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-4";
    private string LogoutBtnClass => "bg-[#5F6F52] hover:bg-[#4E5D44] text-white font-['Montserrat',sans-serif] font-bold text-[11px] xl:text-xs uppercase tracking-wider px-3.5 py-2 rounded-lg transition-colors shadow-sm disabled:opacity-60";
    private string LoginLinkClass => "hidden sm:inline-block font-['Montserrat',sans-serif] text-[11px] xl:text-xs font-bold uppercase tracking-wider text-[#383E43] hover:text-[#5F6F52] px-3 py-1.5 transition-colors";
    private string RegisterLinkClass => "bg-[#5F6F52] hover:bg-[#4E5D44] text-white font-['Montserrat',sans-serif] font-bold text-[11px] xl:text-xs uppercase tracking-wider px-4 py-2 transition-all duration-200 rounded-lg shadow-sm";

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (_disposed) return;
        var module = _navigationModule;
        if (module is null)
        {
            module = await JS.InvokeAsync<IJSObjectReference>("import", $"./js/public-navigation.js?v={DateTime.UtcNow.Ticks}");
            if (_disposed)
            {
                await module.DisposeAsync();
                return;
            }
            _navigationModule = module;
        }
        await module.InvokeVoidAsync("sync", _navigationId, _navbar, IsHome);
    }

    public async ValueTask DisposeAsync()
    {
        _disposed = true;
        if (_navigationModule is null) return;
        try
        {
            await _navigationModule.InvokeVoidAsync("dispose", _navigationId);
            await _navigationModule.DisposeAsync();
        }
        catch (JSDisconnectedException) { }
    }
}
