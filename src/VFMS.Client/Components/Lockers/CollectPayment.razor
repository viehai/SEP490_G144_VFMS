@using VFMS.Client.Components.Operations
@using VFMS.Contracts.Lockers
@* A counter order waiting for money: cash is confirmed by Staff, VietQR is confirmed by the bank callback. *@
<div class="space-y-3">
    <p class="text-sm">Đơn <strong>@Order.OrderNumber</strong> · <strong>@OperationsText.Money(Order.AmountDue)</strong></p>
    @if (Order.DiscountAmount > 0) { <p class="text-sm">Voucher @Order.VoucherCode: giảm @OperationsText.Money(Order.DiscountAmount).</p> }
    @if (Method == "Cash")
    {
        <CashReceiptForm OrderNumber="@Order.OrderNumber" AmountDue="Order.AmountDue" Busy="Busy" OnConfirm="OnCash" />
    }
    else
    {
        <LockerQr Checkout="Order" Now="Now" />
    }
    <button type="button" class="@Ui.DangerButton" disabled="@Busy" @onclick="OnCancel">Hủy đơn</button>
</div>

@code {
    [Parameter, EditorRequired] public LockerCheckout Order { get; set; } = null!;
    [Parameter] public string Method { get; set; } = "Cash";
    [Parameter] public DateTime Now { get; set; } = DateTime.UtcNow;
    [Parameter] public bool Busy { get; set; }
    [Parameter] public EventCallback<decimal> OnCash { get; set; }
    [Parameter] public EventCallback OnCancel { get; set; }
}
