@page "/staff/check-ins"
@layout StaffPTLayout
@attribute [Authorize(Roles = "Staff,Manager")]
@using Microsoft.AspNetCore.Authorization
@using VFMS.Client.Components.Operations
@using VFMS.Contracts.CheckIn
@inject VfmsApiClient Api
@implements IDisposable

<PageTitle>Lễ tân check-in | Victor Fitness</PageTitle>

@* UC-46 Front-desk check-in, UC-47 manual check-out, UC-48 active check-ins. *@
<div class="workspace-page space-y-8 font-['Inter',sans-serif] text-[#242424]">
    <PageHeader Overline="VFMS / CHECK-IN" Title="Lễ tân check-in" Description="Tìm hội viên để check-in thủ công, và check-out người đang có mặt. Danh sách tự cập nhật mỗi 30 giây." />

    <Alerts Notice="@_notice" Error="@_error" />

    <section class="grid gap-4 sm:grid-cols-3" aria-label="Thống kê">
        <div class="@Ui.Card">
            <p class="text-xs font-semibold text-[#6F6966]">Đang có mặt</p>
            <p class="workspace-heading mt-2 text-4xl text-[#242424]">@(_data?.CurrentOccupancy ?? 0)</p>
        </div>
        <div class="@Ui.Card">
            <p class="text-xs font-semibold text-[#6F6966]">Lượt check-in hôm nay</p>
            <p class="workspace-heading mt-2 text-4xl text-[#242424]">@(_data?.CheckInsToday ?? 0)</p>
        </div>
        <div class="@Ui.Card">
            <p class="text-xs font-semibold text-[#6F6966]">Mức cao điểm</p>
            <p class="mt-3 flex items-center gap-2">
                <span class="workspace-heading text-2xl text-[#242424]">@(_data?.PeakThreshold ?? 0)</span>
                @if (_data?.IsPeak == true) { <StatusBadge Status="Pending" Label="Đang cao điểm" /> }
                else { <StatusBadge Status="Available" Label="Bình thường" /> }
            </p>
        </div>
    </section>

    <section class="@Ui.ListCard" aria-labelledby="desk-title">
        <div class="@Ui.ListHeader">
            <h2 id="desk-title" class="workspace-heading text-base">Check-in thủ công</h2>
            <form class="mt-3 flex flex-wrap items-end gap-3" @onsubmit="SearchMembers" @onsubmit:preventDefault>
                <label class="@Ui.Label min-w-64 flex-1">Tên, số điện thoại hoặc mã đơn
                    <input class="@Ui.Field" @bind="_memberSearch" placeholder="VD: 0900000004" />
                </label>
                <button type="submit" class="@Ui.PrimaryButton" disabled="@(_searching || _memberSearch.Trim().Length == 0)">@(_searching ? "Đang tìm…" : "Tìm hội viên")</button>
            </form>
        </div>
        @if (_members is null)
        {
            <p class="p-5 text-sm text-[#6F6966]">Nhập thông tin hội viên rồi bấm Tìm hội viên.</p>
        }
        else if (_members.Count == 0)
        {
            <p role="status" class="p-5 text-sm text-[#6F6966]">Không tìm thấy hội viên phù hợp.</p>
        }
        else
        {
            <ul class="divide-y divide-[#D8D1CD]">
                @foreach (var m in _members)
                {
                    <li @key="m.MemberUserId" class="flex flex-wrap items-center justify-between gap-3 px-5 py-4 hover:bg-[#F3EDEA]">
                        <div>
                            <p class="font-semibold">@m.FullName</p>
                            <p class="text-xs text-[#6F6966]">@(m.PhoneNumber ?? "Chưa có số điện thoại")@(m.ValidThrough is { } until ? $" · hiệu lực đến {until:dd/MM/yyyy}" : "")</p>
                        </div>
                        <div class="flex items-center gap-3">
                            <StatusBadge Status="@m.MembershipStatus" Label="@MembershipLabel(m.MembershipStatus)" />
                            @if (m.IsCheckedIn)
                            {
                                <span class="text-xs font-semibold text-[#6F6966]">Đang trong phòng tập</span>
                            }
                            else
                            {
                                <button type="button" class="@Ui.PrimaryButton" disabled="@(_working || m.MembershipStatus != "Active")" @onclick="() => CheckIn(m)">Check-in</button>
                            }
                        </div>
                    </li>
                }
            </ul>
        }
    </section>

    <section class="@Ui.ListCard" aria-labelledby="inside-title">
        <div class="@Ui.ListHeader flex flex-wrap items-end justify-between gap-3">
            <h2 id="inside-title" class="workspace-heading text-base">Đang có mặt</h2>
            <label class="@Ui.Label w-full max-w-sm">Lọc danh sách
                <input class="@Ui.Field" @bind="_search" @bind:event="oninput" @bind:after="Load" placeholder="Tên, số điện thoại hoặc mã đơn" />
            </label>
        </div>
        <div class="overflow-x-auto" aria-live="polite">
            <table class="w-full min-w-[720px] text-left text-sm">
                <thead class="whitespace-nowrap bg-[#ECE8E4] text-xs font-semibold text-[#6F6966]">
                    <tr><th class="px-5 py-3">Hội viên</th><th class="px-5 py-3">Điện thoại</th><th class="px-5 py-3">Vào lúc</th><th class="px-5 py-3">Thời gian</th><th class="px-5 py-3">Cách check-in</th><th class="px-5 py-3 text-right">Thao tác</th></tr>
                </thead>
                <tbody class="divide-y divide-[#D8D1CD]">
                    @if (_data is null || _data.Items.Count == 0)
                    {
                        <tr><td colspan="6" class="px-5 py-6 text-[#6F6966]">Không có hội viên nào đang có mặt.</td></tr>
                    }
                    else
                    {
                        @foreach (var c in _data.Items)
                        {
                            <tr @key="c.CheckInId" class="hover:bg-[#F3EDEA]">
                                <td class="px-5 py-4 font-semibold">@c.MemberName</td>
                                <td class="px-5 py-4">@c.PhoneNumber</td>
                                <td class="px-5 py-4">@GymTime(c.CheckinTime).ToString("HH:mm")</td>
                                <td class="px-5 py-4">@(c.MinutesInside / 60)h @(c.MinutesInside % 60)m</td>
                                <td class="px-5 py-4">@MethodLabel(c.Method)@(c.HandledByName is null ? "" : $" · {c.HandledByName}")</td>
                                <td class="px-5 py-4 text-right">
                                    @if (_confirmOutId == c.CheckInId)
                                    {
                                        <span class="mr-2 text-xs text-[#6F6966]">Check-out @c.MemberName?</span>
                                        <button type="button" class="@Ui.PrimaryButton" disabled="@_working" @onclick="() => CheckOut(c)">Xác nhận</button>
                                        <button type="button" class="@Ui.Button ml-1" @onclick="() => _confirmOutId = null">Không</button>
                                    }
                                    else
                                    {
                                        <button type="button" class="@Ui.Button" disabled="@_working" @onclick="() => _confirmOutId = c.CheckInId">Check-out</button>
                                    }
                                </td>
                            </tr>
                        }
                    }
                </tbody>
            </table>
        </div>
    </section>
</div>

@code {
    private ActiveCheckInsResponse? _data;
    private List<FrontDeskMemberResponse>? _members;
    private string _search = string.Empty, _memberSearch = string.Empty;
    private string? _notice, _error;
    private int? _confirmOutId;
    private bool _searching, _working;
    private Timer? _timer;

    protected override async Task OnInitializedAsync()
    {
        await Load();
        _timer = new Timer(_ => InvokeAsync(async () => { await Load(); StateHasChanged(); }), null, TimeSpan.FromSeconds(30), TimeSpan.FromSeconds(30));
    }

    private async Task Load()
    {
        try { _data = await Api.GetAsync<ActiveCheckInsResponse>($"api/check-ins/active?search={Uri.EscapeDataString(_search)}"); }
        catch (ApiException ex) { _error = ex.Message; }
    }

    private async Task SearchMembers()
    {
        _searching = true;
        _error = null;
        try { _members = await Api.GetAsync<List<FrontDeskMemberResponse>>($"api/check-ins/members?search={Uri.EscapeDataString(_memberSearch.Trim())}"); }
        catch (ApiException ex) when (ex.ErrorCode == "NOT_FOUND") { _members = []; }   // MSG-01: shown as the empty state
        catch (ApiException ex) { _error = ex.Message; }
        finally { _searching = false; }
    }

    private async Task CheckIn(FrontDeskMemberResponse member)
    {
        if (_working) return;
        _working = true;
        _notice = _error = null;
        try
        {
            var r = await Api.PostAsync<CheckInResultResponse>("api/check-ins/manual", new ManualCheckInRequest(member.MemberUserId));
            _notice = $"Đã check-in {r.MemberName} lúc {GymTime(r.CheckinTime):HH:mm}. {r.Message}";
            await SearchMembers();
            await Load();
        }
        catch (ApiException ex) { _error = ex.ErrorCode == "ANTI_PASSBACK" ? $"Chưa thể check-in lại: {ex.Message}" : ex.Message; }
        finally { _working = false; }
    }

    private async Task CheckOut(ActiveCheckInResponse visit)
    {
        if (_working) return;
        _working = true;
        _notice = _error = null;
        try
        {
            var r = await Api.PostAsync<CheckOutResultResponse>($"api/check-ins/{visit.CheckInId}/check-out");
            _notice = $"Đã check-out {r.MemberName}. Thời gian tập: {r.MinutesInside / 60}h {r.MinutesInside % 60}m.";
            _confirmOutId = null;
            await Load();
            if (_members is not null) await SearchMembers();
        }
        catch (ApiException ex) { _error = ex.Message; }
        finally { _working = false; }
    }

    // The API sends UTC with no kind; gym time is UTC+7.
    private static DateTime GymTime(DateTime utc) => DateTime.SpecifyKind(utc, DateTimeKind.Utc).AddHours(7);

    private static string MembershipLabel(string status) => status switch
    {
        "Active" => "Còn hiệu lực",
        "Frozen" => "Đang bảo lưu",
        "Expired" => "Hết hạn",
        "Scheduled" => "Chưa bắt đầu",
        "None" => "Chưa có gói",
        _ => status
    };

    private static string MethodLabel(string method) => method switch
    {
        "FaceRecognition" => "FaceID",
        "QRCode" => "QR",
        "ManualStaff" => "Lễ tân",
        _ => method
    };

    public void Dispose() => _timer?.Dispose();
}
