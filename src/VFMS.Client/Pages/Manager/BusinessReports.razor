@page "/manager/business-reports"
@page "/admin/business-reports"
@layout ManagerAdminLayout
@using System.Globalization
@using System.Net
@using Microsoft.AspNetCore.Authorization
@using VFMS.Contracts.Common
@using VFMS.Contracts.SystemAdministration
@using VFMS.Contracts.SystemAdministration.Validators
@attribute [Authorize(Roles = "Manager,Admin")]
@inject SystemAdministrationApiClient Api
@implements IDisposable

<PageTitle>Báo cáo kinh doanh | Victor Fitness</PageTitle>

<div class="workspace-page space-y-6">
    <header class="border-b border-[#D8DED2] pb-6">
        <p class="mb-2 text-xs font-bold tracking-wider text-[#5F6F52]">VFMS / ANALYTICS</p>
        <h1 class="text-3xl font-extrabold tracking-tight text-[#383E43] sm:text-4xl">Báo cáo kinh doanh<span class="text-[#5F6F52]">.</span></h1>
        <p class="mt-2 text-sm text-[#69706A]">Tạo báo cáo theo ngày, tuần hoặc tháng. Mỗi lần tạo là một bản chụp số liệu tại thời điểm đó.</p>
    </header>

    @if (_notice is not null)
    {
        <p role="status" class="rounded-xl border border-emerald-300 bg-emerald-50 p-4 text-sm text-emerald-900">@_notice</p>
    }
    @if (_error is not null)
    {
        <p role="alert" class="rounded-xl border border-red-300 bg-red-50 p-4 text-sm text-red-900">@_error</p>
    }

    <section class="rounded-xl border border-[#D8DED2] bg-white p-5 sm:p-6 shadow-sm" aria-labelledby="generate-title">
        <h2 id="generate-title" class="text-base font-bold text-[#383E43]">Tạo báo cáo</h2>
        <EditForm Model="_generate" OnValidSubmit="() => GenerateAsync(false)" class="mt-4" novalidate>
            <ContractValidation TRequest="GenerateBusinessReportRequest" Validator="_generateValidator" CreateRequest="CreateGenerateRequest" @ref="_generateValidation" />
            <ValidationSummary />
            <fieldset disabled="@_working" class="mt-4 flex flex-wrap items-end gap-3">
                <label class="text-xs font-semibold text-[#383E43]" for="report-period">
                    Kỳ báo cáo
                    <InputSelect id="report-period" class="@Field" @bind-Value="_generate.PeriodType">
                        <option value="Day">Ngày</option>
                        <option value="Week">Tuần (Thứ 2 – Chủ nhật)</option>
                        <option value="Month">Tháng</option>
                    </InputSelect>
                </label>
                <label class="text-xs font-semibold text-[#383E43]" for="report-date">
                    Một ngày trong kỳ
                    <InputDate id="report-date" class="@Field" @bind-Value="_generate.Date" />
                </label>
                <button type="submit" class="@PrimaryButton">@(_working ? "Đang tạo..." : "Tạo báo cáo")</button>
            </fieldset>
        </EditForm>
        @if (_confirmNew)
        {
            <div role="alert" class="mt-4 flex flex-wrap items-center justify-between gap-3 rounded-xl border border-amber-300 bg-amber-50 p-4 text-sm text-amber-900">
                <p>Báo cáo cho kỳ này đã tồn tại. Bạn muốn tạo một bản chụp số liệu mới?</p>
                <div class="flex gap-2">
                    <button type="button" class="@Button" disabled="@_working" @onclick="() => GenerateAsync(true)">Tạo bản mới</button>
                    <button type="button" class="@Button" disabled="@_working" @onclick="() => _confirmNew = false">Hủy</button>
                </div>
            </div>
        }
    </section>

    @if (_selected is { } report)
    {
        <section class="rounded-xl border border-[#D8DED2] bg-white p-5 sm:p-6 shadow-sm" aria-labelledby="report-title">
            <div class="flex flex-wrap items-start justify-between gap-3">
                <div>
                    <h2 id="report-title" class="text-base font-bold text-[#383E43]">@report.ReportName</h2>
                    <p class="mt-1 text-xs text-[#69706A]">@PeriodLabel(report.PeriodType) · @report.PeriodStart.ToString("dd/MM/yyyy") – @report.PeriodEnd.ToString("dd/MM/yyyy") · Tạo bởi @(report.GeneratedByName ?? "—") lúc @report.GeneratedAt.ToLocalTime().ToString("dd/MM/yyyy HH:mm")</p>
                </div>
                <button type="button" class="@Button" @onclick="() => _selected = null">Đóng chi tiết</button>
            </div>
            @if (!report.HasData)
            {
                <p role="status" class="mt-4 text-sm text-[#69706A]">Không có dữ liệu trong kỳ đã chọn.</p>
            }
            <dl class="mt-4 grid gap-4 sm:grid-cols-2 xl:grid-cols-4">
                @foreach (var metric in report.Metrics)
                {
                    <div class="rounded-xl border border-[#D8DED2] bg-[#F7F4EC] p-5">
                        <dt class="text-xs font-semibold text-[#69706A]">@MetricLabel(metric)</dt>
                        <dd class="mt-3 text-2xl font-extrabold tracking-tight text-[#5F6F52]">@FormatValue(metric)</dd>
                    </div>
                }
            </dl>
        </section>
    }

    <section class="rounded-xl border border-[#D8DED2] bg-white shadow-sm overflow-hidden" aria-labelledby="history-title" aria-busy="@_loading">
        <div class="border-b border-[#D8DED2] p-5 bg-[#EEF1EA]/40">
            <h2 id="history-title" class="mb-3 text-sm font-bold text-[#383E43]">Lịch sử báo cáo</h2>
            <EditForm Model="_filter" OnValidSubmit="() => LoadAsync(1)" novalidate>
                <ContractValidation TRequest="BusinessReportListRequest" Validator="_listValidator" CreateRequest="() => CreateListRequest(1)" />
                <ValidationSummary />
                <fieldset disabled="@_loading" class="flex flex-wrap items-end gap-3">
                    <label class="text-xs font-semibold text-[#383E43]" for="filter-from">
                        Từ ngày
                        <InputDate id="filter-from" class="@Field" @bind-Value="_filter.From" />
                    </label>
                    <label class="text-xs font-semibold text-[#383E43]" for="filter-to">
                        Đến ngày
                        <InputDate id="filter-to" class="@Field" @bind-Value="_filter.To" />
                    </label>
                    <button type="submit" class="@Button">Áp dụng</button>
                </fieldset>
            </EditForm>
        </div>
        @if (_loading)
        {
            <p role="status" class="p-5 text-sm">Đang tải danh sách báo cáo...</p>
        }
        else if (_page is { Items.Count: > 0 } list)
        {
            <div class="overflow-x-auto">
                <table class="workspace-table min-w-[720px]">
                    <thead>
                        <tr><th scope="col">Báo cáo</th><th scope="col">Kỳ</th><th scope="col">Thời gian</th><th scope="col">Người tạo</th><th scope="col">Tạo lúc</th><th scope="col">Thao tác</th></tr>
                    </thead>
                    <tbody>
                        @foreach (var row in list.Items)
                        {
                            <tr @key="row.Id">
                                <th scope="row">@row.ReportName</th>
                                <td>@PeriodLabel(row.PeriodType)</td>
                                <td class="whitespace-nowrap">@row.PeriodStart.ToString("dd/MM/yyyy") – @row.PeriodEnd.ToString("dd/MM/yyyy")</td>
                                <td>@(row.GeneratedByName ?? "—")</td>
                                <td class="whitespace-nowrap">@row.GeneratedAt.ToLocalTime().ToString("dd/MM/yyyy HH:mm")</td>
                                <td><button type="button" class="@Button" aria-label="Xem @row.ReportName" @onclick="() => OpenAsync(row.Id)">Xem</button></td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
            <nav aria-label="Phân trang báo cáo" class="flex flex-wrap items-center justify-between gap-3 border-t border-[#D8DED2] p-4 text-xs font-medium text-[#69706A]">
                <p>Trang @list.Page / @PageCount(list) · @list.TotalCount báo cáo</p>
                <div class="flex gap-2">
                    <button type="button" class="@Button" disabled="@(_loading || list.Page <= 1)" @onclick="() => LoadAsync(list.Page - 1)">Trang trước</button>
                    <button type="button" class="@Button" disabled="@(_loading || list.Page >= PageCount(list))" @onclick="() => LoadAsync(list.Page + 1)">Trang sau</button>
                </div>
            </nav>
        }
        else
        {
            <p role="status" class="p-5 text-sm text-[#69706A]">Chưa có báo cáo nào trong khoảng thời gian này.</p>
        }
    </section>
</div>

@code {
    private const int PageSize = 10;
    private const string Field = "mt-1 block w-full rounded-lg border border-[#D8DED2] bg-white px-3 py-2 text-sm font-normal text-[#383E43] focus:border-[#5F6F52] focus:ring-2 focus:ring-[#5F6F52]/20 outline-none";
    private const string Button = "rounded-lg border border-[#D8DED2] bg-white px-3 py-1.5 text-xs font-semibold text-[#383E43] hover:bg-[#EEF1EA] transition";
    private const string PrimaryButton = "rounded-lg bg-[#5F6F52] px-4 py-2 text-sm font-semibold text-white hover:bg-[#4E5D44] transition shadow-sm";
    private static readonly NumberFormatInfo NumberFormat = new() { NumberGroupSeparator = ".", NumberDecimalSeparator = "," };

    private readonly CancellationTokenSource _lifetime = new();
    private readonly GenerateModel _generate = new();
    private readonly FilterModel _filter = new();
    private readonly GenerateBusinessReportRequestValidator _generateValidator = new();
    private readonly BusinessReportListRequestValidator _listValidator = new();
    private ContractValidation<GenerateBusinessReportRequest>? _generateValidation;
    private PagedResponse<BusinessReportSummaryResponse>? _page;
    private BusinessReportResponse? _selected;
    private string? _notice, _error;
    private bool _working, _loading, _confirmNew;

    protected override Task OnInitializedAsync() => LoadAsync(1);

    private GenerateBusinessReportRequest CreateGenerateRequest() => new(_generate.PeriodType, _generate.Date ?? default);
    private BusinessReportListRequest CreateListRequest(int page) => new(_filter.From, _filter.To, page, PageSize);

    private async Task GenerateAsync(bool confirmNew)
    {
        if (_working) return;
        _working = true;
        _notice = _error = null;
        try
        {
            _selected = await Api.GenerateReportAsync(CreateGenerateRequest() with { ConfirmNew = confirmNew }, _lifetime.Token);
            _confirmNew = false;
            _notice = $"Đã tạo báo cáo {_selected.ReportName}.";
            await LoadAsync(1);
        }
        catch (AuthApiException error) when (error.StatusCode == HttpStatusCode.Conflict) { _confirmNew = true; }
        catch (AuthApiException error)
        {
            _confirmNew = false;
            _error = error.Message;
            _generateValidation?.ShowErrors(error.Errors);
        }
        catch (OperationCanceledException) when (_lifetime.IsCancellationRequested) { }
        finally { _working = false; }
    }

    private async Task LoadAsync(int page)
    {
        _loading = true;
        try { _page = await Api.GetReportsAsync(CreateListRequest(page), _lifetime.Token); }
        catch (AuthApiException error) { _error = error.Message; }
        catch (OperationCanceledException) when (_lifetime.IsCancellationRequested) { }
        finally { _loading = false; }
    }

    private async Task OpenAsync(int id)
    {
        _error = null;
        try { _selected = await Api.GetReportAsync(id, _lifetime.Token); }
        catch (AuthApiException error) { _error = error.Message; }
        catch (OperationCanceledException) when (_lifetime.IsCancellationRequested) { }
    }

    private static int PageCount(PagedResponse<BusinessReportSummaryResponse> page) => Math.Max(1, (int)Math.Ceiling((double)page.TotalCount / page.PageSize));
    private static string PeriodLabel(string type) => type switch { "Day" => "Ngày", "Week" => "Tuần", "Month" => "Tháng", _ => type };

    private static string MetricLabel(ReportMetricResponse metric) => metric.MetricType switch
    {
        "TotalRevenue" => "Tổng doanh thu",
        "NewMembers" => "Hội viên mới",
        "ActiveMemberships" => "Gói tập đang hoạt động",
        "PTSessionsCompleted" => "Buổi PT hoàn thành",
        "YogaClassAttendance" => "Lượt tham gia Yoga",
        "LockerOccupancy" => "Tỷ lệ sử dụng tủ đồ",
        "SupplementSales" => "Doanh số TPBS",
        "EquipmentIssues" => "Sự cố thiết bị",
        _ => metric.MetricName
    };

    private static string FormatValue(ReportMetricResponse metric) => metric.ValueType switch
    {
        "Currency" => $"{metric.Value.ToString("#,##0.##", NumberFormat)} ₫",
        "Percentage" => $"{metric.Value.ToString("0.##", NumberFormat)}%",
        _ => metric.Value.ToString("#,##0", NumberFormat)
    };

    public void Dispose()
    {
        _lifetime.Cancel();
        _lifetime.Dispose();
    }

    private sealed class GenerateModel
    {
        public string PeriodType { get; set; } = "Day";
        public DateOnly? Date { get; set; } = DateOnly.FromDateTime(DateTime.Today);
    }

    private sealed class FilterModel
    {
        public DateOnly? From { get; set; }
        public DateOnly? To { get; set; }
    }
}
