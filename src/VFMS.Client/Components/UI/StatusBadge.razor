@* Status colours from the frontend guidelines; always paired with text. *@
<span class="inline-block whitespace-nowrap border px-2 py-1 text-[10px] font-bold uppercase rounded-none @Tone">@(Label ?? Status)</span>

@code {
    [Parameter, EditorRequired] public string Status { get; set; } = string.Empty;
    [Parameter] public string? Label { get; set; }

    private string Tone => Status switch
    {
        "Active" or "Approved" or "Confirmed" or "Completed" or "Paid" or "Available" or "Open" or "Attended" or "Scheduled"
            => "border-[#10B981] bg-emerald-50 text-[#047857]",
        "Pending" or "Processing" or "Frozen" or "Waitlisted" or "Draft" or "Full" or "Ongoing"
            => "border-[#F59E0B] bg-amber-50 text-[#92400E]",
        "Rejected" or "Expired" or "NoShow" or "Overdue" or "Locked" or "Escalated"
            => "border-[#EF4444] bg-red-50 text-[#B91C1C]",
        _ => "border-[#4B5563] bg-neutral-100 text-[#4B5563]"
    };
}
