@page "/gym-details"
@layout PublicLayout
@using System.Globalization
@using VFMS.Contracts.Common
@using VFMS.Contracts.Equipment
@using VFMS.Contracts.Memberships
@implements IDisposable
@inject OperationsApiClient Operations
@inject MembershipPlanApiClient Plans

@* UC-70 View Gym Details & Facilities: public, for guests, customers and members. *@

<PageTitle>Thông tin phòng tập | Victor Fitness</PageTitle>

<div class="w-full min-h-screen bg-[#F2EFEC] text-[#242424] font-['Inter',sans-serif] pt-28 pb-20">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">

        @if (_loading)
        {
            <div class="animate-pulse space-y-6" aria-busy="true" aria-label="Đang tải thông tin phòng tập...">
                <div class="h-10 w-2/3 bg-[#ECE8E4] rounded"></div>
                <div class="h-56 w-full bg-[#ECE8E4] rounded-xl"></div>
                <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
                    @for (var i = 0; i < 3; i++)
                    {
                        <div class="h-32 bg-[#ECE8E4] rounded-xl"></div>
                    }
                </div>
            </div>
        }
        else if (_details is null)
        {
            <div role="alert" class="bg-[#F8F5F2] border border-[#DC2626]/30 rounded-xl p-8 sm:p-10 text-center max-w-xl mx-auto shadow-sm">
                <div class="w-12 h-12 mx-auto mb-4 bg-red-100 text-[#DC2626] rounded-full flex items-center justify-center font-bold text-xl">!</div>
                <h1 class="font-['Montserrat',sans-serif] text-lg font-bold text-[#242424] mb-2 uppercase">
                    Không thể tải thông tin phòng tập
                </h1>
                <p class="text-sm text-[#6F6966] mb-6">@(_errorMessage ?? "Vui lòng kiểm tra kết nối mạng và thử lại.")</p>
                <button type="button" @onclick="LoadAsync"
                        class="min-h-[44px] px-6 py-3 bg-[#B83A3A] hover:bg-[#9F3030] text-white font-['Montserrat',sans-serif] font-bold text-xs uppercase tracking-wider rounded-lg transition-colors cursor-pointer">
                    THỬ LẠI
                </button>
            </div>
        }
        else
        {
            var gym = _details;

            <!-- 1. HEADER -->
            <header class="border-b border-[#D8D1CD] pb-8 mb-8">
                <div class="inline-flex items-center gap-2 mb-3">
                    <span class="w-2.5 h-2.5 bg-[#B83A3A] inline-block rounded-full"></span>
                    <p class="font-['Montserrat',sans-serif] text-[11px] font-bold tracking-[.18em] uppercase text-[#B83A3A]">
                        VICTOR FITNESS / THÔNG TIN PHÒNG TẬP
                    </p>
                </div>
                <h1 class="font-['Montserrat',sans-serif] text-3xl sm:text-4xl lg:text-5xl font-black uppercase tracking-tight text-[#242424]">
                    @gym.GymName<span class="text-[#B83A3A]">.</span>
                </h1>
                <div class="mt-4 flex flex-wrap gap-2">
                    @if (OpenState(gym) is { } open)
                    {
                        <span class="inline-flex items-center gap-1.5 text-[11px] font-['Montserrat',sans-serif] font-bold uppercase tracking-wider px-3 py-1.5 rounded @(open ? "bg-[#E3EFE6] text-[#2F6B3F]" : "bg-[#ECE8E4] text-[#6F6966]")"
                              data-testid="open-state">
                            <span class="w-2 h-2 rounded-full @(open ? "bg-[#2F6B3F]" : "bg-[#8C8581]")" aria-hidden="true"></span>
                            @(open ? "Đang mở cửa" : "Đã đóng cửa")
                        </span>
                    }
                    <span class="inline-flex items-center text-[11px] font-['Montserrat',sans-serif] font-bold uppercase tracking-wider px-3 py-1.5 rounded @(gym.IsAcceptingMembers ? "bg-[#F3E4E2] text-[#B83A3A]" : "bg-[#ECE8E4] text-[#6F6966]")">
                        @(gym.IsAcceptingMembers ? "Đang nhận hội viên mới" : "Tạm ngừng nhận hội viên mới")
                    </span>
                </div>
            </header>

            <!-- 2. PHOTO + CONTACT -->
            <section class="grid grid-cols-1 lg:grid-cols-5 gap-6 mb-12" aria-label="Hình ảnh và liên hệ">
                <figure class="lg:col-span-3 relative overflow-hidden rounded-xl border border-[#D8D1CD] bg-[#242424] min-h-[240px]">
                    <img src="/images/hero-bg.png" alt="Không gian tập luyện tại @gym.GymName"
                         class="absolute inset-0 w-full h-full object-cover opacity-90" loading="lazy" />
                    <figcaption class="absolute bottom-0 inset-x-0 bg-gradient-to-t from-black/70 to-transparent p-5 text-white text-sm">
                        Không gian tập luyện tại @gym.GymName
                    </figcaption>
                </figure>

                <dl class="lg:col-span-2 bg-[#F8F5F2] border border-[#D8D1CD] rounded-xl p-6 sm:p-7 space-y-5 shadow-sm">
                    <div>
                        <dt class="@Label">Giờ mở cửa</dt>
                        <dd class="mt-1 font-['Montserrat',sans-serif] text-2xl font-black text-[#242424]" data-testid="opening-hours">
                            @Hours(gym)
                        </dd>
                        <dd class="text-xs text-[#6F6966]">Tất cả các ngày trong tuần</dd>
                    </div>
                    <div>
                        <dt class="@Label">Địa chỉ</dt>
                        <dd class="mt-1 text-sm leading-relaxed">
                            @if (string.IsNullOrWhiteSpace(gym.Address))
                            {
                                <span class="text-[#6F6966]">Đang cập nhật</span>
                            }
                            else
                            {
                                @gym.Address
                                <a class="block mt-1 text-xs font-semibold text-[#B83A3A] hover:underline" target="_blank" rel="noopener noreferrer"
                                   href="@MapLink(gym.Address)">Xem bản đồ ↗</a>
                            }
                        </dd>
                    </div>
                    <div>
                        <dt class="@Label">Liên hệ</dt>
                        <dd class="mt-1 text-sm space-y-1">
                            @if (string.IsNullOrWhiteSpace(gym.PhoneNumber) && string.IsNullOrWhiteSpace(gym.Email))
                            {
                                <span class="text-[#6F6966]">Đang cập nhật</span>
                            }
                            @if (!string.IsNullOrWhiteSpace(gym.PhoneNumber))
                            {
                                <a class="block font-semibold hover:text-[#B83A3A]" href="tel:@gym.PhoneNumber.Replace(" ", "")">@gym.PhoneNumber</a>
                            }
                            @if (!string.IsNullOrWhiteSpace(gym.Email))
                            {
                                <a class="block hover:text-[#B83A3A] break-all" href="mailto:@gym.Email">@gym.Email</a>
                            }
                        </dd>
                    </div>
                </dl>
            </section>

            <!-- 3. FACILITIES -->
            <section class="mb-12" aria-labelledby="facilities-title">
                <h2 id="facilities-title" class="@SectionTitle">Cơ sở vật chất</h2>

                @if (gym.EquipmentAreas.Count == 0 && gym.YogaStudios.Count == 0 && gym.LockerZones.Count == 0)
                {
                    <p class="text-sm text-[#6F6966]">Thông tin cơ sở vật chất đang được cập nhật.</p>
                }

                @if (gym.EquipmentAreas.Count > 0)
                {
                    <h3 class="@SubTitle">Thiết bị tập luyện · @gym.EquipmentAreas.Sum(a => a.Total) máy</h3>
                    <ul class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-4 mb-8" data-testid="equipment-areas">
                        @foreach (var area in gym.EquipmentAreas)
                        {
                            <li class="@Card">
                                <p class="font-['Montserrat',sans-serif] font-bold uppercase text-sm">@(area.CategoryName ?? "Thiết bị khác")</p>
                                @if (!string.IsNullOrWhiteSpace(area.Description))
                                {
                                    <p class="text-xs text-[#6F6966] mt-1 line-clamp-2">@area.Description</p>
                                }
                                <p class="mt-3 font-['Montserrat',sans-serif] text-2xl font-black">@area.Total <span class="text-xs font-semibold text-[#6F6966]">máy</span></p>
                                <p class="text-xs text-[#6F6966]">@area.Available đang sẵn sàng</p>
                            </li>
                        }
                    </ul>
                }

                <div class="grid grid-cols-1 lg:grid-cols-2 gap-6">
                    @if (gym.YogaStudios.Count > 0)
                    {
                        <div>
                            <h3 class="@SubTitle">Phòng Yoga</h3>
                            <ul class="space-y-3" data-testid="yoga-studios">
                                @foreach (var studio in gym.YogaStudios)
                                {
                                    <li class="@Card flex items-center justify-between gap-4">
                                        <div>
                                            <p class="font-semibold text-sm">@studio.StudioName</p>
                                            <p class="text-xs text-[#6F6966]">Tầng @studio.FloorNumber</p>
                                        </div>
                                        <p class="text-xs text-[#6F6966] whitespace-nowrap">Tối đa @studio.Capacity người</p>
                                    </li>
                                }
                            </ul>
                            <a href="/yoga/schedule" class="inline-block mt-3 text-xs font-semibold text-[#B83A3A] hover:underline">Xem lịch tập Yoga →</a>
                        </div>
                    }
                    @if (gym.LockerZones.Count > 0)
                    {
                        <div>
                            <h3 class="@SubTitle">Khu tủ đồ</h3>
                            <ul class="space-y-3" data-testid="locker-zones">
                                @foreach (var zone in gym.LockerZones)
                                {
                                    <li class="@Card flex items-center justify-between gap-4">
                                        <div>
                                            <p class="font-semibold text-sm">@zone.ZoneName</p>
                                            <p class="text-xs text-[#6F6966]">Tầng @zone.FloorNumber · @GenderLabel(zone.GenderRestriction)</p>
                                        </div>
                                        <p class="text-xs text-[#6F6966] whitespace-nowrap">@zone.TotalLockers tủ</p>
                                    </li>
                                }
                            </ul>
                        </div>
                    }
                </div>
            </section>

            <!-- 4. MEMBERSHIP PRICES -->
            <section class="mb-12" aria-labelledby="prices-title">
                <div class="flex flex-wrap items-baseline justify-between gap-3 mb-4">
                    <h2 id="prices-title" class="@TitleText">Bảng giá hội viên</h2>
                    <a href="/membership-plans" class="text-xs font-semibold text-[#B83A3A] hover:underline">Xem tất cả gói →</a>
                </div>
                @if (_plans is null)
                {
                    <p class="text-sm text-[#6F6966]">Không tải được bảng giá lúc này. <a href="/membership-plans" class="text-[#B83A3A] font-semibold hover:underline">Mở trang gói hội viên</a>.</p>
                }
                else if (_plans.Count == 0)
                {
                    <p class="text-sm text-[#6F6966]">Phòng tập đang cập nhật các gói hội viên.</p>
                }
                else
                {
                    <div class="overflow-x-auto bg-[#F8F5F2] border border-[#D8D1CD] rounded-xl shadow-sm">
                        <table class="w-full text-sm" data-testid="plan-prices">
                            <thead class="text-left text-[11px] uppercase tracking-wider text-[#6F6966] border-b border-[#D8D1CD]">
                                <tr>
                                    <th scope="col" class="px-5 py-3 font-semibold">Gói</th>
                                    <th scope="col" class="px-5 py-3 font-semibold">Loại</th>
                                    <th scope="col" class="px-5 py-3 font-semibold">Thời hạn</th>
                                    <th scope="col" class="px-5 py-3 font-semibold text-right">Giá</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var plan in _plans)
                                {
                                    <tr @key="plan.Id" class="border-b border-[#ECE8E4] last:border-b-0">
                                        <td class="px-5 py-3 font-semibold">@plan.Name</td>
                                        <td class="px-5 py-3 text-xs text-[#6F6966]">@(plan.ServiceType == MembershipPlanServiceTypes.Yoga ? "Yoga" : "Gym")</td>
                                        <td class="px-5 py-3 text-xs">@Duration(plan)</td>
                                        <td class="px-5 py-3 text-right font-['Montserrat',sans-serif] font-black whitespace-nowrap">@Vnd(plan.Price)</td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                }
            </section>

            <!-- 5. FREEZE POLICY -->
            <section class="mb-12" aria-labelledby="freeze-title">
                <h2 id="freeze-title" class="@SectionTitle">Chính sách bảo lưu gói Gym</h2>
                @if (gym.FreezePolicy is not { } policy)
                {
                    <p class="text-sm text-[#6F6966]">Chính sách bảo lưu đang được cập nhật. Vui lòng liên hệ quầy lễ tân để được hỗ trợ.</p>
                }
                else
                {
                    <div class="bg-[#F8F5F2] border border-[#D8D1CD] rounded-xl p-6 sm:p-7 shadow-sm" data-testid="freeze-policy">
                        <ul class="space-y-3 text-sm">
                            <li class="flex gap-2.5"><span class="text-[#B83A3A] font-bold">▪</span>
                                <span>Mỗi lần bảo lưu từ <strong>@policy.MinimumFreezeDays</strong> đến <strong>@policy.MaximumFreezeDays ngày</strong>.</span></li>
                            <li class="flex gap-2.5"><span class="text-[#B83A3A] font-bold">▪</span>
                                <span>Gửi yêu cầu trước ngày bắt đầu bảo lưu ít nhất <strong>@policy.MinimumRequestDays ngày</strong>.</span></li>
                            @if (policy.EligibilityPaidDays > 0)
                            {
                                <li class="flex gap-2.5"><span class="text-[#B83A3A] font-bold">▪</span>
                                    <span>Gửi yêu cầu sau ít nhất <strong>@policy.EligibilityPaidDays ngày</strong> kể từ ngày kích hoạt gói.</span></li>
                            }
                        </ul>
                        @if (policy.DefaultMaxFreezeCount is { } count)
                        {
                            <p class="mt-5 text-sm text-vfms-text-secondary">
                                Gói Gym mặc định có <strong class="text-vfms-text">@count lượt bảo lưu</strong>.
                                Xem quyền lợi cụ thể trong chi tiết từng gói.
                            </p>
                        }
                    </div>
                }
            </section>

            <!-- 6. CALL TO ACTION -->
            <section class="bg-[#242424] text-white rounded-xl p-6 sm:p-8 flex flex-col sm:flex-row sm:items-center justify-between gap-4">
                <div>
                    <p class="font-['Montserrat',sans-serif] text-lg font-black uppercase">Bắt đầu tập cùng @gym.GymName</p>
                    <p class="text-sm text-[#D8D1CD]">Chọn gói phù hợp và đăng ký trực tuyến.</p>
                </div>
                <a href="/membership-plans"
                   class="min-h-[44px] inline-flex items-center justify-center px-6 py-3 bg-[#B83A3A] hover:bg-[#9F3030] text-white font-['Montserrat',sans-serif] font-bold text-xs uppercase tracking-wider rounded-lg transition-colors">
                    XEM GÓI HỘI VIÊN
                </a>
            </section>
        }
    </div>
</div>

@code {
    private const string Label = "text-[11px] font-['Montserrat',sans-serif] font-bold uppercase tracking-wider text-[#8C8581]";
    private const string TitleText = "font-['Montserrat',sans-serif] text-xl sm:text-2xl font-black uppercase tracking-tight";
    private const string SectionTitle = TitleText + " mb-4";
    private const string SubTitle = "font-['Montserrat',sans-serif] text-xs font-bold uppercase tracking-wider text-[#6F6966] mb-3";
    private const string Card = "bg-[#F8F5F2] border border-[#D8D1CD] rounded-xl p-4 shadow-sm";
    private static readonly CultureInfo VietnameseCulture = CultureInfo.GetCultureInfo("vi-VN");

    private readonly CancellationTokenSource _cts = new();
    private GymDetailsResponse? _details;
    private IReadOnlyCollection<MembershipPlanCatalogItemResponse>? _plans;
    private string? _errorMessage;
    private bool _loading = true;

    protected override Task OnInitializedAsync() => LoadAsync();

    private async Task LoadAsync()
    {
        _loading = true;
        _errorMessage = null;
        var details = LoadDetailsAsync();
        var plans = LoadPlansAsync();
        await Task.WhenAll(details, plans);
        _loading = false;
    }

    private async Task LoadDetailsAsync()
    {
        try
        {
            _details = await Operations.GetGymDetailsAsync(_cts.Token);
        }
        catch (OperationCanceledException) { }
        catch (AuthApiException error)
        {
            _details = null;
            _errorMessage = error.Message;
        }
        catch (HttpRequestException)
        {
            _details = null;
        }
    }

    /// <summary>The price list is a bonus here: when it fails, the rest of the page still shows.</summary>
    private async Task LoadPlansAsync()
    {
        try
        {
            _plans = (await Plans.ListCatalogAsync(1, _cts.Token)).Items;
        }
        catch (OperationCanceledException) { }
        catch (Exception)
        {
            _plans = null;
        }
    }

    /// <summary>Open now, closed now, or null when the opening hours are not set. Gym time is UTC+7.</summary>
    public static bool? OpenState(GymDetailsResponse gym, DateTime? utcNow = null)
    {
        if (gym.OpenTime is not { } open || gym.CloseTime is not { } close)
            return null;
        var now = TimeOnly.FromDateTime((utcNow ?? DateTime.UtcNow).AddHours(7));
        return now >= open && now < close;
    }

    public static string Hours(GymDetailsResponse gym) =>
        gym.OpenTime is { } open && gym.CloseTime is { } close
            ? $"{open:HH\\:mm} – {close:HH\\:mm}"
            : "Đang cập nhật";

    public static string Duration(MembershipPlanCatalogItemResponse plan) =>
        plan.DurationValue is > 0 ? $"{plan.DurationValue} {(plan.DurationUnit == MembershipDurationUnit.Month ? "tháng" : "ngày")}"
        : "—";

    private static string GenderLabel(string restriction) => restriction switch
    {
        "Male" => "Nam",
        "Female" => "Nữ",
        _ => "Dùng chung",
    };

    private static string MapLink(string address) =>
        "https://www.google.com/maps/search/?api=1&query=" + Uri.EscapeDataString(address);

    private static string Vnd(decimal amount) => amount.ToString("#,0.##", VietnameseCulture) + " ₫";

    public void Dispose()
    {
        _cts.Cancel();
        _cts.Dispose();
    }
}
