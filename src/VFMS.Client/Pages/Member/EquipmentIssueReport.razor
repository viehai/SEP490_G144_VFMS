@page "/equipment-issues"
@layout PublicLayout
@using Microsoft.AspNetCore.Authorization
@using VFMS.Client.Components.Operations
@using VFMS.Contracts.Common
@using VFMS.Contracts.Equipment
@attribute [Authorize(Roles = "Member")]
@inject OperationsApiClient Api
@implements IDisposable

<PageTitle>Báo hỏng thiết bị | Victor Fitness</PageTitle>

<section class="mx-auto max-w-4xl space-y-6 px-5 pb-16 pt-28" aria-labelledby="report-title">
    <header class="space-y-2 border-b border-[#D8DED2] pb-5">
        <h1 id="report-title" class="font-['Montserrat',sans-serif] text-3xl font-black text-[#383E43]">Báo hỏng thiết bị</h1>
        <p class="text-sm text-[#69706A]">Thấy máy tập có vấn đề? Gửi báo cáo, nhân viên sẽ kiểm tra và cập nhật kết quả cho bạn.</p>
    </header>

    <Alerts Notice="@_notice" Error="@_error" />

    <div class="@Ui.Card">
        <EquipmentIssueReportForm OnReported="ReportedAsync" />
    </div>

    <section class="@Ui.ListCard" aria-labelledby="mine-title" aria-busy="@_loading">
        <div class="@Ui.ListHeader"><h2 id="mine-title" class="text-sm font-bold text-[#383E43]">Báo cáo của tôi</h2></div>
        @if (_loading)
        {
            <p role="status" class="p-5 text-sm">Đang tải...</p>
        }
        else if (_mine is { Items.Count: > 0 } list)
        {
            <ul class="divide-y divide-[#EEF1EA]">
                @foreach (var row in list.Items)
                {
                    <li @key="row.Id" class="space-y-1 px-5 py-4">
                        <div class="flex flex-wrap items-center justify-between gap-2">
                            <p class="text-sm font-semibold text-[#383E43]">@row.EquipmentName <span class="text-xs font-normal text-[#8A9089]">· @OperationsText.Label(row.IncidentType) · @OperationsText.Local(row.ReportedAt)</span></p>
                            <span class="@OperationsText.Badge(row.Status)">@OperationsText.Label(row.Status)</span>
                        </div>
                        <p class="text-sm text-[#69706A]">@row.Description</p>
                        @if (row.ResolutionNote is { } note)
                        {
                            <p class="text-xs text-[#383E43]"><span class="font-semibold">Phản hồi:</span> @note</p>
                        }
                    </li>
                }
            </ul>
            <Pager Page="list.Page" PageSize="list.PageSize" TotalCount="list.TotalCount" Noun="báo cáo" AriaLabel="Phân trang báo cáo" Disabled="_loading" OnPage="LoadMineAsync" />
        }
        else
        {
            <p role="status" class="p-5 text-sm text-[#69706A]">Bạn chưa gửi báo cáo nào.</p>
        }
    </section>
</section>

@code {
    private readonly CancellationTokenSource _lifetime = new();
    private PagedResponse<EquipmentIssueResponse>? _mine;
    private string? _notice, _error;
    private bool _loading;

    protected override Task OnInitializedAsync() => LoadMineAsync(1);

    private async Task LoadMineAsync(int page)
    {
        _loading = true;
        try { _mine = await Api.GetIssuesAsync(new(null, null, page, 10), mine: true, ct: _lifetime.Token); }
        catch (AuthApiException error) { _error = error.Message; }
        catch (OperationCanceledException) when (_lifetime.IsCancellationRequested) { }
        finally { _loading = false; }
    }

    private async Task ReportedAsync(EquipmentIssueResponse saved)
    {
        _notice = $"Đã gửi báo cáo cho \"{saved.EquipmentName}\". Cảm ơn bạn!";
        _error = null;
        await LoadMineAsync(1);
    }

    public void Dispose()
    {
        _lifetime.Cancel();
        _lifetime.Dispose();
    }
}
