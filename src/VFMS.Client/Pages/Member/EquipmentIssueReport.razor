@page "/equipment-issues"
@layout PublicLayout
@using Microsoft.AspNetCore.Authorization
@using VFMS.Client.Components.Operations
@using VFMS.Contracts.Common
@using VFMS.Contracts.Equipment
@using VFMS.Contracts.Equipment.Validators
@attribute [Authorize(Roles = "Member")]
@inject OperationsApiClient Api
@implements IDisposable

<PageTitle>Báo hỏng thiết bị | Victor Fitness</PageTitle>

<section class="mx-auto max-w-4xl space-y-6 px-5 pb-16 pt-28" aria-labelledby="report-title">
    <header class="space-y-2 border-b border-[#D8DED2] pb-5">
        <h1 id="report-title" class="font-['Montserrat',sans-serif] text-3xl font-black text-[#383E43]">Báo hỏng thiết bị</h1>
        <p class="text-sm text-[#69706A]">Thấy máy tập có vấn đề? Gửi báo cáo, nhân viên sẽ kiểm tra và cập nhật kết quả cho bạn.</p>
    </header>

    <Alerts Notice="@_notice" Error="@_error" />

    <div class="@Ui.Card">
        <EditForm Model="_form" OnValidSubmit="() => SubmitAsync(false)" novalidate>
            <OperationsValidation TRequest="ReportEquipmentIssueRequest" Validator="_validator" CreateRequest="() => CreateRequest(false)" @ref="_validation" />
            <ValidationSummary />
            <fieldset disabled="@_working" class="mt-2 grid gap-4 sm:grid-cols-2">
                <label class="@Ui.Label sm:col-span-2" for="find-equipment">Tìm thiết bị
                    <div class="flex gap-2">
                        <input id="find-equipment" type="search" class="@Ui.Field" @bind="_search" @bind:event="oninput" @onkeydown="SearchOnEnter" maxlength="100" placeholder="Tên hoặc mã thiết bị" />
                        <button type="button" class="@Ui.Button mt-1" @onclick="SearchAsync">Tìm</button>
                    </div>
                </label>
                <label class="@Ui.Label" for="report-equipment">Thiết bị
                    <InputSelect id="report-equipment" class="@Ui.Field" @bind-Value="_form.EquipmentId">
                        <option value="0">@(_equipment.Count == 0 ? "Không tìm thấy thiết bị" : "Chọn thiết bị")</option>
                        @foreach (var item in _equipment)
                        {
                            <option value="@item.Id">@item.Name@(item.Code is { } code ? $" · {code}" : "")</option>
                        }
                    </InputSelect>
                </label>
                <label class="@Ui.Label" for="report-type">Loại sự cố
                    <InputSelect id="report-type" class="@Ui.Field" @bind-Value="_form.IncidentType">
                        @foreach (var type in OperationsText.IncidentTypes) { <option value="@type">@OperationsText.Label(type)</option> }
                    </InputSelect>
                </label>
                <label class="@Ui.Label sm:col-span-2" for="report-description">Mô tả sự cố
                    <InputTextArea id="report-description" class="@Ui.Field" rows="4" @bind-Value="_form.Description" maxlength="1000" placeholder="VD: Dây cáp máy kéo xô bị sờn, phát ra tiếng kêu khi kéo." />
                </label>
                <label class="@Ui.Label sm:col-span-2" for="report-image">Link ảnh (không bắt buộc)
                    <InputText id="report-image" class="@Ui.Field" @bind-Value="_form.ImageUrl" placeholder="https://..." />
                </label>
                @if (_duplicate)
                {
                    <div class="rounded-xl border border-amber-300 bg-amber-50 p-4 text-sm text-amber-900 sm:col-span-2" role="alert">
                        <p>Thiết bị này đã có báo cáo đang được xử lý. Bạn vẫn muốn gửi thêm báo cáo?</p>
                        <div class="mt-3 flex gap-2">
                            <button type="button" class="@Ui.PrimaryButton" @onclick="() => SubmitAsync(true)">Vẫn gửi</button>
                            <button type="button" class="@Ui.Button" @onclick="() => _duplicate = false">Thôi</button>
                        </div>
                    </div>
                }
                <div class="sm:col-span-2">
                    <button type="submit" class="@Ui.PrimaryButton">@(_working ? "Đang gửi..." : "Gửi báo cáo")</button>
                </div>
            </fieldset>
        </EditForm>
    </div>

    <section class="@Ui.ListCard" aria-labelledby="mine-title" aria-busy="@_loading">
        <div class="@Ui.ListHeader"><h2 id="mine-title" class="text-sm font-bold text-[#383E43]">Báo cáo của tôi</h2></div>
        @if (_loading)
        {
            <p role="status" class="p-5 text-sm">Đang tải...</p>
        }
        else if (_mine is { Items.Count: > 0 } list)
        {
            <ul class="divide-y divide-[#EEF1EA]">
                @foreach (var row in list.Items)
                {
                    <li @key="row.Id" class="space-y-1 px-5 py-4">
                        <div class="flex flex-wrap items-center justify-between gap-2">
                            <p class="text-sm font-semibold text-[#383E43]">@row.EquipmentName <span class="text-xs font-normal text-[#8A9089]">· @OperationsText.Label(row.IncidentType) · @OperationsText.Local(row.ReportedAt)</span></p>
                            <span class="@OperationsText.Badge(row.Status)">@OperationsText.Label(row.Status)</span>
                        </div>
                        <p class="text-sm text-[#69706A]">@row.Description</p>
                        @if (row.ResolutionNote is { } note)
                        {
                            <p class="text-xs text-[#383E43]"><span class="font-semibold">Phản hồi:</span> @note</p>
                        }
                    </li>
                }
            </ul>
            <Pager Page="list.Page" PageSize="list.PageSize" TotalCount="list.TotalCount" Noun="báo cáo" AriaLabel="Phân trang báo cáo" Disabled="_loading" OnPage="LoadMineAsync" />
        }
        else
        {
            <p role="status" class="p-5 text-sm text-[#69706A]">Bạn chưa gửi báo cáo nào.</p>
        }
    </section>
</section>

@code {
    private readonly CancellationTokenSource _lifetime = new();
    private readonly ReportModel _form = new();
    private readonly ReportEquipmentIssueRequestValidator _validator = new();
    private OperationsValidation<ReportEquipmentIssueRequest>? _validation;
    private List<EquipmentResponse> _equipment = [];
    private PagedResponse<EquipmentIssueResponse>? _mine;
    private string _search = "";
    private string? _notice, _error;
    private bool _loading, _working, _duplicate;

    protected override async Task OnInitializedAsync()
    {
        await SearchAsync();
        await LoadMineAsync(1);
    }

    private ReportEquipmentIssueRequest CreateRequest(bool confirmDuplicate) => new(_form.EquipmentId, _form.IncidentType,
        _form.Description.Trim(), string.IsNullOrWhiteSpace(_form.ImageUrl) ? null : _form.ImageUrl.Trim(), confirmDuplicate);

    private async Task SearchOnEnter(KeyboardEventArgs args)
    {
        if (args.Key == "Enter") await SearchAsync();
    }

    private async Task SearchAsync()
    {
        try
        {
            var page = await Api.GetEquipmentAsync(new(string.IsNullOrWhiteSpace(_search) ? null : _search.Trim(), null, null, 1, 100), _lifetime.Token);
            _equipment = page.Items.Where(item => item.Status != "Retired").ToList();
            if (_equipment.All(item => item.Id != _form.EquipmentId)) _form.EquipmentId = _equipment.Count == 1 ? _equipment[0].Id : 0;
        }
        catch (AuthApiException error) { _error = error.Message; }
        catch (OperationCanceledException) when (_lifetime.IsCancellationRequested) { }
    }

    private async Task LoadMineAsync(int page)
    {
        _loading = true;
        try { _mine = await Api.GetIssuesAsync(new(null, null, page, 10), mine: true, ct: _lifetime.Token); }
        catch (AuthApiException error) { _error = error.Message; }
        catch (OperationCanceledException) when (_lifetime.IsCancellationRequested) { }
        finally { _loading = false; }
    }

    private async Task SubmitAsync(bool confirmDuplicate)
    {
        if (_working) return;
        _working = true;
        _notice = _error = null;
        try
        {
            var saved = await Api.ReportIssueAsync(CreateRequest(confirmDuplicate), _lifetime.Token);
            _notice = $"Đã gửi báo cáo cho \"{saved.EquipmentName}\". Cảm ơn bạn!";
            _duplicate = false;
            _form.Description = "";
            _form.ImageUrl = null;
            await LoadMineAsync(1);
        }
        catch (AuthApiException error) when (error.ErrorCode == "EQUIPMENT_ISSUE_DUPLICATE")
        {
            _duplicate = true;
        }
        catch (AuthApiException error)
        {
            _error = error.Message;
            _validation?.ShowErrors(error.Errors);
        }
        catch (OperationCanceledException) when (_lifetime.IsCancellationRequested) { }
        finally { _working = false; }
    }

    public void Dispose()
    {
        _lifetime.Cancel();
        _lifetime.Dispose();
    }

    private sealed class ReportModel
    {
        public int EquipmentId { get; set; }
        public string IncidentType { get; set; } = "Malfunction";
        public string Description { get; set; } = "";
        public string? ImageUrl { get; set; }
    }
}
