@* Semantic status colours (frontend guideline 6.E); always paired with text. *@
<span class="trainer-status @Tone">@(Status switch
    {
        "Pending" => "Chờ duyệt", "UnderReview" => "Đang xem xét", "Interviewing" => "Đang phỏng vấn",
        "Hired" => "Đã tuyển", "Approved" => "Đã duyệt", "Rejected" => "Từ chối",
        "Booked" => "Đã đặt", "Available" => "Còn trống", "Past" => "Đã qua",
        "Active" => "Đang hoạt động", "Frozen" => "Bảo lưu", "Completed" => "Hoàn thành",
        "Scheduled" => "Đã lên lịch", "Cancelled" => "Đã hủy", "NoShow" => "Vắng mặt", _ => Status
    })</span>
@code {
    [Parameter, EditorRequired] public string Status { get; set; } = "";

    private string Tone => Status switch
    {
        "Hired" or "Approved" or "Available" or "Active" or "Completed" => "trainer-status--success",
        "Pending" or "UnderReview" or "Interviewing" or "Booked" or "Frozen" or "Scheduled" => "trainer-status--pending",
        "Rejected" or "NoShow" => "trainer-status--danger",
        _ => "trainer-status--neutral"
    };
}
