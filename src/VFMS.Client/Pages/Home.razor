@page "/"
@layout PublicLayout
@inject NavigationManager Navigation
@inject IJSRuntime JS

<PageTitle>VFMS - Kỷ Luật Thép & Đỉnh Cao Thể Lực</PageTitle>

<!-- Global Styles Scoped to Home for Brutal Minimalism, Marquee & Scroll Reveal -->
<style>
    .font-heading {
        font-family: 'Montserrat', sans-serif;
        text-transform: uppercase;
        letter-spacing: 0.05em;
    }

    .font-body {
        font-family: 'Inter', sans-serif;
    }

    /* Đảm bảo tuyệt đối không bo góc và không đổ bóng theo quy chuẩn Brutal Minimalism */
    .brutal-card, .brutal-btn, .brutal-badge, .brutal-img {
        border-radius: 0px !important;
        box-shadow: none !important;
    }

    /* Infinite Marquee Animation - Không bị ngắt quãng */
    @@keyframes marquee {
        0% { transform: translateX(0%); }
        100% { transform: translateX(-50%); }
    }

    .animate-marquee {
        display: flex;
        width: max-content;
        animation: marquee 28s linear infinite;
    }

    .animate-marquee:hover {
        animation-play-state: paused;
    }

    /* Scroll Reveal Animation: Trượt chậm từ phải sang trái (Cinematic Slow Slide) */
    .slide-reveal-right {
        opacity: 0;
        transform: translateX(90px);
        transition: opacity 1.4s cubic-bezier(0.16, 1, 0.3, 1), transform 1.4s cubic-bezier(0.16, 1, 0.3, 1);
        will-change: opacity, transform;
    }

    .slide-reveal-right.revealed {
        opacity: 1;
        transform: translateX(0);
    }
</style>

