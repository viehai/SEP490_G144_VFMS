@inherits LayoutComponentBase

<div class="auth-shell">
    <aside class="auth-brand" aria-label="Victor Fitness">
        <div class="auth-brand-lines" aria-hidden="true">
            <span class="auth-brand-line"></span>
            <span class="auth-brand-line"></span>
        </div>
        <a class="auth-logo" href="/" aria-label="Victor Fitness - Trang chủ"><img src="/brand/logo-remove.png" alt="Victor Fitness" /></a>
        <div class="auth-brand-copy">
            <p class="auth-overline">VICTOR FITNESS / ESTABLISH YOUR STANDARD</p>
            <p class="auth-brand-title">KỶ LUẬT.<br />SỨC MẠNH.<br /><span>BẢN LĨNH.</span></p>
            <p class="auth-brand-description">Mỗi buổi tập là một bước tiến.<br />Bắt đầu hành trình của bạn cùng Victor Fitness.</p>
        </div>
        <div class="auth-brand-footer"><span>V-FITNESS MANAGEMENT</span><span>MOVE WITH PURPOSE ↗</span></div>
    </aside>
    <main class="auth-main">
        <div class="auth-topbar"><a href="/">← TRỞ VỀ TRANG CHỦ</a><span>VICTOR FITNESS</span></div>
        <div class="auth-form-container">@Body</div>
        <footer class="auth-footer">© @DateTime.Now.Year VICTOR FITNESS. ALL RIGHTS RESERVED.</footer>
    </main>
</div>
