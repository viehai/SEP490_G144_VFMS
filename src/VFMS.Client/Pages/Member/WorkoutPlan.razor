@page "/workout"
@layout PublicLayout
@attribute [Authorize(Roles = "Customer,Member")]
@using Microsoft.AspNetCore.Authorization
@using VFMS.Contracts.Workout
@inject VfmsApiClient Api

<PageTitle>Giáo án tập luyện | Victor Fitness</PageTitle>

<div class="mx-auto max-w-6xl space-y-8 px-4 py-28 font-['Inter',sans-serif] text-[#242424] sm:px-6">
    <header class="border-b border-[#D8D1CD] pb-7">
        <p class="mb-3 text-[10px] font-bold tracking-[.18em] text-[#B83A3A]">TÀI KHOẢN / GIÁO ÁN AI</p>
        <h1 class="font-['Montserrat'] text-3xl font-extrabold uppercase tracking-tight sm:text-4xl">Giáo án cá nhân<span class="text-[#B83A3A]">.</span></h1>
        <p class="mt-3 max-w-2xl text-sm leading-6 text-[#6F6966]">Hoàn thành khảo sát thể trạng, sau đó tạo lộ trình tập luyện bằng Gemini AI.</p>
    </header>

    @if (_message is not null)
    {
        <p role="status" class="border px-4 py-3 text-sm rounded-lg @(_isError ? "border-[#EF4444] bg-red-50 text-[#B91C1C]" : "border-[#10B981] bg-emerald-50 text-[#047857]")">@_message</p>
    }

    <div class="grid items-start gap-6 lg:grid-cols-[360px_minmax(0,1fr)]">
        <form class="space-y-4 border border-[#D8D1CD] bg-[#F8F5F2] p-6 rounded-xl" @onsubmit="SaveSurvey">
            <h2 class="font-['Montserrat'] text-sm font-extrabold uppercase tracking-wider">Khảo sát thể trạng</h2>
            <div class="grid grid-cols-2 gap-3">
                <label class="block text-xs font-semibold">Cân nặng (kg)<input type="number" step="0.1" class="mt-1 w-full border border-[#D8D1CD] px-3 py-2 text-sm rounded-lg bg-[#F8F5F2] focus:border-[#B83A3A] focus:ring-2 focus:ring-[#B83A3A]/20 outline-none" @bind="_survey.Weight" /></label>
                <label class="block text-xs font-semibold">Chiều cao (cm)<input type="number" step="0.1" class="mt-1 w-full border border-[#D8D1CD] px-3 py-2 text-sm rounded-lg bg-[#F8F5F2] focus:border-[#B83A3A] focus:ring-2 focus:ring-[#B83A3A]/20 outline-none" @bind="_survey.Height" /></label>
            </div>
            <label class="block text-xs font-semibold">Mục tiêu
                <select class="mt-1 w-full border border-[#D8D1CD] px-3 py-2 text-sm rounded-lg bg-[#F8F5F2] focus:border-[#B83A3A] focus:ring-2 focus:ring-[#B83A3A]/20 outline-none" @bind="_survey.Goal">
                    <option value="WeightLoss">Giảm mỡ</option><option value="MuscleGain">Tăng cơ</option><option value="Endurance">Sức bền</option>
                    <option value="Flexibility">Dẻo dai</option><option value="GeneralFitness">Thể lực chung</option>
                </select>
            </label>
            <div class="grid grid-cols-2 gap-3">
                <label class="block text-xs font-semibold">Trình độ
                    <select class="mt-1 w-full border border-[#D8D1CD] px-3 py-2 text-sm rounded-lg bg-[#F8F5F2] focus:border-[#B83A3A] focus:ring-2 focus:ring-[#B83A3A]/20 outline-none" @bind="_survey.Level">
                        <option value="Beginner">Mới bắt đầu</option><option value="Intermediate">Trung bình</option><option value="Advanced">Nâng cao</option>
                    </select>
                </label>
                <label class="block text-xs font-semibold">Buổi/tuần<input type="number" min="1" max="7" class="mt-1 w-full border border-[#D8D1CD] px-3 py-2 text-sm rounded-lg bg-[#F8F5F2] focus:border-[#B83A3A] focus:ring-2 focus:ring-[#B83A3A]/20 outline-none" @bind="_survey.Frequency" /></label>
            </div>
            <div class="grid grid-cols-2 gap-3">
                <label class="block text-xs font-semibold">Giới tính
                    <select class="mt-1 w-full border border-[#D8D1CD] px-3 py-2 text-sm rounded-lg bg-[#F8F5F2] focus:border-[#B83A3A] focus:ring-2 focus:ring-[#B83A3A]/20 outline-none" @bind="_survey.Gender">
                        <option value="">Không nêu</option><option value="Male">Nam</option><option value="Female">Nữ</option><option value="Other">Khác</option>
                    </select>
                </label>
                <label class="block text-xs font-semibold">Ngày sinh<input type="date" class="mt-1 w-full border border-[#D8D1CD] px-3 py-2 text-sm rounded-lg bg-[#F8F5F2] focus:border-[#B83A3A] focus:ring-2 focus:ring-[#B83A3A]/20 outline-none" @bind="_survey.Dob" /></label>
            </div>
            <label class="block text-xs font-semibold">Tình trạng sức khỏe / chấn thương
                <textarea rows="3" maxlength="500" class="mt-1 w-full border border-[#D8D1CD] px-3 py-2 text-sm rounded-lg bg-[#F8F5F2] focus:border-[#B83A3A] focus:ring-2 focus:ring-[#B83A3A]/20 outline-none" @bind="_survey.Health"></textarea>
                <span class="mt-1 block font-normal text-[#6F6966]">Không nhập tên, số điện thoại hay thông tin cá nhân khác.</span>
            </label>
            <label class="flex items-start gap-2 text-xs leading-5">
                <input type="checkbox" class="mt-1" @bind="_consent" />
                <span>Tôi đồng ý gửi dữ liệu khảo sát đã ẩn danh (không có tên, email, số điện thoại) tới Google Gemini để tạo giáo án.</span>
            </label>
            <button type="submit" disabled="@_busy" class="w-full bg-[#B83A3A] hover:bg-[#9F3030] px-6 py-3 font-['Montserrat'] text-xs font-bold uppercase text-white rounded-lg disabled:opacity-50">
                @(_busy ? "Đang xử lý…" : _consent ? "Lưu khảo sát & tạo giáo án" : "Lưu khảo sát")
            </button>
        </form>

        <section class="space-y-4" aria-live="polite">
            @if (_plan is null)
            {
                <p class="border border-[#D8D1CD] bg-[#ECE8E4] px-5 py-6 text-sm rounded-xl">Bạn chưa có giáo án đang áp dụng.</p>
            }
            else
            {
                <div class="flex flex-wrap items-end justify-between gap-3 border border-[#2B2928] bg-[#2B2928] px-5 py-4 text-[#F8F5F2] rounded-xl">
                    <div>
                        <p class="font-['Montserrat'] text-lg font-extrabold uppercase">@_plan.Name</p>
                        <p class="text-xs text-[#ECE8E4]">Tạo lúc @_plan.GeneratedAt.ToLocalTime().ToString("dd/MM/yyyy HH:mm") · @(_plan.IsFallback ? "Giáo án tiêu chuẩn" : _plan.GeneratedByAiModel)</p>
                    </div>
                    <p class="font-['Montserrat'] text-2xl font-extrabold">@_plan.CompletedItems/@_plan.TotalItems</p>
                </div>
                @if (_plan.IsFallback)
                {
                    <p class="border border-[#F59E0B] bg-amber-50 px-4 py-3 text-xs text-[#92400E] rounded-lg">Dịch vụ AI tạm thời không khả dụng nên hệ thống đã áp dụng giáo án tiêu chuẩn cho mục tiêu của bạn.</p>
                }
                @foreach (var day in _plan.Items.GroupBy(i => i.DayNumber))
                {
                    <section class="border border-[#D8D1CD] bg-[#F8F5F2] rounded-lg">
                        <h2 class="border-b border-[#D8D1CD] px-5 py-3 font-['Montserrat'] text-xs font-extrabold uppercase tracking-wider">Ngày @day.Key</h2>
                        <ul class="divide-y divide-[#D8D1CD]">
                            @foreach (var item in day)
                            {
                                <li class="flex flex-wrap items-center justify-between gap-3 px-5 py-3">
                                    <label class="flex items-start gap-3">
                                        <input type="checkbox" class="mt-1" checked="@item.IsCompleted" disabled="@_busy" @onchange="e => Toggle(item, (bool)(e.Value ?? false))" />
                                        <span>
                                            <span class="font-semibold @(item.IsCompleted ? "line-through text-[#8C8581]" : "")">@item.ExerciseName</span>
                                            <span class="block text-xs text-[#6F6966]">@Volume(item)@(item.MuscleGroup is null ? "" : $" · {ExerciseCatalog.MuscleGroupLabel(item.MuscleGroup)}")</span>
                                            @if (item.EquipmentName is not null)
                                            {
                                                <span class="mt-1 flex items-center gap-1.5 text-xs text-[#242424]">
                                                    <svg aria-hidden="true" class="h-3.5 w-3.5 shrink-0 text-[#B83A3A]" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M6 7v10M18 7v10M3 10v4M21 10v4M6 12h12"/></svg>
                                                    <span>Máy: <strong class="font-semibold">@item.EquipmentName</strong>@(item.EquipmentCode is null ? "" : $" · {item.EquipmentCode}")</span>
                                                </span>
                                            }
                                            @if (item.Note is not null) { <span class="block text-xs text-[#6F6966]">@item.Note</span> }
                                        </span>
                                    </label>
                                    @if (_swapItemId == item.Id)
                                    {
                                        var sameGroup = SwapChoices(_exercises, item.ExerciseId, item.MuscleGroup, allGroups: false);
                                        var onlyItself = sameGroup.Count <= 1;
                                        var choices = _swapAllGroups || onlyItself ? SwapChoices(_exercises, item.ExerciseId, item.MuscleGroup, allGroups: true) : sameGroup;
                                        <fieldset class="basis-full space-y-3 rounded-lg border border-[#D8D1CD] bg-white p-4">
                                            <legend class="px-1 text-xs font-bold uppercase tracking-wider">Đổi bài tập: @item.ExerciseName</legend>
                                            <div class="flex flex-wrap gap-2" role="group" aria-label="Lọc theo nhóm cơ">
                                                <button type="button" aria-pressed="@(!_swapAllGroups && !onlyItself)" disabled="@onlyItself"
                                                        class="@Chip(!_swapAllGroups && !onlyItself)" @onclick="() => SetAllGroups(item, false)">
                                                    Cùng nhóm: @ExerciseCatalog.MuscleGroupLabel(item.MuscleGroup)
                                                </button>
                                                <button type="button" aria-pressed="@(_swapAllGroups || onlyItself)" class="@Chip(_swapAllGroups || onlyItself)" @onclick="() => SetAllGroups(item, true)">
                                                    Tất cả nhóm
                                                </button>
                                            </div>
                                            @if (onlyItself)
                                            {
                                                <p class="text-xs text-[#6F6966]">Nhóm @ExerciseCatalog.MuscleGroupLabel(item.MuscleGroup) chưa có bài khác, nên đang hiện mọi nhóm.</p>
                                            }
                                            <div class="grid gap-3 sm:grid-cols-2">
                                                <label class="text-xs font-semibold" for="swap-ex-@item.Id">Bài tập
                                                    <select id="swap-ex-@item.Id" class="mt-1 block min-h-[44px] w-full rounded-lg border border-[#D8D1CD] bg-[#F8F5F2] px-3 text-sm font-normal" @bind="_swapExerciseId">
                                                        @foreach (var group in choices.GroupBy(e => e.MuscleGroup))
                                                        {
                                                            <optgroup label="@ExerciseCatalog.MuscleGroupLabel(group.Key)">
                                                                @foreach (var e in group) { <option value="@e.Id">@e.Name · @ExerciseCatalog.LevelLabel(e.DifficultyLevel)</option> }
                                                            </optgroup>
                                                        }
                                                    </select>
                                                </label>
                                                <label class="text-xs font-semibold" for="swap-eq-@item.Id">Máy
                                                    <select id="swap-eq-@item.Id" class="mt-1 block min-h-[44px] w-full rounded-lg border border-[#D8D1CD] bg-[#F8F5F2] px-3 text-sm font-normal" @bind="_swapEquipmentId">
                                                        <option value="">Không dùng máy</option>
                                                        @foreach (var m in _equipment) { <option value="@m.Id">@m.Name@(m.Code is null ? "" : $" · {m.Code}")</option> }
                                                    </select>
                                                </label>
                                            </div>
                                            <div class="flex flex-wrap gap-2">
                                                <button type="button" disabled="@_busy" class="min-h-[44px] rounded-lg bg-[#B83A3A] px-5 text-xs font-bold uppercase text-white hover:bg-[#9F3030] disabled:opacity-50" @onclick="() => Swap(item)">Lưu thay đổi</button>
                                                <button type="button" class="min-h-[44px] rounded-lg border border-[#C9C0BB] px-5 text-xs font-semibold hover:bg-[#ECE8E4]" @onclick="() => _swapItemId = null">Hủy</button>
                                            </div>
                                        </fieldset>
                                    }
                                    else
                                    {
                                        <button type="button" class="min-h-[44px] px-2 text-xs font-bold underline" aria-label="Đổi bài tập @item.ExerciseName" @onclick="() => StartSwap(item)">Đổi bài tập</button>
                                    }
                                </li>
                            }
                        </ul>
                    </section>
                }
            }

            @if (_history.Count > 1)
            {
                <details class="border border-[#D8D1CD] bg-[#F8F5F2] px-5 py-4 rounded-lg">
                    <summary class="cursor-pointer font-['Montserrat'] text-xs font-extrabold uppercase tracking-wider">Lịch sử giáo án</summary>
                    <ul class="mt-3 divide-y divide-[#D8D1CD] text-sm">
                        @foreach (var h in _history)
                        {
                            <li class="flex justify-between py-2"><span>@h.Name · @h.GeneratedAt.ToLocalTime().ToString("dd/MM/yyyy")</span><span class="flex items-center gap-2">@h.CompletedItems/@h.TotalItems <StatusBadge Status="@h.Status" /></span></li>
                        }
                    </ul>
                </details>
            }
        </section>
    </div>
</div>

@code {
    private SurveyForm _survey = new();
    private bool _surveyComplete, _consent, _busy, _isError;
    private string? _message;
    private WorkoutPlanResponse? _plan;
    private List<WorkoutPlanSummaryResponse> _history = [];
    private List<ExerciseResponse> _exercises = [];
    private List<WorkoutEquipmentResponse> _equipment = [];
    private int? _swapItemId;
    private int _swapExerciseId;
    private int? _swapEquipmentId;
    private bool _swapAllGroups;

    protected override async Task OnInitializedAsync()
    {
        try
        {
            var survey = await Api.GetAsync<FitnessSurveyResponse>("api/workout/survey");
            _surveyComplete = survey.IsComplete;
            _survey = new()
            {
                Weight = survey.WeightKg ?? 60, Height = survey.HeightCm ?? 165, Goal = survey.FitnessGoal ?? "GeneralFitness",
                Level = survey.FitnessLevel ?? "Beginner", Frequency = survey.WorkoutFrequencyPerWeek ?? 3, Gender = survey.Gender ?? "",
                Dob = survey.DateOfBirth, Health = survey.HealthConditions
            };
            _exercises = await Api.GetAsync<List<ExerciseResponse>>("api/workout/exercises");
            _equipment = await Api.GetAsync<List<WorkoutEquipmentResponse>>("api/workout/equipment");
            await LoadPlan();
        }
        catch (ApiException ex) { Show(ex.Message, true); }
    }

    private async Task LoadPlan()
    {
        _history = await Api.GetAsync<List<WorkoutPlanSummaryResponse>>("api/workout/plans");
        try { _plan = await Api.GetAsync<WorkoutPlanResponse>("api/workout/plans/active"); }
        catch (ApiException ex) when (ex.StatusCode == System.Net.HttpStatusCode.NotFound) { _plan = null; }
    }

    private async Task SaveSurvey()
    {
        await Busy(async () =>
        {
            var saved = await Api.PutAsync<FitnessSurveyResponse>("api/workout/survey", new FitnessSurveyRequest(
                _survey.Weight, _survey.Height, _survey.Goal, _survey.Level, _survey.Frequency,
                string.IsNullOrEmpty(_survey.Gender) ? null : _survey.Gender, _survey.Dob, _survey.Health));
            _surveyComplete = saved.IsComplete;
            Show("Cập nhật khảo sát thể lực thành công.", false);
            // With consent ticked, saving the survey also builds a new plan from it (the API archives the old one).
            if (_consent && _surveyComplete)
                await GeneratePlan();
        });
    }

    private async Task GeneratePlan()
    {
        _plan = await Api.PostAsync<WorkoutPlanResponse>("api/workout/plans/generate", new GenerateWorkoutPlanRequest(_consent));
        _history = await Api.GetAsync<List<WorkoutPlanSummaryResponse>>("api/workout/plans");
        Show(_plan.IsFallback ? "Đã áp dụng giáo án tiêu chuẩn." : "Đã tạo giáo án mới.", false);
    }

    private Task Toggle(WorkoutPlanItemResponse item, bool done) => Busy(async () =>
    {
        await Api.PatchAsync<WorkoutPlanItemResponse>($"api/workout/plans/{_plan!.Id}/items/{item.Id}/completion", new SetPlanItemCompletionRequest(done));
        _plan = await Api.GetAsync<WorkoutPlanResponse>($"api/workout/plans/{_plan.Id}");
    });

    private void StartSwap(WorkoutPlanItemResponse item)
    {
        _swapItemId = item.Id;
        _swapExerciseId = item.ExerciseId;
        _swapAllGroups = false;
        // Keep the current machine while it still works (a swap without one would clear it).
        _swapEquipmentId = _equipment.Any(m => m.Id == item.EquipmentId) ? item.EquipmentId : null;
    }

    private void SetAllGroups(WorkoutPlanItemResponse item, bool all)
    {
        _swapAllGroups = all;
        if (!SwapChoices(_exercises, item.ExerciseId, item.MuscleGroup, all).Any(e => e.Id == _swapExerciseId))
            _swapExerciseId = item.ExerciseId;   // the picked exercise left the list: go back to the current one
    }

    /// <summary>Exercises offered in "Đổi bài tập": the same muscle group first (always with the current one), or all groups.</summary>
    public static IReadOnlyList<ExerciseResponse> SwapChoices(IEnumerable<ExerciseResponse> exercises, int currentId, string? muscleGroup, bool allGroups) =>
        exercises.Where(e => allGroups || e.Id == currentId || e.MuscleGroup == muscleGroup)
            .OrderBy(e => e.MuscleGroup == muscleGroup ? 0 : 1).ThenBy(e => e.MuscleGroup).ThenBy(e => e.Name)
            .ToList();

    private static string Chip(bool on) => on
        ? "min-h-[44px] rounded-full border border-[#B83A3A] bg-[#B83A3A] px-4 text-xs font-semibold text-white"
        : "min-h-[44px] rounded-full border border-[#C9C0BB] bg-[#F8F5F2] px-4 text-xs font-semibold text-[#242424] hover:bg-[#ECE8E4] disabled:opacity-50";

    private Task Swap(WorkoutPlanItemResponse item) => Busy(async () =>
    {
        await Api.PutAsync<WorkoutPlanItemResponse>($"api/workout/plans/{_plan!.Id}/items/{item.Id}",
            new UpdatePlanItemRequest(_swapExerciseId, item.Sets, item.Reps, item.DurationMinutes ?? (item.Reps is null ? 10 : null), item.Note, _swapEquipmentId));
        _swapItemId = null;
        _plan = await Api.GetAsync<WorkoutPlanResponse>($"api/workout/plans/{_plan.Id}");
        Show("Cập nhật giáo án thành công.", false);
    });

    private async Task Busy(Func<Task> work)
    {
        if (_busy) return;
        _busy = true;
        try { await work(); }
        catch (ApiException ex) { Show(ex.Message, true); }
        finally { _busy = false; }
    }

    private void Show(string message, bool error) { _message = message; _isError = error; }

    private static string Volume(WorkoutPlanItemResponse i) =>
        i.Reps is not null ? $"{i.Sets ?? 1} × {i.Reps}" : i.DurationMinutes is not null ? $"{i.DurationMinutes} phút" : "";

    private sealed class SurveyForm
    {
        public decimal Weight { get; set; } = 60;
        public decimal Height { get; set; } = 165;
        public string Goal { get; set; } = "GeneralFitness";
        public string Level { get; set; } = "Beginner";
        public int Frequency { get; set; } = 3;
        public string Gender { get; set; } = "";
        public DateOnly? Dob { get; set; }
        public string? Health { get; set; }
    }
}
