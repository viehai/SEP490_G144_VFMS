@inject PersonalTrainingApiClient Api
@inject ToastService Toasts
@using VFMS.Contracts.Common
@using VFMS.Client.Components.Operations

<section class="pt-session trainer-stack">
    <h3>Bảo lưu gói PT</h3>
    <TrainerFeedback Error="@_error" />
    @if (_busy) { <p role="status">Đang xử lý…</p> }
    <p>@(Contract.FreezeUsed ? "Hợp đồng đã dùng lượt bảo lưu duy nhất." : Contract.HasPendingOrApprovedFreeze ? "Hợp đồng đang có yêu cầu bảo lưu." :
        $"Một lần bảo lưu cho mỗi hợp đồng, từ {Contract.FreezeMinimumDays} đến {Contract.FreezeMaxTotalDays} ngày.")</p>
    @if (_freezes is null && !_busy)
    {
        <button class="trainer-button" @onclick="LoadAsync">Tải lịch sử bảo lưu</button>
    }
    @if (CanRequest)
    {
        <button type="button" class="trainer-button" disabled="@_busy" @onclick="() => _showRequest = !_showRequest">Xin bảo lưu</button>
        @if (_showRequest)
        {
            <form class="trainer-stack" @onsubmit="RequestAsync" @onsubmit:preventDefault>
                <fieldset class="trainer-grid" disabled="@_busy">
                    <label>Ngày bắt đầu bảo lưu<input type="date" class="trainer-input" min="@Today.ToString("yyyy-MM-dd")" @bind="_start" @bind:after="ClearProposal" aria-invalid="@Invalid("StartDate")" />@FieldError("StartDate")</label>
                    <label>Ngày kết thúc bảo lưu<input type="date" class="trainer-input" min="@_start.ToString("yyyy-MM-dd")" @bind="_end" @bind:after="ClearProposal" aria-invalid="@Invalid("ResumeDate")" />@FieldError("ResumeDate")</label>
                </fieldset>
                <p class="trainer-muted">Số ngày bảo lưu: @Math.Max(0, Days). Ngày bắt đầu và ngày kết thúc đều tính vào kỳ bảo lưu.</p>
                <label>Lý do<textarea class="trainer-input" rows="3" maxlength="1000" @bind="_reason" required disabled="@_busy" aria-invalid="@Invalid("Reason")"></textarea>@FieldError("Reason")</label>
                <label class="trainer-row"><input type="checkbox" @bind="_changeTrainer" @bind:after="ClearProposal" disabled="@_busy" />
                    Đổi huấn luyện viên cho các buổi còn lại (không phát sinh thanh toán)</label>
                @if (_changeTrainer)
                {
                    <ReplacementTrainerPicker ContractId="Contract.Id" Disabled="_busy" Changed="TrainerChosen" />
                    @FieldError("ReplacementTrainerId")
                }
                else
                {
                    <p class="trainer-muted">Chọn ca tập sau bảo lưu (mỗi ngày một ca). Không chọn thì giữ lịch tuần hiện tại.</p>
                    <PTWeeklyGrid Slots="_ownSlots" SelectedIds="_ownSelected.Values" SlotSelected="OwnSlotSelected" Disabled="_busy" />
                }
                <div class="trainer-row">
                    <button type="button" class="trainer-button" disabled="@_busy" @onclick="PreviewRequestAsync">Xem lịch sau bảo lưu</button>
                    @if (_proposal is not null)
                    {
                        <button class="trainer-button trainer-primary" disabled="@_busy">Gửi yêu cầu bảo lưu</button>
                    }
                </div>
                @if (_proposal is { } proposal)
                {
                    <div class="trainer-stack">
                        <p>Hạn gói dự kiến @Date(proposal.ExpiresOn). Các ca dưới đây được giữ chỗ trong lúc chờ quản lý duyệt.</p>
                        <p class="trainer-muted">Ca <strong>giữ nguyên</strong> là các buổi nằm ngoài thời gian bảo lưu, vẫn học như cũ. Ca <strong>dời đến</strong> là các buổi trong thời gian bảo lưu được xếp lại.</p>
                        <PTPreviewCalendar @key="proposal" Slots="AfterFreezeSlots(proposal)" StartDate="Resume">
                            <SlotContent Context="slot">
                                @{
                                    var moved = slot.TemplateId > 0;
                                    var kept = moved ? null : Contract.Sessions.FirstOrDefault(x => x.Id == -slot.TemplateId);
                                    var status = kept?.Status ?? "Scheduled";
                                }
                                <div class="@(moved ? "pt-calendar-slot pt-teaching-slot pt-slot-choice pt-proposed-slot" : "pt-calendar-slot pt-teaching-slot pt-slot-choice")">
                                    <strong>@(_changeTrainer && moved ? "Huấn luyện viên mới" : Contract.TrainerName ?? "Huấn luyện viên")</strong>
                                    <span>@Time(slot.StartTime) – @Time(slot.EndTime)</span>
                                    <span class="pt-pills"><span class="pt-status-pill" data-tone="@(moved ? "amber" : StatusTone(status))">@(moved ? "Dời đến" : Status(status))</span></span>
                                </div>
                            </SlotContent>
                        </PTPreviewCalendar>
                        @if (proposal.SessionsNeedingSlot.Count > 0)
                        {
                            <p class="trainer-feedback trainer-error" role="alert">Có @proposal.SessionsNeedingSlot.Count buổi chưa có ca trống. Chọn ngày giờ khác cho các buổi đó hoặc đổi ca trong bảng rồi xem lại.</p>
                        }
                        @foreach (var (id, draft) in _moves)
                        {
                            <div class="trainer-stack" @key="id">
                                <h5>Buổi #@id@(proposal.SessionsNeedingSlot.Contains(id) ? " · cần chọn ca" : "")@(DraftSlot(draft) is { } picked ? $" · đã chọn {Date(picked.Date)} {Time(picked.Start)}" : "")</h5>
                                <FreezeSlotPicker ContractId="Contract.Id" From="Resume" Disabled="@(_busy || _changeTrainer)"
                                                  Current="DraftSlot(draft)" Picked="slot => PickMove(draft, slot, true)" />
                            </div>
                        }
                        @if (_edited) { <p class="trainer-muted">Bạn đã đổi ca. Bấm "Xem lịch sau bảo lưu" để kiểm tra trước khi gửi.</p> }
                    </div>
                }
            </form>
        }
    }
    @if (_freezes is { } freezes)
    {
        @if (freezes.TotalCount == 0 && !CanRequest) { <p class="trainer-muted">Chưa có yêu cầu bảo lưu cho hợp đồng này.</p> }
        @foreach (var freeze in freezes.Items)
        {
            <article class="pt-suggestion" @key="freeze.Id">
                <div class="trainer-row trainer-between">
                    <strong>@Date(freeze.StartDate) → @Date(freeze.ResumeDate.AddDays(-1))</strong>
                    <TrainerStatus Status="@freeze.Status" />
                </div>
                <p class="trainer-copy">@freeze.Reason</p>
                @if (!string.IsNullOrWhiteSpace(freeze.ReviewNote)) { <p class="trainer-copy">Phản hồi Quản lý: @freeze.ReviewNote</p> }
                @if (freeze.ReplacementTrainerId is not null) { <p class="trainer-muted">Kèm đổi huấn luyện viên cho các buổi còn lại.</p> }
                @if (freeze.ChangeRequestStatus == "Pending")
                {
                    <p class="trainer-feedback" role="status">Đang chờ Quản lý duyệt yêu cầu @(freeze.ChangeRequestType == "Withdraw" ? "rút bảo lưu" : $"tập lại sớm từ {Date(freeze.ChangeResumeDate ?? freeze.ResumeDate)}"). Bảo lưu hiện giữ nguyên cho đến khi được duyệt.</p>
                }
                else if (freeze.ChangeRequestType is not null && freeze.ChangeRequestStatus is "Approved" or "Rejected")
                {
                    <p class="trainer-copy">Yêu cầu @(freeze.ChangeRequestType == "Withdraw" ? "rút bảo lưu" : "tập lại sớm") @(freeze.ChangeRequestStatus == "Approved" ? "đã được duyệt" : "bị từ chối"). @freeze.ChangeOutcome @(string.IsNullOrWhiteSpace(freeze.ChangeReviewNote) ? "" : $"Lý do từ chối: {freeze.ChangeReviewNote}")</p>
                }
                <div class="trainer-row">
                    @if (freeze.Status == "Active" && Today < freeze.ResumeDate && freeze.ChangeRequestStatus != "Pending")
                    {
                        <button class="trainer-button" disabled="@_busy" @onclick="() => OpenEarlyResume(freeze)">Tập lại sớm</button>
                    }
                    @if (freeze.Status == "Pending")
                    {
                        <button class="trainer-button" disabled="@_busy" @onclick="() => OpenSlotsAsync(freeze)">Đổi ca sau bảo lưu</button>
                    }
                    @if (freeze.StartDate > Today && freeze.ChangeRequestStatus != "Pending" &&
                        (freeze.Status == "Pending" || freeze.Status == "Approved" && freeze.ReplacementTrainerId is null))
                    {
                        <button class="trainer-button" disabled="@_busy" @onclick="() => OpenWithdrawAsync(freeze)">Rút yêu cầu</button>
                    }
                </div>
                @if (_withdrawFor?.Id == freeze.Id && _withdraw is { } withdraw)
                {
                    <div class="pt-change">
                        <h4>Xem trước nếu Quản lý duyệt yêu cầu rút</h4>
                        <p class="trainer-muted">Yêu cầu rút cần Quản lý duyệt. Bảo lưu vẫn giữ nguyên cho đến khi được duyệt.</p>
                        <WithdrawPreviewPanel Preview="withdraw" StartDate="freeze.StartDate" TrainerName="@Contract.TrainerName" />
                        <div class="trainer-row">
                            <button class="trainer-button trainer-primary" disabled="@_busy" @onclick="() => WithdrawAsync(freeze)">Gửi yêu cầu rút (chờ Quản lý duyệt)</button>
                            <button type="button" class="trainer-button" disabled="@_busy" @onclick="CloseWithdraw">Đóng</button>
                        </div>
                    </div>
                }
                @if (_slotsFor?.Id == freeze.Id && _slots is { } held)
                {
                    <form class="trainer-stack" @onsubmit="SaveSlotsAsync" @onsubmit:preventDefault>
                        @if (held.SessionsNeedingSlot.Count > 0)
                        {
                            <p class="trainer-feedback trainer-error" role="alert">Có @held.SessionsNeedingSlot.Count ca không còn khả dụng. Chọn ca khác cho các buổi đó.</p>
                        }
                        @foreach (var session in held.Sessions)
                        {
                            var draft = _slotDrafts[session.OriginalSessionId];
                            <div class="trainer-stack" @key="session.OriginalSessionId">
                                <h5>Ca giữ @Date(session.Date) · @Time(session.StartTime)@(held.SessionsNeedingSlot.Contains(session.OriginalSessionId) ? " · cần chọn ca" : "")@(DraftSlot(draft) is { } picked ? $" · đã chọn {Date(picked.Date)} {Time(picked.Start)}" : "")</h5>
                                <FreezeSlotPicker ContractId="Contract.Id" From="freeze.ResumeDate" TrainerId="@freeze.ReplacementTrainerId" Disabled="@_busy"
                                                  Current="DraftSlot(draft)" Picked="slot => PickMove(draft, slot)" />
                            </div>
                        }
                        <div class="trainer-row">
                            <button class="trainer-button trainer-primary" disabled="@_busy">Lưu ca mới</button>
                            <button type="button" class="trainer-button" disabled="@_busy" @onclick="CloseSlots">Đóng</button>
                        </div>
                    </form>
                }
            </article>
        }
        @if (freezes.TotalCount > freezes.PageSize)
        {
            <Pager Page="freezes.Page" PageSize="freezes.PageSize" TotalCount="freezes.TotalCount" Noun="yêu cầu" Disabled="_busy" OnPage="LoadPageAsync" />
        }
    }
    @if (_early is { } early)
    {
        <form class="trainer-stack" @onsubmit="PreviewAsync" @onsubmit:preventDefault>
            <h4>Tập lại sớm</h4>
            <label>Ngày tập lại mới<input type="date" class="trainer-input" min="@Today.ToString("yyyy-MM-dd")"
                max="@early.ResumeDate.AddDays(-1).ToString("yyyy-MM-dd")" @bind="_earlyDate" @bind:after="ClearPreview" disabled="@_busy" /></label>
            <p class="trainer-muted">Chọn ca tập sau khi tập lại sớm (mỗi ngày một ca). Không chọn thì ưu tiên đưa các buổi về ca cũ.</p>
            <PTWeeklyGrid Slots="_ownSlots" SelectedIds="_earlySelected.Values" SlotSelected="EarlySlotSelected" Disabled="_busy" />
            <div class="trainer-row">
                <button class="trainer-button" disabled="@_busy">Xem lịch điều chỉnh</button>
                <button type="button" class="trainer-button" disabled="@_busy" @onclick="CloseEarlyResume">Đóng</button>
            </div>
        </form>
        @if (_preview is { } preview)
        {
            <p>Hạn gói dự kiến @Date(preview.ExpiresOn) · Đã bảo lưu @preview.ActualFrozenDays ngày</p>
            @if (preview.UnavailableOriginalSlots.Count > 0) { <p>Có ca cũ không còn trống. Kiểm tra các buổi cần chọn ca mới.</p> }
            <PTPreviewCalendar @key="preview" Slots="@preview.Sessions.Select(s => new PTCalendarSlot(0, s.Date, s.StartTime, s.EndTime, s.Status)).ToArray()" StartDate="_earlyDate" />
            @foreach (var id in preview.SessionsNeedingNewSlot)
            {
                var session = preview.Sessions.FirstOrDefault(s => s.Id == id);
                var move = _drafts[id];
                <div class="trainer-stack" @key="id">
                    <h5>Chọn ca mới cho buổi @(session is null ? $"#{id}" : $"{Date(session.Date)} · {Time(session.StartTime)}")@(DraftSlot(move) is { } picked ? $" · đã chọn {Date(picked.Date)} {Time(picked.Start)}" : "")</h5>
                    <FreezeSlotPicker ContractId="Contract.Id" From="_earlyDate" Disabled="@_busy"
                                      Current="DraftSlot(move)" Picked="slot => PickMove(move, slot)" />
                </div>
            }
            <div class="trainer-row">
                @if (preview.SessionsNeedingNewSlot.Count > 0)
                {
                    <button class="trainer-button" disabled="@_busy" @onclick="PreviewMovesAsync">Kiểm tra các ca mới</button>
                }
                else
                {
                    <p class="trainer-muted">Yêu cầu tập lại sớm cần Quản lý duyệt. Bảo lưu hiện tại giữ nguyên cho đến khi được duyệt.</p>
                    <button class="trainer-button trainer-primary" disabled="@_busy" @onclick="ConfirmAsync">Gửi yêu cầu tập lại sớm</button>
                }
            </div>
        }
    }
</section>

@code {
    [Parameter, EditorRequired] public PTContractResponse Contract { get; set; } = default!;
    [Parameter] public EventCallback Changed { get; set; }
    private PagedResponse<PTFreezeResponse>? _freezes;
    private bool _hasLiveRequest;
    private PTFreezeResponse? _early;
    private PTEarlyResumePreview? _preview;
    private readonly Dictionary<int, MoveDraft> _drafts = [];
    private DateOnly _start = Today, _end = Today, _earlyDate = Today;
    private DateOnly Resume => _end.AddDays(1);

    // Moved sessions use their original session id (> 0); sessions outside the freeze window stay and use -id.
    private PTCalendarSlot[] AfterFreezeSlots(PTFreezeProposal proposal) =>
    [
        .. proposal.Sessions.Select(m => new PTCalendarSlot(m.OriginalSessionId, m.Date, m.StartTime, m.EndTime, "Held")),
        .. Contract.Sessions
            .Where(x => x.Status is "Scheduled" or "ReschedulePending" or "RescheduleRequested" && x.Date >= Today &&
                (x.Date < _start || x.Date >= Resume) && proposal.Sessions.All(m => m.OriginalSessionId != x.Id))
            .Select(x => new PTCalendarSlot(-x.Id, x.Date, x.StartTime, x.EndTime, "Kept"))
    ];
    private int Days => Resume.DayNumber - _start.DayNumber;
    private PTWeeklySlot[] _ownSlots = [];
    private readonly Dictionary<DayOfWeek, int> _ownSelected = [];

    private readonly Dictionary<DayOfWeek, int> _earlySelected = [];

    private void EarlySlotSelected(PTWeeklySlot slot)
    {
        if (_earlySelected.GetValueOrDefault(slot.DayOfWeek) == slot.TemplateId) _earlySelected.Remove(slot.DayOfWeek);
        else _earlySelected[slot.DayOfWeek] = slot.TemplateId;
        ClearPreview();
    }

    private void OwnSlotSelected(PTWeeklySlot slot)
    {
        if (_ownSelected.GetValueOrDefault(slot.DayOfWeek) == slot.TemplateId) _ownSelected.Remove(slot.DayOfWeek);
        else _ownSelected[slot.DayOfWeek] = slot.TemplateId;
        ClearProposal();
    }
    private bool _busy, _showRequest;
    private string _reason = "";
    private string? _error;
    private Dictionary<string, string> _fieldErrors = [];
    private PTFreezeResponse? _slotsFor;
    private PTFreezeProposal? _slots;
    private readonly Dictionary<int, MoveDraft> _slotDrafts = [];
    private bool CanRequest => Contract.Status == "Active" && Contract.RemainingFreezeDays >= Contract.FreezeMinimumDays &&
        Contract.FreezeMinimumDays > 0 && _freezes is not null && !_hasLiveRequest && !Contract.HasPendingOrApprovedFreeze;

    protected override async Task OnInitializedAsync()
    {
        await LoadAsync();
        try { _ownSlots = await Api.WeeklyTemplateAsync(Contract.TrainerId); }
        catch (AuthApiException) { _ownSlots = []; }
    }
    private Task LoadAsync() => RunAsync(LoadHistoryAsync);
    private Task LoadHistoryAsync() => ReadPageAsync(1);
    private Task LoadPageAsync(int page) => RunAsync(() => ReadPageAsync(page));

    private async Task ReadPageAsync(int page)
    {
        _freezes = await Api.MemberFreezePageAsync(Contract.Id, page);
    }

    private PTFreezeProposal? _proposal;
    private readonly Dictionary<int, MoveDraft> _moves = [];
    private bool _changeTrainer, _edited;
    private (string TrainerId, int[] TemplateIds) _replacement = ("", []);

    private void ClearProposal() { _proposal = null; _moves.Clear(); _edited = false; }
    private void MarkEdited() => _edited = true;
    private void TrainerChosen((string TrainerId, int[] TemplateIds) choice) { _replacement = choice; ClearProposal(); }

    /// <summary>UC 4.8 steps 3-4: field errors shown under each field (MSG-02, MSG-07).</summary>
    private bool Validate()
    {
        _fieldErrors = [];
        var days = Days;
        var first = Today > Contract.StartDate ? Today : Contract.StartDate;
        if (_start < first || _start > Contract.EndDate)
            _fieldErrors["StartDate"] = $"Chọn ngày bắt đầu từ {Date(first)} đến {Date(Contract.EndDate)}.";
        if (days < Contract.FreezeMinimumDays || days > Contract.FreezeMaxTotalDays)
            _fieldErrors["ResumeDate"] = $"Số ngày bảo lưu phải từ {Contract.FreezeMinimumDays} đến {Contract.FreezeMaxTotalDays}.";
        if (string.IsNullOrWhiteSpace(_reason))
            _fieldErrors["Reason"] = "Vui lòng nhập lý do bảo lưu.";
        if (_changeTrainer && (_replacement.TrainerId.Length == 0 || _replacement.TemplateIds.Length == 0))
            _fieldErrors["ReplacementTrainerId"] = "Chọn huấn luyện viên mới và ít nhất một ca trong tuần.";
        return _fieldErrors.Count == 0;
    }

    private string? Invalid(string field) => _fieldErrors.ContainsKey(field) ? "true" : null;

    private RenderFragment? FieldError(string field) => _fieldErrors.TryGetValue(field, out var message)
        ? @<span class="mt-1 block text-xs font-normal text-red-700" role="alert">@message</span>
        : null;

    private PTFreezeRequest BuildRequest() => _changeTrainer
        ? new(_start, Resume, _reason.Trim(), null, _replacement.TrainerId, _replacement.TemplateIds)
        : new(_start, Resume, _reason.Trim(), _moves.Where(m => m.Value.Date is not null && m.Value.Start is not null)
            .Select(m => new PTEarlyResumeMove(m.Key, m.Value.Date!.Value, m.Value.Start!.Value)).ToArray(),
            null, _ownSelected.Count > 0 ? _ownSelected.Values.ToArray() : null);

    private Task PreviewRequestAsync() => RunAsync(async () =>
    {
        if (!Validate()) return;
        _proposal = await Api.PreviewFreezeRequestAsync(Contract.Id, BuildRequest());
        _edited = false;
        // Only sessions the Member placed by hand are kept as explicit moves; the rest follow the chosen weekly slots.
        foreach (var id in _moves.Where(m => m.Value.Date is null || m.Value.Start is null).Select(m => m.Key).ToArray())
            _moves.Remove(id);
        if (!_changeTrainer)
            foreach (var id in _proposal.SessionsNeedingSlot)
                _moves.TryAdd(id, new());
    });

    private PTFreezeResponse? _withdrawFor;
    private PTWithdrawPreview? _withdraw;

    private Task OpenWithdrawAsync(PTFreezeResponse freeze) => RunAsync(async () =>
    {
        _withdraw = null;
        _withdrawFor = freeze;
        _withdraw = await Api.PreviewWithdrawAsync(freeze.Id);
    });

    private void CloseWithdraw() { _withdrawFor = null; _withdraw = null; }

    private Task WithdrawAsync(PTFreezeResponse freeze) => RunAsync(async () =>
    {
        await Api.WithdrawFreezeAsync(freeze.Id);
        CloseWithdraw();
        await LoadHistoryAsync();
        Toasts.Show("Đã gửi yêu cầu rút bảo lưu. Bảo lưu giữ nguyên cho đến khi Quản lý duyệt.");
        await Changed.InvokeAsync();
    });

    private Task RequestAsync() => RunAsync(async () =>
    {
        if (!Validate()) return;
        if (!CanRequest || _proposal is null || _edited || _proposal.SessionsNeedingSlot.Count > 0)
        {
            _error = "Xem và kiểm tra lịch sau bảo lưu trước khi gửi.";
            return;
        }
        await Api.RequestFreezeAsync(Contract.Id, BuildRequest());
        ClearProposal();
        _hasLiveRequest = true;
        await LoadHistoryAsync();
        _reason = "";
        _showRequest = false;
        Toasts.Show("Đã gửi yêu cầu bảo lưu.");
        await Changed.InvokeAsync();
    });

    /// <summary>UC 4.8 step 8.4: choose other slots for the held sessions of a pending request.</summary>
    private Task OpenSlotsAsync(PTFreezeResponse freeze) => RunAsync(async () =>
    {
        _slots = await Api.FreezeSlotsAsync(freeze.Id);
        _slotsFor = freeze;
        _slotDrafts.Clear();
        foreach (var session in _slots.Sessions)
            _slotDrafts[session.OriginalSessionId] = new() { Date = session.Date, Start = session.StartTime };
    });

    private void CloseSlots() { _slotsFor = null; _slots = null; _slotDrafts.Clear(); }

    private Task SaveSlotsAsync() => _slotsFor is { } freeze && _slots is { } held
        ? RunAsync(async () =>
        {
            var moves = held.Sessions.Select(s => (s, d: _slotDrafts[s.OriginalSessionId]))
                .Where(x => x.d.Date is not null && x.d.Start is not null && (x.d.Date != x.s.Date || x.d.Start != x.s.StartTime))
                .Select(x => new PTEarlyResumeMove(x.s.OriginalSessionId, x.d.Date!.Value, x.d.Start!.Value)).ToArray();
            if (moves.Length == 0) { _error = "Chọn ngày giờ mới cho ít nhất một buổi."; return; }
            await Api.ChangeFreezeSlotsAsync(freeze.Id, new(moves));
            CloseSlots();
            Toasts.Show("Đã cập nhật lịch sau bảo lưu.");
            await LoadHistoryAsync();
        })
        : Task.CompletedTask;

    private void OpenEarlyResume(PTFreezeResponse freeze)
    {
        _early = freeze;
        _earlyDate = Today;
        _earlySelected.Clear();
        ClearPreview();
        _error = null;
    }

    private void CloseEarlyResume() { _early = null; ClearPreview(); }
    private void ClearPreview() { _preview = null; _drafts.Clear(); }
    private Task PreviewAsync() => PreviewAsync([]);

    private Task PreviewMovesAsync()
    {
        if (_preview is not { } preview || preview.SessionsNeedingNewSlot.Any(id => _drafts[id].Date is null || _drafts[id].Start is null))
        {
            _error = "Chọn ngày và giờ cho tất cả buổi cần đổi ca.";
            return Task.CompletedTask;
        }
        var moves = preview.Moves.Concat(preview.SessionsNeedingNewSlot.Select(id =>
            new PTEarlyResumeMove(id, _drafts[id].Date!.Value, _drafts[id].Start!.Value))).ToArray();
        return PreviewAsync(moves);
    }

    private Task PreviewAsync(PTEarlyResumeMove[] moves) => _early is { } early
        ? RunAsync(async () =>
        {
            _preview = await Api.PreviewResumeAsync(early.Id, new(_earlyDate, moves, _earlySelected.Count > 0 ? _earlySelected.Values.ToArray() : null));
            foreach (var id in _preview.SessionsNeedingNewSlot)
                _drafts.TryAdd(id, new());
        })
        : Task.CompletedTask;

    private Task ConfirmAsync() => _early is { } early && _preview is { SessionsNeedingNewSlot.Count: 0 } preview
        ? RunAsync(async () =>
        {
            await Api.ConfirmResumeAsync(early.Id, new(preview.ResumeDate, preview.CurrentResumeDate, preview.Moves.ToArray()));
            CloseEarlyResume();
            Toasts.Show("Đã gửi yêu cầu tập lại sớm. Bảo lưu giữ nguyên cho đến khi Quản lý duyệt.");
            await Changed.InvokeAsync();
            await LoadHistoryAsync();
        })
        : Task.CompletedTask;

    private async Task RunAsync(Func<Task> action)
    {
        if (_busy) return;
        _busy = true;
        _error = null;
        try { await action(); }
        catch (AuthApiException ex) { _error = ex.Message; }
        finally { _busy = false; }
    }

    private static (DateOnly Date, TimeOnly Start)? DraftSlot(MoveDraft d) =>
        d.Date is { } date && d.Start is { } start ? (date, start) : null;

    // Only the request form asks the Member to preview again after a change.
    private void PickMove(MoveDraft draft, (DateOnly Date, TimeOnly Start) slot, bool markEdited = false)
    {
        draft.Date = slot.Date;
        draft.Start = slot.Start;
        if (markEdited) MarkEdited();
    }

    private sealed class MoveDraft
    {
        public DateOnly? Date { get; set; }
        public TimeOnly? Start { get; set; }
    }
}
