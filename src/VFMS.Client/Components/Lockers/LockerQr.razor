@using VFMS.Contracts.Lockers
@using VFMS.Client.Components.Operations
@* VietQR transfer details for a locker order, with the time left to pay (GBR-48, GBR-102). *@
@if (Checkout.VietQr is { } qr)
{
    <div class="space-y-3">
        <p class="text-sm">Còn <strong>@LockerText.Remaining(Checkout.ExpiresAt, Now)</strong> để chuyển khoản đúng số tiền và nội dung (trước @LockerText.Local(Checkout.ExpiresAt)).</p>
        <CheckoutQrDetails Qr="qr" AmountDue="Checkout.AmountDue" ImageAlt="Mã VietQR thanh toán tủ" />
    </div>
}

@code {
    [Parameter, EditorRequired] public LockerCheckout Checkout { get; set; } = null!;
    [Parameter] public DateTime Now { get; set; } = DateTime.UtcNow;
}
