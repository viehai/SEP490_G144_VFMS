@page "/my-supplement-orders"
@layout PublicLayout
@using Microsoft.AspNetCore.Authorization
@using VFMS.Client.Components.Operations
@using VFMS.Contracts.Common
@using VFMS.Contracts.Supplements
@attribute [Authorize(Roles = "Customer,Member")]
@inject OperationsApiClient Api
@implements IDisposable

<PageTitle>Đơn hàng của tôi | Victor Fitness</PageTitle>

<section class="mx-auto max-w-4xl space-y-6 px-5 pb-16 pt-28" aria-labelledby="orders-title">
    <header class="flex flex-wrap items-end justify-between gap-4 border-b border-[#D8DED2] pb-5">
        <div class="space-y-2">
            <h1 id="orders-title" class="font-['Montserrat',sans-serif] text-3xl font-black text-[#383E43]">Đơn hàng của tôi</h1>
            <p class="text-sm text-[#69706A]">Theo dõi đơn thực phẩm bổ sung; đơn chưa xử lý có thể hủy.</p>
        </div>
        <a href="/supplements" class="text-sm font-semibold text-[#5F6F52] underline underline-offset-4">← Tiếp tục mua sắm</a>
    </header>

    <Alerts Notice="@_notice" Error="@_error" />

    <div class="flex flex-wrap gap-2" role="tablist" aria-label="Loại đơn">
        <button type="button" role="tab" aria-selected="@_ongoing" class="@Tab(_ongoing)" @onclick="() => SwitchAsync(true)">Đang xử lý</button>
        <button type="button" role="tab" aria-selected="@(!_ongoing)" class="@Tab(!_ongoing)" @onclick="() => SwitchAsync(false)">Lịch sử</button>
        @if (!_ongoing)
        {
            <select class="rounded-lg border border-[#D8DED2] bg-white px-3 py-1.5 text-xs font-semibold" aria-label="Lọc trạng thái" @bind="_status" @bind:after="() => LoadAsync(1)">
                <option value="">Mọi trạng thái</option>
                @foreach (var status in OperationsText.OrderStatuses) { <option value="@status">@OperationsText.Label(status)</option> }
            </select>
        }
    </div>

    @if (_loading)
    {
        <p role="status" class="text-sm text-[#69706A]">Đang tải đơn hàng...</p>
    }
    else if (_page is { Items.Count: > 0 } list)
    {
        <ul class="space-y-4">
            @foreach (var order in list.Items)
            {
                <li @key="order.Id" class="@Ui.Card">
                    <div class="mb-4 flex flex-wrap items-start justify-between gap-3">
                        <div>
                            <p class="text-base font-bold text-[#383E43]">@order.OrderNumber</p>
                            <p class="text-xs text-[#69706A]">@OperationsText.Local(order.PlacedAt) · @OperationsText.Label(order.FulfillmentType)</p>
                        </div>
                        <span class="@OperationsText.Badge(order.Status)">@OperationsText.Label(order.Status)</span>
                    </div>
                    <OrderLines Order="order" />
                    @if (order.Delivery is { CourierName: { } courier } delivery)
                    {
                        <p class="mt-2 text-xs text-[#69706A]">Vận chuyển: @courier · Mã vận đơn @delivery.TrackingCode</p>
                    }
                    @if (order.CanCancel)
                    {
                        <div class="mt-3 flex flex-wrap items-center gap-2">
                            @if (_confirmCancelId == order.Id)
                            {
                                <span class="text-sm text-red-800">Hủy đơn này?</span>
                                <button type="button" class="@Ui.DangerButton" disabled="@_working" @onclick="() => CancelAsync(order)">Xác nhận hủy</button>
                                <button type="button" class="@Ui.Button" @onclick="() => _confirmCancelId = null">Không</button>
                            }
                            else
                            {
                                <button type="button" class="@Ui.DangerButton" disabled="@_working" @onclick="() => _confirmCancelId = order.Id">Hủy đơn</button>
                            }
                        </div>
                    }
                </li>
            }
        </ul>
        <div class="overflow-hidden rounded-xl border border-[#D8DED2] bg-white">
            <Pager Page="list.Page" PageSize="list.PageSize" TotalCount="list.TotalCount" Noun="đơn" AriaLabel="Phân trang đơn hàng" Disabled="_loading" OnPage="LoadAsync" />
        </div>
    }
    else
    {
        <p role="status" class="text-sm text-[#69706A]">@(_ongoing ? "Không có đơn nào đang xử lý." : "Chưa có đơn hàng.")</p>
    }
</section>

@code {
    private const int PageSize = 10;
    private readonly CancellationTokenSource _lifetime = new();
    private PagedResponse<SupplementOrderResponse>? _page;
    private string _status = "";
    private string? _notice, _error;
    private int? _confirmCancelId;
    private bool _ongoing = true, _loading, _working;

    private static string Tab(bool active) => active
        ? "rounded-lg bg-[#5F6F52] px-4 py-1.5 text-xs font-semibold text-white"
        : "rounded-lg border border-[#D8DED2] bg-white px-4 py-1.5 text-xs font-semibold text-[#383E43] hover:bg-[#EEF1EA]";

    protected override Task OnInitializedAsync() => LoadAsync(1);

    private Task SwitchAsync(bool ongoing)
    {
        _ongoing = ongoing;
        _status = "";
        return LoadAsync(1);
    }

    private async Task LoadAsync(int page)
    {
        _loading = true;
        try
        {
            _page = _ongoing
                ? await Api.GetOngoingOrdersAsync(page, PageSize, _lifetime.Token)
                : await Api.GetOrdersAsync(new(string.IsNullOrEmpty(_status) ? null : _status, Page: page, PageSize: PageSize), mine: true, _lifetime.Token);
        }
        catch (AuthApiException error) { _error = error.Message; }
        catch (OperationCanceledException) when (_lifetime.IsCancellationRequested) { }
        finally { _loading = false; }
    }

    private async Task CancelAsync(SupplementOrderResponse order)
    {
        if (_working) return;
        _working = true;
        _notice = _error = null;
        try
        {
            var saved = await Api.OrderActionAsync(order.Id, "cancel", ct: _lifetime.Token);
            _notice = $"Đã hủy đơn {saved.OrderNumber}.";
            _confirmCancelId = null;
            await LoadAsync(_page?.Page ?? 1);
        }
        catch (AuthApiException error) { _error = error.Message; }
        catch (OperationCanceledException) when (_lifetime.IsCancellationRequested) { }
        finally { _working = false; }
    }

    public void Dispose()
    {
        _lifetime.Cancel();
        _lifetime.Dispose();
    }
}
