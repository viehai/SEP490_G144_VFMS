    private async Task ScrollToFeaturedClasses()
    {
        try
        {
            await JS.InvokeVoidAsync("eval", "document.getElementById('featured-classes')?.scrollIntoView({ behavior: 'smooth' })");
        }
        catch
        {
            Navigation.NavigateTo("#featured-classes");
        }
    }

    // =========================================================================
    // SCROLL REVEAL BẰNG INTERSECTION OBSERVER API TRONG BLAZOR
    // =========================================================================
    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            await JS.InvokeVoidAsync("eval", @"
                (function() {
                    const items = document.querySelectorAll('.slide-reveal-right');
                    if (!items.length) return;

                    const observerOptions = {
                        root: null,
                        rootMargin: '0px 0px -60px 0px',
                        threshold: 0.15
                    };

                    const observer = new IntersectionObserver((entries, obs) => {
                        entries.forEach(entry => {
                            if (entry.isIntersecting) {
                                entry.target.classList.add('revealed');
                                obs.unobserve(entry.target); // Chỉ kích hoạt 1 lần khi cuộn tới
                            }
                        });
                    }, observerOptions);

                    items.forEach(el => observer.observe(el));
                })();
            ");
        }
    }

