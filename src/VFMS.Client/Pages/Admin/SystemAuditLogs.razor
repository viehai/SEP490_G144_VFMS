@page "/admin/audit-logs"
@layout ManagerAdminLayout
@using System.Text.Encodings.Web
@using System.Text.Json
@using Microsoft.AspNetCore.Authorization
@using VFMS.Contracts.Common
@using VFMS.Contracts.SystemAdministration
@using VFMS.Contracts.SystemAdministration.Validators
@attribute [Authorize(Roles = "Admin")]
@inject SystemAdministrationApiClient Api
@implements IDisposable

<PageTitle>Nhật ký hệ thống | Victor Fitness</PageTitle>

<div class="workspace-page space-y-6">
    <header class="border-b-2 border-black pb-6">
        <p class="workspace-heading mb-3 text-[10px] tracking-[.18em] text-[#71717A]">VFMS / SECURITY</p>
        <h1 class="workspace-heading text-3xl tracking-tight sm:text-4xl">Nhật ký hệ thống<span class="text-[#FF3E3E]">.</span></h1>
        <p class="mt-3 text-sm text-[#545454]">Theo dõi các thay đổi dữ liệu và thao tác quan trọng. Bộ lọc ngày tính theo giờ UTC.</p>
    </header>

    @if (_error is not null)
    {
        <p role="alert" class="border border-red-600 bg-red-50 p-4 text-sm text-red-900">@_error</p>
    }

    @if (_selected is { } log)
    {
        <section class="border-2 border-black bg-white p-5 sm:p-6" aria-labelledby="log-detail-title">
            <div class="flex flex-wrap items-start justify-between gap-3">
                <div>
                    <h2 id="log-detail-title" class="workspace-heading text-base">#@log.Id · @ActionLabel(log.ActionType) · @log.AuditEntity@(log.EntityId is { } selectedId ? $" #{selectedId}" : "")</h2>
                    <p class="mt-1 text-xs text-[#545454]">@log.OccurredAt.ToLocalTime().ToString("dd/MM/yyyy HH:mm:ss") · @(log.ActorName ?? "Hệ thống")@(log.IpAddress is { } ip ? $" · IP {ip}" : "")</p>
                </div>
                <button type="button" class="@Button" @onclick="() => _selected = null">Đóng chi tiết</button>
            </div>
            <div class="mt-4 grid gap-4 lg:grid-cols-2">
                <div>
                    <p class="mb-2 text-sm font-semibold">Giá trị cũ</p>
                    <pre class="max-h-96 overflow-auto whitespace-pre-wrap break-all border border-black bg-[#F7F7F7] p-4 text-xs">@FormatValue(log.OldValue)</pre>
                </div>
                <div>
                    <p class="mb-2 text-sm font-semibold">Giá trị mới</p>
                    <pre class="max-h-96 overflow-auto whitespace-pre-wrap break-all border border-black bg-[#F7F7F7] p-4 text-xs">@FormatValue(log.NewValue)</pre>
                </div>
            </div>
        </section>
    }

    <section class="border-2 border-black bg-white" aria-labelledby="log-list-title" aria-busy="@_loading">
        <div class="border-b border-black p-5">
            <h2 id="log-list-title" class="workspace-heading mb-3 text-sm">Bản ghi</h2>
            <EditForm Model="_filter" OnValidSubmit="() => LoadAsync(1)" novalidate>
                <ContractValidation TRequest="AuditLogListRequest" Validator="_validator" CreateRequest="() => CreateRequest(1)" @ref="_validation" />
                <ValidationSummary />
                <fieldset disabled="@_loading" class="flex flex-wrap items-end gap-3">
                    <label class="text-sm font-semibold" for="log-from">
                        Từ ngày
                        <InputDate id="log-from" class="@Field" @bind-Value="_filter.From" />
                    </label>
                    <label class="text-sm font-semibold" for="log-to">
                        Đến ngày
                        <InputDate id="log-to" class="@Field" @bind-Value="_filter.To" />
                    </label>
                    <label class="text-sm font-semibold" for="log-action">
                        Thao tác
                        <InputSelect id="log-action" class="@Field" @bind-Value="_filter.ActionType">
                            <option value="">Tất cả</option>
                            @foreach (var type in AuditLogListRequestValidator.ActionTypes)
                            {
                                <option value="@type">@ActionLabel(type)</option>
                            }
                        </InputSelect>
                    </label>
                    <label class="text-sm font-semibold" for="log-entity">
                        Đối tượng
                        <InputText id="log-entity" class="@Field" @bind-Value="_filter.Entity" list="log-entities" maxlength="100" />
                        <datalist id="log-entities">
                            @foreach (var entity in KnownEntities) { <option value="@entity"></option> }
                        </datalist>
                    </label>
                    <label class="text-sm font-semibold" for="log-actor">
                        Mã người thực hiện
                        <InputText id="log-actor" class="@Field" @bind-Value="_filter.ActorUserId" maxlength="128" />
                    </label>
                    <button type="submit" class="@Button">Áp dụng</button>
                    <button type="button" class="@Button" @onclick="ClearAsync">Xóa lọc</button>
                </fieldset>
            </EditForm>
        </div>
        @if (_loading)
        {
            <p role="status" class="p-5 text-sm">Đang tải nhật ký...</p>
        }
        else if (_page is { Items.Count: > 0 } list)
        {
            <div class="overflow-x-auto">
                <table class="workspace-table min-w-[820px]">
                    <thead>
                        <tr><th scope="col">Thời gian</th><th scope="col">Người thực hiện</th><th scope="col">Thao tác</th><th scope="col">Đối tượng</th><th scope="col">IP</th><th scope="col">Chi tiết</th></tr>
                    </thead>
                    <tbody>
                        @foreach (var row in list.Items)
                        {
                            <tr @key="row.Id">
                                <th scope="row" class="whitespace-nowrap font-normal">@row.OccurredAt.ToLocalTime().ToString("dd/MM/yyyy HH:mm:ss")</th>
                                <td>@(row.ActorName ?? "Hệ thống")</td>
                                <td><span class="inline-block whitespace-nowrap border border-black px-2 py-1 text-[10px] font-bold uppercase">@ActionLabel(row.ActionType)</span></td>
                                <td>@row.AuditEntity@(row.EntityId is { } id ? $" #{id}" : "")</td>
                                <td>@(row.IpAddress ?? "—")</td>
                                <td><button type="button" class="@Button" @onclick="() => OpenAsync(row.Id)">Xem</button></td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
            <nav aria-label="Phân trang nhật ký" class="flex flex-wrap items-center justify-between gap-3 border-t border-black p-4 text-sm">
                <p>Trang @list.Page / @PageCount(list) · @list.TotalCount bản ghi</p>
                <div class="flex gap-2">
                    <button type="button" class="@Button" disabled="@(_loading || list.Page <= 1)" @onclick="() => LoadAsync(list.Page - 1)">Trang trước</button>
                    <button type="button" class="@Button" disabled="@(_loading || list.Page >= PageCount(list))" @onclick="() => LoadAsync(list.Page + 1)">Trang sau</button>
                </div>
            </nav>
        }
        else
        {
            <p role="status" class="p-5 text-sm text-[#545454]">Không có bản ghi phù hợp.</p>
        }
    </section>
</div>

@code {
    private const int PageSize = 20;
    private const string Field = "mt-1 block w-full border border-[#71717A] bg-white px-3 py-2 text-sm font-normal";
    private const string Button = "border border-black bg-white px-3 py-2 text-xs font-bold hover:bg-[#F7F7F7]";
    private static readonly string[] KnownEntities =
        ["Gym", "BannedWordList", "BusinessReportSnapshot", "Equipment", "CatalogCategory", "EquipmentIssueReport",
         "PurchaseProposal", "SupplementProduct", "SupplementOrder", "ApplicationUser"];
    private static readonly JsonSerializerOptions Indented = new() { WriteIndented = true, Encoder = JavaScriptEncoder.UnsafeRelaxedJsonEscaping };

    private readonly CancellationTokenSource _lifetime = new();
    private readonly FilterModel _filter = new();
    private readonly AuditLogListRequestValidator _validator = new();
    private ContractValidation<AuditLogListRequest>? _validation;
    private PagedResponse<AuditLogResponse>? _page;
    private AuditLogResponse? _selected;
    private string? _error;
    private bool _loading;

    protected override Task OnInitializedAsync() => LoadAsync(1);

    private AuditLogListRequest CreateRequest(int page) => new(
        _filter.From?.ToDateTime(TimeOnly.MinValue), _filter.To?.ToDateTime(TimeOnly.MinValue),
        Blank(_filter.ActorUserId), Blank(_filter.ActionType), Blank(_filter.Entity), page, PageSize);

    private static string? Blank(string? value) => string.IsNullOrWhiteSpace(value) ? null : value.Trim();

    private async Task LoadAsync(int page)
    {
        _loading = true;
        _error = null;
        try { _page = await Api.GetAuditLogsAsync(CreateRequest(page), _lifetime.Token); }
        catch (AuthApiException error)
        {
            _error = error.Message;
            _validation?.ShowErrors(error.Errors);
        }
        catch (OperationCanceledException) when (_lifetime.IsCancellationRequested) { }
        finally { _loading = false; }
    }

    private Task ClearAsync()
    {
        _filter.From = _filter.To = null;
        _filter.ActionType = _filter.Entity = _filter.ActorUserId = null;
        return LoadAsync(1);
    }

    private async Task OpenAsync(int id)
    {
        _error = null;
        try { _selected = await Api.GetAuditLogAsync(id, _lifetime.Token); }
        catch (AuthApiException error) { _error = error.Message; }
        catch (OperationCanceledException) when (_lifetime.IsCancellationRequested) { }
    }

    private static int PageCount(PagedResponse<AuditLogResponse> page) => Math.Max(1, (int)Math.Ceiling((double)page.TotalCount / page.PageSize));

    private static string FormatValue(string? value)
    {
        if (string.IsNullOrWhiteSpace(value)) return "—";
        try
        {
            using var document = JsonDocument.Parse(value);
            return JsonSerializer.Serialize(document.RootElement, Indented);
        }
        // Most entries are "Key=Value; Key=Value": show one field per line.
        catch (JsonException) { return value.Replace("; ", "\n"); }
    }

    private static string ActionLabel(string type) => type switch
    {
        "Create" => "Tạo mới",
        "Update" => "Cập nhật",
        "Delete" => "Xóa",
        "Login" => "Đăng nhập",
        "Logout" => "Đăng xuất",
        "RoleChange" => "Đổi vai trò",
        "AccountLock" => "Khóa tài khoản",
        "AccountUnlock" => "Mở khóa tài khoản",
        "PasswordChange" => "Đổi mật khẩu",
        "CreateMembershipPlan" => "Tạo gói hội viên",
        "UpdateMembershipPlan" => "Sửa gói hội viên",
        "ActivateMembershipPlan" => "Mở bán gói hội viên",
        "DeactivateMembershipPlan" => "Ngừng bán gói hội viên",
        "DeleteMembershipPlan" => "Xóa gói hội viên",
        _ => type
    };

    public void Dispose()
    {
        _lifetime.Cancel();
        _lifetime.Dispose();
    }

    private sealed class FilterModel
    {
        public DateOnly? From { get; set; }
        public DateOnly? To { get; set; }
        public string? ActorUserId { get; set; }
        public string? ActionType { get; set; }
        public string? Entity { get; set; }
    }
}
