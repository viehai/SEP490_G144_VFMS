@using VFMS.Contracts.Lockers
@using VFMS.Client.Components.Operations
@* Locker grid grouped by zone; the cell frame remains visible in every state. *@
@if (Slots.Count == 0)
{
    <p role="status" class="text-sm text-vfms-text-secondary">Không có tủ phù hợp.</p>
}
else
{
    @foreach (var zone in PageSlots.GroupBy(s => s.Zone))
    {
        <section class="space-y-2" aria-label="@($"Khu {zone.Key}")">
            <h3 class="text-xs font-bold uppercase tracking-wider text-vfms-text-secondary">Khu @zone.Key</h3>
            <div class="locker-grid">
                @foreach (var slot in zone.OrderBy(s => s.Number, StringComparer.OrdinalIgnoreCase))
                {
                    var chosen = slot.Id == SelectedId;
                    <button type="button" @key="slot.Id" disabled="@(!IsSelectable(slot))" aria-pressed="@chosen.ToString().ToLowerInvariant()"
                            class="locker-cell" data-locker-status="@slot.Status" @onclick="() => OnSelect.InvokeAsync(slot)">
                        <span class="locker-cell-number">@slot.Number</span>
                        <StatusBadge Status="@LockerText.SlotTone(slot.Status)" Label="@LockerText.Slot(slot.Status)" />
                    </button>
                }
            </div>
        </section>
    }
    @if (Slots.Count > PageSize)
    {
        <Pager Page="_page" PageSize="PageSize" TotalCount="Slots.Count" Noun="tủ" OnPage="page => _page = page" />
    }
}

@code {
    [Parameter, EditorRequired] public IReadOnlyList<LockerSlot> Slots { get; set; } = [];
    [Parameter] public int? SelectedId { get; set; }
    [Parameter] public Func<LockerSlot, bool>? Selectable { get; set; }
    [Parameter] public EventCallback<LockerSlot> OnSelect { get; set; }

    private const int PageSize = 10;
    private int _page = 1;
    private IReadOnlyList<LockerSlot>? _previousSlots;
    private IEnumerable<LockerSlot> PageSlots => Slots.OrderBy(s => s.Zone)
        .ThenBy(s => s.Number, StringComparer.OrdinalIgnoreCase).ThenBy(s => s.Id)
        .Skip((_page - 1) * PageSize).Take(PageSize);

    protected override void OnParametersSet()
    {
        // A filtered grid may have a different set of lockers; start from its first page.
        if (_previousSlots is not null && !_previousSlots.Select(s => s.Id).SequenceEqual(Slots.Select(s => s.Id)))
            _page = 1;
        _previousSlots = Slots;
        _page = Math.Clamp(_page, 1, Math.Max(1, (Slots.Count + PageSize - 1) / PageSize));
    }

    private bool IsSelectable(LockerSlot slot) => Selectable?.Invoke(slot) ?? true;

}
