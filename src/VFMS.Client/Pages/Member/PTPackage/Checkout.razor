@page "/pt-checkout/{OrderNumber}"
@layout PublicLayout
@attribute [Authorize(Roles = "Member")]
@implements IDisposable
@using VFMS.Contracts.Memberships
@using VFMS.Client.Components.Operations
@inject PersonalTrainingApiClient Api
@inject ToastService Toasts
<PageTitle>Thanh toán gói PT | Victor Fitness</PageTitle>

<section class="trainer-page trainer-public trainer-narrow trainer-stack">
    <a class="trainer-back" href="/my-pt-packages">← Gói PT của tôi</a>
    <PageHeader Overline="VFMS / GÓI PT" Title="Thanh toán gói PT"
                Description="Chọn VietQR hoặc thanh toán tiền mặt tại quầy lễ tân. Lịch tập được xác nhận ngay khi đơn đã thanh toán." />
    <TrainerFeedback Error="@_error" />
    @if (_order is { } order)
    {
        <section class="trainer-panel trainer-stack">
            <div class="trainer-row trainer-between"><h2>Đơn @order.OrderNumber</h2><TrainerStatus Status="@(order.Status == "Pending" ? "PendingPayment" : order.Status)" /></div>
            <strong class="pt-plan-price">@Money(order.AmountDue)</strong>
            @if (order.Status is "Pending" && order.PayAtCounter)
            {
                <p>Mang mã đơn <strong>@order.OrderNumber</strong> đến quầy lễ tân và trả đúng @Money(order.AmountDue) tiền mặt.</p>
                <p>Lịch tập được giữ đến <strong>@LocalTime(order.HoldExpiresAt)</strong> (còn @Remaining(order.HoldExpiresAt)). Quá hạn chưa trả thì lịch được trả lại.</p>
            }
            else if (order.Status is "Pending" or "AwaitingConfirmation")
            {
                @if (order.Status == "Pending" && order.VietQr is { } qr)
                {
                    <p>Còn <strong>@Remaining(order.ExpiresAt)</strong> để chuyển khoản đúng số tiền và nội dung (trước @LocalTime(order.ExpiresAt)).</p>
                    @if (Uri.TryCreate(qr.ImageUrl, UriKind.Absolute, out var image) && image.Scheme == "https")
                    {
                        <img class="pt-qr" src="@image.AbsoluteUri" alt="Mã VietQR thanh toán gói PT" />
                    }
                    <dl class="pt-facts">
                        <dt>Ngân hàng</dt><dd>@qr.BankId</dd>
                        <dt>Số tài khoản</dt><dd>@qr.AccountNumber</dd>
                        <dt>Chủ tài khoản</dt><dd>@qr.AccountName</dd>
                        <dt>Nội dung</dt><dd>@qr.TransferContent</dd>
                    </dl>
                }
                else if (order.Status == "Pending" && CanChoose(order))
                {
                    <p>Còn <strong>@Remaining(order.ProceedBefore!.Value)</strong> để chọn cách thanh toán (trước @LocalTime(order.ProceedBefore.Value)). Sau khi chọn, số tiền được chốt.</p>
                    <label>Voucher (không bắt buộc)<input class="trainer-input" maxlength="80" @bind="_voucher" disabled="@_busy" /></label>
                    <div class="trainer-row">
                        <button type="button" class="trainer-button trainer-primary" disabled="@_busy" @onclick="() => PayAsync(MembershipPaymentMethods.VietQr)">Tạo mã VietQR</button>
                        <button type="button" class="trainer-button" disabled="@_busy" @onclick="() => PayAsync(MembershipPaymentMethods.Cash)">Thanh toán tại quầy</button>
                    </div>
                    <small class="trainer-muted">VietQR: chuyển khoản trong 15 phút kể từ lúc giữ lịch. Tại quầy: trả tiền mặt trong 24 giờ kể từ lúc giữ lịch.</small>
                }
                else if (order.Status == "Pending" && order.ProceedBefore is not null)
                {
                    <p>Đã quá 10 phút mà chưa chọn cách thanh toán. Lịch đang giữ sẽ được trả lại lúc @LocalTime(order.HoldExpiresAt).</p>
                    <a class="trainer-button" href="/trainers">Chọn lịch khác</a>
                }
                else
                {
                    <p>Đã hết thời gian chuyển khoản. Hệ thống đang chờ xác nhận giao dịch đã thực hiện đúng hạn (đến @LocalTime(order.HoldExpiresAt)).</p>
                }
            }
            else if (order.Status == "Paid")
            {
                <p>Đã xác nhận lịch tập.</p>
                @if (order.InvoiceNumber is { } invoice)
                {
                    <p>Hóa đơn @invoice</p>
                }
                <a class="trainer-button trainer-primary" href="@($"/my-pt-packages?contract={order.ContractId}")">Xem hợp đồng và lịch tập</a>
            }
            else if (order.Status == "Expired")
            {
                <p>Đã hết thời gian giữ lịch. Nếu đã chuyển khoản, kiểm tra lại trạng thái tại đây.</p>
                <a class="trainer-button" href="/trainers">Chọn lịch khác</a>
            }
            @if (order.Refunds is { Count: > 0 } refunds)
            {
                <section class="trainer-stack">
                    <h3>Các khoản hoàn tiền</h3>
                    <ul class="trainer-list">
                        @foreach (var refund in refunds)
                        {
                            <li @key="refund.Id" class="trainer-row trainer-between">
                                <span>@Money(refund.Amount) · @LocalTime(refund.ReceivedAt)</span>
                                <TrainerStatus Status="@(refund.Status switch { "Pending" => "RefundPending", "Failed" => "RefundFailed", var s => s })" />
                            </li>
                        }
                    </ul>
                </section>
            }
            <button class="trainer-button" disabled="@_busy" @onclick="RefreshAsync">Kiểm tra trạng thái</button>
        </section>
    }
    else if (_busy) { <p role="status">Đang tải đơn…</p> }
    else { <button class="trainer-button" @onclick="RefreshAsync">Tải lại</button> }
</section>

@code {
    [Parameter] public string OrderNumber { get; set; } = "";
    private CancellationTokenSource? _lifetime;
    private PTCheckoutResponse? _order;
    private string _voucher = "";
    private bool _busy;
    private string? _error;

    protected override async Task OnParametersSetAsync()
    {
        Dispose();
        var lifetime = new CancellationTokenSource();
        var ct = lifetime.Token;
        _lifetime = lifetime;
        _order = null;
        _busy = false;
        _voucher = "";
        await RefreshAsync();
        if (!ct.IsCancellationRequested)
            _ = PollAsync(ct);
    }

    // GBR-102: the payment choice must be made within 10 minutes of holding the slots.
    private static bool CanChoose(PTCheckoutResponse order) =>
        order.ProceedBefore is { } before && DateTime.UtcNow < before && DateTime.UtcNow < order.ExpiresAt;

    private async Task RefreshAsync()
    {
        if (_busy || _lifetime is null) return;
        var ct = _lifetime.Token;
        _busy = true;
        try
        {
            var order = await Api.CheckoutAsync(OrderNumber, ct);
            if (!ct.IsCancellationRequested) { SetOrder(order); _error = null; }
        }
        catch (AuthApiException ex) when (!ct.IsCancellationRequested) { _error = ex.Message; }
        catch (Exception ex) when (ct.IsCancellationRequested && ex is OperationCanceledException or AuthApiException) { }
        finally { if (!ct.IsCancellationRequested) _busy = false; }
    }

    private async Task PayAsync(string method)
    {
        if (_busy || _order is not { Status: "Pending", VietQr: null, PayAtCounter: false } order || !CanChoose(order)) return;
        _busy = true;
        _error = null;
        var ct = _lifetime!.Token;
        try
        {
            var updated = await Api.StartPaymentAsync(order.OrderNumber,
                new(string.IsNullOrWhiteSpace(_voucher) ? null : _voucher.Trim(), method));
            if (!ct.IsCancellationRequested) SetOrder(updated);
        }
        catch (AuthApiException ex) { if (!ct.IsCancellationRequested) _error = ex.Message; }
        finally { if (!ct.IsCancellationRequested) _busy = false; }
    }

    // MSG-23: toast once, when this page sees the order become paid (not when opening an already paid order).
    private void SetOrder(PTCheckoutResponse order)
    {
        if (_order is { Status: not "Paid" } && order.Status == "Paid")
            Toasts.Show($"Thanh toán thành công cho hóa đơn #{order.InvoiceNumber}.");
        _order = order;
    }

    private async Task PollAsync(CancellationToken ct)
    {
        using var timer = new PeriodicTimer(TimeSpan.FromSeconds(1));
        var seconds = 0;
        try
        {
            while (_order?.Status is "Pending" or "AwaitingConfirmation" or "RefundPending" && await timer.WaitForNextTickAsync(ct))
            {
                if (++seconds % 4 == 0) await RefreshAsync();
                if (!ct.IsCancellationRequested) await InvokeAsync(StateHasChanged);
            }
        }
        catch (OperationCanceledException) when (ct.IsCancellationRequested) { }
    }

    private static string Remaining(DateTime until)
    {
        var left = TimeSpan.FromSeconds(Math.Max(0, Math.Ceiling((until - DateTime.UtcNow).TotalSeconds)));
        return left.TotalHours >= 1 ? $"{(int)left.TotalHours} giờ {left.Minutes} phút" : left.ToString(@"mm\:ss");
    }

    public void Dispose()
    {
        _lifetime?.Cancel();
        _lifetime?.Dispose();
        _lifetime = null;
    }
}
