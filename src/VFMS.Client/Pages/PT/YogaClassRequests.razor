@page "/pt/yoga/class-requests"
@layout StaffPTLayout
@attribute [Authorize(Roles = "YogaInstructor")]
@using Microsoft.AspNetCore.Authorization
@using VFMS.Client.Components.Memberships
@using VFMS.Client.Components.Operations
@using VFMS.Contracts.Yoga
@inject VfmsApiClient Api

@* GBR-128..GBR-130: the instructor asks the Manager to open a class; the Manager approves (creates a Draft class) or rejects. *@
<PageTitle>Yêu cầu mở lớp Yoga | Victor Fitness</PageTitle>

<div class="workspace-page space-y-8 font-['Inter',sans-serif] text-[#242424]">
    <PageHeader Overline="VFMS / YOGA" Title="Yêu cầu mở lớp" Description="Đề xuất lớp bạn muốn dạy. Quản lý xem xét, chỉnh nếu cần rồi tạo lớp; bạn sẽ nhận thông báo kết quả." />

    <StatusMessage Notice="@_notice" Error="@_error" />

    <section class="grid gap-6 xl:grid-cols-[420px_minmax(0,1fr)]">
        <form class="@Ui.Card space-y-4" @onsubmit="Submit" aria-labelledby="request-form-title">
            <h2 id="request-form-title" class="workspace-heading text-sm font-extrabold uppercase tracking-wider">Đề xuất lớp mới</h2>

            <label class="block @Ui.Label">Tên lớp
                <input class="@Ui.Field" @bind="_form.Name" maxlength="256" required />
            </label>
            <div class="grid grid-cols-2 gap-3">
                <label class="block @Ui.Label">Loại lớp
                    <select class="@Ui.Field" @bind="_form.TypeId" required>
                        <option value="0">— Chọn —</option>
                        @foreach (var t in _options?.ClassTypes ?? []) { <option value="@t.Id">@t.TypeName</option> }
                    </select>
                </label>
                <label class="block @Ui.Label">Cấp độ gói
                    <select class="@Ui.Field" @bind="_form.Level">
                        <option value="Beginner">Cơ bản</option><option value="Intermediate">Trung bình</option><option value="Advanced">Nâng cao</option>
                    </select>
                </label>
            </div>
            <div class="grid grid-cols-3 gap-3">
                <label class="block @Ui.Label">Tối thiểu<input type="number" min="1" class="@Ui.Field" @bind="_form.Min" /></label>
                <label class="block @Ui.Label">Tối đa<input type="number" min="1" class="@Ui.Field" @bind="_form.Max" @bind:after="ClearError" /></label>
                <label class="block @Ui.Label">Phút/buổi<input type="number" min="45" max="90" class="@Ui.Field" @bind="_form.Duration" /></label>
            </div>
            <div class="grid grid-cols-2 gap-3">
                <label class="block @Ui.Label">Ngày bắt đầu<input type="date" min="@Earliest.ToString("yyyy-MM-dd")" class="@Ui.Field" @bind="_form.Start" aria-describedby="start-help" /></label>
                <label class="block @Ui.Label">Ngày kết thúc<input type="date" class="@Ui.Field" @bind="_form.End" /></label>
            </div>
            <p id="start-help" class="text-xs text-[#6F6966]">Bắt đầu sớm nhất @Earliest.ToString("dd/MM/yyyy"): lớp cần được công bố trước buổi đầu tiên ít nhất 7 ngày.</p>

            <label class="block @Ui.Label">Buổi/tuần
                <input type="number" min="1" max="7" class="@Ui.Field" @bind="_form.PerWeek" @bind:after="TrimDays" />
            </label>
            <fieldset aria-describedby="days-help">
                <legend class="@Ui.Label">Thứ muốn dạy</legend>
                @{ var full = _form.Days.Count >= _form.PerWeek; }
                <div class="mt-1 flex flex-wrap gap-2">
                    @foreach (var (day, label) in YogaClassRequestPrefill.WeekDays)
                    {
                        var on = _form.Days.Contains(day);
                        var locked = full && !on;
                        <button type="button" aria-pressed="@(on ? "true" : "false")" disabled="@locked" @onclick="() => ToggleDay(day)"
                                class="@($"min-h-[44px] min-w-[52px] rounded-lg border px-3 text-xs font-bold transition-colors {(on ? "border-[#B83A3A] bg-[#B83A3A] text-white" : locked ? "cursor-not-allowed border-[#D8D1CD] bg-[#ECE8E4] text-[#9A928E] opacity-60" : "border-[#C9C0BB] bg-[#F8F5F2] text-[#242424] hover:bg-[#F3EDEA]")}")">@label</button>
                    }
                </div>
                <p id="days-help" class="mt-2 text-xs @(DaysProblem is null ? "text-[#15803D]" : "text-[#6F6966]")" aria-live="polite">
                    @(DaysProblem ?? $"Đã chọn đủ {_form.PerWeek} ngày.")
                </p>
            </fieldset>
            <div class="grid grid-cols-2 gap-3">
                <label class="block @Ui.Label">Giờ bắt đầu<input type="time" class="@Ui.Field" @bind="_form.Time" /></label>
                <label class="block @Ui.Label">Phòng mong muốn
                    <select class="@Ui.Field" @bind="_form.StudioId" aria-describedby="studio-help">
                        <option value="0">Để quản lý chọn</option>
                        @foreach (var s in _options?.Studios ?? []) { <option value="@s.Id">@s.StudioName (@s.Capacity thảm)</option> }
                    </select>
                </label>
            </div>
            @if (StudioProblem is { } studioProblem)
            {
                <p id="studio-help" class="text-xs font-semibold text-[#B91C1C]" role="alert">@studioProblem</p>
            }
            <label class="block @Ui.Label">Mô tả lớp<textarea class="@Ui.Field" rows="2" @bind="_form.Description" maxlength="1000"></textarea></label>
            <label class="block @Ui.Label">Ghi chú cho quản lý<textarea class="@Ui.Field" rows="2" @bind="_form.Note" maxlength="1000" placeholder="Ví dụ: đã có nhiều hội viên hỏi lớp buổi sáng"></textarea></label>

            <button type="submit" disabled="@(_busy || DaysProblem is not null || StudioProblem is not null)"
                    class="@Ui.PrimaryButton min-h-[44px] w-full disabled:cursor-not-allowed disabled:opacity-50">
                @(_busy ? "Đang gửi…" : "Gửi yêu cầu")
            </button>
        </form>

        <div class="space-y-4" aria-labelledby="my-requests-title">
            <h2 id="my-requests-title" class="workspace-heading text-sm font-extrabold uppercase tracking-wider">Yêu cầu của tôi</h2>
            @if (_loading)
            {
                <p role="status" class="text-sm text-[#6F6966]">Đang tải…</p>
            }
            else if (_items.Count == 0)
            {
                <p class="@Ui.Card text-sm text-[#6F6966]">Bạn chưa gửi yêu cầu mở lớp nào.</p>
            }
            @foreach (var r in _items)
            {
                <article @key="r.Id" class="@Ui.ListCard">
                    <div class="flex flex-wrap items-start justify-between gap-3 px-5 py-4">
                        <div class="min-w-0">
                            <p class="workspace-heading text-sm font-extrabold uppercase">@r.ClassName</p>
                            <p class="mt-1 text-xs text-[#6F6966]">@r.TypeName · @YogaClassCard.LevelName(r.DifficultyLevel) · @r.MinParticipants–@r.MaxParticipants người · @r.DurationMinutes phút</p>
                            <p class="text-xs text-[#6F6966]">@r.StartDate.ToString("dd/MM/yyyy") → @r.EndDate.ToString("dd/MM/yyyy") · @YogaClassRequestPrefill.DaysLabel(r.PreferredDays) lúc @r.PreferredStartTime.ToString("HH:mm")@(r.PreferredStudioName is { } room ? $" · {room}" : "")</p>
                            <p class="text-xs text-[#6F6966]">Gửi lúc @r.CreatedAt.AddHours(7).ToString("dd/MM/yyyy HH:mm")</p>
                        </div>
                        <div class="flex flex-wrap items-center gap-2">
                            <StatusBadge Status="@r.Status" Label="@YogaClassRequestPrefill.StatusLabel(r.Status)" />
                            @if (r.Status == "Pending")
                            {
                                <button type="button" class="@Ui.DangerButton min-h-[44px]" disabled="@_busy" @onclick="() => Withdraw(r)">Rút yêu cầu</button>
                            }
                        </div>
                    </div>
                    @if (r.Status == "Rejected")
                    {
                        <p class="border-t border-[#D8D1CD] bg-red-50 px-5 py-3 text-sm text-red-900"><b>Lý do từ chối:</b> @r.RejectReason</p>
                    }
                    else if (r.Status == "Approved")
                    {
                        <p class="border-t border-[#D8D1CD] bg-emerald-50 px-5 py-3 text-sm text-emerald-900">Đã duyệt@(r.ReviewedByName is { } by ? $" bởi {by}" : ""). Lớp đã được tạo ở trạng thái nháp; quản lý sẽ xếp lịch và công bố.</p>
                    }
                </article>
            }
        </div>
    </section>
</div>

@code {
    private YogaClassOpeningOptionsResponse? _options;
    private List<YogaClassOpeningRequestResponse> _items = [];
    private RequestForm _form = new();
    private bool _loading = true, _busy;
    private string? _notice, _error;

    private static DateOnly Earliest => DateOnly.FromDateTime(DateTime.UtcNow.AddHours(7)).AddDays(7);
    private string? DaysProblem => YogaClassRequestPrefill.DaysProblem(_form.Days, _form.PerWeek);
    private string? StudioProblem =>
        YogaClassRequestPrefill.StudioProblem(_options?.Studios.FirstOrDefault(s => s.Id == _form.StudioId), _form.Max);

    protected override async Task OnInitializedAsync()
    {
        try
        {
            var options = Api.GetAsync<YogaClassOpeningOptionsResponse>("api/yoga/class-requests/options");
            var mine = Api.GetAsync<List<YogaClassOpeningRequestResponse>>("api/yoga/class-requests/mine");
            (_options, _items) = (await options, await mine);
        }
        catch (ApiException ex) { _error = ex.Message; }
        finally { _loading = false; }
    }

    private void ClearError() => _error = null;

    private void ToggleDay(DayOfWeek day)
    {
        if (!_form.Days.Remove(day) && _form.Days.Count < _form.PerWeek) _form.Days.Add(day);
    }

    private void TrimDays()
    {
        // Fewer sessions a week than days picked: drop the last ones picked in week order.
        foreach (var extra in _form.Days.OrderBy(d => ((int)d + 6) % 7).Skip(Math.Max(0, _form.PerWeek)).ToArray())
            _form.Days.Remove(extra);
    }

    private async Task Submit()
    {
        if (_busy) return;
        _busy = true; _notice = null; _error = null;
        try
        {
            var body = new YogaClassOpeningRequestRequest(_form.TypeId, _form.Name, _form.Level, _form.PerWeek, _form.Min, _form.Max,
                _form.Duration, _form.Start, _form.End, _form.Days.ToArray(), _form.Time,
                _form.StudioId == 0 ? null : _form.StudioId, _form.Description, _form.Note);
            await Api.PostAsync<YogaClassOpeningRequestResponse>("api/yoga/class-requests", body);
            _notice = "Đã gửi yêu cầu mở lớp. Quản lý sẽ xem xét và thông báo kết quả cho bạn.";   // MSG-54
            _form = new();
            _items = await Api.GetAsync<List<YogaClassOpeningRequestResponse>>("api/yoga/class-requests/mine");
        }
        catch (ApiException ex) { _error = ex.Message; }
        finally { _busy = false; }
    }

    private async Task Withdraw(YogaClassOpeningRequestResponse r)
    {
        if (_busy) return;
        _busy = true; _notice = null; _error = null;
        try
        {
            await Api.PostAsync<YogaClassOpeningRequestResponse>($"api/yoga/class-requests/{r.Id}/withdraw");
            _notice = $"Đã rút yêu cầu mở lớp {r.ClassName}.";
            _items = await Api.GetAsync<List<YogaClassOpeningRequestResponse>>("api/yoga/class-requests/mine");
        }
        catch (ApiException ex) { _error = ex.Message; }
        finally { _busy = false; }
    }

    private sealed class RequestForm
    {
        public string Name { get; set; } = string.Empty;
        public int TypeId { get; set; }
        public string Level { get; set; } = "Beginner";
        public int PerWeek { get; set; } = 2;
        public int Min { get; set; } = 3;
        public int Max { get; set; } = 15;
        public int Duration { get; set; } = 60;
        public DateOnly Start { get; set; } = DateOnly.FromDateTime(DateTime.UtcNow.AddHours(7)).AddDays(14);
        public DateOnly End { get; set; } = DateOnly.FromDateTime(DateTime.UtcNow.AddHours(7)).AddDays(60);
        public TimeOnly Time { get; set; } = new(7, 0);
        public int StudioId { get; set; }
        public HashSet<DayOfWeek> Days { get; } = [];
        public string? Description { get; set; }
        public string? Note { get; set; }
    }
}
