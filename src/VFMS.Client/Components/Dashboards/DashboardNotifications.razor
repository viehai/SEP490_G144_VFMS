@inject VfmsApiClient Api
@inject ToastService Toast
@implements IDisposable
<details class="dash-inbox">
    <summary aria-label="@Label" title="@Label"><DashboardIcon Name="bell" />
        @if (_inbox is { Unread: > 0 }) { <span class="dash-count">@_inbox.Unread</span> }
    </summary>
    <div class="dash-popover"><strong>Thông báo</strong>
        @if (_error is not null) { <p role="alert">@_error</p><button type="button" disabled="@(_saving || Disabled)" @onclick="Load">Thử lại</button> }
        else if (_inbox is null) { <p role="status">Đang tải…</p> }
        else if (_inbox.Recent.Count == 0) { <p>Chưa có thông báo.</p> }
        else
        {
            @foreach (var n in _inbox.Recent)
            {
                <article><strong>@n.Title</strong><small>@n.SentAt.AddHours(7).ToString("dd/MM HH:mm") @(n.Read ? "· Đã đọc" : "· Chưa đọc")</small><p>@n.Message</p>
                    @if (!n.Read && n.Id is { } id)
                    {
                        <button type="button" disabled="@(_saving || Disabled)" @onclick="() => MarkRead(id)" aria-label="@($"Đánh dấu đã đọc: {n.Title}")">Đánh dấu đã đọc</button>
                    }
                </article>
            }
        }
        @if (_inbox is not null)
        {
            <button type="button" disabled="@(_saving || Disabled || _inbox.Unread == 0)" @onclick="MarkAllRead">Đánh dấu tất cả đã đọc</button>
        }
        <a href="/notifications">Xem tất cả</a>
    </div>
</details>

@code {
    [Parameter] public EventCallback OnRead { get; set; }
    [Parameter] public EventCallback<bool> OnSavingChanged { get; set; }
    [Parameter] public bool Disabled { get; set; }
    private DashboardInbox? _inbox;
    private bool _saving;
    private int _loadVersion;
    private string? _error;
    private readonly CancellationTokenSource _lifetime = new();
    private string Label => _inbox is { Unread: > 0 } ? $"Thông báo, {_inbox.Unread} chưa đọc" : "Thông báo";
    protected override Task OnInitializedAsync() => Load();
    public async Task RefreshAsync() { await Load(); StateHasChanged(); }
    private Task MarkRead(int id) => Save($"api/dashboards/notifications/{id}/read", "Đã đánh dấu thông báo là đã đọc.");
    private Task MarkAllRead() => Save("api/dashboards/notifications/read-all", "Đã đánh dấu tất cả thông báo là đã đọc.");
    private async Task Save(string path, string message)
    {
        if (_saving || Disabled) return;
        _saving = true;
        ++_loadVersion;
        try
        {
            await OnSavingChanged.InvokeAsync(true);
            var inbox = await Api.PostAsync<DashboardInbox>(path, cancellationToken: _lifetime.Token);
            ++_loadVersion;
            _inbox = inbox;
            _error = null;
            Toast.Show(message);
            await OnRead.InvokeAsync();
        }
        catch (ApiException ex) { Toast.ShowError(ex.Message); }
        catch (OperationCanceledException) when (_lifetime.IsCancellationRequested) { }
        finally { _saving = false; await OnSavingChanged.InvokeAsync(false); }
    }
    private async Task Load()
    {
        var version = ++_loadVersion;
        _error = null;
        try
        {
            var inbox = await Api.GetAsync<DashboardInbox>("api/dashboards/notifications", _lifetime.Token);
            if (version == _loadVersion) _inbox = inbox;
        }
        catch (ApiException ex) { if (version == _loadVersion) _error = ex.Message; }
        catch (OperationCanceledException) when (_lifetime.IsCancellationRequested) { }
    }
    public void Dispose() { _lifetime.Cancel(); _lifetime.Dispose(); }
}
