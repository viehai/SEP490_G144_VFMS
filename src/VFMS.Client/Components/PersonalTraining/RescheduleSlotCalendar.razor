@* Same week table as the teaching schedule: the trainer's published slots are buttons, busy or unusable ones stay disabled. *@
<PTPreviewCalendar @key="Options" Slots="_slots" StartDate="From">
    <SlotContent Context="slot">
        @{ var option = Options[slot.TemplateId]; }
        @if (option.Status == "Available")
        {
            <button type="button" class="trainer-button pt-slot-choice" disabled="@Disabled"
                    aria-pressed="@(Equals(Selected, option) ? "true" : "false")"
                    aria-label="@($"{Day(option.Date.DayOfWeek)} {Date(option.Date)}, {Time(option.StartTime)} đến {Time(option.EndTime)}")"
                    @onclick="() => SelectedChanged.InvokeAsync(option)">
                @Time(option.StartTime) – @Time(option.EndTime)
            </button>
        }
        else
        {
            <div class="pt-calendar-slot"><strong>@Time(option.StartTime) – @Time(option.EndTime)</strong>
                <small class="block trainer-muted">@Status(option.Status)</small></div>
        }
    </SlotContent>
</PTPreviewCalendar>

@code {
    [Parameter, EditorRequired] public PTRescheduleSlot[] Options { get; set; } = [];
    [Parameter, EditorRequired] public DateOnly From { get; set; }
    [Parameter] public PTRescheduleSlot? Selected { get; set; }
    [Parameter] public EventCallback<PTRescheduleSlot> SelectedChanged { get; set; }
    [Parameter] public bool Disabled { get; set; }

    private PTCalendarSlot[] _slots = [];

    protected override void OnParametersSet() =>
        _slots = Options.Select((o, i) => new PTCalendarSlot(i, o.Date, o.StartTime, o.EndTime, o.Status)).ToArray();
}
