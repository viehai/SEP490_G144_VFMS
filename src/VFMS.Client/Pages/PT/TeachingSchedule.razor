@page "/pt/teaching-schedule"
@layout StaffPTLayout
@attribute [Authorize(Roles = "PT")]
@using VFMS.Client.Components.Operations
@inject PersonalTrainingApiClient Api

<PageTitle>Lịch dạy PT | Victor Fitness</PageTitle>

<section class="workspace-page trainer-page trainer-stack">
    <PageHeader Overline="VFMS / PT" Title="Lịch dạy PT"
                Description="Các buổi dạy trong tuần theo thứ Hai đến Chủ nhật." />
    <section class="trainer-panel trainer-stack">
        <div class="trainer-row trainer-between">
            <p role="status">@Date(_monday) – @Date(_monday.AddDays(6))</p>
            <div class="trainer-row" role="group" aria-label="Chuyển tuần lịch dạy">
                <button type="button" class="trainer-button" disabled="@(_loading || _monday.DayNumber < 7)"
                        @onclick="() => LoadAsync(_monday.AddDays(-7))">← Tuần trước</button>
                <button type="button" class="trainer-button" disabled="@(_loading || _monday == CurrentMonday)"
                        @onclick="() => LoadAsync(CurrentMonday)">Tuần này</button>
                <button type="button" class="trainer-button" disabled="@(_loading || _monday.DayNumber > DateOnly.MaxValue.DayNumber - 13)"
                        @onclick="() => LoadAsync(_monday.AddDays(7))">Tuần sau →</button>
            </div>
        </div>
        <TrainerFeedback Error="@_error" />
        @if (_loading)
        {
            <p role="status">Đang tải lịch dạy…</p>
        }
        else if (_error is not null)
        {
            <button type="button" class="trainer-button" @onclick="() => LoadAsync(_monday)">Tải lại</button>
        }
        else
        {
            <p class="pt-legend" aria-label="Chú thích trạng thái">
                <span><i class="pt-legend-swatch" data-tone="blue"></i>Đã lên lịch</span>
                <span><i class="pt-legend-swatch" data-tone="amber"></i>Chờ điểm danh / phản hồi / bảo lưu</span>
                <span><i class="pt-legend-swatch" data-tone="green"></i>Hoàn thành</span>
                <span><i class="pt-legend-swatch" data-tone="red"></i>Vắng mặt</span>
                <span><i class="pt-legend-swatch" data-tone="purple"></i>Tranh chấp / báo PT vắng</span>
            </p>
            <PTWeeklyGrid Slots="_slots" WeekMonday="_monday">
                <SlotContent Context="slot">
                    @{ var session = _sessions[Math.Abs(slot.TemplateId)]; }
                    @if (slot.TemplateId < 0)
                    {
                        <div class="pt-calendar-slot pt-teaching-slot pt-proposed-slot">
                            <strong>@session.MemberName</strong>
                            <span>@Time(slot.StartTime) – @Time(slot.EndTime)</span>
                            <span class="pt-pills"><span class="pt-status-pill" data-tone="amber">Xin chuyển sang</span></span>
                            <a class="trainer-link" href="@($"/pt/contracts/{session.ContractId}/sessions/{session.Id}")">Chi tiết ca</a>
                        </div>
                    }
                    else
                    {
                    <div class="pt-calendar-slot pt-teaching-slot">
                        <strong>@session.MemberName</strong>
                        <span>@Time(slot.StartTime) – @Time(slot.EndTime)</span>
                        <span class="pt-pills"><span class="pt-status-pill" data-tone="@StatusTone(session.IsAwaitingAttendance ? "AwaitingAttendance" : session.Status)">@Status(session.IsAwaitingAttendance ? "AwaitingAttendance" : session.Status)</span></span>
                        <a class="trainer-link" href="@($"/pt/contracts/{session.ContractId}/sessions/{session.Id}")">Chi tiết ca</a>
                    </div>
                    }
                </SlotContent>
            </PTWeeklyGrid>
        }
    </section>
</section>

@code {
    private static DateOnly CurrentMonday
    {
        get
        {
            var today = Today;
            return today.AddDays(-DayIndex(today.DayOfWeek));
        }
    }

    private DateOnly _monday = CurrentMonday;
    private Dictionary<int, PTTeachingSlot> _sessions = [];
    private PTWeeklySlot[] _slots = [];
    private bool _loading;
    private string? _error;

    protected override Task OnInitializedAsync() => LoadAsync(_monday);

    private async Task LoadAsync(DateOnly monday)
    {
        _monday = monday;
        _loading = true;
        _error = null;
        try
        {
            var schedule = await Api.TeachingScheduleAsync(monday);
            _sessions = schedule.ToDictionary(s => s.Id);
            var end = monday.AddDays(6);
            _slots = schedule.Select(s => new PTWeeklySlot(s.Id, s.Date.DayOfWeek, s.StartTime, s.EndTime))
                .Concat(schedule.Where(s => s.ProposedDate is { } d && d >= monday && d <= end)
                    .Select(s => new PTWeeklySlot(-s.Id, s.ProposedDate!.Value.DayOfWeek, s.ProposedStartTime!.Value, s.ProposedEndTime!.Value)))
                .ToArray();
        }
        catch (AuthApiException ex) { _error = ex.Message; }
        finally { _loading = false; }
    }
}
