@page "/auth/setup-password"
@layout AuthLayout
@using System.Text.RegularExpressions
@using VFMS.Contracts.Auth
@using VFMS.Contracts.Auth.Validators
@using VFMS.Contracts.Common
@inject AuthApiClient AuthApi
@inject AuthSession Session
@inject NavigationManager Navigation
@inject IJSRuntime Js

<PageTitle>Thiết lập mật khẩu | Victor Fitness</PageTitle>

<span class="auth-overline-card">TÀI KHOẢN KHÁCH HÀNG / KÍCH HOẠT</span>
<h1 class="auth-title">THIẾT LẬP<br />MẬT KHẨU.</h1>

@if (_done)
{
    <div class="auth-success-mark" aria-hidden="true">✓</div>
    <p class="auth-description">Mật khẩu của bạn đã được thiết lập thành công. Tài khoản hiện đã sẵn sàng để đăng nhập.</p>
    <AuthorizeView>
        <Authorized Context="auth">
            <p class="auth-description">Trình duyệt đang đăng nhập bằng tài khoản @auth.User.Identity?.Name.</p>
            <button type="button" class="auth-submit" disabled="@_busy" @onclick="SignOutAndLoginAsync">
                @(_busy ? "ĐANG ĐĂNG XUẤT..." : "ĐĂNG XUẤT VÀ ĐĂNG NHẬP") <span aria-hidden="true">↗</span>
            </button>
        </Authorized>
        <NotAuthorized>
            <a class="auth-submit" href="/auth/login">ĐĂNG NHẬP NGAY <span aria-hidden="true">↗</span></a>
        </NotAuthorized>
    </AuthorizeView>
}
else if (_readingLink)
{
    <p class="auth-description" role="status">Đang kiểm tra liên kết thiết lập mật khẩu...</p>
}
else if (_token is null)
{
    <div class="auth-notice auth-notice-error" role="alert">@_linkError</div>
    <p class="auth-switch"><a href="/auth/login">Quay lại trang đăng nhập ↗</a></p>
}
else
{
    <p class="auth-description">Nhập mật khẩu mới để kích hoạt tài khoản Victor Fitness của bạn. Liên kết này chỉ dùng một lần trong vòng 48 giờ.</p>
    @if (!string.IsNullOrEmpty(_error))
    {
        <div class="auth-notice auth-notice-error" role="alert">@_error</div>
    }
    <EditForm Model="_model" OnValidSubmit="SubmitAsync" OnInvalidSubmit="InvalidSubmit" Context="setupForm" novalidate>
        <ContractValidation TRequest="SetupPasswordRequest" Validator="_validator" CreateRequest="CreateRequest" @ref="_validation" />
        <fieldset disabled="@_busy" aria-busy="@(_busy ? "true" : "false")">
            <div class="auth-field">
                <label for="setup-password">Mật khẩu mới</label>
                <PasswordInput id="setup-password" class="auth-input" @bind-Value="_model.NewPassword" autocomplete="new-password" aria-describedby="setup-password-error" />
                <div id="setup-password-error"><ValidationMessage For="() => _model.NewPassword" /></div>
            </div>
            <div class="auth-field">
                <label for="setup-confirm-password">Xác nhận mật khẩu</label>
                <PasswordInput id="setup-confirm-password" class="auth-input" @bind-Value="_model.ConfirmPassword" autocomplete="new-password" aria-describedby="setup-confirm-error" />
                <div id="setup-confirm-error"><ValidationMessage For="() => _model.ConfirmPassword" /></div>
            </div>
            <p class="auth-description">Mật khẩu từ 8–32 ký tự, gồm chữ hoa, chữ thường, chữ số và ký tự đặc biệt.</p>
            <button class="auth-submit" type="submit">
                @if (_busy) { <span class="auth-spinner" aria-hidden="true"></span> }
                @(_busy ? "ĐANG LƯU MẬT KHẨU..." : "KÍCH HOẠT TÀI KHOẢN") <span aria-hidden="true">↗</span>
            </button>
        </fieldset>
    </EditForm>
    <p class="auth-switch">Đã có mật khẩu? <a href="/auth/login">Đăng nhập ↗</a></p>
}

@code {
    private const string ReopenLink = "Liên kết thiết lập không còn trong phiên này. Vui lòng mở lại liên kết từ email hoặc liên hệ quầy lễ tân.";
    private const string InvalidLink = "Liên kết thiết lập mật khẩu không hợp lệ. Vui lòng mở lại liên kết từ email hoặc liên hệ quầy lễ tân.";

    private readonly SetupPasswordModel _model = new();
    private readonly SetupPasswordRequestValidator _validator = new();
    private ContractValidation<SetupPasswordRequest>? _validation;
    private string? _token;
    private string? _linkError;
    private string? _error;
    private bool _readingLink = true;
    private bool _busy;
    private bool _done;

    protected override async Task OnInitializedAsync()
    {
        try
        {
            var fragment = await Js.InvokeAsync<string?>("vfmsCustomerSetup.takeFragment");
            _token = ExtractToken(fragment);
            _linkError = fragment is null ? ReopenLink : InvalidLink;
        }
        catch (JSException)
        {
            _linkError = ReopenLink;
        }
        finally
        {
            _readingLink = false;
        }
    }

    private SetupPasswordRequest CreateRequest() => new(_token ?? string.Empty, _model.NewPassword, _model.ConfirmPassword);

    private void InvalidSubmit() => _error = "Vui lòng kiểm tra lại mật khẩu và xác nhận mật khẩu.";

    private async Task SubmitAsync()
    {
        if (_busy || string.IsNullOrWhiteSpace(_token)) return;
        _busy = true;
        _error = null;
        try
        {
            await AuthApi.SetupPasswordAsync(CreateRequest());
            _done = true;
            ClearCredentials();
        }
        catch (AuthApiException ex) when (ex.ErrorCode == "AUTH_INVALID_SETUP_TOKEN")
        {
            _linkError = "Liên kết thiết lập mật khẩu không hợp lệ, đã hết hạn hoặc đã được sử dụng. Vui lòng liên hệ quầy lễ tân nếu cần gửi lại.";
            ClearCredentials();
        }
        catch (AuthApiException ex)
        {
            _error = ex.Message;
            _validation?.ShowErrors(ex.Errors);
        }
        finally
        {
            _busy = false;
        }
    }

    private async Task SignOutAndLoginAsync()
    {
        if (_busy) return;
        _busy = true;
        try
        {
            await Session.SignOutAsync();
            Navigation.NavigateTo("/auth/login", replace: true);
        }
        finally
        {
            _busy = false;
        }
    }

    private void ClearCredentials()
    {
        _model.NewPassword = string.Empty;
        _model.ConfirmPassword = string.Empty;
        _token = null;
    }

    private static string? ExtractToken(string? fragment)
    {
        const string prefix = "#token=";
        if (fragment is null || !fragment.StartsWith(prefix, StringComparison.Ordinal))
            return null;

        var token = Uri.UnescapeDataString(fragment[prefix.Length..]);
        return token.Length == 64 && Regex.IsMatch(token, PasswordPolicyRules.HexTokenPattern) ? token : null;
    }

    private sealed class SetupPasswordModel
    {
        public string NewPassword { get; set; } = string.Empty;
        public string ConfirmPassword { get; set; } = string.Empty;
    }
}
