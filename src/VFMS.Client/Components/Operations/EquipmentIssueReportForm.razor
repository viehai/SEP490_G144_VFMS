@* UC-71 Report Equipment Issue form, used by the Member page and the Staff issue board. *@
@using VFMS.Contracts.Equipment
@using VFMS.Contracts.Equipment.Validators
@inject OperationsApiClient Api
@implements IDisposable

<Alerts Error="@_error" />
<EditForm EditContext="_editContext" OnSubmit="HandleSubmitAsync" novalidate>
    <OperationsValidation TRequest="ReportEquipmentIssueRequest" Validator="_validator" CreateRequest="() => CreateRequest(false)" @ref="_validation" />
    <ValidationSummary />
    <fieldset disabled="@_working" class="mt-2 grid gap-4 sm:grid-cols-2">
        @* One searchable picker: type a name, code or brand and choose from the list under it (WAI-ARIA combobox). *@
        <div class="relative">
            <label class="@Ui.Label" for="@ComboId">Thiết bị <span class="text-vfms-primary" aria-hidden="true">*</span></label>
            <input id="@ComboId" type="text" role="combobox" class="@Ui.Field" autocomplete="off" maxlength="100"
                   aria-required="true" aria-autocomplete="list" aria-controls="@ListId"
                   aria-expanded="@(_open ? "true" : "false")" aria-activedescendant="@ActiveOptionId"
                   placeholder="@(_loading ? "Đang tải thiết bị..." : "Gõ tên, mã hoặc hãng, VD: máy chạy, TM-0002")"
                   value="@_query" @oninput="QueryChanged" @onfocus="OpenList" @onclick="OpenList" @onblur="CloseList" @onkeydown="KeyDown" />
            @if (_open)
            {
                <ul id="@ListId" role="listbox" aria-label="Danh sách thiết bị"
                    class="absolute left-0 right-0 z-20 mt-1 max-h-72 overflow-auto rounded-lg border border-[#D8D1CD] bg-white py-1 shadow-lg">
                    @if (_matches.Count == 0)
                    {
                        <li class="px-3 py-2 text-sm text-[#6F6966]">Không tìm thấy thiết bị phù hợp.</li>
                    }
                    @for (var i = 0; i < _matches.Count; i++)
                    {
                        var index = i;
                        var item = _matches[i];
                        <li id="@OptionId(index)" role="option" aria-selected="@(item.Id == _form.EquipmentId ? "true" : "false")"
                            class="flex cursor-pointer items-center justify-between gap-3 px-3 py-2 text-sm @(index == _active ? "bg-[#F3E4E2]" : "hover:bg-[#ECE8E4]")"
                            @onmousedown="() => Pick(item)" @onmousedown:preventDefault>
                            <span class="min-w-0">
                                <span class="block truncate font-semibold text-[#242424]">@item.Name</span>
                                <span class="block truncate text-xs text-[#6F6966]">@string.Join(" · ", new[] { item.Code, item.Brand, item.CategoryName }.Where(text => !string.IsNullOrWhiteSpace(text)))</span>
                            </span>
                            @if (item.Status != "Operational")
                            {
                                <span class="@OperationsText.Badge(item.Status) shrink-0">@OperationsText.Label(item.Status)</span>
                            }
                        </li>
                    }
                </ul>
            }
        </div>
        <label class="@Ui.Label" for="@($"{IdPrefix}-type")">Loại sự cố <span class="text-vfms-primary" aria-hidden="true">*</span>
            <InputSelect aria-required="true" id="@($"{IdPrefix}-type")" class="@Ui.Field" @bind-Value="_form.IncidentType">
                @foreach (var type in OperationsText.IncidentTypes) { <option value="@type">@OperationsText.Label(type)</option> }
            </InputSelect>
        </label>
        <label class="@Ui.Label sm:col-span-2" for="@($"{IdPrefix}-description")">Mô tả sự cố <span class="text-vfms-primary" aria-hidden="true">*</span>
            <InputTextArea aria-required="true" id="@($"{IdPrefix}-description")" class="@Ui.Field" rows="4" @bind-Value="_form.Description" maxlength="1000" placeholder="VD: Dây cáp máy kéo xô bị sờn, phát ra tiếng kêu khi kéo." />
        </label>
        <label class="@Ui.Label sm:col-span-2" for="@($"{IdPrefix}-image")">Link ảnh (không bắt buộc)
            <InputText id="@($"{IdPrefix}-image")" class="@Ui.Field" @bind-Value="_form.ImageUrl" placeholder="https://..." />
        </label>
        @if (_duplicate)
        {
            <div class="rounded-[10px] border border-amber-300 bg-amber-50 p-4 text-sm text-amber-900 sm:col-span-2" role="alert">
                <p>Thiết bị này đã có báo cáo đang được xử lý. Bạn vẫn muốn gửi thêm báo cáo?</p>
                <div class="mt-3 flex gap-2">
                    <button type="button" class="@Ui.PrimaryButton" @onclick="() => SubmitAsync(true)">Vẫn gửi</button>
                    <button type="button" class="@Ui.Button" @onclick="() => _duplicate = false">Thôi</button>
                </div>
            </div>
        }
        <div class="flex flex-wrap gap-3 sm:col-span-2">
            <button type="submit" class="@Ui.PrimaryButton">@(_working ? "Đang gửi..." : "Gửi báo cáo")</button>
            @if (OnCancel.HasDelegate)
            {
                <button type="button" class="@Ui.Button" @onclick="OnCancel">Hủy</button>
            }
        </div>
    </fieldset>
</EditForm>

@code {
    /// <summary>Prefix for element ids, so two forms on one page never clash.</summary>
    [Parameter] public string IdPrefix { get; set; } = "report";
    [Parameter] public EventCallback<EquipmentIssueResponse> OnReported { get; set; }
    [Parameter] public EventCallback OnCancel { get; set; }

    private readonly CancellationTokenSource _lifetime = new();
    private readonly ReportModel _form = new();
    private readonly ReportEquipmentIssueRequestValidator _validator = new();
    private EditContext _editContext = default!;
    private OperationsValidation<ReportEquipmentIssueRequest>? _validation;
    private List<EquipmentResponse> _equipment = [];
    private List<EquipmentResponse> _matches = [];
    private string _query = "";
    private string? _error;
    private int _active = -1;
    private bool _working, _duplicate, _open, _loading = true;
    private DateTime _pickerEnterAt = DateTime.MinValue;

    private string ComboId => $"{IdPrefix}-equipment";
    private string ListId => $"{IdPrefix}-equipment-list";
    private string OptionId(int index) => $"{IdPrefix}-equipment-option-{index}";
    private string? ActiveOptionId => _open && _active >= 0 && _active < _matches.Count ? OptionId(_active) : null;

    protected override async Task OnInitializedAsync()
    {
        _editContext = new EditContext(_form);
        try
        {
            // Every machine that is not retired; the list is filtered on the page as the user types.
            var page = await Api.GetEquipmentAsync(new(null, null, null, 1, 100), _lifetime.Token);
            _equipment = page.Items.Where(item => item.Status != "Retired").ToList();
            _matches = _equipment;
        }
        catch (AuthApiException error) { _error = error.Message; }
        catch (OperationCanceledException) when (_lifetime.IsCancellationRequested) { }
        finally { _loading = false; }
    }

    private ReportEquipmentIssueRequest CreateRequest(bool confirmDuplicate) => new(_form.EquipmentId, _form.IncidentType,
        _form.Description.Trim(), string.IsNullOrWhiteSpace(_form.ImageUrl) ? null : _form.ImageUrl.Trim(), confirmDuplicate);

    private void QueryChanged(ChangeEventArgs args)
    {
        _query = args.Value?.ToString() ?? "";
        // Typing again after a choice clears it, so the form never sends a machine the text no longer names.
        var chosen = _equipment.FirstOrDefault(item => item.Id == _form.EquipmentId);
        if (_form.EquipmentId != 0 && (chosen is null || _query != EquipmentSearch.Display(chosen))) SetEquipment(0);
        _matches = _equipment.Where(item => EquipmentSearch.Matches(item, _query)).ToList();
        _active = _matches.Count > 0 ? 0 : -1;
        _open = true;
    }

    private void OpenList()
    {
        if (_open) return;
        // With a machine already chosen, show the whole list again so it is easy to switch.
        _matches = _form.EquipmentId != 0 ? _equipment : _equipment.Where(item => EquipmentSearch.Matches(item, _query)).ToList();
        _active = Math.Max(0, _matches.FindIndex(item => item.Id == _form.EquipmentId));
        _open = true;
    }

    private void CloseList() => _open = false;

    private void KeyDown(KeyboardEventArgs args)
    {
        switch (args.Key)
        {
            case "ArrowDown":
                if (!_open) OpenList();
                else if (_matches.Count > 0) _active = (_active + 1) % _matches.Count;
                break;
            case "ArrowUp":
                if (_open && _matches.Count > 0) _active = (_active - 1 + _matches.Count) % _matches.Count;
                break;
            case "Enter":
                _pickerEnterAt = DateTime.UtcNow; // Enter here chooses a machine; it must not send the form (see HandleSubmitAsync).
                if (_open && _active >= 0 && _active < _matches.Count) Pick(_matches[_active]);
                break;
            case "Escape":
                _open = false;
                break;
        }
    }

    private void Pick(EquipmentResponse item)
    {
        SetEquipment(item.Id);
        _query = EquipmentSearch.Display(item);
        _open = false;
    }

    private void SetEquipment(int id)
    {
        _form.EquipmentId = id;
        _editContext.NotifyFieldChanged(FieldIdentifier.Create(() => _form.EquipmentId));
    }

    private async Task HandleSubmitAsync()
    {
        // The browser sends the form right after Enter is pressed in a text box; Enter in the picker only chooses.
        if (DateTime.UtcNow - _pickerEnterAt < TimeSpan.FromMilliseconds(500))
        {
            _pickerEnterAt = DateTime.MinValue;
            return;
        }
        if (_editContext.Validate()) await SubmitAsync(false);
    }

    private async Task SubmitAsync(bool confirmDuplicate)
    {
        if (_working) return;
        _working = true;
        _error = null;
        try
        {
            var saved = await Api.ReportIssueAsync(CreateRequest(confirmDuplicate), _lifetime.Token);
            _duplicate = false;
            _form.Description = "";
            _form.ImageUrl = null;
            await OnReported.InvokeAsync(saved);
        }
        catch (AuthApiException error) when (error.ErrorCode == "EQUIPMENT_ISSUE_DUPLICATE")
        {
            _duplicate = true;
        }
        catch (AuthApiException error)
        {
            _error = error.Message;
            _validation?.ShowErrors(error.Errors);
        }
        catch (OperationCanceledException) when (_lifetime.IsCancellationRequested) { }
        finally { _working = false; }
    }

    public void Dispose()
    {
        _lifetime.Cancel();
        _lifetime.Dispose();
    }

    private sealed class ReportModel
    {
        public int EquipmentId { get; set; }
        public string IncidentType { get; set; } = "Malfunction";
        public string Description { get; set; } = "";
        public string? ImageUrl { get; set; }
    }
}
