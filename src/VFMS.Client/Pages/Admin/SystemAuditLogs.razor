@page "/admin/audit-logs"
@layout ManagerAdminLayout
@using VFMS.Client.Components.Operations
@using System.Text.Encodings.Web
@using System.Text.Json
@using Microsoft.AspNetCore.Authorization
@using VFMS.Contracts.Common
@using VFMS.Contracts.SystemAdministration
@using VFMS.Contracts.SystemAdministration.Validators
@attribute [Authorize(Roles = "Admin")]
@inject SystemAdministrationApiClient Api
@inject IJSRuntime JS
@implements IDisposable

<PageTitle>Nhật ký hệ thống | Victor Fitness</PageTitle>

<div class="workspace-page space-y-6">
    <header class="border-b border-vfms-border pb-6">
        <p class="mb-2 text-xs font-bold tracking-wider text-vfms-primary">VFMS / SECURITY</p>
        <h1 class="text-3xl font-extrabold tracking-tight text-vfms-text sm:text-4xl">Nhật ký hệ thống<span class="text-vfms-primary">.</span></h1>
        <p class="mt-2 text-sm text-vfms-text-secondary">Theo dõi các thay đổi dữ liệu và thao tác quan trọng. Ngày và giờ theo giờ Việt Nam.</p>
    </header>

    @if (_notice is not null)
    {
        <p role="status" class="rounded-[10px] border border-emerald-300 bg-emerald-50 p-4 text-sm text-emerald-900">@_notice</p>
    }
    @if (_error is not null)
    {
        <p role="alert" class="rounded-[10px] border border-red-300 bg-red-50 p-4 text-sm text-red-900">@_error</p>
    }

    @if (_selected is { } log)
    {
        <section class="rounded-[12px] border border-vfms-border bg-vfms-surface p-5 sm:p-6 shadow-sm" aria-labelledby="log-detail-title">
            <div class="flex flex-wrap items-start justify-between gap-3">
                <div>
                    <h2 id="log-detail-title" class="text-base font-bold text-vfms-text">#@log.Id · @OperationsText.AuditAction(log.ActionType) · @OperationsText.AuditEntity(log.AuditEntity, log.EntityId)</h2>
                    <p class="mt-1 text-xs text-vfms-text-secondary">@log.OccurredAt.ToLocalTime().ToString("dd/MM/yyyy HH:mm:ss") · @(log.ActorName ?? "Hệ thống")</p>
                </div>
                <button type="button" class="@Button" @onclick="() => _selected = null">Đóng chi tiết</button>
            </div>
            <div class="mt-4 grid gap-4 lg:grid-cols-2">
                <div>
                    <p class="mb-2 text-sm font-semibold text-vfms-text">Giá trị cũ</p>
                    <pre class="max-h-96 overflow-auto whitespace-pre-wrap break-all rounded-lg border border-vfms-border bg-vfms-surface-alt p-4 text-xs text-vfms-text">@FormatValue(log.OldValue)</pre>
                </div>
                <div>
                    <p class="mb-2 text-sm font-semibold text-vfms-text">Giá trị mới</p>
                    <pre class="max-h-96 overflow-auto whitespace-pre-wrap break-all rounded-lg border border-vfms-border bg-vfms-surface-alt p-4 text-xs text-vfms-text">@FormatValue(log.NewValue)</pre>
                </div>
            </div>
        </section>
    }

    <section class="rounded-[12px] border border-vfms-border bg-vfms-surface shadow-sm overflow-hidden" aria-labelledby="log-list-title" aria-busy="@_loading">
        <div class="border-b border-vfms-border p-5 bg-vfms-surface-alt/40">
            <div class="mb-3 flex flex-wrap items-center justify-between gap-2">
                <h2 id="log-list-title" class="text-sm font-bold text-vfms-text">Bản ghi</h2>
                <button type="button" class="@Button" disabled="@_exporting" @onclick="ExportCsvAsync">@(_exporting ? "Đang xuất..." : "Xuất CSV")</button>
            </div>
            <EditForm Model="_filter" OnValidSubmit="() => LoadAsync(1)" novalidate>
                <OperationsValidation TRequest="AuditLogListRequest" Validator="_validator" CreateRequest="() => CreateRequest(1)" @ref="_validation" />
                <ValidationSummary />
                <fieldset class="flex flex-wrap items-end gap-3">
                    <label class="text-xs font-semibold text-vfms-text" for="log-from">
                        Từ ngày
                        <InputDate id="log-from" ParsingErrorMessage="Nhập ngày hợp lệ." class="@Field" @bind-Value="_filter.From" @bind-Value:after="() => LoadAsync(1)" />
                    </label>
                    <label class="text-xs font-semibold text-vfms-text" for="log-to">
                        Đến ngày
                        <InputDate id="log-to" ParsingErrorMessage="Nhập ngày hợp lệ." class="@Field" @bind-Value="_filter.To" @bind-Value:after="() => LoadAsync(1)" />
                    </label>
                    <label class="text-xs font-semibold text-vfms-text" for="log-action">
                        Thao tác
                        <InputSelect id="log-action" class="@Field" @bind-Value="_filter.ActionType" @bind-Value:after="() => LoadAsync(1)">
                            <option value="">Tất cả</option>
                            @foreach (var type in AuditLogListRequestValidator.ActionTypes)
                            {
                                <option value="@type">@OperationsText.AuditAction(type)</option>
                            }
                        </InputSelect>
                    </label>
                    <label class="text-xs font-semibold text-vfms-text" for="log-entity">
                        Đối tượng
                        <InputSelect id="log-entity" class="@Field" @bind-Value="_filter.Entity" @bind-Value:after="() => LoadAsync(1)">
                            <option value="">Tất cả</option>
                            @foreach (var (type, label) in OperationsText.AuditEntities) { <option value="@type">@label</option> }
                        </InputSelect>
                    </label>
                    <label class="text-xs font-semibold text-vfms-text" for="log-actor">
                        Người thực hiện
                        <input id="log-actor" type="search" class="@Field" @bind="_filter.Actor" @bind:event="oninput" @bind:after="SearchTypedAsync" maxlength="100" placeholder="Tên hoặc email" />
                    </label>
                    <button type="button" class="@Button" @onclick="ClearAsync">Xóa lọc</button>
                </fieldset>
            </EditForm>
        </div>
        @if (_loading && _page is null)
        {
            <p role="status" class="p-5 text-sm">Đang tải nhật ký...</p>
        }
        else if (_page is { Items.Count: > 0 } list)
        {
            <div class="overflow-x-auto">
                <table class="workspace-table min-w-[820px]">
                    <thead>
                        <tr><th scope="col">Thời gian</th><th scope="col">Người thực hiện</th><th scope="col">Thao tác</th><th scope="col">Đối tượng</th><th scope="col">Chi tiết</th></tr>
                    </thead>
                    <tbody>
                        @foreach (var row in list.Items)
                        {
                            <tr @key="row.Id">
                                <th scope="row" class="whitespace-nowrap font-normal">@row.OccurredAt.ToLocalTime().ToString("dd/MM/yyyy HH:mm:ss")</th>
                                <td>@(row.ActorName ?? "Hệ thống")</td>
                                <td><span class="inline-block whitespace-nowrap rounded-md border border-vfms-border bg-vfms-surface-alt px-2.5 py-1 text-[11px] font-semibold text-vfms-text">@OperationsText.AuditAction(row.ActionType)</span></td>
                                <td>@OperationsText.AuditEntity(row.AuditEntity, row.EntityId)</td>
                                <td><button type="button" class="@Button" @onclick="() => OpenAsync(row.Id)">Xem</button></td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
            <nav aria-label="Phân trang nhật ký" class="flex flex-wrap items-center justify-between gap-3 border-t border-vfms-border p-4 text-xs font-medium text-vfms-text-secondary">
                <p>Trang @list.Page / @PageCount(list) · @list.TotalCount bản ghi</p>
                <div class="flex gap-2">
                    <button type="button" class="@Button" disabled="@(_loading || list.Page <= 1)" @onclick="() => LoadAsync(list.Page - 1)">Trang trước</button>
                    <button type="button" class="@Button" disabled="@(_loading || list.Page >= PageCount(list))" @onclick="() => LoadAsync(list.Page + 1)">Trang sau</button>
                </div>
            </nav>
        }
        else
        {
            <p role="status" class="p-5 text-sm text-vfms-text-secondary">Không có bản ghi phù hợp.</p>
        }
    </section>
</div>

@code {
    private const int PageSize = 20;
    private const string Field = "mt-1 block w-full rounded-lg border border-vfms-border bg-vfms-surface px-3 py-2 text-sm font-normal text-vfms-text focus:border-vfms-primary focus:ring-2 focus:ring-vfms-primary/20 outline-none";
    private const string Button = "rounded-lg border border-vfms-border-strong bg-vfms-surface px-3 py-1.5 text-xs font-semibold text-vfms-text hover:bg-[#F3EDEA] transition";
    private static readonly JsonSerializerOptions Indented = new() { WriteIndented = true, Encoder = JavaScriptEncoder.UnsafeRelaxedJsonEscaping };

    private readonly CancellationTokenSource _lifetime = new();
    private readonly FilterModel _filter = new();
    private readonly AuditLogListRequestValidator _validator = new();
    private OperationsValidation<AuditLogListRequest>? _validation;
    private PagedResponse<AuditLogResponse>? _page;
    private AuditLogResponse? _selected;
    private string? _error, _notice;
    private bool _loading, _exporting;

    /// <summary>Downloads every log entry that matches the current filters as a CSV file.</summary>
    private async Task ExportCsvAsync()
    {
        if (_exporting) return;
        _exporting = true;
        _error = _notice = null;
        try
        {
            var (rows, truncated) = await CsvFile.CollectAsync((page, size) =>
                Api.GetAuditLogsAsync(CreateRequest(page) with { PageSize = size }, _lifetime.Token));
            var name = CsvFile.FileName("nhat-ky-he-thong");
            await CsvFile.DownloadAsync(JS, name, ListExports.AuditLogs(rows, OperationsText.AuditAction), _lifetime.Token);
            _notice = $"Đã xuất {rows.Count} bản ghi ra {name}." + (truncated ? $" Chỉ lấy {CsvFile.MaxRows} dòng đầu, hãy lọc bớt." : "");
        }
        catch (AuthApiException error)
        {
            _error = error.Message;
            _validation?.ShowErrors(error.Errors);
        }
        catch (JSException) { _error = "Trình duyệt không tải được tệp CSV. Vui lòng thử lại."; }
        catch (OperationCanceledException) when (_lifetime.IsCancellationRequested) { }
        finally { _exporting = false; }
    }

    protected override Task OnInitializedAsync() => LoadAsync(1);

    private AuditLogListRequest CreateRequest(int page) => new(
        _filter.From?.ToDateTime(TimeOnly.MinValue), _filter.To?.ToDateTime(TimeOnly.MinValue),
        null, Blank(_filter.ActionType), Blank(_filter.Entity), page, PageSize, Blank(_filter.Actor));

    private static string? Blank(string? value) => string.IsNullOrWhiteSpace(value) ? null : value.Trim();

    // Filters apply as they change: dropdowns and dates at once, text boxes after a short pause in typing.
    private LiveQuery Live => _live ??= new(_lifetime.Token);
    private LiveQuery? _live;

    private Task LoadAsync(int page) => Live.NowAsync(token => FetchAsync(page, token));

    private Task SearchTypedAsync() => Live.AfterTypingAsync(token => FetchAsync(1, token));

    private async Task FetchAsync(int page, CancellationToken token)
    {
        _loading = true;
        _error = null;
        try { _page = await Api.GetAuditLogsAsync(CreateRequest(page), token); }
        catch (AuthApiException error)
        {
            _error = error.Message;
            _validation?.ShowErrors(error.Errors);
        }
        finally { if (!token.IsCancellationRequested) _loading = false; }
    }

    private Task ClearAsync()
    {
        _filter.From = _filter.To = null;
        _filter.ActionType = _filter.Entity = _filter.Actor = null;
        return LoadAsync(1);
    }

    private async Task OpenAsync(int id)
    {
        _error = null;
        try { _selected = await Api.GetAuditLogAsync(id, _lifetime.Token); }
        catch (AuthApiException error) { _error = error.Message; }
        catch (OperationCanceledException) when (_lifetime.IsCancellationRequested) { }
    }

    private static int PageCount(PagedResponse<AuditLogResponse> page) => Math.Max(1, (int)Math.Ceiling((double)page.TotalCount / page.PageSize));

    private static string FormatValue(string? value)
    {
        if (string.IsNullOrWhiteSpace(value)) return "—";
        try
        {
            using var document = JsonDocument.Parse(value);
            return JsonSerializer.Serialize(document.RootElement, Indented);
        }
        // Most entries are "Key=Value; Key=Value": show one field per line.
        catch (JsonException) { return value.Replace("; ", "\n"); }
    }



    public void Dispose()
    {
        _lifetime.Cancel();
        _live?.Dispose();
        _lifetime.Dispose();
    }

    private sealed class FilterModel
    {
        public DateOnly? From { get; set; }
        public DateOnly? To { get; set; }
        public string? Actor { get; set; }
        public string? ActionType { get; set; }
        public string? Entity { get; set; }
    }
}
