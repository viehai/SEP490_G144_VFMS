@page "/my-qr"
@layout PublicLayout
@attribute [Authorize(Roles = "Customer,Member")]
@using Microsoft.AspNetCore.Authorization
@using VFMS.Contracts.CheckIn
@inject VfmsApiClient Api
@inject IJSRuntime JS
@using Microsoft.Extensions.Logging
@inject ILogger<MyQr> Log

<PageTitle>Mã QR của tôi | Victor Fitness</PageTitle>

<div class="mx-auto max-w-xl space-y-8 px-4 py-28 font-['Inter',sans-serif] text-[#242424] sm:px-6">
    <header class="border-b border-[#D8D1CD] pb-7">
        <p class="mb-3 text-[10px] font-bold tracking-[.18em] text-[#B83A3A]">TÀI KHOẢN / MÃ QR</p>
        <h1 class="font-['Montserrat'] text-3xl font-extrabold uppercase tracking-tight sm:text-4xl">Mã QR của tôi<span class="text-[#B83A3A]">.</span></h1>
        <p class="mt-3 text-sm leading-6 text-[#6F6966]">Đưa mã này cho Kiosk để vào hoặc ra phòng tập. Mã dùng một lần và hết hạn sau 2 phút; mỗi lần mở lại trang này sẽ tạo mã mới và mã cũ không dùng được nữa.</p>
    </header>

    @if (_error is not null)
    {
        <p role="status" class="border border-red-200 bg-red-50 px-4 py-3 text-sm text-[#B91C1C] rounded-lg">@_error</p>
    }

    <section class="space-y-4 border border-[#D8D1CD] bg-[#F8F5F2] p-6 text-center rounded-xl">
        @if (_svg is not null && _qr is not null)
        {
            <div class="mx-auto w-64">@((MarkupString)_svg)</div>
            <p class="text-xs text-[#6F6966]">Hết hạn lúc @DateTime.SpecifyKind(_qr.ExpiresAt, DateTimeKind.Utc).AddHours(7).ToString("HH:mm:ss")</p>
            <p class="break-all font-mono text-[11px] text-[#6F6966]">@_qr.Token</p>
        }
        <button type="button" disabled="@_busy" class="bg-[#B83A3A] hover:bg-[#9F3030] px-6 py-3 text-xs font-bold uppercase text-white rounded-lg disabled:opacity-40" @onclick="NewCode">@(_qr is null ? "Tạo mã" : "Tạo mã mới")</button>
    </section>
</div>

@code {
    private MemberQrResponse? _qr;
    private string? _svg, _error;
    private bool _busy;

    protected override Task OnInitializedAsync() => NewCode();

    private async Task NewCode()
    {
        _busy = true;
        _error = null;
        try
        {
            _qr = await Api.PostAsync<MemberQrResponse>("api/my-qr", new { });
            await JS.InvokeVoidAsync("import", "./js/qr-code.js");
            _svg = await JS.InvokeAsync<string>("vfmsQr.svg", _qr.Token);
        }
        catch (ApiException ex) { _error = ex.Message; }
        catch (JSException ex) { Log.LogWarning(ex, "MyQr: vfmsQr.svg (qr-code.js) failed"); _svg = null; _error = "Không vẽ được mã QR; hãy dùng mã chữ bên dưới."; }
        finally { _busy = false; }
    }
}
