@page "/manager/supplement-products"
@layout ManagerAdminLayout
@using Microsoft.AspNetCore.Authorization
@using VFMS.Client.Components.Operations
@using VFMS.Client.Services
@using VFMS.Contracts.Common
@using VFMS.Contracts.Supplements
@using VFMS.Contracts.Supplements.Validators
@attribute [Authorize(Roles = "Manager")]
@inject OperationsApiClient Api
@implements IDisposable

<PageTitle>Sản phẩm bổ sung | Victor Fitness</PageTitle>

<div class="workspace-page space-y-6">
    <PageHeader Overline="VFMS / SUPPLEMENT STORE" Title="Sản phẩm bổ sung" Description="Danh mục sản phẩm, giá bán và trạng thái hiển thị trên cửa hàng.">
        <button type="button" class="@Ui.PrimaryButton" @onclick="StartCreate">+ Thêm sản phẩm</button>
    </PageHeader>

    <Alerts Notice="@_notice" Error="@_error" />

    @if (_formOpen)
    {
        <section class="@Ui.Card" aria-labelledby="product-form-title">
            <h2 id="product-form-title" class="text-base font-bold text-vfms-text">@(_editingId is null ? "Thêm sản phẩm" : "Sửa sản phẩm")</h2>
            <EditForm Model="_form" OnValidSubmit="SaveAsync" class="mt-4" novalidate>
                <OperationsValidation TRequest="SupplementProductRequest" Validator="_validator" CreateRequest="CreateRequest" @ref="_validation" />
                <ValidationSummary />
                <fieldset disabled="@_working" class="mt-4 grid gap-4 sm:grid-cols-[1fr_1fr_160px]">
                    <label class="@Ui.Label sm:col-span-2" for="product-name">Tên sản phẩm
                        <InputText id="product-name" class="@Ui.Field" @bind-Value="_form.Name" maxlength="200" required />
                    </label>
                    <div class="row-span-5 flex items-start justify-center">
                        @if (!string.IsNullOrWhiteSpace(_form.ImageUrl) && _brokenPreview != _form.ImageUrl)
                        {
                            <img src="@_form.ImageUrl" alt="Ảnh xem trước" class="h-36 w-36 rounded-lg border border-vfms-border object-contain bg-white" @onerror="() => _brokenPreview = _form.ImageUrl" />
                        }
                        else
                        {
                            <div class="flex h-36 w-36 items-center justify-center rounded-lg border border-dashed border-vfms-border px-3 text-center text-xs text-vfms-text-muted">@(string.IsNullOrWhiteSpace(_form.ImageUrl) ? "Chưa có ảnh" : "Không tải được ảnh từ link này")</div>
                        }
                    </div>
                    <label class="@Ui.Label" for="product-brand">Thương hiệu
                        <InputSelect id="product-brand" class="@Ui.Field" @bind-Value="_form.Brand">
                            <option value="">Chọn thương hiệu</option>
                            @foreach (var brand in SupplementCatalog.WithCurrent(SupplementCatalog.Brands, _form.Brand)) { <option value="@brand">@brand</option> }
                        </InputSelect>
                    </label>
                    <label class="@Ui.Label" for="product-category">Loại sản phẩm
                        <InputSelect id="product-category" class="@Ui.Field" @bind-Value="_form.Category" aria-describedby="product-category-hint">
                            <option value="">Chọn loại</option>
                            @foreach (var type in SupplementCatalog.WithCurrent(SupplementCatalog.TypeNames, _form.Category)) { <option value="@type">@type</option> }
                        </InputSelect>
                        <span id="product-category-hint" class="mt-1 block text-xs font-normal normal-case tracking-normal text-vfms-text-secondary">@SupplementCatalog.HintOf(_form.Category)</span>
                    </label>
                    <label class="@Ui.Label" for="product-size">Quy cách
                        <InputText id="product-size" class="@Ui.Field" @bind-Value="_form.Size" maxlength="50" placeholder="VD: 5 lbs (2.27 kg), 120 viên" />
                    </label>
                    <label class="@Ui.Label" for="product-flavour">Hương vị
                        <InputText id="product-flavour" class="@Ui.Field" @bind-Value="_form.Flavour" maxlength="100" placeholder="VD: Double Rich Chocolate" />
                    </label>
                    <label class="@Ui.Label" for="product-price">Giá bán (₫)
                        <InputNumber id="product-price" class="@Ui.Field" @bind-Value="_form.UnitPrice" min="1" step="1000" />
                    </label>
                    @if (_editingId is null)
                    {
                        <label class="@Ui.Label" for="product-stock">Tồn kho ban đầu
                            <InputNumber id="product-stock" class="@Ui.Field" @bind-Value="_form.StockQuantity" min="0" max="@SupplementStock.MaxQuantity" placeholder="Để trống nếu không theo dõi" aria-describedby="product-stock-hint" />
                            <span id="product-stock-hint" class="mt-1 block text-xs font-normal text-vfms-text-secondary">Có số lượng thì đơn hàng tự trừ kho và tự chuyển "Hết hàng" khi về 0.</span>
                        </label>
                    }
                    else
                    {
                        <p class="text-xs text-vfms-text-secondary">Tồn kho: <span class="font-semibold text-vfms-text">@StockText(_form.StockQuantity)</span>. Đổi tồn kho bằng nút "Kho" trong danh sách.</p>
                    }
                    <label class="@Ui.Label" for="product-status">Trạng thái
                        <InputSelect id="product-status" class="@Ui.Field" @bind-Value="_form.Status">
                            @foreach (var status in OperationsText.ProductStatuses) { <option value="@status">@OperationsText.Label(status)</option> }
                        </InputSelect>
                    </label>
                    <label class="@Ui.Label sm:col-span-2" for="product-image">Link ảnh (png, jpg, jpeg)
                        <InputText id="product-image" class="@Ui.Field" @bind-Value="_form.ImageUrl" placeholder="https://.../anh.jpg" />
                    </label>
                    <label class="@Ui.Label sm:col-span-3" for="product-description">Mô tả
                        <InputTextArea id="product-description" class="@Ui.Field" rows="3" @bind-Value="_form.Description" maxlength="2000" />
                    </label>
                    <div class="flex flex-wrap items-end gap-3 sm:col-span-3">
                        <button type="submit" class="@Ui.PrimaryButton">@(_working ? "Đang lưu..." : "Lưu sản phẩm")</button>
                        <button type="button" class="@Ui.Button" @onclick="() => _formOpen = false">Hủy</button>
                    </div>
                </fieldset>
            </EditForm>
        </section>
    }

    @if (_stockTarget is { } stockOf)
    {
        <section class="@Ui.Card" aria-labelledby="stock-title">
            <h2 id="stock-title" class="text-base font-bold text-vfms-text">Kho · @stockOf.Name</h2>
            <p class="mt-1 text-xs text-vfms-text-secondary">Tồn kho hiện tại: <span class="font-semibold text-vfms-text">@StockText(stockOf.StockQuantity)</span></p>
            <form class="mt-4" @onsubmit="SaveStockAsync" @onsubmit:preventDefault>
                <fieldset disabled="@_working" class="grid gap-4 sm:grid-cols-[220px_160px_1fr]">
                    <label class="@Ui.Label" for="stock-action">Thao tác
                        <select id="stock-action" class="@Ui.Field" @bind="_stockAction">
                            <option value="@SupplementStock.Add">Nhập thêm hàng</option>
                            <option value="@SupplementStock.Set">Kiểm kê (đặt số lượng)</option>
                            @if (stockOf.StockQuantity is not null)
                            {
                                <option value="@SupplementStock.StopTracking">Ngừng theo dõi tồn kho</option>
                            }
                        </select>
                    </label>
                    @if (_stockAction != SupplementStock.StopTracking)
                    {
                        <label class="@Ui.Label" for="stock-quantity">@(_stockAction == SupplementStock.Add ? "Số lượng nhập" : "Số lượng thực tế")
                            <input id="stock-quantity" type="number" class="@Ui.Field" min="@(_stockAction == SupplementStock.Add ? 1 : 0)" max="@SupplementStock.MaxQuantity" @bind="_stockQuantity" required />
                        </label>
                    }
                    <label class="@Ui.Label" for="stock-note">Ghi chú
                        <input id="stock-note" class="@Ui.Field" @bind="_stockNote" maxlength="500" placeholder="VD: Nhập lô hàng 19/11" />
                    </label>
                    <p class="text-xs text-vfms-text-secondary sm:col-span-3">@StockActionHint</p>
                    <div class="flex gap-2 sm:col-span-3">
                        <button type="submit" class="@Ui.PrimaryButton">@(_working ? "Đang lưu..." : "Lưu")</button>
                        <button type="button" class="@Ui.Button" @onclick="() => _stockTarget = null">Hủy</button>
                    </div>
                </fieldset>
            </form>
        </section>
    }

    <section class="@Ui.ListCard" aria-labelledby="product-list-title" aria-busy="@_loading">
        <div class="@Ui.ListHeader">
            <h2 id="product-list-title" class="mb-3 text-sm font-bold text-vfms-text">Sản phẩm</h2>
            <form @onsubmit="() => LoadAsync(1)" @onsubmit:preventDefault>
                <fieldset disabled="@_working" class="flex flex-wrap items-end gap-3">
                    <label class="@Ui.Label w-full sm:w-64" for="product-search">Tìm kiếm
                        <input id="product-search" type="search" class="@Ui.Field" @bind="_search" @bind:event="oninput" @bind:after="SearchTypedAsync" maxlength="100" />
                    </label>
                    <label class="@Ui.Label" for="product-filter-brand">Thương hiệu
                        <select id="product-filter-brand" class="@Ui.Field" @bind="_filterBrand" @bind:after="() => LoadAsync(1)">
                            <option value="">Tất cả</option>
                            @foreach (var brand in _brands) { <option value="@brand">@brand</option> }
                        </select>
                    </label>
                    <label class="@Ui.Label" for="product-filter-category">Loại
                        <select id="product-filter-category" class="@Ui.Field" @bind="_filterCategory" @bind:after="() => LoadAsync(1)">
                            <option value="">Tất cả</option>
                            @foreach (var category in _categories) { <option value="@category">@category</option> }
                        </select>
                    </label>
                    <label class="@Ui.Label w-32" for="product-filter-min">Giá từ (₫)
                        <input id="product-filter-min" type="number" class="@Ui.Field" min="0" step="10000" @bind="_minPrice" @bind:event="oninput" @bind:after="SearchTypedAsync" placeholder="0" />
                    </label>
                    <label class="@Ui.Label w-32" for="product-filter-max">Đến (₫)
                        <input id="product-filter-max" type="number" class="@Ui.Field" min="0" step="10000" @bind="_maxPrice" @bind:event="oninput" @bind:after="SearchTypedAsync" placeholder="Tối đa" />
                    </label>
                    <label class="@Ui.Label" for="product-filter-status">Trạng thái
                        <select id="product-filter-status" class="@Ui.Field" @bind="_filterStatus" @bind:after="() => LoadAsync(1)">
                            <option value="">Tất cả</option>
                            @foreach (var status in OperationsText.ProductStatuses) { <option value="@status">@OperationsText.Label(status)</option> }
                        </select>
                    </label>
                    <label class="@Ui.Label" for="product-sort">Sắp xếp
                        <select id="product-sort" class="@Ui.Field" @bind="_sort" @bind:after="() => LoadAsync(1)">
                            @foreach (var (value, label) in Sorts) { <option value="@value">@label</option> }
                        </select>
                    </label>
                    <label class="flex items-center gap-2 pb-2 text-xs font-semibold text-vfms-text" for="product-low-stock">
                        <input id="product-low-stock" type="checkbox" class="h-4 w-4 accent-[#B83A3A]" @bind="_lowStock" @bind:after="() => LoadAsync(1)" />
                        Sắp hết hàng (≤ @SupplementStock.LowStockThreshold)
                    </label>
                    @if (HasFilters)
                    {
                        <button type="button" class="text-xs font-semibold text-vfms-primary underline-offset-2 hover:underline" @onclick="ClearFiltersAsync">Xóa bộ lọc</button>
                    }
                </fieldset>
                @if (_priceError is not null)
                {
                    <p role="alert" class="mt-2 text-xs font-semibold text-vfms-error">@_priceError</p>
                }
            </form>
        </div>
        @if (_loading && _page is null)
        {
            <p role="status" class="p-5 text-sm">Đang tải sản phẩm...</p>
        }
        else if (_page is { Items.Count: > 0 } list)
        {
            <div class="overflow-x-auto">
                <table class="workspace-table min-w-[1060px]">
                    <thead>
                        <tr><th scope="col">Sản phẩm</th><th scope="col">Thương hiệu</th><th scope="col">Loại</th><th scope="col" class="text-right">Giá bán</th><th scope="col" class="text-right">Tồn kho</th><th scope="col">Trạng thái</th><th scope="col">Thao tác</th></tr>
                    </thead>
                    <tbody>
                        @foreach (var row in list.Items)
                        {
                            <tr @key="row.Id">
                                <th scope="row">
                                    <div class="flex items-center gap-3">
                                        @if (row.ImageUrl is { } image && !_brokenImages.Contains(row.Id))
                                        {
                                            <img src="@image" alt="" class="h-10 w-10 flex-none rounded-md border border-vfms-border bg-white object-contain" loading="lazy" @onerror="() => _brokenImages.Add(row.Id)" />
                                        }
                                        else
                                        {
                                            <span class="h-10 w-10 flex-none rounded-md border border-dashed border-vfms-border bg-vfms-surface-alt" aria-hidden="true"></span>
                                        }
                                        <div class="min-w-0">
                                            <span class="block font-semibold">@row.Name</span>
                                            @if (Details(row) is { Length: > 0 } details)
                                            {
                                                <span class="block text-xs font-normal text-vfms-text-secondary">@details</span>
                                            }
                                        </div>
                                    </div>
                                </th>
                                <td>@(row.Brand ?? "—")</td>
                                <td>@(row.Category ?? "—")</td>
                                <td class="text-right whitespace-nowrap">@OperationsText.Money(row.UnitPrice)</td>
                                <td class="text-right whitespace-nowrap">
                                    @if (row.StockQuantity is { } stock)
                                    {
                                        <span class="font-semibold">@stock</span>
                                        @if (stock == 0)
                                        {
                                            <span class="ml-1 inline-block rounded-full border border-red-200 bg-red-50 px-2 py-0.5 text-[10px] font-bold text-[#DC2626]">Hết</span>
                                        }
                                        else if (row.LowStock)
                                        {
                                            <span class="ml-1 inline-block rounded-full border border-amber-200 bg-amber-50 px-2 py-0.5 text-[10px] font-bold text-[#D97706]">Sắp hết</span>
                                        }
                                    }
                                    else
                                    {
                                        <span class="text-xs text-vfms-text-muted">Không theo dõi</span>
                                    }
                                </td>
                                <td><span class="@OperationsText.Badge(row.Status)">@OperationsText.Label(row.Status)</span></td>
                                <td>
                                    <div class="flex flex-nowrap whitespace-nowrap items-center gap-2">
                                        <button type="button" class="@Ui.Button" disabled="@Busy" aria-label="Sửa @row.Name" @onclick="() => StartEdit(row)">Sửa</button>
                                        <button type="button" class="@Ui.Button" disabled="@Busy" aria-label="Kho @row.Name" @onclick="() => StartStock(row)">Kho</button>
                                        <select class="rounded-lg border border-vfms-border bg-vfms-surface px-2 py-1.5 text-xs font-semibold text-vfms-text" disabled="@Busy"
                                                aria-label="Đổi trạng thái @row.Name" value="@row.Status" @onchange="args => ChangeStatusAsync(row, args.Value?.ToString())">
                                            @foreach (var status in OperationsText.ProductStatuses) { <option value="@status">@OperationsText.Label(status)</option> }
                                        </select>
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
            <Pager Page="list.Page" PageSize="list.PageSize" TotalCount="list.TotalCount" Noun="sản phẩm" AriaLabel="Phân trang sản phẩm" Disabled="Busy" OnPage="LoadAsync" />
        }
        else
        {
            <p role="status" class="p-5 text-sm text-vfms-text-secondary">Chưa có sản phẩm phù hợp.</p>
        }
    </section>
</div>

@code {
    private const int PageSize = 20;
    private readonly CancellationTokenSource _lifetime = new();
    private readonly ProductModel _form = new();
    private readonly SupplementProductRequestValidator _validator = new();
    private OperationsValidation<SupplementProductRequest>? _validation;
    private PagedResponse<SupplementProductResponse>? _page;
    private static readonly (string Value, string Label)[] Sorts =
    [
        ("name", "Tên A → Z"),
        ("price_asc", "Giá thấp → cao"),
        ("price_desc", "Giá cao → thấp"),
        ("newest", "Mới thêm"),
    ];
    private List<string> _categories = [];
    private List<string> _brands = [];
    private string _filterBrand = "", _sort = "name";
    private bool _lowStock;
    private SupplementProductResponse? _stockTarget;
    private string _stockAction = SupplementStock.Add;
    private int? _stockQuantity;
    private string? _stockNote;
    private decimal? _minPrice, _maxPrice;
    private string? _priceError;
    private bool HasFilters => !string.IsNullOrWhiteSpace(_search) || _filterBrand != "" || _filterCategory != "" || _filterStatus != ""
        || _minPrice.HasValue || _maxPrice.HasValue || _sort != "name" || _lowStock;
    private int? _editingId;
    private string? _brokenPreview;
    private readonly HashSet<int> _brokenImages = [];
    private string _search = "", _filterCategory = "", _filterStatus = "";
    private string? _notice, _error;
    private bool _formOpen, _loading, _working;
    private bool Busy => _loading || _working;

    protected override async Task OnInitializedAsync()
    {
        await LoadCategoriesAsync();
        await LoadAsync(1);
    }

    private SupplementProductRequest CreateRequest() => new(_form.Name.Trim(), _form.Description.Trim(), _form.ImageUrl.Trim(),
        _form.UnitPrice, Blank(_form.Category), _form.Status,
        Brand: Blank(_form.Brand), Size: Blank(_form.Size), Flavour: Blank(_form.Flavour),
        StockQuantity: _editingId is null ? _form.StockQuantity : null);

    private static string StockText(int? stock) => stock is { } units ? $"{units} sản phẩm" : "không theo dõi";

    private string StockActionHint => _stockAction switch
    {
        SupplementStock.Add => "Cộng thêm vào tồn kho hiện tại. Sản phẩm đang “Hết hàng” sẽ được mở bán lại.",
        SupplementStock.Set => "Đặt tồn kho đúng bằng số đếm được. Về 0 thì sản phẩm chuyển “Hết hàng”.",
        _ => "Đơn hàng sẽ không trừ kho nữa; trạng thái sản phẩm do quản lý tự đặt.",
    };

    private void StartStock(SupplementProductResponse product)
    {
        _formOpen = false;
        _stockTarget = product;
        _stockAction = SupplementStock.Add;
        _stockQuantity = null;
        _stockNote = null;
        _notice = _error = null;
    }

    private async Task SaveStockAsync()
    {
        if (Busy || _stockTarget is not { } product) return;
        var quantity = _stockAction == SupplementStock.StopTracking ? 0 : _stockQuantity;
        var min = _stockAction == SupplementStock.Add ? 1 : 0;
        if (quantity is null || quantity < min || quantity > SupplementStock.MaxQuantity)
        {
            _error = $"Số lượng phải từ {min} đến {SupplementStock.MaxQuantity}.";
            return;
        }
        _working = true;
        _notice = _error = null;
        try
        {
            var saved = await Api.AdjustProductStockAsync(product.Id, new(_stockAction, quantity.Value, Blank(_stockNote)), _lifetime.Token);
            _notice = $"“{saved.Name}”: tồn kho {StockText(saved.StockQuantity)}, {OperationsText.Label(saved.Status).ToLowerInvariant()}.";
            _stockTarget = null;
        }
        catch (AuthApiException error) { _error = error.Message; }
        catch (OperationCanceledException) when (_lifetime.IsCancellationRequested) { }
        finally { _working = false; }
        await LoadAsync(_page?.Page ?? 1);
    }

    private static string? Blank(string? value) => string.IsNullOrWhiteSpace(value) ? null : value.Trim();

    /// <summary>Size and flavour under the product name, e.g. "5 lbs · Double Rich Chocolate".</summary>
    private static string Details(SupplementProductResponse row) =>
        string.Join(" · ", new[] { row.Size, row.Flavour }.Where(v => !string.IsNullOrWhiteSpace(v)));

    // Filters apply as they change: dropdowns at once, the search box after a short pause in typing.
    private LiveQuery Live => _live ??= new(_lifetime.Token);
    private LiveQuery? _live;

    private Task LoadAsync(int page) => Live.NowAsync(token => FetchAsync(page, token));

    private Task SearchTypedAsync() => Live.AfterTypingAsync(token => FetchAsync(1, token));

    private async Task FetchAsync(int page, CancellationToken token)
    {
        _priceError = _minPrice > _maxPrice ? "Giá \"từ\" phải nhỏ hơn hoặc bằng giá \"đến\"." : null;
        if (_priceError is not null || _minPrice < 0 || _maxPrice < 0)
        {
            _priceError ??= "Giá không được âm.";
            return;
        }
        _loading = true;
        try
        {
            _page = await Api.GetProductsAsync(new(Blank(_search), Blank(_filterCategory), Blank(_filterStatus), page, PageSize,
                Brand: Blank(_filterBrand), MinPrice: _minPrice, MaxPrice: _maxPrice, Sort: _sort, LowStock: _lowStock), manage: true, token);
        }
        catch (AuthApiException error) { _error = error.Message; }
        finally { if (!token.IsCancellationRequested) _loading = false; }
    }

    private async Task ClearFiltersAsync()
    {
        _search = _filterBrand = _filterCategory = _filterStatus = "";
        _minPrice = _maxPrice = null;
        _sort = "name";
        _lowStock = false;
        await LoadAsync(1);
    }

    private async Task LoadCategoriesAsync()
    {
        try
        {
            _categories = await Api.GetProductCategoriesAsync(_lifetime.Token);
            _brands = await Api.GetProductBrandsAsync(_lifetime.Token);
        }
        catch (AuthApiException error) { _error = error.Message; }
        catch (OperationCanceledException) when (_lifetime.IsCancellationRequested) { }
    }

    private void StartCreate()
    {
        _editingId = null;
        _form.Name = _form.Description = _form.ImageUrl = "";
        _form.Category = _form.Brand = _form.Size = _form.Flavour = null;
        _form.UnitPrice = 0;
        _form.Status = "Active";
        _form.StockQuantity = null;
        _stockTarget = null;
        _formOpen = true;
    }

    private void StartEdit(SupplementProductResponse product)
    {
        _editingId = product.Id;
        _form.Name = product.Name;
        _form.Description = product.Description ?? "";
        _form.ImageUrl = product.ImageUrl ?? "";
        _form.Category = product.Category;
        _form.Brand = product.Brand;
        _form.Size = product.Size;
        _form.Flavour = product.Flavour;
        _form.UnitPrice = product.UnitPrice;
        _form.Status = product.Status;
        _form.StockQuantity = product.StockQuantity;
        _stockTarget = null;
        _formOpen = true;
    }

    private async Task SaveAsync()
    {
        if (Busy) return;
        _working = true;
        _notice = _error = null;
        try
        {
            var saved = _editingId is { } id
                ? await Api.UpdateProductAsync(id, CreateRequest(), _lifetime.Token)
                : await Api.CreateProductAsync(CreateRequest(), _lifetime.Token);
            _notice = _editingId is null ? $"Đã thêm \"{saved.Name}\"." : $"Đã cập nhật \"{saved.Name}\".";
            _formOpen = false;
            await LoadCategoriesAsync();
            await LoadAsync(_page?.Page ?? 1);
        }
        catch (AuthApiException error)
        {
            _error = error.Message;
            _validation?.ShowErrors(error.Errors);
        }
        catch (OperationCanceledException) when (_lifetime.IsCancellationRequested) { }
        finally { _working = false; }
    }

    private async Task ChangeStatusAsync(SupplementProductResponse product, string? status)
    {
        if (Busy || status is null || status == product.Status) return;
        _working = true;
        _notice = _error = null;
        try
        {
            var saved = await Api.ChangeProductStatusAsync(product.Id, status, _lifetime.Token);
            _notice = $"\"{saved.Name}\": {OperationsText.Label(saved.Status).ToLowerInvariant()}.";
        }
        catch (AuthApiException error) { _error = error.Message; }
        catch (OperationCanceledException) when (_lifetime.IsCancellationRequested) { }
        finally { _working = false; }
        await LoadAsync(_page?.Page ?? 1);
    }

    public void Dispose()
    {
        _lifetime.Cancel();
        _live?.Dispose();
        _lifetime.Dispose();
    }

    private sealed class ProductModel
    {
        public string Name { get; set; } = "";
        public string Description { get; set; } = "";
        public string ImageUrl { get; set; } = "";
        public string? Category { get; set; }
        public string? Brand { get; set; }
        public string? Size { get; set; }
        public string? Flavour { get; set; }
        public decimal UnitPrice { get; set; }
        public string Status { get; set; } = "Active";
        public int? StockQuantity { get; set; }
    }
}
