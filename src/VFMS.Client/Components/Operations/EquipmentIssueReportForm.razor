@* UC-71 Report Equipment Issue form, used by the Member page and the Staff issue board. *@
@using VFMS.Contracts.Equipment
@using VFMS.Contracts.Equipment.Validators
@inject OperationsApiClient Api
@implements IDisposable

<Alerts Error="@_error" />
<EditForm Model="_form" OnValidSubmit="() => SubmitAsync(false)" novalidate>
    <OperationsValidation TRequest="ReportEquipmentIssueRequest" Validator="_validator" CreateRequest="() => CreateRequest(false)" @ref="_validation" />
    <ValidationSummary />
    <fieldset disabled="@_working" class="mt-2 grid gap-4 sm:grid-cols-2">
        <label class="@Ui.Label sm:col-span-2" for="@($"{IdPrefix}-find")">Tìm thiết bị
            <div class="flex gap-2">
                <input id="@($"{IdPrefix}-find")" type="search" class="@Ui.Field" @bind="_search" @bind:event="oninput" @onkeydown="SearchOnEnter" maxlength="100" placeholder="Tên hoặc mã thiết bị" />
                <button type="button" class="@Ui.Button mt-1" @onclick="SearchAsync">Tìm</button>
            </div>
        </label>
        <label class="@Ui.Label" for="@($"{IdPrefix}-equipment")">Thiết bị
            <InputSelect id="@($"{IdPrefix}-equipment")" class="@Ui.Field" @bind-Value="_form.EquipmentId">
                <option value="0">@(_equipment.Count == 0 ? "Không tìm thấy thiết bị" : "Chọn thiết bị")</option>
                @foreach (var item in _equipment)
                {
                    <option value="@item.Id">@item.Name@(item.Code is { } code ? $" · {code}" : "")</option>
                }
            </InputSelect>
        </label>
        <label class="@Ui.Label" for="@($"{IdPrefix}-type")">Loại sự cố
            <InputSelect id="@($"{IdPrefix}-type")" class="@Ui.Field" @bind-Value="_form.IncidentType">
                @foreach (var type in OperationsText.IncidentTypes) { <option value="@type">@OperationsText.Label(type)</option> }
            </InputSelect>
        </label>
        <label class="@Ui.Label sm:col-span-2" for="@($"{IdPrefix}-description")">Mô tả sự cố
            <InputTextArea id="@($"{IdPrefix}-description")" class="@Ui.Field" rows="4" @bind-Value="_form.Description" maxlength="1000" placeholder="VD: Dây cáp máy kéo xô bị sờn, phát ra tiếng kêu khi kéo." />
        </label>
        <label class="@Ui.Label sm:col-span-2" for="@($"{IdPrefix}-image")">Link ảnh (không bắt buộc)
            <InputText id="@($"{IdPrefix}-image")" class="@Ui.Field" @bind-Value="_form.ImageUrl" placeholder="https://..." />
        </label>
        @if (_duplicate)
        {
            <div class="rounded-xl border border-amber-300 bg-amber-50 p-4 text-sm text-amber-900 sm:col-span-2" role="alert">
                <p>Thiết bị này đã có báo cáo đang được xử lý. Bạn vẫn muốn gửi thêm báo cáo?</p>
                <div class="mt-3 flex gap-2">
                    <button type="button" class="@Ui.PrimaryButton" @onclick="() => SubmitAsync(true)">Vẫn gửi</button>
                    <button type="button" class="@Ui.Button" @onclick="() => _duplicate = false">Thôi</button>
                </div>
            </div>
        }
        <div class="flex flex-wrap gap-3 sm:col-span-2">
            <button type="submit" class="@Ui.PrimaryButton">@(_working ? "Đang gửi..." : "Gửi báo cáo")</button>
            @if (OnCancel.HasDelegate)
            {
                <button type="button" class="@Ui.Button" @onclick="OnCancel">Hủy</button>
            }
        </div>
    </fieldset>
</EditForm>

@code {
    /// <summary>Prefix for element ids, so two forms on one page never clash.</summary>
    [Parameter] public string IdPrefix { get; set; } = "report";
    [Parameter] public EventCallback<EquipmentIssueResponse> OnReported { get; set; }
    [Parameter] public EventCallback OnCancel { get; set; }

    private readonly CancellationTokenSource _lifetime = new();
    private readonly ReportModel _form = new();
    private readonly ReportEquipmentIssueRequestValidator _validator = new();
    private OperationsValidation<ReportEquipmentIssueRequest>? _validation;
    private List<EquipmentResponse> _equipment = [];
    private string _search = "";
    private string? _error;
    private bool _working, _duplicate;

    protected override Task OnInitializedAsync() => SearchAsync();

    private ReportEquipmentIssueRequest CreateRequest(bool confirmDuplicate) => new(_form.EquipmentId, _form.IncidentType,
        _form.Description.Trim(), string.IsNullOrWhiteSpace(_form.ImageUrl) ? null : _form.ImageUrl.Trim(), confirmDuplicate);

    private async Task SearchOnEnter(KeyboardEventArgs args)
    {
        if (args.Key == "Enter") await SearchAsync();
    }

    private async Task SearchAsync()
    {
        try
        {
            var page = await Api.GetEquipmentAsync(new(string.IsNullOrWhiteSpace(_search) ? null : _search.Trim(), null, null, 1, 100), _lifetime.Token);
            _equipment = page.Items.Where(item => item.Status != "Retired").ToList();
            if (_equipment.All(item => item.Id != _form.EquipmentId)) _form.EquipmentId = _equipment.Count == 1 ? _equipment[0].Id : 0;
        }
        catch (AuthApiException error) { _error = error.Message; }
        catch (OperationCanceledException) when (_lifetime.IsCancellationRequested) { }
    }

    private async Task SubmitAsync(bool confirmDuplicate)
    {
        if (_working) return;
        _working = true;
        _error = null;
        try
        {
            var saved = await Api.ReportIssueAsync(CreateRequest(confirmDuplicate), _lifetime.Token);
            _duplicate = false;
            _form.Description = "";
            _form.ImageUrl = null;
            await OnReported.InvokeAsync(saved);
        }
        catch (AuthApiException error) when (error.ErrorCode == "EQUIPMENT_ISSUE_DUPLICATE")
        {
            _duplicate = true;
        }
        catch (AuthApiException error)
        {
            _error = error.Message;
            _validation?.ShowErrors(error.Errors);
        }
        catch (OperationCanceledException) when (_lifetime.IsCancellationRequested) { }
        finally { _working = false; }
    }

    public void Dispose()
    {
        _lifetime.Cancel();
        _lifetime.Dispose();
    }

    private sealed class ReportModel
    {
        public int EquipmentId { get; set; }
        public string IncidentType { get; set; } = "Malfunction";
        public string Description { get; set; } = "";
        public string? ImageUrl { get; set; }
    }
}
