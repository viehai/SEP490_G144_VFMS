<CascadingAuthenticationState>
<Router AppAssembly="@typeof(App).Assembly">
    <Found Context="routeData">
        @* PublicLayout, not the Blazor template's MainLayout: the not-authorized and checking states use the default layout. *@
        <AuthorizeRouteView RouteData="@routeData" DefaultLayout="@typeof(PublicLayout)">
            <Authorizing><p role="status" class="px-5 pb-16 pt-32 text-center text-sm text-[#6F6966]">Đang kiểm tra phiên đăng nhập...</p></Authorizing>
            <NotAuthorized Context="auth">
                @if (auth.User.Identity?.IsAuthenticated == true)
                {
                    <section class="mx-auto max-w-lg space-y-4 px-5 pb-16 pt-32 text-center font-['Inter',sans-serif] text-[#242424]">
                        <p class="text-[10px] font-bold tracking-[.18em] text-[#B83A3A]">VICTOR FITNESS / 403</p>
                        <h1 class="font-['Montserrat'] text-2xl font-extrabold">Không có quyền truy cập</h1>
                        <p role="alert" class="text-sm text-[#6F6966]">Tài khoản của bạn không có quyền truy cập trang này.</p>
                        <a href="/" class="inline-block rounded-lg bg-[#B83A3A] px-4 py-2 text-sm font-semibold text-white hover:bg-[#9F3030]">Về trang chủ</a>
                    </section>
                }
                else
                {
                    <RedirectToLogin />
                }
            </NotAuthorized>
        </AuthorizeRouteView>
        <FocusOnNavigate RouteData="@routeData" Selector="h1" />
    </Found>
    <NotFound>
        <PageTitle>Không tìm thấy trang | Victor Fitness</PageTitle>
        <LayoutView Layout="@typeof(PublicLayout)">
            <section class="mx-auto max-w-lg space-y-4 px-5 pb-16 pt-32 text-center font-['Inter',sans-serif] text-[#242424]">
                <p class="text-[10px] font-bold tracking-[.18em] text-[#B83A3A]">VICTOR FITNESS / 404</p>
                <h1 class="font-['Montserrat'] text-2xl font-extrabold">Không tìm thấy trang</h1>
                <p role="alert" class="text-sm text-[#6F6966]">Địa chỉ này không tồn tại hoặc đã được chuyển.</p>
                <a href="/" class="inline-block rounded-lg bg-[#B83A3A] px-4 py-2 text-sm font-semibold text-white hover:bg-[#9F3030]">Về trang chủ</a>
            </section>
        </LayoutView>
    </NotFound>
</Router>
</CascadingAuthenticationState>
