@page "/consultations"
@layout PublicLayout
@using Microsoft.AspNetCore.Authorization
@using VFMS.Contracts.Common
@using VFMS.Contracts.Consultations
@attribute [Authorize(Roles = "Customer,Member")]
@inject SystemAdministrationApiClient Api
@implements IDisposable

<PageTitle>Trò chuyện tư vấn | Victor Fitness</PageTitle>

<section class="mx-auto max-w-6xl px-4 pb-12 pt-28 sm:px-6">
    <header class="border-b border-[#D8D1CD] pb-5">
        <p class="text-xs font-bold tracking-wider text-[#B83A3A]">VFMS / CONSULTATION</p>
        <h1 class="mt-2 text-3xl font-black text-[#242424]">Trò chuyện với phòng gym.</h1>
        <p class="mt-2 text-sm text-[#6F6966]">Trao đổi trực tiếp với đội ngũ quản lý phòng gym.</p>
    </header>

    @if (!string.IsNullOrWhiteSpace(_error))
    {
        <p role="alert" class="mt-5 rounded-lg border border-red-300 bg-red-50 p-4 text-sm text-red-900">@_error</p>
    }

    <div class="mt-6 grid min-h-[560px] grid-rows-[220px_minmax(0,1fr)] overflow-hidden rounded-2xl border border-[#D8D1CD] bg-white shadow-sm lg:h-[min(72vh,760px)] lg:grid-cols-[320px_minmax(0,1fr)] lg:grid-rows-1">
        <aside class="flex min-h-0 flex-col border-b border-[#D8D1CD] bg-[#FAF8F6] lg:border-b-0 lg:border-r">
            <div class="flex items-center justify-between gap-3 border-b border-[#D8D1CD] p-4">
                <div>
                    <h2 class="text-sm font-bold">Tin nhắn</h2>
                    <p class="mt-1 text-xs text-[#6F6966]">Phòng gym sẽ phản hồi tại đây</p>
                </div>
                <button type="button" class="rounded-lg bg-[#B83A3A] px-3 py-2 text-xs font-bold text-white hover:bg-[#9F3030]"
                        disabled="@Busy" @onclick="() => { _error = null; _creating = !_creating; }">
                    Tin mới
                </button>
            </div>

            @if (_creating)
            {
                <div class="space-y-3 border-b border-[#D8D1CD] bg-white p-4">
                    <label class="block text-xs font-semibold" for="chat-subject">
                        Chủ đề
                        <input id="chat-subject" class="mt-1 block w-full rounded-lg border border-[#D8D1CD] px-3 py-2 text-sm"
                               maxlength="200" @bind="_subject" @bind:event="oninput" placeholder="Ví dụ: Hỏi về gói hội viên" />
                    </label>
                    <label class="block text-xs font-semibold" for="chat-message">
                        Tin nhắn đầu tiên
                        <textarea id="chat-message" class="mt-1 block w-full resize-y rounded-lg border border-[#D8D1CD] px-3 py-2 text-sm"
                                  rows="3" maxlength="2000" @bind="_message" @bind:event="oninput" placeholder="Bạn cần phòng gym hỗ trợ điều gì?"></textarea>
                    </label>
                    <div class="flex gap-2">
                        <button type="button" class="flex-1 rounded-lg bg-[#B83A3A] px-3 py-2 text-xs font-bold text-white"
                                disabled="@Busy" @onclick="CreateAsync">Bắt đầu trò chuyện</button>
                        <button type="button" class="rounded-lg border border-[#D8D1CD] px-3 py-2 text-xs font-bold"
                                disabled="@Busy" @onclick="CancelCreate">Hủy</button>
                    </div>
                </div>
            }

            <div class="min-h-0 flex-1 divide-y divide-[#E8E2DE] overflow-y-auto">
                @if (_loading && _conversations.Count == 0)
                {
                    <p class="p-4 text-sm text-[#6F6966]">Đang tải tin nhắn...</p>
                }
                else if (_conversations.Count == 0)
                {
                    <p class="p-4 text-sm text-[#6F6966]">Chưa có cuộc trò chuyện nào.</p>
                }
                @foreach (var conversation in _conversations)
                {
                    <button type="button"
                            class="block w-full px-4 py-3 text-left transition hover:bg-white @(_selected?.Id == conversation.Id ? "bg-white shadow-[inset_3px_0_0_#B83A3A]" : "")"
                            @onclick="() => SelectAsync(conversation.Id)">
                        <span class="flex items-center justify-between gap-2">
                            <span class="truncate text-sm font-bold">@conversation.Subject</span>
                            <span class="shrink-0 rounded-full bg-[#F2EFEC] px-2 py-1 text-[10px] font-semibold text-[#6F6966]">@StatusLabel(conversation.Status)</span>
                        </span>
                        <span class="mt-1 block truncate text-xs text-[#6F6966]">
                            @(conversation.Messages.OrderByDescending(message => message.CreatedAt).FirstOrDefault()?.Content ?? "Chưa có tin nhắn")
                        </span>
                        <span class="mt-1 block text-[10px] text-[#8C8581]">@conversation.LastMessageAt.ToLocalTime().ToString("dd/MM HH:mm")</span>
                    </button>
                }
            </div>
        </aside>

        <section class="flex min-h-0 min-w-0 flex-col bg-white">
            @if (_selected is null)
            {
                <div class="flex flex-1 flex-col items-center justify-center p-8 text-center">
                    <span class="mb-3 grid h-12 w-12 place-items-center rounded-full bg-[#F8F5F2] text-xl text-[#B83A3A]" aria-hidden="true">✉</span>
                    <h2 class="font-bold">Bắt đầu trò chuyện với phòng gym</h2>
                    <p class="mt-2 max-w-sm text-sm text-[#6F6966]">Tạo một cuộc trò chuyện mới hoặc chọn hội thoại bên trái để xem tin nhắn.</p>
                    <button type="button" class="mt-5 rounded-lg bg-[#B83A3A] px-4 py-2.5 text-sm font-bold text-white lg:hidden"
                            disabled="@Busy" @onclick="() => { _error = null; _creating = true; }">Tạo cuộc trò chuyện</button>
                </div>
            }
            else
            {
                <header class="flex items-center justify-between gap-3 border-b border-[#E8E2DE] px-4 py-3 sm:px-6">
                    <div class="min-w-0">
                        <h2 class="truncate font-bold">@_selected.Subject</h2>
                        <p class="mt-1 text-xs text-[#6F6966]">@(_selected.ManagerName ?? "Phòng gym") · @StatusLabel(_selected.Status)</p>
                    </div>
                    <button type="button" class="shrink-0 rounded-lg border border-[#D8D1CD] px-3 py-2 text-xs font-semibold hover:bg-[#F8F5F2]"
                            disabled="@Busy" @onclick="RefreshSelectedAsync">Làm mới</button>
                </header>

                <div class="flex-1 space-y-4 overflow-y-auto bg-[#FCFBFA] p-4 sm:p-6">
                    @if (_selected.Messages.Count == 0)
                    {
                        <p class="text-center text-sm text-[#6F6966]">Hãy gửi tin nhắn để bắt đầu trao đổi.</p>
                    }
                    @foreach (var chat in _selected.Messages.OrderBy(message => message.CreatedAt))
                    {
                        var isCustomer = chat.SenderUserId == _selected.CustomerUserId;
                        <div class="flex @(isCustomer ? "justify-end" : "justify-start")">
                            <div class="max-w-[85%] rounded-2xl @(isCustomer ? "rounded-br-md bg-[#B83A3A] text-white" : "rounded-bl-md border border-[#E8E2DE] bg-white text-[#242424]") px-4 py-3 shadow-sm sm:max-w-[75%]">
                                <p class="text-[11px] font-bold @(isCustomer ? "text-white/80" : "text-[#8C4545]")">@(isCustomer ? "Bạn" : chat.SenderName)</p>
                                <p class="mt-1 whitespace-pre-wrap break-words text-sm">@chat.Content</p>
                                <p class="mt-2 text-right text-[10px] @(isCustomer ? "text-white/70" : "text-[#8C8581]")">@chat.CreatedAt.ToLocalTime().ToString("dd/MM HH:mm")</p>
                            </div>
                        </div>
                    }
                </div>

                @if (_selected.Status != "Closed")
                {
                    <form @onsubmit="SendAsync" @onsubmit:preventDefault class="flex items-end gap-2 border-t border-[#E8E2DE] bg-white p-3 sm:p-4">
                        <textarea aria-label="Tin nhắn" class="max-h-28 min-h-11 min-w-0 flex-1 resize-y rounded-xl border border-[#D8D1CD] px-4 py-3 text-sm focus:border-[#B83A3A] focus:outline-none"
                                  rows="1" maxlength="2000" @bind="_reply" @bind:event="oninput" placeholder="Nhập tin nhắn của bạn..."></textarea>
                        <button type="submit" class="rounded-xl bg-[#B83A3A] px-5 py-3 text-sm font-bold text-white hover:bg-[#9F3030]"
                                disabled="@Busy">Gửi</button>
                    </form>
                }
                else
                {
                    <p class="border-t border-[#E8E2DE] bg-[#F8F5F2] p-4 text-center text-sm text-[#6F6966]">Cuộc trò chuyện này đã đóng.</p>
                }
            }
        </section>
    </div>
</section>

@code {
    private readonly CancellationTokenSource _lifetime = new();
    private IReadOnlyCollection<ConsultationConversationResponse> _conversations = [];
    private ConsultationConversationResponse? _selected;
    private string _subject = "", _message = "", _reply = "";
    private string? _error;
    private bool _creating, _loading, _working;
    private bool Busy => _loading || _working;

    protected override Task OnInitializedAsync() => LoadAsync();

    private async Task LoadAsync()
    {
        _loading = true;
        _error = null;
        try
        {
            var page = await Api.GetConsultationsAsync(new(null, null, 1, 100), _lifetime.Token);
            _conversations = page.Items;
        }
        catch (AuthApiException error) { _error = error.Message; }
        finally { _loading = false; }
    }

    private async Task CreateAsync()
    {
        if (string.IsNullOrWhiteSpace(_subject) || string.IsNullOrWhiteSpace(_message))
        {
            _error = "Vui lòng nhập chủ đề và nội dung tư vấn.";
            return;
        }
        _working = true;
        _error = null;
        try
        {
            _selected = await Api.CreateConsultationAsync(new(_subject.Trim(), _message.Trim()), _lifetime.Token);
            CancelCreate();
            await LoadAsync();
        }
        catch (AuthApiException error) { _error = error.Message; }
        finally { _working = false; }
    }

    private void CancelCreate()
    {
        _creating = false;
        _subject = "";
        _message = "";
    }

    private async Task SelectAsync(int id)
    {
        _error = null;
        try { _selected = await Api.GetConsultationAsync(id, _lifetime.Token); _reply = ""; }
        catch (AuthApiException error) { _error = error.Message; }
    }

    private async Task RefreshSelectedAsync()
    {
        if (_selected is not null) await SelectAsync(_selected.Id);
    }

    private async Task SendAsync()
    {
        if (_selected is null || string.IsNullOrWhiteSpace(_reply)) return;
        _working = true;
        _error = null;
        try
        {
            _selected = await Api.SendConsultationMessageAsync(
                _selected.Id, new(_reply.Trim()), _lifetime.Token);
            _reply = "";
        }
        catch (AuthApiException error) { _error = error.Message; }
        finally { _working = false; }
    }

    public void Dispose()
    {
        _lifetime.Cancel();
        _lifetime.Dispose();
    }

    private static string StatusLabel(string status) => status == "Closed" ? "Đã đóng" : "Đang xử lý";
}
