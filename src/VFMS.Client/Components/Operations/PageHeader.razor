<header class="flex flex-wrap items-end justify-between gap-4 border-b border-[#D8D1CD] pb-6">
    <div>
        <p class="mb-2 text-xs font-bold tracking-wider text-[#B83A3A]">@Overline</p>
        <h1 class="text-3xl font-extrabold tracking-tight text-[#242424] sm:text-4xl">@Title<span class="text-[#B83A3A]">.</span></h1>
        <p class="mt-2 text-sm text-[#6F6966]">@Description</p>
    </div>
    @ChildContent
</header>

@code {
    [Parameter] public string Overline { get; set; } = "";
    [Parameter] public string Title { get; set; } = "";
    [Parameter] public string Description { get; set; } = "";
    [Parameter] public RenderFragment? ChildContent { get; set; }
}
