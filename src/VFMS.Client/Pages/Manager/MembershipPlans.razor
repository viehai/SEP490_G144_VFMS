@page "/manager/membership-plans"
@layout ManagerAdminLayout
@using Microsoft.AspNetCore.Authorization
@using VFMS.Client.Components.Memberships
@using VFMS.Contracts.Common
@using VFMS.Contracts.Memberships
@using VFMS.Contracts.Memberships.Validators
@using VFMS.Contracts.Yoga.Validators
@attribute [Authorize(Roles = "Manager")]
@inject MembershipPlanApiClient Api
@inject IJSRuntime JS
@implements IDisposable

<PageTitle>Quản lý gói hội viên | Victor Fitness</PageTitle>

<div class="workspace-page space-y-6">
    <header class="flex flex-wrap items-end justify-between gap-4 border-b border-[#D8D1CD] pb-6">
        <div>
            <h1 class="text-3xl font-extrabold tracking-tight text-[#242424] sm:text-4xl">Quản lý gói hội viên<span class="text-[#B83A3A]">.</span></h1>
            <p class="mt-2 text-sm text-[#6F6966]">Quản lý thông tin gói tập, trạng thái mở bán và số lượt đăng ký đang hoạt động.</p>
        </div>
        <button type="button" class="@PrimaryButton" disabled="@ListDisabled" @onclick="OpenCreateAsync">Thêm gói mới</button>
    </header>

    @if (_notice is not null)
    {
        <p role="status" class="rounded-xl border p-4 text-sm @(_noticeIsWarning ? "border-amber-300 bg-amber-50 text-amber-900" : "border-emerald-300 bg-emerald-50 text-emerald-900")">@_notice</p>
    }
    @if (_actionError is not null)
    {
        <p role="alert" class="rounded-xl border border-red-300 bg-red-50 p-4 text-sm text-red-900">@_actionError</p>
    }

    @if (_form is { } form)
    {
        <section class="membership-plan-editor rounded-xl border border-vfms-border bg-vfms-surface p-4 sm:p-6 shadow-sm" aria-labelledby="membership-plan-editor">
            <h2 id="membership-plan-editor" class="text-base font-bold text-[#242424] border-b border-[#D8D1CD] pb-3" tabindex="-1" @ref="_panelHeading">@(_selected is null ? "Thêm gói hội viên" : "Chỉnh sửa gói hội viên")</h2>
            <EditForm @key="form" Model="form" OnValidSubmit="SaveAsync" class="mt-4" novalidate>
                <ContractValidation TRequest="MembershipPlanRequest" Validator="_validator" CreateRequest="CreateRequest" @ref="_validation" />
                <ValidationSummary />
                <fieldset disabled="@_working" class="mt-4 grid min-w-0 gap-4 sm:grid-cols-2">
                    <label class="text-sm font-semibold text-[#242424]" for="plan-name">
                        Tên gói <span aria-hidden="true" class="text-vfms-primary">*</span>
                        <InputText id="plan-name" class="@Field" @bind-Value="form.Name" maxlength="256" required />
                        <ValidationMessage For="@(() => form.Name)" />
                    </label>
                    <label class="text-sm font-semibold text-[#242424]" for="plan-service">
                        Loại dịch vụ <span aria-hidden="true" class="text-vfms-primary">*</span>
                        <InputSelect id="plan-service" class="@Field" @bind-Value="form.ServiceType" disabled="@(_selected is not null)"
                                     aria-describedby="plan-service-hint" required>
                            <option value="@MembershipPlanServiceTypes.Gym">Gym</option>
                            <option value="@MembershipPlanServiceTypes.Yoga">Yoga</option>
                        </InputSelect>
                        <span id="plan-service-hint" class="mt-1 block text-xs font-normal text-[#6F6966]">@(_selected is null ? "Gói Yoga đặt được lớp theo cấp độ của gói. Không đổi được sau khi tạo." : "Không đổi được loại dịch vụ của gói đã tạo.")</span>
                        <ValidationMessage For="@(() => form.ServiceType)" />
                    </label>
                    <label class="text-sm font-semibold text-[#242424]" for="plan-status">
                        Trạng thái <span aria-hidden="true" class="text-vfms-primary">*</span>
                        <InputSelect id="plan-status" class="@Field" @bind-Value="form.Status" required>
                            <option value="@Active">Đang mở bán</option>
                            <option value="@Inactive">Ngừng bán</option>
                        </InputSelect>
                        <ValidationMessage For="@(() => form.Status)" />
                    </label>
                    @if (IsYoga(form.ServiceType))
                    {
                        <label class="text-sm font-semibold text-[#242424]" for="plan-level">
                            Cấp độ yoga
                            <InputSelect id="plan-level" class="@Field" @bind-Value="form.YogaDifficultyLevel" required aria-describedby="plan-level-hint">
                                <option value="">Chọn cấp độ</option>
                                @foreach (var level in YogaRules.DifficultyLevels)
                                {
                                    <option value="@level">@YogaRules.LevelLabel(level)</option>
                                }
                            </InputSelect>
                            <span id="plan-level-hint" class="mt-1 block text-xs font-normal text-[#6F6966]">@(string.IsNullOrEmpty(form.YogaDifficultyLevel) ? "Gói cấp cao hơn đặt được cả các lớp cấp thấp hơn." : $"Đặt được lớp: {YogaRules.CoveredLabels(form.YogaDifficultyLevel)}.") @(_selected is null ? "" : "Không đổi được khi gói đã có người mua.")</span>
                            <ValidationMessage For="@(() => form.YogaDifficultyLevel)" />
                        </label>
                    }
                    <div class="min-w-0 sm:col-start-1">
                        <MembershipDurationInput Id="plan-duration" Label="Thời hạn gói" Minimum="1" Required
                                                 @bind-Value="form.DurationValue" @bind-Unit="form.DurationUnit" />
                    </div>
                    <label class="text-sm font-semibold text-[#242424]" for="plan-price">
                        Giá (đ) <span aria-hidden="true" class="text-vfms-primary">*</span>
                        <InputVnd id="plan-price" class="@Field" @bind-Value="form.Price" required ParsingErrorMessage="Giá phải là một số hợp lệ." />
                        <ValidationMessage For="@(() => form.Price)" />
                    </label>
                    <label class="text-sm font-semibold text-[#242424] sm:col-span-2" for="plan-description">
                        Mô tả
                        <InputTextArea id="plan-description" class="@Field" @bind-Value="form.Description" rows="3" maxlength="4000" placeholder="Mô tả quyền lợi của gói..." />
                        <ValidationMessage For="@(() => form.Description)" />
                    </label>
                    <label class="text-sm font-semibold text-[#242424] sm:col-span-2" for="plan-audience">
                        Phù hợp với ai
                        <InputTextArea id="plan-audience" class="@Field" @bind-Value="form.TargetAudience" rows="3" maxlength="4000" placeholder="Đối tượng phù hợp với gói tập..." />
                        <ValidationMessage For="@(() => form.TargetAudience)" />
                    </label>
                    <section class="min-w-0 space-y-3 border-t border-vfms-border pt-4 sm:col-span-2" aria-labelledby="plan-freeze-benefits">
                        <h3 id="plan-freeze-benefits" class="text-sm font-bold text-vfms-text">Quyền lợi bảo lưu</h3>
                        @if (form.ServiceType == MembershipPlanServiceTypes.Gym)
                        {
                            <div class="grid gap-3 sm:grid-cols-3">
                                <label class="block text-sm font-semibold">Số lượt bảo lưu
                                    <InputNumber @bind-Value="form.MaxFreezeCount" min="0" class="@Field" placeholder="@($"Theo chính sách: {_policy?.DefaultMaxFreezeCount}")" />
                                    <ValidationMessage For="@(() => form.MaxFreezeCount)" />
                                </label>
                                <label class="block text-sm font-semibold">Số ngày tối thiểu mỗi lượt
                                    <InputNumber @bind-Value="form.MinFreezeDaysPerRequest" min="1" class="@Field" placeholder="@($"Theo chính sách: {_policy?.MinimumFreezeDays}")" />
                                    <ValidationMessage For="@(() => form.MinFreezeDaysPerRequest)" />
                                </label>
                                <label class="block text-sm font-semibold">Số ngày tối đa mỗi lượt
                                    <InputNumber @bind-Value="form.MaxFreezeDaysPerRequest" min="1" class="@Field" placeholder="@($"Theo chính sách: {_policy?.MaximumFreezeDays}")" />
                                    <ValidationMessage For="@(() => form.MaxFreezeDaysPerRequest)" />
                                </label>
                            </div>
                            <p class="text-xs text-vfms-text-secondary">Để trống từng ô để dùng chính sách chung. Nhập 0 lượt để tắt bảo lưu.</p>
                            <div class="min-w-0 rounded-lg bg-vfms-surface-alt p-4" aria-labelledby="applied-freeze-policy">
                                <h4 id="applied-freeze-policy" class="border-b border-vfms-border pb-2 text-sm font-bold text-vfms-text">Chính sách bảo lưu áp dụng</h4>
                                @if (_policyLoading)
                                {
                                    <p class="mt-3 text-sm text-vfms-text-secondary" role="status">Đang tải chính sách bảo lưu...</p>
                                }
                                else if (_policyError is not null)
                                {
                                    <p class="mt-3 text-sm text-red-800" role="alert">@_policyError</p>
                                    <button type="button" class="@Button mt-2" @onclick="LoadPolicyAsync">Tải lại chính sách</button>
                                }
                                else
                                {
                                    var visits = form.MaxFreezeCount ?? _policy?.DefaultMaxFreezeCount;
                                    var minimum = form.MinFreezeDaysPerRequest ?? _policy?.MinimumFreezeDays;
                                    var maximum = form.MaxFreezeDaysPerRequest ?? _policy?.MaximumFreezeDays;
                                    <p class="mt-2 text-sm" aria-live="polite">@(visits == 0 ? "Gói này không cho phép bảo lưu."
                                        : visits.HasValue && minimum.HasValue && maximum.HasValue
                                            ? $"{visits} lượt bảo lưu, mỗi lượt từ {minimum} đến {maximum} ngày liên tiếp."
                                            : "Chưa đủ thông tin để xác định quyền lợi bảo lưu.")</p>
                                }
                            </div>
                        }
                        else if (form.DurationUnit == MembershipDurationUnit.Day && form.DurationValue == 7)
                        {
                            <p class="text-sm">Gói Yoga theo tuần không hỗ trợ bảo lưu.</p>
                        }
                        else
                        {
                            <MembershipDurationInput Id="plan-freeze-allowance" Label="Tổng thời gian bảo lưu riêng của gói Yoga"
                                                     @bind-Value="form.FreezeAllowanceOverrideValue" @bind-Unit="form.FreezeAllowanceOverrideUnit"
                                                     ShowFreezeConversion HelpText="Để trống hoặc nhập 0 nếu gói không có quyền lợi bảo lưu." />
                        }
                    </section>
                    <div class="flex flex-wrap gap-3 sm:col-span-2 pt-2">
                        <button type="submit" class="@PrimaryButton">@(_working ? "Đang lưu..." : "Lưu gói hội viên")</button>
                        <button type="button" class="@Button" @onclick="ClosePanel">Hủy</button>
                    </div>
                </fieldset>
            </EditForm>
        </section>
    }
    else if (_selected is { } plan)
    {
        <section class="rounded-xl border border-[#D8D1CD] bg-[#F8F5F2] p-5 sm:p-6 shadow-sm" aria-labelledby="membership-plan-details">
            <h2 id="membership-plan-details" class="break-words text-base font-bold text-[#242424] border-b border-[#D8D1CD] pb-3" tabindex="-1" @ref="_panelHeading">@plan.Name</h2>
            <dl class="mt-4 grid gap-4 text-sm sm:grid-cols-2">
                <div><dt class="font-semibold text-[#6F6966]">Loại dịch vụ</dt><dd class="font-bold text-[#242424]">@ServiceLabel(plan)</dd></div>
                <div><dt class="font-semibold text-[#6F6966]">Thời hạn</dt><dd class="font-bold text-[#242424]">@Duration(plan)</dd></div>
                <div><dt class="font-semibold text-[#6F6966]">Giá</dt><dd class="font-bold text-[#B83A3A]">@Vnd.Format(plan.Price)</dd></div>
                <div><dt class="font-semibold text-[#6F6966]">Trạng thái</dt><dd class="font-semibold text-[#242424]">@StatusLabel(plan.Status)</dd></div>
                <div><dt class="font-semibold text-[#6F6966]">Lượt đăng ký đang hoạt động</dt><dd class="font-bold text-[#242424]">@plan.SubscriberCount</dd></div>
                <div class="sm:col-span-2"><dt class="font-semibold text-[#6F6966]">Mô tả</dt><dd class="whitespace-pre-wrap break-words text-[#242424]">@(plan.Description ?? "—")</dd></div>
                <div class="sm:col-span-2"><dt class="font-semibold text-[#6F6966]">Phù hợp với ai</dt><dd class="whitespace-pre-wrap break-words text-[#242424]">@(plan.TargetAudience ?? "—")</dd></div>
                <div><dt class="font-semibold text-[#6F6966]">Quyền lợi bảo lưu</dt><dd class="text-[#242424]">@(plan.ServiceType == MembershipPlanServiceTypes.Gym ? (plan.MaxFreezeCount is { } count ? $"{count} lượt" : "Số lượt theo chính sách chung") : plan.DurationUnit == MembershipDurationUnit.Day && plan.DurationValue == 7 ? "Yoga theo tuần không hỗ trợ bảo lưu" : AllowanceLabel(plan.FreezeAllowanceOverrideDays ?? 0))</dd></div>
            </dl>
            <div class="mt-5 flex flex-wrap gap-3 pt-2">
                <button type="button" class="@PrimaryButton" @onclick="OpenEditAsync">Chỉnh sửa</button>
                <button type="button" class="@Button" @onclick="ClosePanel">Đóng chi tiết</button>
            </div>
        </section>
    }

    <section class="rounded-xl border border-[#D8D1CD] bg-[#F8F5F2] shadow-sm overflow-hidden" aria-labelledby="membership-plan-list" aria-busy="@(_loading || _working)">
        <div class="border-b border-[#D8D1CD] p-5 bg-[#ECE8E4]/40">
            <h2 id="membership-plan-list" class="mb-3 text-sm font-bold text-[#242424]">Danh mục gói hội viên</h2>
            <form @onsubmit="ApplyFiltersAsync" @onsubmit:preventDefault>
                <fieldset disabled="@ListDisabled" class="flex flex-wrap items-end gap-3">
                    <label class="w-full text-xs font-semibold text-[#242424] sm:w-64" for="plan-search">
                        Tìm theo tên
                        <input id="plan-search" type="search" @bind="_searchInput" class="@Field" maxlength="256" />
                    </label>
                    <label class="text-xs font-semibold text-[#242424]" for="plan-filter-service">
                        Loại dịch vụ
                        <select id="plan-filter-service" @bind="_serviceInput" class="@Field">
                            <option value="">Tất cả</option>
                            <option value="@MembershipPlanServiceTypes.Gym">Gym</option>
                            <option value="@MembershipPlanServiceTypes.Yoga">Yoga</option>
                        </select>
                    </label>
                    <label class="text-xs font-semibold text-[#242424]" for="plan-filter-status">
                        Trạng thái
                        <select id="plan-filter-status" @bind="_statusInput" class="@Field">
                            <option value="">Tất cả</option>
                            <option value="@Active">Đang mở bán</option>
                            <option value="@Inactive">Ngừng bán</option>
                        </select>
                    </label>
                    <label class="text-xs font-semibold text-[#242424]" for="plan-filter-duration">
                        Đơn vị thời hạn
                        <select id="plan-filter-duration" @bind="_durationUnitInput" class="@Field">
                            <option value="">Tất cả</option>
                            <option value="@MembershipDurationUnit.Day">Ngày</option>
                            <option value="@MembershipDurationUnit.Month">Tháng</option>
                        </select>
                    </label>
                    <label class="text-xs font-semibold text-[#242424]" for="plan-filter-freeze">
                        Quyền lợi bảo lưu
                        <select id="plan-filter-freeze" @bind="_freezeFilterInput" class="@Field">
                            <option value="">Tất cả</option>
                            <option value="@MembershipFreezeAllowanceFilter.Default">Theo chính sách mặc định</option>
                            <option value="@MembershipFreezeAllowanceFilter.Disabled">Tắt riêng cho gói</option>
                            <option value="@MembershipFreezeAllowanceFilter.Custom">Có thiết lập riêng</option>
                        </select>
                    </label>
                    <button type="submit" class="@Button">Áp dụng</button>
                </fieldset>
            </form>
        </div>

        @if (_loading)
        {
            <div class="flex items-center gap-3 p-6 text-sm text-[#6F6966]" role="status">
                <svg class="h-5 w-5 animate-spin text-[#B83A3A]" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24"><circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"></circle><path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8v8H4z"></path></svg>
                Đang tải danh sách gói hội viên...
            </div>
        }
        else if (_listError is not null)
        {
            <div class="space-y-3 p-5 text-sm">
                <p role="alert" class="text-red-800">@_listError</p>
                <button type="button" class="@Button" disabled="@ListDisabled" @onclick="LoadPlansAsync">Tải lại</button>
            </div>
        }
        else if (_list is { Items.Count: > 0 } list)
        {
            <div class="overflow-x-auto">
                <table class="workspace-table min-w-[780px]">
                    <thead>
                        <tr><th scope="col">Tên gói</th><th scope="col">Dịch vụ</th><th scope="col">Thời hạn</th><th scope="col">Giá</th><th scope="col">Lượt đăng ký</th><th scope="col">Trạng thái</th><th scope="col">Thao tác</th></tr>
                    </thead>
                    <tbody>
                        @foreach (var row in list.Items)
                        {
                            <tr @key="row.Id">
                                <th scope="row" class="max-w-56 break-words">@row.Name</th>
                                <td>@ServiceLabel(row)</td>
                                <td>@Duration(row)</td>
                                <td class="whitespace-nowrap font-semibold text-[#B83A3A]">@Vnd.Format(row.Price)</td>
                                <td>@row.SubscriberCount</td>
                                <td><span class="inline-block whitespace-nowrap rounded-md border px-2.5 py-1 text-[11px] font-semibold @(IsActive(row.Status) ? "border-emerald-200 bg-emerald-50 text-emerald-800" : "border-[#D8D1CD] bg-[#ECE8E4] text-[#6F6966]")">@StatusLabel(row.Status)</span></td>
                                <td>
                                    <div class="flex flex-wrap gap-2">
                                        <button type="button" class="@Button" disabled="@ListDisabled" aria-label="Xem hoặc sửa @row.Name" @onclick="() => OpenDetailsAsync(row.Id)">Xem / Sửa</button>
                                        <button type="button" class="@Button" disabled="@ListDisabled" @onclick="() => ChangeStatusAsync(row)">@(IsActive(row.Status) ? "Ngừng bán" : "Mở bán")</button>
                                        <button type="button" class="@Button text-red-700 hover:bg-red-50" disabled="@ListDisabled" aria-label="Xóa @row.Name" @onclick="() => DeleteAsync(row)">Xóa</button>
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
            <nav aria-label="Phân trang gói hội viên" class="flex flex-wrap items-center justify-between gap-3 border-t border-[#D8D1CD] p-4 text-xs font-medium text-[#6F6966]">
                <p>Trang @list.Page / @PageCount(list) · @list.TotalCount gói</p>
                <div class="flex gap-2">
                    <button type="button" class="@Button" disabled="@(ListDisabled || list.Page <= 1)" @onclick="() => ChangePageAsync(list.Page - 1)">Trang trước</button>
                    <button type="button" class="@Button" disabled="@(ListDisabled || list.Page >= PageCount(list))" @onclick="() => ChangePageAsync(list.Page + 1)">Trang sau</button>
                </div>
            </nav>
        }
        else
        {
            <p role="status" class="p-6 text-sm text-[#6F6966]">Không tìm thấy gói hội viên phù hợp.</p>
        }
    </section>
</div>

@code {
    private const string Active = MembershipPlanStatuses.Active;
    private const string Inactive = MembershipPlanStatuses.Inactive;
    private const string Field = "mt-1 block min-h-[44px] min-w-0 w-full rounded-lg border border-vfms-border bg-vfms-surface px-3 py-2 text-base font-normal text-vfms-text focus:border-vfms-primary sm:text-sm";
    private const string Button = "min-h-[44px] rounded-lg border border-[#C9C0BB] bg-[#F8F5F2] px-3 py-1.5 text-xs font-semibold text-[#242424] hover:bg-[#F3EDEA] transition";
    private const string PrimaryButton = "min-h-[44px] rounded-lg bg-[#B83A3A] px-4 py-2 text-sm font-semibold text-white hover:bg-[#9F3030] active:bg-[#7F2929] transition shadow-sm";

    private readonly CancellationTokenSource _lifetime = new();
    private readonly MembershipPlanRequestValidator _validator = new();
    private readonly MembershipPlanListRequest _query = new() { Status = Active };
    private PagedResponse<MembershipPlanResponse>? _list;
    private MembershipPlanResponse? _selected;
    private MembershipPlanRequest? _form;
    private ContractValidation<MembershipPlanRequest>? _validation;
    private ElementReference _panelHeading;
    private string _searchInput = string.Empty;
    private string _statusInput = Active;
    private string _serviceInput = string.Empty;
    private MembershipDurationUnit? _durationUnitInput;
    private MembershipFreezeAllowanceFilter? _freezeFilterInput;
    private MembershipFreezePolicyConfiguration? _policy;
    private bool _policyLoading;
    private string? _policyError;
    private string? _actionError;
    private string? _listError;
    private string? _notice;
    private bool _noticeIsWarning;
    private bool _loading;
    private bool _working;
    private bool _focusPanel;
    private bool ListDisabled => _loading || _working || _form is not null || _selected is not null;

    protected override Task OnInitializedAsync() => LoadPlansAsync();

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!_focusPanel) return;
        _focusPanel = false;
        await _panelHeading.FocusAsync();
    }

    private async Task LoadPlansAsync()
    {
        _loading = true;
        _listError = null;
        try
        {
            var page = await Api.ListAsync(_query, _lifetime.Token);
            if (_query.Page > PageCount(page))
            {
                _query.Page = PageCount(page);
                page = await Api.ListAsync(_query, _lifetime.Token);
            }
            _list = page;
        }
        catch (AuthApiException error) { _listError = error.Message; }
        catch (OperationCanceledException) when (_lifetime.IsCancellationRequested) { }
        finally { _loading = false; }
    }

    private Task ApplyFiltersAsync()
    {
        if (ListDisabled) return Task.CompletedTask;
        _query.Search = _searchInput.Trim();
        _query.Status = _statusInput;
        _query.ServiceType = _serviceInput;
        _query.DurationUnit = _durationUnitInput;
        _query.FreezeAllowanceFilter = _freezeFilterInput;
        return ChangePageAsync(1);
    }

    private Task ChangePageAsync(int page)
    {
        _query.Page = page;
        return LoadPlansAsync();
    }

    private Task OpenCreateAsync()
    {
        _actionError = _notice = null;
        _form = new() { Status = Active };
        _focusPanel = true;
        return LoadPolicyAsync();
    }

    private Task OpenDetailsAsync(int id) => RunActionAsync(async () =>
    {
        _selected = await Api.GetAsync(id, _lifetime.Token);
        _focusPanel = true;
    });

    private Task OpenEditAsync()
    {
        if (_selected is not { } plan) return Task.CompletedTask;
        _form = new()
        {
            Name = plan.Name,
            Description = plan.Description,
            TargetAudience = plan.TargetAudience,
            DurationValue = plan.DurationValue,
            DurationUnit = plan.DurationUnit,
            MaxFreezeCount = plan.MaxFreezeCount,
            MinFreezeDaysPerRequest = plan.MinFreezeDaysPerRequest,
            MaxFreezeDaysPerRequest = plan.MaxFreezeDaysPerRequest,
            FreezeAllowanceOverrideValue = plan.FreezeAllowanceOverrideValue,
            FreezeAllowanceOverrideUnit = plan.FreezeAllowanceOverrideUnit,
            Price = plan.Price,
            Status = IsActive(plan.Status) ? Active : Inactive,
            ServiceType = plan.ServiceType,
            YogaDifficultyLevel = plan.YogaDifficultyLevel
        };
        _focusPanel = true;
        return LoadPolicyAsync();
    }

    private async Task LoadPolicyAsync()
    {
        var form = _form;
        _policyLoading = true;
        _policyError = null;
        _policy = null;
        try
        {
            var response = await Api.GetMembershipFreezePolicyAsync(_lifetime.Token);
            if (ReferenceEquals(form, _form))
                _policy = response.Policy;
        }
        catch (AuthApiException error)
        {
            if (ReferenceEquals(form, _form))
                _policyError = error.Message;
        }
        catch (OperationCanceledException) when (_lifetime.IsCancellationRequested) { }
        finally
        {
            if (ReferenceEquals(form, _form))
                _policyLoading = false;
        }
    }

    private MembershipPlanRequest CreateRequest() => _form!;

    private Task SaveAsync() => RunActionAsync(async () =>
    {
        var request = CreateRequest();
        if (_selected is { } plan)
        {
            await Api.UpdateAsync(plan.Id, request, _lifetime.Token);
            _notice = "Đã cập nhật gói hội viên.";
        }
        else
        {
            await Api.CreateAsync(request, _lifetime.Token);
            _notice = "Đã tạo gói hội viên mới.";
        }
        ClosePanel();
        await LoadPlansAsync();
    });

    private Task ChangeStatusAsync(MembershipPlanResponse plan) => RunActionAsync(async () =>
    {
        var status = IsActive(plan.Status) ? Inactive : Active;
        var updated = await Api.ChangeStatusAsync(plan.Id, status, _lifetime.Token);
        _notice = IsActive(updated.Status) ? "Đã mở bán gói hội viên." : "Đã ngừng bán gói hội viên.";
        await LoadPlansAsync();
    });

    private Task DeleteAsync(MembershipPlanResponse plan) => RunActionAsync(async () =>
    {
        var confirmed = await JS.InvokeAsync<bool>("confirm", _lifetime.Token,
            $"Xóa gói hội viên “{plan.Name}”? Hệ thống sẽ kiểm tra lịch sử bán và lượt đăng ký trước khi xóa.");
        if (!confirmed) return;
        var result = await Api.DeleteAsync(plan.Id, _lifetime.Token);
        _notice = result.Message;
        _noticeIsWarning = result.Deactivated;
        await LoadPlansAsync();
    });

    private async Task RunActionAsync(Func<Task> action)
    {
        if (_working || _loading) return;
        _working = true;
        _actionError = _notice = null;
        _noticeIsWarning = false;
        try { await action(); }
        catch (AuthApiException error)
        {
            _actionError = error.Message;
            _validation?.ShowErrors(error.Errors);
        }
        catch (OperationCanceledException) when (_lifetime.IsCancellationRequested) { }
        finally { _working = false; }
    }

    private void ClosePanel()
    {
        _form = null;
        _selected = null;
        _validation = null;
        _actionError = null;
        _policyLoading = false;
    }

    private static int PageCount(PagedResponse<MembershipPlanResponse> page) => Math.Max(1, (int)Math.Ceiling((double)page.TotalCount / page.PageSize));
    private static bool IsActive(string status) => string.Equals(status, Active, StringComparison.OrdinalIgnoreCase);
    private static string StatusLabel(string status) => IsActive(status) ? "Đang mở bán" : "Ngừng bán";
    private static bool IsYoga(string? type) => string.Equals(type, MembershipPlanServiceTypes.Yoga, StringComparison.OrdinalIgnoreCase);
    // Yoga plans show their level; old ones without a level are not sold until the manager sets one.
    private static string ServiceLabel(MembershipPlanResponse plan) => !IsYoga(plan.ServiceType) ? "Gym"
        : plan.YogaDifficultyLevel is { } level ? $"Yoga · {YogaRules.LevelLabel(level)}" : "Yoga · Chưa có cấp độ · không bán";
    private static string Duration(MembershipPlanResponse plan) => Duration(plan.DurationValue, plan.DurationUnit);
    private static string Duration(int? value, MembershipDurationUnit unit) =>
        value is > 0 ? $"{value} {(unit == MembershipDurationUnit.Month ? "tháng" : "ngày")}" : "—";
    private static string AllowanceLabel(int? days) => days switch
    {
        null => "Chưa xác định",
        0 => "Không được bảo lưu",
        _ => $"{days} ngày"
    };

    public void Dispose()
    {
        _lifetime.Cancel();
        _lifetime.Dispose();
    }
}
