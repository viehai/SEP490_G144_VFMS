@using VFMS.Contracts.Common
@using VFMS.Contracts.Equipment
@inject OperationsApiClient Api
@implements IDisposable

@* UC-72 Handle Equipment Issues (Role = Staff) and UC-73 Manage Equipment Repairs (Role = Manager). *@

<Alerts Notice="@_notice" Error="@_error" />

@if (_selected is { } issue)
{
    <section class="@Ui.Card" aria-labelledby="issue-detail-title">
        <div class="flex flex-wrap items-start justify-between gap-3">
            <div>
                <h2 id="issue-detail-title" class="text-base font-bold text-[#383E43]">#@issue.Id · @issue.EquipmentName@(issue.EquipmentCode is { } code ? $" ({code})" : "")</h2>
                <p class="mt-1 text-xs text-[#69706A]">Báo lúc @OperationsText.Local(issue.ReportedAt) bởi @(issue.ReportedByName ?? "hội viên")@(issue.HandledByName is { } handler ? $" · Người xử lý: {handler}" : "")</p>
            </div>
            <div class="flex flex-wrap items-center gap-2">
                <span class="@OperationsText.Badge(issue.IncidentType)">@OperationsText.Label(issue.IncidentType)</span>
                <span class="@OperationsText.Badge(issue.Status)">@OperationsText.Label(issue.Status)</span>
                <span class="@OperationsText.Badge(issue.EquipmentStatus)">Thiết bị: @OperationsText.Label(issue.EquipmentStatus)</span>
                <button type="button" class="@Ui.Button" @onclick="() => _selected = null">Đóng</button>
            </div>
        </div>
        <div class="mt-4 grid gap-4 lg:grid-cols-2">
            <div class="space-y-3">
                <p class="rounded-lg border border-[#D8DED2] bg-[#F7F4EC] p-4 text-sm whitespace-pre-wrap">@issue.Description</p>
                @if (issue.ImageUrl is { } image)
                {
                    <a href="@image" target="_blank" rel="noopener noreferrer" class="text-sm font-semibold text-[#5F6F52] underline underline-offset-4">Xem ảnh đính kèm ↗</a>
                }
                @if (issue.ResolutionNote is { } resolution)
                {
                    <p class="text-sm"><span class="font-semibold">Kết quả:</span> @resolution@(issue.ResolvedAt is { } at ? $" ({OperationsText.Local(at)})" : "")</p>
                }
                @if (issue.SafetyConfirmations.Count > 0)
                {
                    <div>
                        <p class="mb-1 text-xs font-bold text-[#383E43]">Lịch sử xác nhận</p>
                        <ul class="space-y-1 text-xs text-[#69706A]">
                            @foreach (var confirmation in issue.SafetyConfirmations.OrderByDescending(c => c.ConfirmedAt))
                            {
                                <li>@OperationsText.Local(confirmation.ConfirmedAt) · @(confirmation.ConfirmedByName ?? "—"): @confirmation.Note</li>
                            }
                        </ul>
                    </div>
                }
            </div>
            <div>
                @if (Actions(issue) is { Count: > 0 } actions)
                {
                    <form @onsubmit="() => RunActionAsync(issue)" @onsubmit:preventDefault>
                        <fieldset disabled="@_working" class="space-y-3">
                            <label class="@Ui.Label block" for="issue-action">Thao tác
                                <select id="issue-action" class="@Ui.Field" @bind="_action">
                                    @foreach (var action in actions) { <option value="@action.Path">@action.Label</option> }
                                </select>
                            </label>
                            @if (NeedsNote)
                            {
                                <label class="@Ui.Label block" for="issue-note">Ghi chú (bắt buộc)
                                    <textarea id="issue-note" class="@Ui.Field" rows="3" @bind="_note" maxlength="1000" required></textarea>
                                </label>
                            }
                            @if (_action == "repair/dispose")
                            {
                                <p class="text-xs text-red-700">Thiết bị sẽ chuyển sang "Đã thanh lý" và không thể sử dụng lại.</p>
                            }
                            <button type="submit" class="@Ui.PrimaryButton">@(_working ? "Đang lưu..." : "Xác nhận")</button>
                        </fieldset>
                    </form>
                }
                else
                {
                    <p class="text-sm text-[#69706A]">@(Role == "Manager" && issue.Status is "Reported" or "InProgress" && !IsRepair(issue) ? "Sự cố đang do nhân viên xử lý." : "Không có thao tác nào cho trạng thái này.")</p>
                }
            </div>
        </div>
    </section>
}

<section class="@Ui.ListCard" aria-labelledby="issue-list-title" aria-busy="@_loading">
    <div class="@Ui.ListHeader">
        <h2 id="issue-list-title" class="mb-3 text-sm font-bold text-[#383E43]">Báo cáo sự cố</h2>
        <form @onsubmit="() => LoadAsync(1)" @onsubmit:preventDefault>
            <fieldset disabled="@Busy" class="flex flex-wrap items-end gap-3">
                <label class="@Ui.Label" for="issue-status">Trạng thái
                    <select id="issue-status" class="@Ui.Field" @bind="_status">
                        <option value="">Tất cả</option>
                        @foreach (var status in OperationsText.IssueStatuses) { <option value="@status">@OperationsText.Label(status)</option> }
                    </select>
                </label>
                <button type="submit" class="@Ui.Button">Áp dụng</button>
            </fieldset>
        </form>
    </div>
    @if (_loading)
    {
        <p role="status" class="p-5 text-sm">Đang tải báo cáo sự cố...</p>
    }
    else if (_page is { Items.Count: > 0 } list)
    {
        <div class="overflow-x-auto">
            <table class="workspace-table min-w-[820px]">
                <thead>
                    <tr><th scope="col">Thời gian</th><th scope="col">Thiết bị</th><th scope="col">Loại</th><th scope="col">Người báo</th><th scope="col">Trạng thái</th><th scope="col">Chi tiết</th></tr>
                </thead>
                <tbody>
                    @foreach (var row in list.Items)
                    {
                        <tr @key="row.Id">
                            <th scope="row" class="whitespace-nowrap font-normal">@OperationsText.Local(row.ReportedAt)</th>
                            <td class="font-semibold">@row.EquipmentName<span class="block text-xs font-normal text-[#8A9089]">@OperationsText.Label(row.EquipmentStatus)</span></td>
                            <td><span class="@OperationsText.Badge(row.IncidentType)">@OperationsText.Label(row.IncidentType)</span></td>
                            <td>@(row.ReportedByName ?? "—")</td>
                            <td><span class="@OperationsText.Badge(row.Status)">@OperationsText.Label(row.Status)</span>@if (IsRepair(row)) { <span class="ml-1 text-[11px] text-[#69706A]">sửa chữa</span> }</td>
                            <td><button type="button" class="@Ui.Button" disabled="@Busy" @onclick="() => Select(row)">@(Actions(row).Count > 0 ? "Xử lý" : "Xem")</button></td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
        <Pager Page="list.Page" PageSize="list.PageSize" TotalCount="list.TotalCount" Noun="báo cáo" AriaLabel="Phân trang sự cố" Disabled="Busy" OnPage="LoadAsync" />
    }
    else
    {
        <p role="status" class="p-5 text-sm text-[#69706A]">Không có báo cáo sự cố phù hợp.</p>
    }
</section>

@code {
    /// <summary>"Staff" or "Manager".</summary>
    [Parameter, EditorRequired] public string Role { get; set; } = "Staff";
    [Parameter] public string InitialStatus { get; set; } = "";

    private sealed record IssueAction(string Path, string Label, bool NeedsNote);
    private const int PageSize = 20;
    private readonly CancellationTokenSource _lifetime = new();
    private PagedResponse<EquipmentIssueResponse>? _page;
    private EquipmentIssueResponse? _selected;
    private string _status = "", _action = "", _note = "";
    private string? _notice, _error;
    private bool _loading, _working;
    private bool Busy => _loading || _working;
    private bool NeedsNote => _selected is { } issue && Actions(issue).FirstOrDefault(a => a.Path == _action)?.NeedsNote == true;

    protected override Task OnInitializedAsync()
    {
        _status = InitialStatus;
        return LoadAsync(1);
    }

    // A Manager repair keeps the issue "InProgress" and puts the equipment under maintenance (or damaged after a failed check).
    private static bool IsRepair(EquipmentIssueResponse issue) =>
        issue.Status == "InProgress" && issue.EquipmentStatus is "UnderMaintenance" or "Damaged";

    private List<IssueAction> Actions(EquipmentIssueResponse issue) => (Role, issue.Status, IsRepair(issue)) switch
    {
        ("Staff", "Reported", _) =>
        [
            new("start", "Bắt đầu xử lý", false),
            new("mark-safe", "Kiểm tra: an toàn, đóng báo cáo", true),
            new("escalate", "Chuyển quản lý sửa chữa", true)
        ],
        ("Staff", "InProgress", false) =>
        [
            new("resolve", "Đã khắc phục xong", true),
            new("mark-safe", "Kiểm tra: an toàn, đóng báo cáo", true),
            new("escalate", "Chuyển quản lý sửa chữa", true)
        ],
        ("Manager", "Escalated", _) =>
        [
            new("repair/start", "Nhận sửa chữa", false),
            new("repair/dispose", "Thanh lý thiết bị", true)
        ],
        ("Manager", "InProgress", true) =>
        [
            new("repair/confirm-safe", "Sửa xong: xác nhận an toàn", true),
            new("repair/not-safe", "Chưa an toàn, sửa tiếp", true),
            new("repair/dispose", "Thanh lý thiết bị", true)
        ],
        _ => []
    };

    private void Select(EquipmentIssueResponse issue)
    {
        _selected = issue;
        _action = Actions(issue).FirstOrDefault()?.Path ?? "";
        _note = "";
        _notice = _error = null;
    }

    private async Task LoadAsync(int page)
    {
        _loading = true;
        try { _page = await Api.GetIssuesAsync(new(string.IsNullOrEmpty(_status) ? null : _status, null, page, PageSize), ct: _lifetime.Token); }
        catch (AuthApiException error) { _error = error.Message; }
        catch (OperationCanceledException) when (_lifetime.IsCancellationRequested) { }
        finally { _loading = false; }
    }

    private async Task RunActionAsync(EquipmentIssueResponse issue)
    {
        if (Busy || string.IsNullOrEmpty(_action)) return;
        var action = Actions(issue).First(a => a.Path == _action);
        if (action.NeedsNote && string.IsNullOrWhiteSpace(_note))
        {
            _error = "Vui lòng nhập ghi chú.";
            return;
        }
        _working = true;
        _notice = _error = null;
        try
        {
            var saved = await Api.IssueActionAsync(issue.Id, action.Path, action.NeedsNote ? _note.Trim() : null, _lifetime.Token);
            Select(saved);
            _notice = $"Sự cố #{saved.Id} đã cập nhật: {OperationsText.Label(saved.Status)}.";
            if (Actions(saved).Count == 0) _selected = null;
            await LoadAsync(_page?.Page ?? 1);
        }
        catch (AuthApiException error) { _error = error.Message; }
        catch (OperationCanceledException) when (_lifetime.IsCancellationRequested) { }
        finally { _working = false; }
    }

    public void Dispose()
    {
        _lifetime.Cancel();
        _lifetime.Dispose();
    }
}
