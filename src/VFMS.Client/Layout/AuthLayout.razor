@inherits LayoutComponentBase

<div class="auth-shell">
    <aside class="auth-brand" aria-label="Victor Fitness branding">
        <div class="auth-brand-lines" aria-hidden="true">
            <span class="auth-brand-line"></span>
            <span class="auth-brand-line"></span>
        </div>
        <a class="auth-logo" href="/" aria-label="Victor Fitness – Trang chủ">
            <img src="/brand/logo-remove.png" alt="Victor Fitness" />
        </a>
        <div class="auth-brand-copy">
            <div class="auth-overline-wrap">
                <span class="auth-overline-rule" aria-hidden="true"></span>
                <p class="auth-overline">VICTOR FITNESS / ESTABLISH YOUR STANDARD</p>
            </div>
            <p class="auth-brand-title">KỶ LUẬT.<br />SỨC MẠNH.<br /><span>BẢN LĨNH.</span></p>
            <p class="auth-brand-description">Mỗi buổi tập là một bước tiến.<br />Bắt đầu hành trình của bạn cùng Victor Fitness.</p>
        </div>
        <div class="auth-brand-footer">
            <span>V-FITNESS MANAGEMENT</span>
            <span>MOVE WITH PURPOSE ↗</span>
        </div>
        <div class="auth-brand-ribbon" aria-hidden="true"></div>
    </aside>
    <main class="auth-main" aria-label="Đăng nhập / Đăng ký">
        <!-- decorative background shapes: position:absolute, z-index:0 -->
        <div class="auth-deco auth-deco--tr" aria-hidden="true"></div>
        <div class="auth-deco auth-deco--bl" aria-hidden="true"></div>

        <!-- actual content layer: z-index above deco -->
        <div class="auth-panel-content">
            <header class="auth-topbar">
                <a href="/">← TRỞ VỀ TRANG CHỦ</a>
                <span>VICTOR FITNESS</span>
            </header>

            <div class="auth-form-area">
                <div class="auth-card">@Body</div>
            </div>

            <footer class="auth-panel-footer">© @DateTime.Now.Year VICTOR FITNESS. ALL RIGHTS RESERVED.</footer>
        </div>
    </main>
</div>
