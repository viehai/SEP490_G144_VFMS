@using VFMS.Contracts.Common
@using VFMS.Contracts.Supplements
@inject OperationsApiClient Api
@implements IDisposable

@* UC-81/82 Process Supplement Orders, shared by Staff and Manager. *@

<Alerts Notice="@_notice" Error="@_error" />

@if (_selected is { } order)
{
    <section class="@Ui.Card" aria-labelledby="order-detail-title">
        <div class="flex flex-wrap items-start justify-between gap-3">
            <div>
                <h2 id="order-detail-title" class="text-base font-bold text-[#383E43]">Đơn @order.OrderNumber</h2>
                <p class="mt-1 text-xs text-[#69706A]">@(order.CustomerName ?? "Khách hàng") · Đặt @OperationsText.Local(order.PlacedAt) · @OperationsText.Label(order.FulfillmentType)</p>
            </div>
            <div class="flex items-center gap-2">
                <span class="@OperationsText.Badge(order.Status)">@OperationsText.Label(order.Status)</span>
                <button type="button" class="@Ui.Button" @onclick="() => _selected = null">Đóng</button>
            </div>
        </div>
        <div class="mt-4 grid gap-5 lg:grid-cols-[1fr_320px]">
            <OrderLines Order="order" />
            <div class="space-y-4">
                @if (order.Delivery is { } delivery && order.FulfillmentType == "HomeDelivery")
                {
                    <dl class="space-y-1 rounded-lg border border-[#D8DED2] bg-[#F7F4EC] p-4 text-xs">
                        <div><dt class="inline font-semibold">Người nhận:</dt> <dd class="inline">@(delivery.RecipientName ?? "—")</dd></div>
                        <div><dt class="inline font-semibold">Điện thoại:</dt> <dd class="inline">@(delivery.ContactPhone ?? "—")</dd></div>
                        <div><dt class="inline font-semibold">Địa chỉ:</dt> <dd class="inline">@(delivery.DeliveryAddress ?? "—")</dd></div>
                        @if (delivery.DeliveryNote is { } note) { <div><dt class="inline font-semibold">Ghi chú:</dt> <dd class="inline">@note</dd></div> }
                        @if (delivery.CourierName is { } courier) { <div><dt class="inline font-semibold">Vận chuyển:</dt> <dd class="inline">@courier · @delivery.TrackingCode</dd></div> }
                    </dl>
                }
                @switch (order.Status)
                {
                    case "Pending":
                        <button type="button" class="@Ui.PrimaryButton w-full" disabled="@_working" @onclick='() => ActAsync(order, "process")'>Nhận đơn, bắt đầu chuẩn bị</button>
                        break;
                    case "Processing" when order.FulfillmentType == "GymPickup":
                        <button type="button" class="@Ui.PrimaryButton w-full" disabled="@_working" @onclick='() => ActAsync(order, "ready-for-pickup")'>Đã chuẩn bị xong, chờ khách nhận</button>
                        break;
                    case "Processing":
                        <form class="space-y-3" @onsubmit='() => ActAsync(order, "out-for-delivery")' @onsubmit:preventDefault>
                            <fieldset disabled="@_working" class="space-y-3">
                                <label class="@Ui.Label block" for="courier">Đơn vị vận chuyển
                                    <input id="courier" class="@Ui.Field" @bind="_courier" maxlength="100" required placeholder="VD: GHN" />
                                </label>
                                <label class="@Ui.Label block" for="tracking">Mã vận đơn
                                    <input id="tracking" class="@Ui.Field" @bind="_tracking" maxlength="100" required />
                                </label>
                                <button type="submit" class="@Ui.PrimaryButton w-full">Giao cho đơn vị vận chuyển</button>
                            </fieldset>
                        </form>
                        break;
                    case "ReadyForPickup":
                        <button type="button" class="@Ui.PrimaryButton w-full" disabled="@_working" @onclick='() => ActAsync(order, "complete")'>Khách đã nhận và thanh toán</button>
                        break;
                    case "OutForDelivery":
                        <button type="button" class="@Ui.PrimaryButton w-full" disabled="@_working" @onclick='() => ActAsync(order, "complete")'>Đã giao và thu tiền (COD)</button>
                        break;
                    default:
                        <p class="text-sm text-[#69706A]">@(order.Status == "Cancelled" ? $"Khách đã hủy đơn{(order.CancelledAt is { } at ? $" lúc {OperationsText.Local(at)}" : "")}." : $"Đơn đã hoàn tất{(order.CompletedAt is { } done ? $" lúc {OperationsText.Local(done)}" : "")}.")</p>
                        break;
                }
            </div>
        </div>
    </section>
}

<section class="@Ui.ListCard" aria-labelledby="order-list-title" aria-busy="@_loading">
    <div class="@Ui.ListHeader">
        <h2 id="order-list-title" class="mb-3 text-sm font-bold text-[#383E43]">Đơn hàng</h2>
        <form @onsubmit="() => LoadAsync(1)" @onsubmit:preventDefault>
            <fieldset disabled="@Busy" class="flex flex-wrap items-end gap-3">
                <label class="@Ui.Label w-full sm:w-56" for="order-search">Tìm kiếm
                    <input id="order-search" type="search" class="@Ui.Field" @bind="_search" maxlength="100" placeholder="Mã đơn hoặc tên khách" />
                </label>
                <label class="@Ui.Label" for="order-status">Trạng thái
                    <select id="order-status" class="@Ui.Field" @bind="_status">
                        <option value="">Tất cả</option>
                        @foreach (var status in OperationsText.OrderStatuses) { <option value="@status">@OperationsText.Label(status)</option> }
                    </select>
                </label>
                <label class="@Ui.Label" for="order-type">Hình thức
                    <select id="order-type" class="@Ui.Field" @bind="_type">
                        <option value="">Tất cả</option>
                        @foreach (var type in OperationsText.FulfillmentTypes) { <option value="@type">@OperationsText.Label(type)</option> }
                    </select>
                </label>
                <label class="@Ui.Label" for="order-from">Từ ngày
                    <input id="order-from" type="date" class="@Ui.Field" @bind="_from" />
                </label>
                <label class="@Ui.Label" for="order-to">Đến ngày
                    <input id="order-to" type="date" class="@Ui.Field" @bind="_to" />
                </label>
                <button type="submit" class="@Ui.Button">Áp dụng</button>
            </fieldset>
        </form>
    </div>
    @if (_loading)
    {
        <p role="status" class="p-5 text-sm">Đang tải đơn hàng...</p>
    }
    else if (_page is { Items.Count: > 0 } list)
    {
        <div class="overflow-x-auto">
            <table class="workspace-table min-w-[860px]">
                <thead>
                    <tr><th scope="col">Mã đơn</th><th scope="col">Khách hàng</th><th scope="col">Hình thức</th><th scope="col" class="text-right">Tổng tiền</th><th scope="col">Trạng thái</th><th scope="col">Chi tiết</th></tr>
                </thead>
                <tbody>
                    @foreach (var row in list.Items)
                    {
                        <tr @key="row.Id">
                            <th scope="row" class="whitespace-nowrap font-semibold">@row.OrderNumber<span class="block text-xs font-normal text-[#8A9089]">@OperationsText.Local(row.PlacedAt)</span></th>
                            <td>@(row.CustomerName ?? "—")</td>
                            <td>@OperationsText.Label(row.FulfillmentType)</td>
                            <td class="text-right whitespace-nowrap">@OperationsText.Money(row.TotalAmount)</td>
                            <td><span class="@OperationsText.Badge(row.Status)">@OperationsText.Label(row.Status)</span></td>
                            <td><button type="button" class="@Ui.Button" disabled="@Busy" @onclick="() => Select(row)">@(row.Status is "Completed" or "Cancelled" ? "Xem" : "Xử lý")</button></td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
        <Pager Page="list.Page" PageSize="list.PageSize" TotalCount="list.TotalCount" Noun="đơn" AriaLabel="Phân trang đơn hàng" Disabled="Busy" OnPage="LoadAsync" />
    }
    else
    {
        <p role="status" class="p-5 text-sm text-[#69706A]">Không có đơn hàng phù hợp.</p>
    }
</section>

@code {
    private const int PageSize = 20;
    private readonly CancellationTokenSource _lifetime = new();
    private PagedResponse<SupplementOrderResponse>? _page;
    private SupplementOrderResponse? _selected;
    private string _search = "", _status = "", _type = "", _courier = "", _tracking = "";
    private DateOnly? _from, _to;
    private string? _notice, _error;
    private bool _loading, _working;
    private bool Busy => _loading || _working;

    protected override Task OnInitializedAsync() => LoadAsync(1);

    private static string? Blank(string value) => string.IsNullOrWhiteSpace(value) ? null : value.Trim();

    private async Task LoadAsync(int page)
    {
        if (_from > _to)
        {
            _error = "Ngày bắt đầu không được sau ngày kết thúc.";
            return;
        }
        _loading = true;
        _error = null;
        try { _page = await Api.GetOrdersAsync(new(Blank(_status), _from, _to, Blank(_type), Blank(_search), page, PageSize), mine: false, _lifetime.Token); }
        catch (AuthApiException error) { _error = error.Message; }
        catch (OperationCanceledException) when (_lifetime.IsCancellationRequested) { }
        finally { _loading = false; }
    }

    private void Select(SupplementOrderResponse order)
    {
        _selected = order;
        _courier = _tracking = "";
        _notice = _error = null;
    }

    private async Task ActAsync(SupplementOrderResponse order, string action)
    {
        if (Busy) return;
        SupplementOutForDeliveryRequest? delivery = null;
        if (action == "out-for-delivery")
        {
            if (string.IsNullOrWhiteSpace(_courier) || string.IsNullOrWhiteSpace(_tracking))
            {
                _error = "Cần nhập đơn vị vận chuyển và mã vận đơn.";
                return;
            }
            delivery = new(_courier.Trim(), _tracking.Trim());
        }
        _working = true;
        _notice = _error = null;
        try
        {
            var saved = await Api.OrderActionAsync(order.Id, action, delivery, _lifetime.Token);
            _notice = $"Đơn {saved.OrderNumber}: {OperationsText.Label(saved.Status)}.";
            _selected = saved.Status is "Completed" or "Cancelled" ? null : saved;
            await LoadAsync(_page?.Page ?? 1);
        }
        catch (AuthApiException error)
        {
            _error = error.Message;
            if (error.ErrorCode == "SUPPLEMENT_ORDER_CANCELLED") await LoadAsync(_page?.Page ?? 1);
        }
        catch (OperationCanceledException) when (_lifetime.IsCancellationRequested) { }
        finally { _working = false; }
    }

    public void Dispose()
    {
        _lifetime.Cancel();
        _lifetime.Dispose();
    }
}
