                    <div class="font-body text-xs text-neutral-400 uppercase tracking-wider mt-1">HLV Chuyên Nghiệp</div>
                </div>
            </div>

        </div>

        <!-- Scroll Down Indicator -->
        <div class="absolute bottom-6 left-1/2 transform -translate-x-1/2 z-10 flex flex-col items-center">
            <span class="font-heading text-[10px] tracking-widest text-neutral-400 uppercase mb-2">CUỘN XUỐNG</span>
            <div class="w-px h-8 bg-neutral-500 animate-pulse"></div>
        </div>

    </section>

    <!-- ========================================================================= -->
    <!-- 2. FEATURED CLASSES SECTION (Nền trắng, ảnh khổ lớn theo ảnh tham chiếu)  -->
    <!-- ========================================================================= -->
    <section id="featured-classes" class="w-full bg-[#FFFFFF] text-[#252525] pt-16 sm:pt-20 pb-28 border-b border-[#CFCFCF]">
        
        <!-- ===================================================================== -->
