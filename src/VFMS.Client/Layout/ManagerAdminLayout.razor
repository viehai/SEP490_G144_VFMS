@inherits LayoutComponentBase
@inject NavigationManager Navigation

<WorkspaceShell Variant="@Variant" IsPreview="@IsPreview">@Body</WorkspaceShell>

@code {
    private string Variant => Navigation.ToBaseRelativePath(Navigation.Uri).StartsWith("admin/", StringComparison.OrdinalIgnoreCase) ? "admin" : "manager";
    private bool IsPreview
    {
        get
        {
            var route = Navigation.ToBaseRelativePath(Navigation.Uri).Split('?', '#')[0].TrimEnd('/');
            return !route.Equals("manager/membership-plans", StringComparison.OrdinalIgnoreCase) &&
                !route.Equals("manager/membership-freeze-policy", StringComparison.OrdinalIgnoreCase);
        }
    }
}
