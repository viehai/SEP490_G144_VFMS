@page "/admin/banned-words"
@layout ManagerAdminLayout
@using Microsoft.AspNetCore.Authorization
@using VFMS.Contracts.Common
@using VFMS.Contracts.SystemAdministration
@using VFMS.Contracts.SystemAdministration.Validators
@attribute [Authorize(Roles = "Admin")]
@inject SystemAdministrationApiClient Api
@implements IDisposable

<PageTitle>Từ khóa cấm | Victor Fitness</PageTitle>

<div class="workspace-page space-y-6">
    <header class="border-b-2 border-black pb-6">
        <p class="workspace-heading mb-3 text-[10px] tracking-[.18em] text-[#71717A]">VFMS / CONTENT MODERATION</p>
        <h1 class="workspace-heading text-3xl tracking-tight sm:text-4xl">Từ khóa cấm<span class="text-[#FF3E3E]">.</span></h1>
        <p class="mt-3 text-sm text-[#545454]">Danh sách từ ngữ bị chặn trong đánh giá và phản hồi của người dùng.</p>
    </header>

    @if (_notice is not null)
    {
        <p role="status" class="border border-emerald-600 bg-emerald-50 p-4 text-sm text-emerald-900">@_notice</p>
    }
    @if (_error is not null)
    {
        <p role="alert" class="border border-red-600 bg-red-50 p-4 text-sm text-red-900">@_error</p>
    }

    <section class="border-2 border-black bg-white p-5 sm:p-6" aria-labelledby="word-form-title">
        <h2 id="word-form-title" class="workspace-heading text-base">@(_editingId is null ? "Thêm từ khóa" : "Sửa từ khóa")</h2>
        <EditForm Model="_form" OnValidSubmit="SaveAsync" class="mt-4" novalidate>
            <ContractValidation TRequest="BannedWordRequest" Validator="_validator" CreateRequest="CreateRequest" @ref="_validation" />
            <ValidationSummary />
            <fieldset disabled="@_working" class="mt-4 flex flex-wrap items-end gap-3">
                <label class="min-w-[240px] flex-1 text-sm font-semibold" for="word-input">
                    Từ khóa
                    <InputText id="word-input" class="@Field" @bind-Value="_form.Word" maxlength="100" required />
                </label>
                <button type="submit" class="@PrimaryButton">@(_editingId is null ? "Thêm" : "Lưu")</button>
                @if (_editingId is not null)
                {
                    <button type="button" class="@Button" @onclick="CancelEdit">Hủy</button>
                }
            </fieldset>
        </EditForm>
    </section>

    <section class="border-2 border-black bg-white" aria-labelledby="word-list-title" aria-busy="@(_loading || _working)">
        <div class="border-b border-black p-5">
            <h2 id="word-list-title" class="workspace-heading mb-3 text-sm">Danh sách</h2>
            <form @onsubmit="() => LoadAsync(1)" @onsubmit:preventDefault>
                <fieldset disabled="@ListDisabled" class="flex flex-wrap items-end gap-3">
                    <label class="w-full text-sm font-semibold sm:w-64" for="word-search">
                        Tìm kiếm
                        <input id="word-search" type="search" @bind="_search" class="@Field" maxlength="100" />
                    </label>
                    <label class="text-sm font-semibold" for="word-status">
                        Trạng thái
                        <select id="word-status" @bind="_status" class="@Field">
                            <option value="">Tất cả</option>
                            <option value="true">Đang chặn</option>
                            <option value="false">Đã tắt</option>
                        </select>
                    </label>
                    <button type="submit" class="@Button">Áp dụng</button>
                </fieldset>
            </form>
        </div>
        @if (_loading)
        {
            <p role="status" class="p-5 text-sm">Đang tải danh sách từ khóa...</p>
        }
        else if (_page is { Items.Count: > 0 } list)
        {
            <div class="overflow-x-auto">
                <table class="workspace-table min-w-[680px]">
                    <thead>
                        <tr><th scope="col">Từ khóa</th><th scope="col">Trạng thái</th><th scope="col">Người tạo</th><th scope="col">Ngày tạo</th><th scope="col">Thao tác</th></tr>
                    </thead>
                    <tbody>
                        @foreach (var row in list.Items)
                        {
                            <tr @key="row.Id">
                                <th scope="row" class="max-w-56 break-words">@row.Word</th>
                                <td><span class="inline-block whitespace-nowrap border px-2 py-1 text-[10px] font-bold uppercase @(row.IsActive ? "border-red-600 bg-red-50 text-red-800" : "border-zinc-500 bg-zinc-100 text-zinc-700")">@(row.IsActive ? "Đang chặn" : "Đã tắt")</span></td>
                                <td>@(row.CreatedByName ?? "—")</td>
                                <td class="whitespace-nowrap">@row.CreatedAt.ToLocalTime().ToString("dd/MM/yyyy")</td>
                                <td>
                                    <div class="flex flex-wrap gap-2">
                                        <button type="button" class="@Button" disabled="@ListDisabled" aria-label="Sửa @row.Word" @onclick="() => StartEdit(row)">Sửa</button>
                                        <button type="button" class="@Button" disabled="@ListDisabled" @onclick="() => ToggleAsync(row)">@(row.IsActive ? "Tắt" : "Bật")</button>
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
            <nav aria-label="Phân trang từ khóa" class="flex flex-wrap items-center justify-between gap-3 border-t border-black p-4 text-sm">
                <p>Trang @list.Page / @PageCount(list) · @list.TotalCount từ khóa</p>
                <div class="flex gap-2">
                    <button type="button" class="@Button" disabled="@(ListDisabled || list.Page <= 1)" @onclick="() => LoadAsync(list.Page - 1)">Trang trước</button>
                    <button type="button" class="@Button" disabled="@(ListDisabled || list.Page >= PageCount(list))" @onclick="() => LoadAsync(list.Page + 1)">Trang sau</button>
                </div>
            </nav>
        }
        else
        {
            <p role="status" class="p-5 text-sm text-[#545454]">Không tìm thấy từ khóa phù hợp.</p>
        }
    </section>
</div>

@code {
    private const int PageSize = 20;
    private const string Field = "mt-1 block w-full border border-[#71717A] bg-white px-3 py-2 text-sm font-normal";
    private const string Button = "border border-black bg-white px-3 py-2 text-xs font-bold hover:bg-[#F7F7F7]";
    private const string PrimaryButton = "border border-black bg-black px-4 py-2.5 text-sm font-bold text-white hover:bg-[#27272A]";

    private readonly CancellationTokenSource _lifetime = new();
    private readonly WordModel _form = new();
    private readonly BannedWordRequestValidator _validator = new();
    private ContractValidation<BannedWordRequest>? _validation;
    private PagedResponse<BannedWordResponse>? _page;
    private int? _editingId;
    private string _search = string.Empty, _status = string.Empty;
    private string? _notice, _error;
    private bool _loading, _working;
    private bool ListDisabled => _loading || _working;

    protected override Task OnInitializedAsync() => LoadAsync(1);

    private BannedWordRequest CreateRequest() => new(_form.Word.Trim());

    private async Task LoadAsync(int page)
    {
        _loading = true;
        try
        {
            bool? isActive = _status switch { "true" => true, "false" => false, _ => null };
            _page = await Api.GetBannedWordsAsync(new(_search, isActive, page, PageSize), _lifetime.Token);
        }
        catch (AuthApiException error) { _error = error.Message; }
        catch (OperationCanceledException) when (_lifetime.IsCancellationRequested) { }
        finally { _loading = false; }
    }

    private Task SaveAsync() => RunActionAsync(async () =>
    {
        var saved = _editingId is { } id
            ? await Api.UpdateBannedWordAsync(id, CreateRequest(), _lifetime.Token)
            : await Api.CreateBannedWordAsync(CreateRequest(), _lifetime.Token);
        _notice = _editingId is null ? $"Đã thêm từ khóa \"{saved.Word}\"." : $"Đã cập nhật từ khóa \"{saved.Word}\".";
        CancelEdit();
        await LoadAsync(_page?.Page ?? 1);
    });

    private Task ToggleAsync(BannedWordResponse word) => RunActionAsync(async () =>
    {
        var saved = await Api.SetBannedWordActiveAsync(word.Id, !word.IsActive, _lifetime.Token);
        _notice = saved.IsActive ? $"Đã bật chặn \"{saved.Word}\"." : $"Đã tắt chặn \"{saved.Word}\".";
        await LoadAsync(_page?.Page ?? 1);
    });

    private async Task RunActionAsync(Func<Task> action)
    {
        if (_working || _loading) return;
        _working = true;
        _notice = _error = null;
        try { await action(); }
        catch (AuthApiException error)
        {
            _error = error.Message;
            _validation?.ShowErrors(error.Errors);
        }
        catch (OperationCanceledException) when (_lifetime.IsCancellationRequested) { }
        finally { _working = false; }
    }

    private void StartEdit(BannedWordResponse word)
    {
        _editingId = word.Id;
        _form.Word = word.Word;
    }

    private void CancelEdit()
    {
        _editingId = null;
        _form.Word = string.Empty;
    }

    private static int PageCount(PagedResponse<BannedWordResponse> page) => Math.Max(1, (int)Math.Ceiling((double)page.TotalCount / page.PageSize));

    public void Dispose()
    {
        _lifetime.Cancel();
        _lifetime.Dispose();
    }

    private sealed class WordModel
    {
        public string Word { get; set; } = string.Empty;
    }
}
