@page "/manager/membership-plans"
@layout ManagerAdminLayout
@using Microsoft.AspNetCore.Authorization
@using System.Globalization
@using VFMS.Contracts.Common
@using VFMS.Contracts.Memberships
@using VFMS.Contracts.Memberships.Validators
@attribute [Authorize(Roles = "Manager")]
@inject MembershipPlanApiClient Api
@inject IJSRuntime JS
@implements IDisposable

<PageTitle>Quản lý gói hội viên | Victor Fitness</PageTitle>

<div class="workspace-page space-y-6">
    <header class="flex flex-wrap items-end justify-between gap-4 border-b border-[#D8DED2] pb-6">
        <div>
            <p class="mb-2 text-xs font-bold tracking-wider text-[#5F6F52]">VFMS / MEMBERSHIPS</p>
            <h1 class="text-3xl font-extrabold tracking-tight text-[#383E43] sm:text-4xl">Quản lý gói hội viên<span class="text-[#5F6F52]">.</span></h1>
            <p class="mt-2 text-sm text-[#69706A]">Quản lý thông tin gói tập, trạng thái mở bán và số lượt đăng ký đang hoạt động.</p>
        </div>
        <button type="button" class="@PrimaryButton" disabled="@ListDisabled" @onclick="OpenCreate">Thêm gói mới</button>
    </header>

    @if (_notice is not null)
    {
        <p role="status" class="rounded-xl border p-4 text-sm @(_noticeIsWarning ? "border-amber-300 bg-amber-50 text-amber-900" : "border-emerald-300 bg-emerald-50 text-emerald-900")">@_notice</p>
    }
    @if (_actionError is not null)
    {
        <p role="alert" class="rounded-xl border border-red-300 bg-red-50 p-4 text-sm text-red-900">@_actionError</p>
    }

    @if (_form is { } form)
    {
        <section class="rounded-xl border border-[#D8DED2] bg-white p-5 sm:p-6 shadow-sm" aria-labelledby="membership-plan-editor">
            <h2 id="membership-plan-editor" class="text-base font-bold text-[#383E43] border-b border-[#D8DED2] pb-3" tabindex="-1" @ref="_panelHeading">@(_selected is null ? "Thêm gói hội viên" : "Chỉnh sửa gói hội viên")</h2>
            <EditForm @key="form" Model="form" OnValidSubmit="SaveAsync" class="mt-4" novalidate>
                <ContractValidation TRequest="MembershipPlanRequest" Validator="_validator" CreateRequest="CreateRequest" @ref="_validation" />
                <ValidationSummary />
                <fieldset disabled="@_working" class="mt-4 grid gap-4 sm:grid-cols-2">
                    <label class="text-sm font-semibold text-[#383E43]" for="plan-name">
                        Tên gói
                        <InputText id="plan-name" class="@Field" @bind-Value="form.Name" maxlength="256" required />
                    </label>
                    <label class="text-sm font-semibold text-[#383E43]" for="plan-status">
                        Trạng thái
                        <InputSelect id="plan-status" class="@Field" @bind-Value="form.Status">
                            <option value="@Active">Đang mở bán</option>
                            <option value="@Inactive">Ngừng bán</option>
                        </InputSelect>
                    </label>
                    <label class="text-sm font-semibold text-[#383E43]" for="plan-duration">
                        Thời hạn (ngày)
                        <InputNumber id="plan-duration" class="@Field" @bind-Value="form.DurationInDays" min="1" step="1" required ParsingErrorMessage="Thời hạn phải là số ngày nguyên."
                                     aria-describedby="@(_selected is { DurationInMonths: > 0, DurationInDays: not null } ? "plan-duration-hint" : null)" />
                        @if (_selected is { DurationInMonths: > 0, DurationInDays: not null } legacy)
                        {
                            <span id="plan-duration-hint" class="mt-1 block text-xs font-normal text-[#69706A]">Số ngày được quy đổi từ @legacy.DurationInMonths tháng. Hệ thống giữ kỳ hạn theo tháng nếu bạn giữ nguyên số ngày này.</span>
                        }
                    </label>
                    <label class="text-sm font-semibold text-[#383E43]" for="plan-price">
                        Giá (₫)
                        <InputNumber id="plan-price" class="@Field" @bind-Value="form.Price" min="0" step="0.01" required ParsingErrorMessage="Giá phải là một số hợp lệ." />
                    </label>
                    <label class="text-sm font-semibold text-[#383E43] sm:col-span-2" for="plan-description">
                        Mô tả
                        <InputTextArea id="plan-description" class="@Field" @bind-Value="form.Description" rows="3" maxlength="4000" />
                    </label>
                    <div class="flex flex-wrap gap-3 sm:col-span-2 pt-2">
                        <button type="submit" class="@PrimaryButton">@(_working ? "Đang lưu..." : "Lưu gói hội viên")</button>
                        <button type="button" class="@Button" @onclick="ClosePanel">Hủy</button>
                    </div>
                </fieldset>
            </EditForm>
        </section>
    }
    else if (_selected is { } plan)
    {
        <section class="rounded-xl border border-[#D8DED2] bg-white p-5 sm:p-6 shadow-sm" aria-labelledby="membership-plan-details">
            <h2 id="membership-plan-details" class="break-words text-base font-bold text-[#383E43] border-b border-[#D8DED2] pb-3" tabindex="-1" @ref="_panelHeading">@plan.Name</h2>
            <dl class="mt-4 grid gap-4 text-sm sm:grid-cols-2">
                <div><dt class="font-semibold text-[#69706A]">Thời hạn</dt><dd class="font-bold text-[#383E43]">@Duration(plan)</dd></div>
                <div><dt class="font-semibold text-[#69706A]">Giá</dt><dd class="font-bold text-[#5F6F52]">@Money(plan.Price)</dd></div>
                <div><dt class="font-semibold text-[#69706A]">Trạng thái</dt><dd class="font-semibold text-[#383E43]">@StatusLabel(plan.Status)</dd></div>
                <div><dt class="font-semibold text-[#69706A]">Lượt đăng ký đang hoạt động</dt><dd class="font-bold text-[#383E43]">@plan.SubscriberCount</dd></div>
                <div class="sm:col-span-2"><dt class="font-semibold text-[#69706A]">Mô tả</dt><dd class="whitespace-pre-wrap break-words text-[#383E43]">@(plan.Description ?? "—")</dd></div>
            </dl>
            <div class="mt-5 flex flex-wrap gap-3 pt-2">
                <button type="button" class="@PrimaryButton" @onclick="OpenEdit">Chỉnh sửa</button>
                <button type="button" class="@Button" @onclick="ClosePanel">Đóng chi tiết</button>
            </div>
        </section>
    }

    <section class="rounded-xl border border-[#D8DED2] bg-white shadow-sm overflow-hidden" aria-labelledby="membership-plan-list" aria-busy="@(_loading || _working)">
        <div class="border-b border-[#D8DED2] p-5 bg-[#EEF1EA]/40">
            <h2 id="membership-plan-list" class="mb-3 text-sm font-bold text-[#383E43]">Danh mục gói hội viên</h2>
            <form @onsubmit="ApplyFiltersAsync" @onsubmit:preventDefault>
                <fieldset disabled="@ListDisabled" class="flex flex-wrap items-end gap-3">
                    <label class="w-full text-xs font-semibold text-[#383E43] sm:w-64" for="plan-search">
                        Tìm theo tên
                        <input id="plan-search" type="search" @bind="_searchInput" class="@Field" maxlength="256" />
                    </label>
                    <label class="text-xs font-semibold text-[#383E43]" for="plan-filter-status">
                        Trạng thái
                        <select id="plan-filter-status" @bind="_statusInput" class="@Field">
                            <option value="">Tất cả</option>
                            <option value="@Active">Đang mở bán</option>
                            <option value="@Inactive">Ngừng bán</option>
                        </select>
                    </label>
                    <button type="submit" class="@Button">Áp dụng</button>
                </fieldset>
            </form>
        </div>

        @if (_loading)
        {
            <div class="flex items-center gap-3 p-6 text-sm text-[#69706A]" role="status">
                <svg class="h-5 w-5 animate-spin text-[#5F6F52]" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24"><circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"></circle><path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8v8H4z"></path></svg>
                Đang tải danh sách gói hội viên...
            </div>
        }
        else if (_listError is not null)
        {
            <div class="space-y-3 p-5 text-sm">
                <p role="alert" class="text-red-800">@_listError</p>
                <button type="button" class="@Button" disabled="@ListDisabled" @onclick="LoadPlansAsync">Tải lại</button>
            </div>
        }
        else if (_list is { Items.Count: > 0 } list)
        {
            <div class="overflow-x-auto">
                <table class="workspace-table min-w-[780px]">
                    <thead>
                        <tr><th scope="col">Tên gói</th><th scope="col">Thời hạn</th><th scope="col">Giá</th><th scope="col">Lượt đăng ký</th><th scope="col">Trạng thái</th><th scope="col">Thao tác</th></tr>
                    </thead>
                    <tbody>
                        @foreach (var row in list.Items)
                        {
                            <tr @key="row.Id">
                                <th scope="row" class="max-w-56 break-words">@row.Name</th>
                                <td>@Duration(row)</td>
                                <td class="whitespace-nowrap font-semibold text-[#5F6F52]">@Money(row.Price)</td>
                                <td>@row.SubscriberCount</td>
                                <td><span class="inline-block whitespace-nowrap rounded-md border px-2.5 py-1 text-[11px] font-semibold @(IsActive(row.Status) ? "border-emerald-200 bg-emerald-50 text-emerald-800" : "border-[#D8DED2] bg-[#EEF1EA] text-[#69706A]")">@StatusLabel(row.Status)</span></td>
                                <td>
                                    <div class="flex flex-wrap gap-2">
                                        <button type="button" class="@Button" disabled="@ListDisabled" aria-label="Xem hoặc sửa @row.Name" @onclick="() => OpenDetailsAsync(row.Id)">Xem / Sửa</button>
                                        <button type="button" class="@Button" disabled="@ListDisabled" @onclick="() => ChangeStatusAsync(row)">@(IsActive(row.Status) ? "Ngừng bán" : "Mở bán")</button>
                                        <button type="button" class="@Button text-red-700 hover:bg-red-50" disabled="@ListDisabled" aria-label="Xóa @row.Name" @onclick="() => DeleteAsync(row)">Xóa</button>
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
            <nav aria-label="Phân trang gói hội viên" class="flex flex-wrap items-center justify-between gap-3 border-t border-[#D8DED2] p-4 text-xs font-medium text-[#69706A]">
                <p>Trang @list.Page / @PageCount(list) · @list.TotalCount gói</p>
                <div class="flex gap-2">
                    <button type="button" class="@Button" disabled="@(ListDisabled || list.Page <= 1)" @onclick="() => ChangePageAsync(list.Page - 1)">Trang trước</button>
                    <button type="button" class="@Button" disabled="@(ListDisabled || list.Page >= PageCount(list))" @onclick="() => ChangePageAsync(list.Page + 1)">Trang sau</button>
                </div>
            </nav>
        }
        else
        {
            <p role="status" class="p-6 text-sm text-[#69706A]">Không tìm thấy gói hội viên phù hợp.</p>
        }
    </section>
</div>

@code {
    private const string Active = MembershipPlanStatuses.Active;
    private const string Inactive = MembershipPlanStatuses.Inactive;
    private const string Field = "mt-1 block w-full rounded-lg border border-[#D8DED2] bg-white px-3 py-2 text-sm font-normal text-[#383E43] focus:border-[#5F6F52] focus:ring-2 focus:ring-[#5F6F52]/20 outline-none";
    private const string Button = "rounded-lg border border-[#D8DED2] bg-white px-3 py-1.5 text-xs font-semibold text-[#383E43] hover:bg-[#EEF1EA] transition";
    private const string PrimaryButton = "rounded-lg bg-[#5F6F52] px-4 py-2 text-sm font-semibold text-white hover:bg-[#4E5D44] transition shadow-sm";
    private static readonly NumberFormatInfo CurrencyFormat = new() { NumberGroupSeparator = ".", NumberDecimalSeparator = "," };

    private readonly CancellationTokenSource _lifetime = new();
    private readonly MembershipPlanRequestValidator _validator = new();
    private readonly MembershipPlanListRequest _query = new();
    private PagedResponse<MembershipPlanResponse>? _list;
    private MembershipPlanResponse? _selected;
    private MembershipPlanRequest? _form;
    private ContractValidation<MembershipPlanRequest>? _validation;
    private ElementReference _panelHeading;
    private string _searchInput = string.Empty;
    private string _statusInput = string.Empty;
    private string? _actionError;
    private string? _listError;
    private string? _notice;
    private bool _noticeIsWarning;
    private bool _loading;
    private bool _working;
    private bool _focusPanel;
    private bool ListDisabled => _loading || _working || _form is not null || _selected is not null;

    protected override Task OnInitializedAsync() => LoadPlansAsync();

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!_focusPanel) return;
        _focusPanel = false;
        await _panelHeading.FocusAsync();
    }

    private async Task LoadPlansAsync()
    {
        _loading = true;
        _listError = null;
        try
        {
            var page = await Api.ListAsync(_query, _lifetime.Token);
            if (_query.Page > PageCount(page))
            {
                _query.Page = PageCount(page);
                page = await Api.ListAsync(_query, _lifetime.Token);
            }
            _list = page;
        }
        catch (AuthApiException error) { _listError = error.Message; }
        catch (OperationCanceledException) when (_lifetime.IsCancellationRequested) { }
        finally { _loading = false; }
    }

    private Task ApplyFiltersAsync()
    {
        if (ListDisabled) return Task.CompletedTask;
        _query.Search = _searchInput.Trim();
        _query.Status = _statusInput;
        return ChangePageAsync(1);
    }

    private Task ChangePageAsync(int page)
    {
        _query.Page = page;
        return LoadPlansAsync();
    }

    private void OpenCreate()
    {
        _actionError = _notice = null;
        _form = new() { Status = Active };
        _focusPanel = true;
    }

    private Task OpenDetailsAsync(int id) => RunActionAsync(async () =>
    {
        _selected = await Api.GetAsync(id, _lifetime.Token);
        _focusPanel = true;
    });

    private void OpenEdit()
    {
        if (_selected is not { } plan) return;
        _form = new()
        {
            Name = plan.Name,
            Description = plan.Description,
            DurationInDays = plan.DurationInDays,
            Price = plan.Price,
            Status = IsActive(plan.Status) ? Active : Inactive
        };
        _focusPanel = true;
    }

    private MembershipPlanRequest CreateRequest() => _form!;

    private Task SaveAsync() => RunActionAsync(async () =>
    {
        var request = CreateRequest();
        if (_selected is { } plan)
        {
            await Api.UpdateAsync(plan.Id, request, _lifetime.Token);
            _notice = "Đã cập nhật gói hội viên.";
        }
        else
        {
            await Api.CreateAsync(request, _lifetime.Token);
            _notice = "Đã tạo gói hội viên mới.";
        }
        ClosePanel();
        await LoadPlansAsync();
    });

    private Task ChangeStatusAsync(MembershipPlanResponse plan) => RunActionAsync(async () =>
    {
        var status = IsActive(plan.Status) ? Inactive : Active;
        var updated = await Api.ChangeStatusAsync(plan.Id, status, _lifetime.Token);
        _notice = IsActive(updated.Status) ? "Đã mở bán gói hội viên." : "Đã ngừng bán gói hội viên.";
        await LoadPlansAsync();
    });

    private Task DeleteAsync(MembershipPlanResponse plan) => RunActionAsync(async () =>
    {
        var confirmed = await JS.InvokeAsync<bool>("confirm", _lifetime.Token,
            $"Xóa gói hội viên “{plan.Name}”? Hệ thống sẽ kiểm tra lịch sử bán và lượt đăng ký trước khi xóa.");
        if (!confirmed) return;
        var result = await Api.DeleteAsync(plan.Id, _lifetime.Token);
        _notice = result.Message;
        _noticeIsWarning = result.Deactivated;
        await LoadPlansAsync();
    });

    private async Task RunActionAsync(Func<Task> action)
    {
        if (_working || _loading) return;
        _working = true;
        _actionError = _notice = null;
        _noticeIsWarning = false;
        try { await action(); }
        catch (AuthApiException error)
        {
            _actionError = error.Message;
            _validation?.ShowErrors(error.Errors);
        }
        catch (OperationCanceledException) when (_lifetime.IsCancellationRequested) { }
        finally { _working = false; }
    }

    private void ClosePanel()
    {
        _form = null;
        _selected = null;
        _validation = null;
        _actionError = null;
    }

    private static int PageCount(PagedResponse<MembershipPlanResponse> page) => Math.Max(1, (int)Math.Ceiling((double)page.TotalCount / page.PageSize));
    private static bool IsActive(string status) => string.Equals(status, Active, StringComparison.OrdinalIgnoreCase);
    private static string StatusLabel(string status) => IsActive(status) ? "Đang mở bán" : "Ngừng bán";
    private static string Money(decimal value) => $"{value.ToString("#,##0.##", CurrencyFormat)} ₫";
    private static string Duration(MembershipPlanResponse plan) => plan.DurationInMonths is > 0 ? $"{plan.DurationInMonths} tháng"
        : plan.DurationInDays is { } days ? $"{days} ngày" : "—";

    public void Dispose()
    {
        _lifetime.Cancel();
        _lifetime.Dispose();
    }
}
