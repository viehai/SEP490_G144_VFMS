@inject PersonalTrainingApiClient Api
@inject ToastService Toasts
@using VFMS.Contracts.Trainers
@using VFMS.Client.Components.Operations

<section class="trainer-panel trainer-stack">
    <header class="trainer-row trainer-between">
        <div><h2>@(Contract.PackageName ?? $"Hợp đồng #{Contract.Id}")</h2><p class="trainer-muted">@TrainerName · @Date(Contract.StartDate) đến @Date(Contract.EndDate)</p></div>
        <TrainerStatus Status="@Contract.Status" />
    </header>
    <div class="pt-metrics">
        <div><span>Tổng số buổi</span><strong>@Contract.TotalCredits</strong></div>
        <div><span>Đã dùng</span><strong>@Contract.UsedCredits</strong></div>
        @if (Contract.Status == "Expired")
        {
            <div><span>Buổi hết hiệu lực</span><strong>@Contract.RemainingCredits</strong></div>
        }
        else
        {
            <div><span>Đã phân bổ</span><strong>@Contract.ReservedCredits</strong></div>
            <div><span>Chưa phân bổ</span><strong>@Contract.AvailableCredits</strong></div>
            <div><span>Còn lại</span><strong>@Contract.RemainingCredits</strong></div>
        }
    </div>
    @if (Contract.MakeUpDeadline is { } makeUpDeadline)
    {
        <p class="trainer-muted">@(Contract.MakeUpUnits > 0
            ? $"Có {Contract.MakeUpUnits} lượt tập bù, dùng được đến {Date(makeUpDeadline)}. Chọn buổi có nhãn \"Lượt bù\" để đặt lịch."
            : $"Có lượt tập bù đang chờ PT phản hồi, dùng được đến {Date(makeUpDeadline)}.")</p>
    }
    <p class="trainer-muted">
        Bảo lưu: @(Contract.FreezeUsed ? "đã dùng lượt bảo lưu" : Contract.HasPendingOrApprovedFreeze ? "đang chờ duyệt" : $"còn dùng được (tối đa {Contract.FreezeMaxTotalDays} ngày)")
    </p>
    @if (!IsTrainer && Contract.TrainerChangeDeadline is { } changeDeadline)
    {
        <div class="trainer-feedback trainer-row trainer-between" role="status">
            <span>Huấn luyện viên đã ngừng nhận học viên mới. Bạn có thể chọn huấn luyện viên khác đến @LocalTime(changeDeadline).</span>
            <a class="trainer-button trainer-primary" href="@($"/my-pt-packages/{Contract.Id}/change-trainer")">Đổi huấn luyện viên</a>
        </div>
    }
    @if (Contract.Status == "PendingPayment" && !IsTrainer && Contract.OrderNumber is { } orderNumber)
    {
        var canPay = Contract.PaymentExpiresAt > DateTime.UtcNow;
        <div class="trainer-row">
            <p class="trainer-muted">@(canPay ? "Lịch đang được giữ trong khi chờ thanh toán." : "Đã hết thời gian chuyển khoản. Kiểm tra trạng thái của đơn tại trang thanh toán.")</p>
            <a class="trainer-button trainer-primary" href="@($"/pt-checkout/{Uri.EscapeDataString(orderNumber)}")">
                @(canPay ? "Tiếp tục thanh toán" : "Xem trạng thái thanh toán")
            </a>
        </div>
    }

    @if (!IsTrainer && CanOfferReview)
    {
        <div class="trainer-row">
            <button type="button" class="trainer-button trainer-primary" @onclick="() => _reviewOpen = true">Đánh giá huấn luyện viên</button>
        </div>
    }
    else if (!IsTrainer && ReviewNotice is { } reviewNotice)
    {
        <p class="trainer-muted">@reviewNotice</p>
    }
    @* UC 4.10: the 'Rate Your Trainer' modal. *@
    <WorkspaceModal Open="@(_reviewOpen && CanOfferReview)" Eyebrow="VFMS / GÓI PT" Title="Đánh giá huấn luyện viên"
                    OnClose="() => _reviewOpen = false">
        <form class="pt-review-form" @onsubmit="ReviewAsync" @onsubmit:preventDefault>
            <div class="pt-review-trainer">
                <span class="trainer-avatar" aria-hidden="true">@Initials(TrainerName)</span>
                <div>
                    <strong>@(TrainerName ?? "Huấn luyện viên")</strong>
                    <span class="trainer-muted">@(Contract.PackageName ?? $"Hợp đồng #{Contract.Id}")@(Contract.TrainerLevel is { } level ? $" · cấp {level}" : "")</span>
                </div>
            </div>
            <fieldset class="pt-review-rating" disabled="@_busy" @onmouseleave="() => _hoverRating = null">
                <legend>Bạn chấm buổi tập với huấn luyện viên này mấy sao?</legend>
                <div class="pt-review-stars">
                    @for (var i = 1; i <= 5; i++)
                    {
                        var star = i;
                        <button type="button" class="pt-review-star" data-on="@((_hoverRating ?? _rating) >= star ? "true" : "false")"
                                aria-label="@($"{star} sao")" aria-pressed="@(_rating == star ? "true" : "false")"
                                @onmouseenter="() => _hoverRating = star" @onfocus="() => _hoverRating = star"
                                @onclick="() => _rating = star">★</button>
                    }
                </div>
                <span class="pt-review-caption" aria-live="polite">@(_hoverRating ?? _rating)/5 · @RatingLabel(_hoverRating ?? _rating)</span>
            </fieldset>
            <label class="pt-review-comment">Nhận xét
                <textarea class="trainer-input" rows="4" maxlength="500" placeholder="Chia sẻ trải nghiệm: giáo án, cách hướng dẫn, mức độ hỗ trợ…"
                          @bind="_comment" @bind:event="oninput" disabled="@_busy"></textarea>
                <span class="pt-review-count" data-ok="@(CommentLength is 0 or (>= 10 and <= 500) ? "true" : "false")">
                    <span>Tối thiểu 10 ký tự</span><span>@CommentLength/500</span>
                </span>
            </label>
            <BannedWordPreview Text="@_comment" Words="_bannedWords" />
            <p class="pt-review-note">Đánh giá được công khai kèm tên của bạn và không thể sửa hoặc xóa.</p>
            <TrainerFeedback Error="@_error" />
            <div class="pt-review-actions">
                <button type="button" class="trainer-button" disabled="@_busy" @onclick="() => _reviewOpen = false">Hủy</button>
                <button class="trainer-button trainer-primary" disabled="@_busy">Gửi đánh giá</button>
            </div>
        </form>
    </WorkspaceModal>

    <TrainerFeedback Error="@_error" Message="@_message" />
    <button type="button" class="trainer-button" aria-pressed="@_history" disabled="@_busy"
            @onclick="() => SelectHistory(!_history)">@(_history ? "Quay lại lịch tuần" : "Lịch sử buổi tập")</button>
    @if (!IsTrainer && !_history)
    {
        <PTPreviewCalendar Slots="CalendarSlots" StartDate="Contract.StartDate" StartCurrentWeek="true">
            <SlotContent Context="slot">
                @if (slot.TemplateId < 0)
                {
                    @* The slot a pending reschedule would move this session to (negative id = proposal of session -id). *@
                    <div class="pt-calendar-slot pt-teaching-slot pt-proposed-slot">
                        <strong>@(TrainerName ?? "Huấn luyện viên")</strong>
                        <span>@Time(slot.StartTime) – @Time(slot.EndTime)</span>
                        <span class="pt-pills"><span class="pt-status-pill" data-tone="amber">Xin chuyển sang</span></span>
                    </div>
                    return;
                }
                @{ var session = Contract.Sessions.First(s => s.Id == slot.TemplateId); }
                <button type="button" class="pt-calendar-slot pt-teaching-slot pt-slot-choice pt-contract-calendar-slot"
                        aria-pressed="@(_selectedCalendarSession == session.Id)"
                        @onclick="() => SelectCalendarSession(slot)">
                    <strong>@(TrainerName ?? "Huấn luyện viên")</strong>
                    <span>@Time(slot.StartTime) – @Time(slot.EndTime)</span>
                    <span class="pt-pills">
                        @if (session.Proposal is { Type: "Reschedule" }) { <span class="pt-status-pill" data-tone="gray">Buổi ban đầu</span> }
                        <span class="pt-status-pill" data-tone="@StatusTone(session.Status)">@Status(session.Status)</span>
                        @if (session.IsMakeUpUnit) { <span class="pt-status-pill" data-tone="purple">Lượt bù</span> }
                    </span>
                    <span>Chi tiết ca</span>
                </button>
            </SlotContent>
        </PTPreviewCalendar>
        @if (_selectedCalendarSession is null)
        {
            <p class="trainer-muted">Chọn một ca để xem chi tiết và thao tác.</p>
        }
    }
    else if (!Visible.Any()) { <p class="trainer-muted">Chưa có buổi tập trong danh sách này.</p> }
    <div class="trainer-stack">
        @foreach (var item in ListedSessions.Skip((SessionPage - 1) * PageSize).Take(PageSize))
        {
            <article class="pt-session trainer-stack" @key="item.Id">
                <div class="trainer-row trainer-between">
                    <strong>@Day(item.Date.DayOfWeek), @Date(item.Date) · @Time(item.StartTime) – @Time(item.EndTime)</strong>
                    @if (item.IsMakeUpUnit) { <span class="trainer-status trainer-status--success">Lượt bù</span> }
                    else { <TrainerStatus Status="@item.Status" /> }
                </div>
                <p class="trainer-muted">Tính @item.CreditUnits buổi</p>
                @if (item.CompletedByCheckIn) { <p class="trainer-muted">Ghi có mặt nhờ hội viên ghi nhận vào phòng tập.</p> }
                @if (IsTrainer)
                {
                    <div class="trainer-row">
                        <a class="trainer-link" href="@($"/pt/contracts/{Contract.Id}/sessions/{item.Id}")">Mở chi tiết ca học</a>
                        <button type="button" class="trainer-button" aria-expanded="@(_calendarSession == item.Id)"
                                @onclick="() => ToggleCalendarAsync(item)">@(_calendarSession == item.Id ? "Ẩn lịch" : "Xem lịch")</button>
                    </div>
                }
                @if (!string.IsNullOrWhiteSpace(item.Note)) { <p class="trainer-copy">@item.Note</p> }
                @if (item.NoteUpdatedAt is { } noteTime) { <p class="trainer-muted">Ghi chú cập nhật @LocalTime(noteTime)</p> }

                @if (item.Proposal is { } proposal && proposal.ExpiresAt > DateTime.UtcNow)
                {
                    @if (proposal.Type == "Reschedule")
                    {
                        <div class="pt-change">
                            <p><span class="pt-status-pill" data-tone="gray">Buổi ban đầu</span> @Day(item.Date.DayOfWeek), @Date(item.Date) · @Time(item.StartTime) – @Time(item.EndTime)</p>
                            <p><span class="pt-status-pill" data-tone="amber">Buổi xin chuyển sang</span> @Day(proposal.Date.DayOfWeek), @Date(proposal.Date) · @Time(proposal.StartTime) – @Time(proposal.EndTime)</p>
                            <p class="trainer-muted">Hạn phản hồi @LocalTime(proposal.ExpiresAt)</p>
                        </div>
                    }
                    else
                    {
                        <p>@ProposalText(proposal) · Hạn phản hồi @LocalTime(proposal.ExpiresAt)</p>
                    }
                    @if (IDecide(item))
                    {
                        <div class="trainer-row">
                            <button class="trainer-button trainer-primary" disabled="@_busy" @onclick="() => DecideAsync(item, proposal, true)">Chấp nhận</button>
                            <button class="trainer-button" disabled="@_busy" @onclick="() => DecideAsync(item, proposal, false)">Từ chối</button>
                        </div>
                    }
                    else { <p class="trainer-muted">Đang chờ bên kia phản hồi. Lịch hiện tại vẫn được giữ.</p> }
                }

                <div class="trainer-row">
                    @if (Contract.Status == "Active" && item.Status == "Scheduled" && IsFuture(item.Date, item.StartTime))
                    {
                        @if (!CanRequestChange(item))
                        {
                            <span class="trainer-muted">Đổi hoặc hủy buổi cần gửi trước giờ tập ít nhất 12 giờ.</span>
                        }
                        else if (IsTrainer)
                        {
                            <button class="trainer-button" disabled="@_busy" @onclick="() => OpenOptionsAsync(item)">Đề xuất đổi lịch</button>
                            <button class="trainer-button" disabled="@_busy" @onclick="() => CancelAsync(item)">Xin hủy buổi</button>
                        }
                        else
                        {
                            @if (IsReschedulePage)
                            { <button class="trainer-button" disabled="@_busy" @onclick="() => OpenOptionsAsync(item)">Chọn ca mới</button> }
                            else
                            { <a class="trainer-button" href="@($"/my-pt-packages/{Contract.Id}/reschedule?session={item.Id}")">Xin đổi lịch</a> }
                            <button class="trainer-button" disabled="@_busy" @onclick="() => CancelAsync(item)">Xin hủy buổi</button>
                        }
                    }
                    @if (item.IsMakeUpUnit && Contract.Status == "Active")
                    {
                        <button class="trainer-button trainer-primary" disabled="@_busy" @onclick="() => OpenMakeUp(item)">Đặt buổi bù</button>
                    }
                    @if (CanReportAbsence(item))
                    {
                        <button class="trainer-button" disabled="@_busy" @onclick="() => OpenEditor(item, Absence)">Báo PT vắng mặt</button>
                    }
                </div>

                @if (_sessionId == item.Id && _editor == Reschedule)
                {
                    <div class="trainer-stack">
                        <p class="trainer-muted">Lịch cũ vẫn được giữ cho đến khi @(IsTrainer ? "hội viên" : "PT") chấp nhận. Các ca bận chỉ hiển thị thời gian.</p>
                        <p class="trainer-muted">Chọn một ca trong lịch tuần PT đã công bố, trong tuần của buổi tập hoặc tuần kế tiếp. Ca bận hoặc không khả dụng không chọn được.</p>
                        @if (_options is { Length: 0 }) { <p>Không có ca trong khoảng đã chọn.</p> }
                        else
                        {
                            <RescheduleSlotCalendar Options="_options" From="_from" Selected="_requested" Disabled="_busy"
                                                    SelectedChanged="slot => _requested = slot" />
                            @if (_requested is { } chosen)
                            {
                                <p>Ca mới: <strong>@Day(chosen.Date.DayOfWeek), @Date(chosen.Date) · @Time(chosen.StartTime) – @Time(chosen.EndTime)</strong></p>
                            }
                        }
                        <div class="trainer-row">
                            <button class="trainer-button trainer-primary" disabled="@(_busy || _requested is null)" @onclick="SendRescheduleAsync">Gửi yêu cầu</button>
                            <button class="trainer-button" disabled="@_busy" @onclick="CloseEditor">Đóng</button>
                        </div>
                    </div>
                }
                @if (_sessionId == item.Id && _editor == MakeUp)
                {
                    <form class="trainer-stack" @onsubmit="SendMakeUpAsync" @onsubmit:preventDefault>
                        <p class="trainer-muted">Buổi bù dài 60 phút, bắt đầu vào giờ tròn và trước @(Contract.MakeUpDeadline is { } deadline ? Date(deadline) : "hạn tập bù"). @(IsTrainer ? "Hội viên" : "PT") sẽ xác nhận.</p>
                        <fieldset class="trainer-grid" disabled="@_busy">
                            <label>Ngày tập bù<input class="trainer-input" type="date" min="@Today.ToString("yyyy-MM-dd")" @bind="_makeUpDate" /></label>
                            <label>Giờ bắt đầu
                                <select class="trainer-input" @bind="_makeUpHour">
                                    @foreach (var hour in MakeUpHours) { <option value="@hour">@($"{hour:00}:00 – {hour + 1:00}:00")</option> }
                                </select>
                            </label>
                        </fieldset>
                        <div class="trainer-row">
                            <button class="trainer-button trainer-primary" disabled="@_busy">Gửi đề xuất buổi bù</button>
                            <button type="button" class="trainer-button" @onclick="CloseEditor">Đóng</button>
                        </div>
                    </form>
                }
                @if (_sessionId == item.Id && _editor == Absence)
                {
                    <form class="trainer-stack" @onsubmit="SendAbsenceAsync" @onsubmit:preventDefault>
                        <p class="trainer-muted">Nếu PT chưa điểm danh, buổi thành buổi bù; PT có thể phản hồi đến hết ngày hôm sau, sau đó bạn mới đặt lịch buổi bù được. Nếu PT đã điểm danh (có mặt hoặc vắng mặt), Quản lý sẽ xem xét.</p>
                        <label>Ghi chú (không bắt buộc)<textarea class="trainer-input" rows="3" maxlength="1000" @bind="_absenceReason" disabled="@_busy"></textarea></label>
                        <div class="trainer-row"><button class="trainer-button trainer-primary" disabled="@_busy">Gửi báo cáo</button>
                            <button type="button" class="trainer-button" @onclick="CloseEditor">Đóng</button></div>
                    </form>
                }
                @if (item.TrainerAbsenceReportedAt is not null)
                {
                    <p class="trainer-muted">Báo PT vắng mặt: @AbsenceOutcome(item)</p>
                    @if (!string.IsNullOrWhiteSpace(item.TrainerAbsenceReviewNote)) { <p class="trainer-copy">Quản lý: @item.TrainerAbsenceReviewNote</p> }
                }
                @if (_calendarSession == item.Id)
                {
                    @* Original slot and, when a reschedule is pending, the slot it would move to. *@
                    @if (_calendarOptions is { Length: > 0 } all)
                    {
                        <RescheduleSlotCalendar Options="all" From="item.Date" Disabled="true"
                                                Original="OriginalMark(item)" Proposed="ProposedMark(item)" />
                    }
                    else if (_calendarOptions is null && _busy) { <p role="status">Đang tải lịch…</p> }
                    else
                    {
                    <PTPreviewCalendar Slots="SessionCalendar(item)" StartDate="item.Date">
                        <SlotContent Context="slot">
                            @if (slot.TemplateId < 0)
                            {
                                <div class="pt-calendar-slot pt-teaching-slot pt-proposed-slot">
                                    <strong>@Time(slot.StartTime) – @Time(slot.EndTime)</strong>
                                    <span class="pt-pills"><span class="pt-status-pill" data-tone="amber">Buổi xin chuyển sang</span></span>
                                </div>
                            }
                            else
                            {
                                <div class="pt-calendar-slot pt-teaching-slot">
                                    <strong>@Time(slot.StartTime) – @Time(slot.EndTime)</strong>
                                    <span class="pt-pills"><span class="pt-status-pill" data-tone="gray">@(item.Proposal is { Type: "Reschedule" } ? "Buổi ban đầu" : "Buổi tập")</span></span>
                                </div>
                            }
                        </SlotContent>
                    </PTPreviewCalendar>
                    }
                }
            </article>
        }
    </div>
    @if (ListedSessions.Length > PageSize)
    {
        <Pager Page="SessionPage" PageSize="PageSize" TotalCount="ListedSessions.Length" Noun="buổi tập" Disabled="_busy" OnPage="page => _sessionPage = page" />
    }
</section>

@code {
    private const int PageSize = 10;
    private int _sessionPage = 1;
    private int SessionPage => Math.Clamp(_sessionPage, 1, Math.Max(1, (ListedSessions.Length + PageSize - 1) / PageSize));
    private PTSessionResponse[] ListedSessions => Visible.Where(item => IsTrainer || _history || item.Id == _selectedCalendarSession)
        .OrderBy(item => item.Date).ThenBy(item => item.StartTime).ThenBy(item => item.Id).ToArray();
    [Parameter, EditorRequired] public PTContractResponse Contract { get; set; } = default!;
    [Parameter] public bool IsTrainer { get; set; }
    [Parameter] public string? TrainerName { get; set; }
    [Parameter] public EventCallback Changed { get; set; }
    [Parameter] public bool IsReschedulePage { get; set; }
    [Parameter] public int? InitialSessionId { get; set; }
    /// <summary>UC 4.10: open the review modal at once (the contract was opened from 'Completed Contracts').</summary>
    [Parameter] public bool OpenReview { get; set; }
    private const string Reschedule = "reschedule", MakeUp = "makeup", Absence = "absence";
    private PTRescheduleSlot[] _options = [];
    private PTRescheduleSlot? _requested;
    private DateOnly _from = Today, _makeUpDate = Today.AddDays(1);
    private int _makeUpHour = 9;
    private int? _sessionId, _selectedCalendarSession, _calendarSession;
    private PTRescheduleSlot[]? _calendarOptions;
    private static bool CanLoadOptions(PTSessionResponse item) =>
        item.Status is "Scheduled" or "ReschedulePending" or "RescheduleRequested" && IsFuture(item.Date, item.StartTime);
    private static (DateOnly, TimeOnly)? OriginalMark(PTSessionResponse item) => (item.Date, item.StartTime);
    private static (DateOnly, TimeOnly)? ProposedMark(PTSessionResponse item) =>
        item.Proposal is { Type: "Reschedule" } p ? (p.Date, p.StartTime) : null;

    // "Xem lịch": the trainer's whole week table (free, busy and unusable slots) with this session's slots marked.
    private async Task ToggleCalendarAsync(PTSessionResponse item)
    {
        if (_calendarSession == item.Id) { _calendarSession = null; return; }
        _calendarSession = item.Id;
        _calendarOptions = null;
        if (CanLoadOptions(item))
            await RunAsync(async () => _calendarOptions = await Api.RescheduleOptionsAsync(item.Id, item.Date));
    }

    private static PTCalendarSlot[] SessionCalendar(PTSessionResponse item) =>
        [new(item.Id, item.Date, item.StartTime, item.EndTime, item.Status),
            .. item.Proposal is { Type: "Reschedule" } p ? new[] { new PTCalendarSlot(-item.Id, p.Date, p.StartTime, p.EndTime, "Proposed") } : []];
    private string? _editor, _error, _message;
    private string _comment = "", _absenceReason = "";
    private IReadOnlyList<string> _bannedWords = [];
    private int _rating = 5;
    private int? _hoverRating;
    private int CommentLength => _comment.Trim().Length;
    private static string RatingLabel(int rating) => rating switch
    {
        1 => "Rất không hài lòng",
        2 => "Chưa hài lòng",
        3 => "Bình thường",
        4 => "Hài lòng",
        _ => "Rất hài lòng"
    };
    private static string Initials(string? name) => string.Concat((name ?? "HLV").Replace("-", " ")
        .Split(' ', StringSplitOptions.RemoveEmptyEntries).TakeLast(2).Select(word => char.ToUpperInvariant(word[0])));
    private bool _busy, _history, _reviewed, _reviewOpen;

    private static readonly string[] Taught = ["Completed", "AutoCompleted", "NoShow", "Disputed"];
    private IEnumerable<PTSessionResponse> Visible => Contract.Sessions.Where(s => _history
        ? !IsFuture(s.Date, s.EndTime) && (Taught.Contains(s.Status) || s.Status == "Cancelled" && s.TrainerAbsenceReportedAt is not null)
        : true)
        .Where(s => _history || !IsTrainer || IsFuture(s.Date, s.EndTime) || s.IsMakeUpUnit);
    private PTCalendarSlot[] CalendarSlots => Visible.Select(s => new PTCalendarSlot(s.Id, s.Date, s.StartTime, s.EndTime, s.Status))
        .Concat(Visible.Where(s => s.Proposal is { Type: "Reschedule" } p && p.ExpiresAt > DateTime.UtcNow)
            .Select(s => new PTCalendarSlot(-s.Id, s.Proposal!.Date, s.Proposal.StartTime, s.Proposal.EndTime, "Proposed"))).ToArray();
    // UC 4.7: a 60-minute make-up starts on a whole hour and ends by gym closing time.
    private IEnumerable<int> MakeUpHours => MakeUpStartHours(Contract);
    public static IEnumerable<int> MakeUpStartHours(PTContractResponse? contract) =>
        contract is { GymOpenTime: { } open, GymCloseTime: { } close } && open < close
            ? Enumerable.Range(open.Hour + (open.Minute > 0 ? 1 : 0), Math.Max(0, close.Hour - open.Hour - (open.Minute > 0 ? 1 : 0)))
            : Enumerable.Range(5, 18);
    // UC 4.10: the server decides eligibility (completed, final session held); a contract is reviewed once, also after a reload.
    private bool CanOfferReview => !_reviewed && !Contract.HasReview && Contract.CanReview;
    private string? ReviewNotice => _reviewed || Contract.HasReview
        ? "Bạn đã đánh giá hợp đồng này. Đánh giá không thể sửa hoặc xóa."
        : Contract.Status is "Completed" or "Expired"
            ? "Chỉ hợp đồng đã hoàn thành đủ buổi và đã tập buổi cuối mới được đánh giá huấn luyện viên."
            : null;

    protected override void OnInitialized() => _reviewOpen = OpenReview && CanOfferReview;

    // "Xin đổi lịch" links here with ?session=: open that session's free-slot picker straight away.
    protected override async Task OnInitializedAsync()
    {
        if (IsReschedulePage && !IsTrainer && InitialSessionId is { } id &&
            Contract.Sessions.FirstOrDefault(s => s.Id == id) is { Status: "Scheduled" } item &&
            IsFuture(item.Date, item.StartTime) && CanRequestChange(item))
        {
            _selectedCalendarSession = id;
            await OpenOptionsAsync(item);
        }
    }
    private static DateTime LocalNow => DateTime.UtcNow.AddHours(7);
    private static bool IsFuture(DateOnly date, TimeOnly time) => date.ToDateTime(time) > LocalNow;
    // GBR-14: changes are requested at least 12 hours before the start.
    private static bool CanRequestChange(PTSessionResponse s) => s.Date.ToDateTime(s.StartTime) - LocalNow >= TimeSpan.FromHours(12);
    // GBR-103: the Member reports 'PT Absent' on the session day, after it started.
    private bool CanReportAbsence(PTSessionResponse s) => !IsTrainer && s.TrainerAbsenceReportedAt is null && s.Date == Today &&
        !IsFuture(s.Date, s.StartTime) && s.Status is "Scheduled" or "Completed" or "NoShow" or "ReschedulePending" or "RescheduleRequested";
    private bool IDecide(PTSessionResponse s) => IsTrainer
        ? s.Status is "RescheduleRequested" or "MakeUpRequested"
        : s.Status is "ReschedulePending" or "MakeUpPending";

    private static string ProposalText(PTProposalResponse p) => p.Type switch
    {
        "Cancellation" => "Đề nghị hủy buổi này (sẽ thành lượt bù)",
        "MakeUp" => $"Buổi bù {Date(p.Date)} · {Time(p.StartTime)} – {Time(p.EndTime)}",
        _ => $"Đề xuất đổi sang {Date(p.Date)} · {Time(p.StartTime)} – {Time(p.EndTime)}"
    };

    private static string AbsenceOutcome(PTSessionResponse s) => s.Status switch
    {
        "Disputed" => "PT đã điểm danh khác với báo cáo, đang chờ quản lý xem xét.",
        "Cancelled" when s.MakeUpAvailableAt is { } opens => $"đang chờ PT phản hồi; buổi bù đặt lịch được từ {LocalTime(opens)}.",
        "Cancelled" => "đã trả lại thành buổi bù.",
        "Completed" => "Quản lý xác nhận buổi tập đã diễn ra.",
        "NoShow" => "Quản lý xác nhận hội viên vắng mặt.",
        _ => "đã ghi nhận."
    };

    private void SelectHistory(bool history)
    {
        _history = history;
        _sessionPage = 1;
        _selectedCalendarSession = null;
        CloseEditor();
    }

    private void SelectCalendarSession(PTWeeklySlot slot)
    {
        _selectedCalendarSession = _selectedCalendarSession == slot.TemplateId ? null : slot.TemplateId;
        CloseEditor();
    }

    private void CloseEditor() { _editor = null; _sessionId = null; }
    private void OpenEditor(PTSessionResponse item, string editor) { _sessionId = item.Id; _editor = editor; _absenceReason = ""; }
    private void OpenMakeUp(PTSessionResponse item)
    {
        OpenEditor(item, MakeUp);
        _makeUpDate = Today.AddDays(1);
        if (!MakeUpHours.Contains(_makeUpHour)) _makeUpHour = MakeUpHours.FirstOrDefault(9);
    }

    private Task SendAbsenceAsync() => _sessionId is { } id
        ? RunAsync(async () =>
        {
            var note = _absenceReason.Trim();
            await Api.ReportTrainerAbsenceAsync(id, new(note.Length == 0 ? null : note));
            CloseEditor();
        }, "Đã gửi báo PT vắng mặt.", refresh: true)
        : Task.CompletedTask;

    private Task SendMakeUpAsync() => _sessionId is { } id
        ? RunAsync(async () => { await Api.ProposeMakeUpAsync(id, new(_makeUpDate, new TimeOnly(_makeUpHour, 0))); CloseEditor(); },
            "Đã gửi đề xuất buổi bù.", refresh: true)
        : Task.CompletedTask;

    private async Task OpenOptionsAsync(PTSessionResponse item)
    {
        OpenEditor(item, Reschedule);
        _from = item.Date;
        await LoadOptionsAsync();
    }

    private async Task LoadOptionsAsync()
    {
        _requested = null;
        _options = [];
        if (_sessionId is { } id)
            await RunAsync(async () => _options = await Api.RescheduleOptionsAsync(id, _from));
    }

    private Task SendRescheduleAsync() => _sessionId is { } id && _requested is { } slot
        ? RunAsync(async () =>
        {
            if (IsTrainer) await Api.ProposeAsync(id, new(slot.Date, slot.StartTime, "Reschedule"));
            else await Api.RequestRescheduleAsync(id, new(slot.Date, slot.StartTime));
            CloseEditor();
        }, "Đã gửi yêu cầu đổi lịch.", refresh: true)
        : Task.CompletedTask;

    private Task CancelAsync(PTSessionResponse item) => RunAsync(async () => await Api.RequestCancellationAsync(item.Id),
        "Đã gửi yêu cầu hủy buổi. Buổi chỉ bị hủy khi bên kia đồng ý.", refresh: true);

    private Task DecideAsync(PTSessionResponse item, PTProposalResponse proposal, bool accept) => RunAsync(async () =>
    {
        if (IsTrainer && item.Status == "MakeUpRequested") await Api.DecideMakeUpRequestAsync(item.Id, new(accept, proposal.ExpiresAt));
        else if (IsTrainer) await Api.DecideRescheduleAsync(item.Id, new(accept, proposal.Date, proposal.StartTime, proposal.ExpiresAt));
        else await Api.DecideProposalAsync(item.Id, new(accept, proposal.ExpiresAt));
    }, accept ? "Đã chấp nhận đề xuất." : "Đã từ chối đề xuất.", refresh: true);

    private Task ReviewAsync()
    {
        if (_comment.Trim().Length is < 10 or > 500)
        {
            _error = "Nhập nhận xét từ 10 đến 500 ký tự.";
            return Task.CompletedTask;
        }
        _bannedWords = [];
        return RunAsync(async () =>
        {
            try { await Api.ReviewAsync(Contract.Id, new(_rating, _comment.Trim())); }
            catch (AuthApiException ex) when (TrainerContentRules.ProhibitedWords(ex.ErrorCode, ex.Message) is { Count: > 0 } words)
            {
                _bannedWords = words;
                throw new AuthApiException("Nhận xét có từ ngữ không được phép. Sửa các từ được tô đỏ rồi gửi lại.");
            }
            _reviewed = true;
            _reviewOpen = false;
            Toasts.Show("Đã gửi đánh giá. Cảm ơn bạn!");
        }, refresh: true);
    }

    private async Task RunAsync(Func<Task> action, string? message = null, bool refresh = false)
    {
        if (_busy) return;
        _busy = true;
        _error = _message = null;
        try { await action(); _message = message; }
        catch (AuthApiException ex) { _error = ex.Message; }
        finally
        {
            if (refresh) await Changed.InvokeAsync();
            _busy = false;
        }
    }
}
