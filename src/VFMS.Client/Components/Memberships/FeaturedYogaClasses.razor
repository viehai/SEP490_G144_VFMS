@using VFMS.Contracts.Yoga
@inject VfmsApiClient Api
@implements IDisposable

@* Home "Các lớp học nổi bật": up to 4 real yoga classes from the public timetable (UC-37), soonest first. *@
@if (_loading)
{
    <p role="status" class="font-body text-sm text-[#6F6966]">Đang tải các lớp học...</p>
}
else if (_error is not null)
{
    <p role="alert" class="rounded-xl border border-red-200 bg-red-50 p-5 font-body text-sm text-red-900">@_error</p>
}
else if (_cards.Count == 0)
{
    <p role="status" class="rounded-xl border border-[#D8D1CD] bg-[#F8F5F2] p-8 font-body text-sm text-[#6F6966]">
        Chưa có lớp học nào mở trong 4 tuần tới. <a href="/yoga/schedule" class="font-bold text-[#B83A3A] underline">Xem thời khóa biểu</a>
    </p>
}
else
{
    <div class="w-full overflow-hidden">
        <div id="classes-grid" class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-4 md:gap-5">
            @for (var i = 0; i < _cards.Count; i++)
            {
                var card = _cards[i];
                var badge = card.Badge(DateTime.UtcNow);
                <a href="/yoga/schedule" aria-label="@($"{card.Name}, {YogaClassCard.BadgeText(badge)}")"
                   class="group relative block w-full h-[68vh] min-h-[520px] max-h-[750px] overflow-hidden bg-[#ECE8E4] border border-[#D8D1CD] hover:border-[#B83A3A] focus-visible:border-[#B83A3A] rounded-xl select-none transition-all duration-300">
                    <img src="@Photo(i)" alt="" loading="lazy"
                         class="w-full h-full object-cover object-center group-hover:scale-105 transition-all duration-700 ease-out pointer-events-none" />
                    <div class="absolute top-3 left-3 z-10">
                        <span class="@($"text-white font-heading text-[10px] font-bold uppercase tracking-[0.1em] px-2.5 py-1 rounded-md {YogaClassCard.BadgeColor(badge)}")">@YogaClassCard.BadgeText(badge)</span>
                    </div>
                    <div class="absolute inset-x-0 bottom-0 bg-[#F8F5F2]/95 border-t border-[#D8D1CD] p-4 translate-y-full group-hover:translate-y-0 group-focus-visible:translate-y-0 transition-transform duration-300 ease-out pointer-events-none rounded-b-xl">
                        <span class="font-heading text-[10px] font-bold text-[#B83A3A] uppercase tracking-[0.12em] block">YOGA@(string.IsNullOrWhiteSpace(card.TypeName) ? "" : $" · {card.TypeName}")</span>
                        <h4 class="font-heading font-bold text-sm text-[#252323] mt-0.5 truncate tracking-tight">@card.Name</h4>
                        <p class="font-body text-xs text-[#6F6966] mt-1">@card.Minutes phút · @card.SessionsPerWeek buổi/tuần · @card.DifficultyName</p>
                    </div>
                </a>
            }
        </div>
    </div>
}

@code {
    // Classes have no photo of their own yet (the manager form has no image field): yoga stock photos in turn.
    private static readonly string[] Photos =
    [
        "https://images.unsplash.com/photo-1545205597-3d9d02c29597?auto=format&fit=crop&w=800&h=1200&q=80",
        "https://images.unsplash.com/photo-1544367567-0f2fcb009e0b?auto=format&fit=crop&w=800&h=1200&q=80",
        "https://images.unsplash.com/photo-1575052814086-f385e2e2ad1b?auto=format&fit=crop&w=800&h=1200&q=80",
        "https://images.unsplash.com/photo-1588286840104-8957b019727f?auto=format&fit=crop&w=800&h=1200&q=80",
    ];

    private readonly CancellationTokenSource _lifetime = new();
    private IReadOnlyList<YogaClassCard> _cards = [];
    private bool _loading = true;
    private string? _error;

    private static string Photo(int index) => Photos[index % Photos.Length];

    protected override async Task OnInitializedAsync()
    {
        var today = DateOnly.FromDateTime(DateTimeOffset.UtcNow.ToOffset(TimeSpan.FromHours(7)).DateTime);
        try
        {
            var sessions = await Api.GetAsync<List<YogaSessionResponse>>(
                $"api/yoga/schedule?from={today:yyyy-MM-dd}&to={today.AddDays(27):yyyy-MM-dd}", _lifetime.Token);
            // Classes still open for booking first, then the rest; at most 4 cards.
            _cards = YogaClassCard.FromSessions(sessions)
                .OrderBy(card => card.Badge(DateTime.UtcNow) == YogaClassBadge.Closed)
                .Take(4).ToArray();
        }
        catch (ApiException ex)
        {
            _error = ex.Message;
        }
        catch (OperationCanceledException) when (_lifetime.IsCancellationRequested)
        {
            // The visitor left the page.
        }
        finally
        {
            _loading = false;
        }
    }

    public void Dispose()
    {
        _lifetime.Cancel();
        _lifetime.Dispose();
    }
}
