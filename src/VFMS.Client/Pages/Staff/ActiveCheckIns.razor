@page "/staff/check-ins"
@layout StaffPTLayout
@using VFMS.Contracts.CheckIn
@inject VfmsApiClient Api
@implements IDisposable

<PageTitle>Đang có mặt | Victor Fitness</PageTitle>

<div class="workspace-page space-y-8 font-['Inter',sans-serif] text-[#252525]">
    <header class="border-b-2 border-black pb-7">
        <p class="workspace-heading mb-3 text-[10px] font-bold tracking-[.18em] text-[#71717A]">VFMS / CHECK-IN</p>
        <h1 class="workspace-heading text-3xl font-extrabold uppercase tracking-tight sm:text-4xl">Đang có mặt<span>.</span></h1>
        <p class="mt-3 text-sm text-[#545454]">Hội viên đang ở phòng tập, tự cập nhật mỗi 30 giây.</p>
    </header>

    <section class="grid gap-4 sm:grid-cols-2" aria-label="Thống kê">
        <div class="border-2 border-black bg-white p-6 rounded-none"><p class="workspace-heading text-[11px] font-bold uppercase tracking-wider">Đang có mặt</p><p class="workspace-heading mt-4 text-5xl font-extrabold">@(_data?.CurrentOccupancy ?? 0)</p></div>
        <div class="border-2 border-black bg-white p-6 rounded-none"><p class="workspace-heading text-[11px] font-bold uppercase tracking-wider">Lượt check-in hôm nay</p><p class="workspace-heading mt-4 text-5xl font-extrabold">@(_data?.CheckInsToday ?? 0)</p></div>
    </section>

    <label class="block max-w-sm text-xs font-semibold">Tìm theo tên hoặc số điện thoại
        <input class="mt-1 w-full border border-[#CFCFCF] px-3 py-2 text-sm rounded-none" @bind="_search" @bind:event="oninput" @bind:after="Load" />
    </label>

    @if (_error is not null)
    {
        <p role="alert" class="border-2 border-[#EF4444] bg-red-50 px-4 py-3 text-sm text-[#B91C1C] rounded-none">@_error</p>
    }
    <div class="overflow-x-auto border-2 border-black bg-white rounded-none" aria-live="polite">
        <table class="w-full min-w-[640px] text-left text-sm">
            <thead class="workspace-heading bg-[#F7F7F7] text-[10px] uppercase tracking-wider"><tr><th class="px-5 py-3">Hội viên</th><th class="px-5 py-3">Điện thoại</th><th class="px-5 py-3">Vào lúc</th><th class="px-5 py-3">Thời gian</th><th class="px-5 py-3">Cách check-in</th></tr></thead>
            <tbody>
                @if (_data is null || _data.Items.Count == 0)
                {
                    <tr><td colspan="5" class="px-5 py-6 text-[#545454]">No matching records found.</td></tr>
                }
                else
                {
                    @foreach (var c in _data.Items)
                    {
                        <tr class="border-t border-[#CFCFCF]">
                            <td class="px-5 py-4 font-semibold">@c.MemberName</td>
                            <td class="px-5 py-4">@c.PhoneNumber</td>
                            <td class="px-5 py-4">@c.CheckinTime.ToUniversalTime().AddHours(7).ToString("HH:mm")</td>
                            <td class="px-5 py-4">@(c.MinutesInside / 60)h @(c.MinutesInside % 60)m</td>
                            <td class="px-5 py-4">@MethodLabel(c.Method)@(c.HandledByName is null ? "" : $" · {c.HandledByName}")</td>
                        </tr>
                    }
                }
            </tbody>
        </table>
    </div>
</div>

@code {
    private ActiveCheckInsResponse? _data;
    private string _search = string.Empty;
    private string? _error;
    private Timer? _timer;

    protected override async Task OnInitializedAsync()
    {
        await Load();
        _timer = new Timer(_ => InvokeAsync(async () => { await Load(); StateHasChanged(); }), null, TimeSpan.FromSeconds(30), TimeSpan.FromSeconds(30));
    }

    private async Task Load()
    {
        try
        {
            _data = await Api.GetAsync<ActiveCheckInsResponse>($"api/check-ins/active?search={Uri.EscapeDataString(_search)}");
            _error = null;
        }
        catch (ApiException ex) { _error = ex.Message; }
    }

    private static string MethodLabel(string method) => method switch
    {
        "FaceRecognition" => "FaceID",
        "QRCode" => "QR",
        "ManualStaff" => "Lễ tân",
        _ => method
    };

    public void Dispose() => _timer?.Dispose();
}
