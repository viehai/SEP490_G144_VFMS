@using System.Security.Claims
@using Microsoft.AspNetCore.Components.Sections
@inject NavigationManager Navigation

<div class="workspace-shell workspace-shell--@CurrentVariant">
    @if (Variant != "member")
    {
        <a class="workspace-skip-link" href="@(new Uri(Navigation.Uri).PathAndQuery + "#workspace-main")"
           @onclick="FocusMainAsync">Đến nội dung chính</a>
    }
    <aside class="workspace-sidebar" aria-label="Điều hướng không gian làm việc">
        <a href="/" class="workspace-logo"><img src="/brand/logo-remove.png" alt="Victor Fitness - Trang chủ" class="brightness-0" /></a>
        <div class="workspace-sidebar-label">V-FITNESS MANAGEMENT</div>
        <div class="workspace-role"><span aria-hidden="true">@RoleMark</span><div><strong>@RoleName</strong><small>KHÔNG GIAN LÀM VIỆC</small></div></div>
        @if (Variant == "member")
        {
            <p class="workspace-sidebar-label workspace-sidebar-label--menu">ĐIỀU HƯỚNG</p>
            <nav class="workspace-nav" aria-label="Điều hướng hội viên">
                <NavLink href="/profile" Match="NavLinkMatch.All" class="workspace-nav-link" ActiveClass="workspace-nav-link--active"><span aria-hidden="true">03</span> Hồ sơ cá nhân <span aria-hidden="true">↗</span></NavLink>
                <NavLink href="/competitions" Match="NavLinkMatch.All" class="workspace-nav-link" ActiveClass="workspace-nav-link--active"><span aria-hidden="true">04</span> Cuộc thi <span aria-hidden="true">↗</span></NavLink>
                <a href="/" class="workspace-nav-link"><span aria-hidden="true">05</span> Trang chủ <span aria-hidden="true">↗</span></a>
                <AuthorizeView Roles="Customer,Member">
                    <NavLink href="/my-vouchers" class="workspace-nav-link" ActiveClass="workspace-nav-link--active">Voucher của tôi</NavLink>
                    <NavLink href="/my-memberships" Match="NavLinkMatch.Prefix" class="workspace-nav-link" ActiveClass="workspace-nav-link--active">Gói của tôi</NavLink>
                    <NavLink href="/my-pt-packages" Match="NavLinkMatch.All" class="workspace-nav-link" ActiveClass="workspace-nav-link--active">Gói PT</NavLink>
                </AuthorizeView>
            </nav>
        }
        else
        {
            <WorkspaceNavigation Variant="@CurrentVariant" User="@_user" />
        }
        <div class="workspace-sidebar-bottom">
            <p class="workspace-sidebar-label">VICTOR FITNESS / VFMS</p>
            <p>Vận hành có kỷ luật.<br />Phát triển có định hướng.</p>
        </div>
    </aside>
    <div class="workspace-content">
        <header class="workspace-topbar">
            <div class="workspace-breadcrumb"><a href="/">VFMS</a><span aria-hidden="true">/</span><strong>@RoleName</strong></div>
            @if (Variant == "member")
            {
                <AuthorizeView><LogoutButton Class="border border-[#D8D1CD] bg-[#F8F5F2] hover:bg-[#ECE8E4] text-[#242424] px-3.5 py-2 text-xs font-bold rounded-lg transition-colors" /></AuthorizeView>
            }
            else
            {
                <div class="dash-account-bar"><SectionOutlet SectionName="dashboard-notifications" />
                <AuthorizeView><details class="dash-account">
                    <summary><span class="dash-avatar" aria-hidden="true">@RoleMark</span><strong>@context.User.Identity?.Name</strong><span aria-hidden="true">⌄</span></summary>
                    <div class="dash-popover"><a href="/profile">Hồ sơ cá nhân</a><LogoutButton>Đăng xuất</LogoutButton></div>
                </details></AuthorizeView>
                </div>
            }
        </header>
        @if (IsPreview)
        {
            <div class="workspace-demo-note"><span aria-hidden="true">◼</span> BẢN XEM TRƯỚC <span aria-hidden="true">/</span> Dữ liệu minh họa, chưa phản ánh hoạt động thực tế.</div>
        }
        <main class="workspace-main" id="workspace-main" tabindex="-1" @ref="_main">@ChildContent</main>
        <footer class="workspace-footer"><span>© @DateTime.Now.Year VICTOR FITNESS</span><span>V-FITNESS MANAGEMENT SYSTEM</span></footer>
    </div>
</div>

@code {
    [Parameter] public string Variant { get; set; } = "staff";
    [Parameter] public bool IsPreview { get; set; } = true;
    [Parameter] public RenderFragment? ChildContent { get; set; }
    private string RoleName => CurrentVariant switch { "admin" => "ADMIN", "manager" => "MANAGER", "pt" => "HUẤN LUYỆN VIÊN", "member" => "HỘI VIÊN", _ => "STAFF" };
    private string RoleMark => CurrentVariant switch { "admin" => "AD", "manager" => "MG", "pt" => "PT", "member" => "HV", _ => "ST" };
    [CascadingParameter] private Task<AuthenticationState> Authentication { get; set; } = default!;
    private ClaimsPrincipal _user = new(new ClaimsIdentity());
    private string CurrentVariant { get; set; } = "staff";
    private ElementReference _main;
    private static readonly (string Role, string Variant)[] RoleWorkspaces =
        [("Admin", "admin"), ("Manager", "manager"), ("Staff", "staff"), ("PT", "pt"), ("YogaInstructor", "pt")];

    protected override async Task OnParametersSetAsync()
    {
        _user = (await Authentication).User;
        var workspaces = RoleWorkspaces.Where(workspace => _user.IsInRole(workspace.Role));
        // Shared pages can be reached through another role's URL, e.g. Manager at /staff/check-ins.
        CurrentVariant = Variant == "member" || workspaces.Any(workspace => workspace.Variant == Variant)
            ? Variant : workspaces.Select(workspace => workspace.Variant).FirstOrDefault() ?? Variant;
    }

    private Task FocusMainAsync(MouseEventArgs e) =>
        e.CtrlKey || e.MetaKey || e.ShiftKey || e.AltKey ? Task.CompletedTask : _main.FocusAsync().AsTask();
}
