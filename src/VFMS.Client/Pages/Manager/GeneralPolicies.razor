@page "/manager/general-policies"
@layout ManagerAdminLayout
@using Microsoft.AspNetCore.Authorization
@using VFMS.Contracts.SystemAdministration
@using VFMS.Contracts.SystemAdministration.Validators
@attribute [Authorize]
@inject SystemAdministrationApiClient Api
@implements IDisposable

<PageTitle>Chính sách chung | Victor Fitness</PageTitle>

<div class="workspace-page space-y-6">
    <header class="flex flex-wrap items-end justify-between gap-4 border-b-2 border-black pb-6">
        <div>
            <p class="workspace-heading mb-3 text-[10px] tracking-[.18em] text-[#71717A]">VFMS / SYSTEM CONFIGURATION</p>
            <h1 class="workspace-heading text-3xl tracking-tight sm:text-4xl">Chính sách chung<span class="text-[#6366F1]">.</span></h1>
            <p class="mt-3 text-sm text-[#545454]">Thông tin phòng tập, giờ mở cửa và trạng thái nhận hội viên mới.</p>
        </div>
        @if (_settings is not null)
        {
            <p class="text-xs text-[#545454]">Cập nhật: @_settings.UpdatedAt.ToLocalTime().ToString("dd/MM/yyyy HH:mm")</p>
        }
    </header>

    @if (_notice is not null)
    {
        <p role="status" class="border border-emerald-600 bg-emerald-50 p-4 text-sm text-emerald-900">@_notice</p>
    }
    @if (_error is not null)
    {
        <p role="alert" class="border border-red-600 bg-red-50 p-4 text-sm text-red-900">@_error</p>
    }

    @if (_loading)
    {
        <p role="status" class="text-sm">Đang tải thông tin phòng tập...</p>
    }
    else if (_settings is not null)
    {
        <section class="border-2 border-black bg-white p-5 sm:p-6" aria-labelledby="gym-settings-title">
            <h2 id="gym-settings-title" class="workspace-heading text-base">Thông tin phòng tập</h2>
            @if (!_canEdit)
            {
                <p class="mt-2 text-xs text-[#545454]">Chỉ Manager được chỉnh sửa.</p>
            }
            <EditForm Model="_model" OnValidSubmit="SaveAsync" class="mt-4" novalidate>
                <ContractValidation TRequest="GymSettingsRequest" Validator="_validator" CreateRequest="CreateRequest" @ref="_validation" />
                <ValidationSummary />
                <fieldset disabled="@(_working || !_canEdit)" class="mt-4 grid gap-4 sm:grid-cols-2">
                    <label class="text-sm font-semibold sm:col-span-2" for="gym-name">
                        Tên phòng tập
                        <InputText id="gym-name" class="@Field" @bind-Value="_model.GymName" maxlength="256" required />
                    </label>
                    <label class="text-sm font-semibold sm:col-span-2" for="gym-address">
                        Địa chỉ
                        <InputText id="gym-address" class="@Field" @bind-Value="_model.Address" maxlength="500" />
                    </label>
                    <label class="text-sm font-semibold" for="gym-phone">
                        Số điện thoại
                        <InputText id="gym-phone" class="@Field" @bind-Value="_model.PhoneNumber" maxlength="20" />
                    </label>
                    <label class="text-sm font-semibold" for="gym-email">
                        Email
                        <InputText id="gym-email" class="@Field" @bind-Value="_model.Email" maxlength="256" />
                    </label>
                    <label class="text-sm font-semibold" for="gym-open">
                        Giờ mở cửa
                        <InputDate id="gym-open" Type="InputDateType.Time" class="@Field" @bind-Value="_model.OpenTime" />
                    </label>
                    <label class="text-sm font-semibold" for="gym-close">
                        Giờ đóng cửa
                        <InputDate id="gym-close" Type="InputDateType.Time" class="@Field" @bind-Value="_model.CloseTime" />
                    </label>
                    <label class="flex items-center gap-3 text-sm font-semibold sm:col-span-2">
                        <InputCheckbox @bind-Value="_model.IsAcceptingMembers" /> Đang nhận hội viên mới
                    </label>
                    @if (_canEdit)
                    {
                        <div class="flex flex-wrap gap-3 sm:col-span-2">
                            <button type="submit" class="@PrimaryButton">@(_working ? "Đang lưu..." : "Lưu thay đổi")</button>
                            <button type="button" class="@Button" @onclick="Reset">Hoàn tác</button>
                        </div>
                    }
                </fieldset>
            </EditForm>
        </section>
    }
</div>

@code {
    private const string Field = "mt-1 block w-full border border-[#71717A] bg-white px-3 py-2 text-sm font-normal";
    private const string Button = "border border-black bg-white px-3 py-2 text-xs font-bold hover:bg-[#F7F7F7]";
    private const string PrimaryButton = "border border-black bg-[#4338CA] px-4 py-2.5 text-sm font-bold text-white hover:bg-[#3730A3]";

    [CascadingParameter] private Task<AuthenticationState> AuthState { get; set; } = default!;
    private readonly CancellationTokenSource _lifetime = new();
    private readonly GymSettingsModel _model = new();
    private readonly GymSettingsRequestValidator _validator = new();
    private ContractValidation<GymSettingsRequest>? _validation;
    private GymSettingsResponse? _settings;
    private string? _notice, _error;
    private bool _loading = true, _working, _canEdit;

    protected override async Task OnInitializedAsync()
    {
        _canEdit = (await AuthState).User.IsInRole("Manager");
        try
        {
            _settings = await Api.GetGymSettingsAsync(_lifetime.Token);
            Reset();
        }
        catch (AuthApiException error) { _error = error.Message; }
        catch (OperationCanceledException) when (_lifetime.IsCancellationRequested) { }
        finally { _loading = false; }
    }

    private GymSettingsRequest CreateRequest() => new(_model.GymName.Trim(), Blank(_model.Address), Blank(_model.PhoneNumber),
        Blank(_model.Email), _model.OpenTime, _model.CloseTime, _model.IsAcceptingMembers);

    private static string? Blank(string? value) => string.IsNullOrWhiteSpace(value) ? null : value.Trim();

    private async Task SaveAsync()
    {
        if (_working) return;
        _working = true;
        _notice = _error = null;
        try
        {
            _settings = await Api.UpdateGymSettingsAsync(CreateRequest(), _lifetime.Token);
            Reset();
            _notice = "Đã lưu chính sách chung.";
        }
        catch (AuthApiException error)
        {
            _error = error.Message;
            _validation?.ShowErrors(error.Errors);
        }
        catch (OperationCanceledException) when (_lifetime.IsCancellationRequested) { }
        finally { _working = false; }
    }

    private void Reset()
    {
        if (_settings is not { } settings) return;
        _model.GymName = settings.GymName;
        _model.Address = settings.Address;
        _model.PhoneNumber = settings.PhoneNumber;
        _model.Email = settings.Email;
        _model.OpenTime = settings.OpenTime;
        _model.CloseTime = settings.CloseTime;
        _model.IsAcceptingMembers = settings.IsAcceptingMembers;
    }

    public void Dispose()
    {
        _lifetime.Cancel();
        _lifetime.Dispose();
    }

    private sealed class GymSettingsModel
    {
        public string GymName { get; set; } = string.Empty;
        public string? Address { get; set; }
        public string? PhoneNumber { get; set; }
        public string? Email { get; set; }
        public TimeOnly? OpenTime { get; set; }
        public TimeOnly? CloseTime { get; set; }
        public bool IsAcceptingMembers { get; set; }
    }
}
