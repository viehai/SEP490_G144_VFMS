@page "/manager/locker-clearances"
@layout ManagerAdminLayout
@using Microsoft.AspNetCore.Authorization
@using VFMS.Client.Components.Operations
@using VFMS.Contracts.Lockers
@attribute [Authorize(Roles = "Manager")]
@inject LockerApiClient Api
@inject ToastService Toasts
@inject AuthenticationStateProvider Auth
@implements IDisposable

<PageTitle>Xác nhận dọn tủ | Victor Fitness</PageTitle>

<section class="workspace-page space-y-6 font-['Inter',sans-serif] text-[#242424]" aria-labelledby="clearances-title" aria-busy="@_loading.ToString().ToLowerInvariant()">
    <PageHeader Overline="VFMS / QUẢN LÝ TỦ" Title="Xác nhận dọn tủ" Description="Biên bản kiểm kê do nhân viên gửi. quản lý khác với người gửi xác nhận để kết thúc hợp đồng, mất cọc và ghi nợ phí.">
        <div class="flex flex-wrap gap-2">
            <a href="/manager/lockers" class="@Ui.Button">← Danh mục tủ</a>
        </div>
    </PageHeader>
    <Alerts Error="@_error" />

    @if (_loading)
    {
        <p role="status" class="text-sm text-[#6F6966]">Đang tải…</p>
    }
    else if (_items.Length == 0)
    {
        <p role="status" class="@Ui.Card text-sm">Không có biên bản nào đang chờ xác nhận.</p>
    }
    else
    {
        <div class="space-y-4">
            @foreach (var item in _items.Skip((_page - 1) * PageSize).Take(PageSize))
            {
                <article @key="item.Id" class="@Ui.Card space-y-3">
                    <div class="flex flex-wrap items-center justify-between gap-3">
                        <h2 class="text-sm font-extrabold">Hợp đồng #@item.RentalId · gửi lúc @LockerText.Local(item.ReportedAt)</h2>
                        <a class="text-xs font-bold text-[#B83A3A] underline" href="@($"/manager/lockers")">Danh mục tủ</a>
                    </div>
                    @if (item.Inventory.Count == 0)
                    {
                        <p class="text-sm">Nhân viên xác nhận tủ trống, không có đồ bỏ lại.</p>
                    }
                    else
                    {
                        <ul class="list-disc pl-5 text-sm">
                            @foreach (var thing in item.Inventory) { <li>@thing.Name × @thing.Quantity</li> }
                        </ul>
                    }
                    @if (item.StaffId == _me)
                    {
                        <p class="text-xs text-[#6F6966]">Biên bản do chính bạn gửi, cần một quản lý khác xác nhận.</p>
                    }
                    <button type="button" class="@Ui.PrimaryButton" disabled="@(_busy || item.StaffId == _me)" @onclick="() => VerifyAsync(item)">Xác nhận &amp; kết thúc hợp đồng</button>
                </article>
            }
        </div>
        <Pager Page="_page" PageSize="PageSize" TotalCount="_items.Length" Noun="biên bản" Disabled="_busy" OnPage="page => _page = page" />
    }
</section>

@code {
    private const int PageSize = 10;
    private int _page = 1;
    private readonly CancellationTokenSource _lifetime = new();
    private LockerClearanceView[] _items = [];
    private string? _me, _error;
    private bool _loading = true, _busy;

    protected override async Task OnInitializedAsync()
    {
        var state = await Auth.GetAuthenticationStateAsync();
        _me = state.User.FindFirst(System.Security.Claims.ClaimTypes.NameIdentifier)?.Value ?? state.User.FindFirst("sub")?.Value;
        await LoadAsync();
        _loading = false;
    }

    private async Task LoadAsync()
    {
        try
        {
            _items = await Api.ClearancesAsync(_lifetime.Token);
            _page = Math.Clamp(_page, 1, Math.Max(1, (_items.Length + PageSize - 1) / PageSize));
            _error = null;
        }
        catch (ApiException ex) { _error = ex.Message; Toasts.ShowError(ex.Message); }
        catch (OperationCanceledException) when (_lifetime.IsCancellationRequested) { }
    }

    private async Task VerifyAsync(LockerClearanceView item)
    {
        if (_busy) return;
        _busy = true;
        _error = null;
        try
        {
            await Api.VerifyClearanceAsync(item.Id, _lifetime.Token);
            Toasts.Show("Đã cập nhật hợp đồng tủ thành công.");
            await LoadAsync();
        }
        catch (ApiException ex) { _error = ex.Message; Toasts.ShowError(ex.Message); }
        catch (OperationCanceledException) when (_lifetime.IsCancellationRequested) { }
        finally { _busy = false; }
    }

    public void Dispose()
    {
        _lifetime.Cancel();
        _lifetime.Dispose();
    }
}
