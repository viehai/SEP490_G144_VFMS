@page "/staff/membership-cash-receipt"
@layout StaffPTLayout
@using Microsoft.AspNetCore.Authorization
@using VFMS.Contracts.Memberships
@attribute [Authorize(Roles = "Staff")]
@inject MembershipPlanApiClient Plans
@implements IDisposable

<PageTitle>Xác nhận tiền mặt | Victor Fitness</PageTitle>

<section class="workspace-page space-y-5" aria-labelledby="cash-receipt-title">
    <div>
        <h1 id="cash-receipt-title" class="text-2xl font-bold text-[#383E43]">Xác nhận tiền mặt mua gói tập</h1>
        <p class="mt-1 text-sm text-[#69706A]">Nhập mã đơn và số tiền thực tế đã nhận tại quầy.</p>
    </div>
    <form @onsubmit="ConfirmAsync" @onsubmit:preventDefault>
        <fieldset disabled="@_submitting" class="max-w-md space-y-4 rounded-xl border border-[#D8DED2] bg-white p-6 shadow-sm">
            <label class="block text-sm font-semibold text-[#383E43]">
                Mã đơn
                <input class="mt-1 block w-full rounded-lg border border-[#D8DED2] bg-white px-3.5 py-2.5 text-sm text-[#383E43] outline-none transition focus:border-[#5F6F52] focus:ring-2 focus:ring-[#5F6F52]/20" @bind="_orderNumber" required maxlength="50" placeholder="VD: ORD-123456" />
            </label>
            <label class="block text-sm font-semibold text-[#383E43]">
                Số tiền đã nhận (₫)
                <input type="number" class="mt-1 block w-full rounded-lg border border-[#D8DED2] bg-white px-3.5 py-2.5 text-sm text-[#383E43] outline-none transition focus:border-[#5F6F52] focus:ring-2 focus:ring-[#5F6F52]/20" @bind="_amount" required min="1" step="1" placeholder="Nhập số tiền..." />
            </label>
            <div class="pt-2">
                <button type="submit" class="w-full rounded-lg bg-[#5F6F52] hover:bg-[#4E5D44] px-5 py-2.5 text-sm font-semibold text-white transition shadow-sm disabled:opacity-50">
                    @(_submitting ? "Đang xác nhận..." : "Xác nhận đã nhận tiền")
                </button>
            </div>
        </fieldset>
    </form>
    @if (_error is not null)
    {
        <div class="max-w-md rounded-xl border border-red-200 bg-red-50 p-4">
            <p role="alert" class="text-sm text-red-900">@_error</p>
        </div>
    }
    @if (_confirmed is { } purchase)
    {
        <div class="max-w-md rounded-xl border border-emerald-200 bg-emerald-50 p-4">
            <p role="status" class="text-sm font-medium text-emerald-900">@purchase.Message · Đơn <strong>#@purchase.OrderNumber</strong> · Hóa đơn <strong>#@purchase.InvoiceNumber</strong></p>
        </div>
    }
</section>

@code {
    private readonly CancellationTokenSource _lifetime = new();
    private string _orderNumber = "";
    private decimal? _amount;
    private bool _submitting;
    private string? _error;
    private MembershipPurchaseResponse? _confirmed;

    private async Task ConfirmAsync()
    {
        if (_submitting || _amount is not > 0 || string.IsNullOrWhiteSpace(_orderNumber))
            return;
        _submitting = true;
        _confirmed = null;
        _error = null;
        var ct = _lifetime.Token;
        try
        {
            _confirmed = await Plans.ConfirmCashAsync(_orderNumber.Trim().ToUpperInvariant(), new(_amount.Value), ct);
            _orderNumber = "";
            _amount = null;
        }
        catch (AuthApiException ex)
        {
            _error = ex.Message;
        }
        catch (OperationCanceledException) when (ct.IsCancellationRequested)
        {
            // The user left the receipt form.
        }
        finally
        {
            _submitting = false;
        }
    }

    public void Dispose()
    {
        _lifetime.Cancel();
        _lifetime.Dispose();
    }
}
