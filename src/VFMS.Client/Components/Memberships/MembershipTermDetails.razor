@using VFMS.Contracts.Memberships

<dl class="grid gap-3 text-sm sm:grid-cols-3">
    <div>
        <dt class="text-xs font-semibold text-vfms-text-secondary">Dịch vụ</dt>
        <dd class="mt-1 font-bold text-vfms-text">@ComponentLabel</dd>
    </div>
    @if (Membership.Activation is { } activation)
    {
        <div>
            <dt class="text-xs font-semibold text-vfms-text-secondary">Ngày mua</dt>
            <dd class="mt-1 font-bold text-vfms-text"><MembershipDate Date="@activation.PurchasedOn" /></dd>
        </div>
        <div>
            <dt class="text-xs font-semibold text-vfms-text-secondary">Hạn chọn ngày kích hoạt</dt>
            <dd class="mt-1 font-bold text-vfms-text"><MembershipDate Date="@activation.Deadline" /></dd>
        </div>
    }
    else if (Membership.StartDate is { } start && Membership.EndDate is { } end)
    {
        <div>
            <dt class="text-xs font-semibold text-vfms-text-secondary">Ngày kích hoạt</dt>
            <dd class="mt-1 font-bold text-vfms-text"><MembershipDate Date="@start" /></dd>
        </div>
        <div>
            <dt class="text-xs font-semibold text-vfms-text-secondary">Ngày hết hạn</dt>
            <dd class="mt-1 font-bold text-vfms-text"><MembershipDate Date="@end" /></dd>
        </div>
    }
</dl>
@if (Membership.Activation is { } window && window.Deadline >= MembershipDisplay.Today)
{
    var daysLeft = window.Deadline.DayNumber - MembershipDisplay.Today.DayNumber;
    <p class="mt-3 text-sm font-semibold text-amber-800">@(daysLeft > 0 ? $"Còn {daysLeft} ngày để chọn." : "Hôm nay là hạn chọn ngày.")</p>
}
else if (Membership.Status == MembershipStatuses.Scheduled && Membership.StartDate is { } scheduled)
{
    var days = scheduled.DayNumber - MembershipDisplay.Today.DayNumber;
    <p class="mt-3 text-sm font-semibold text-blue-800">@(days > 0 ? $"Bắt đầu sau {days} ngày" : "Đến ngày kích hoạt")</p>
}
else if (Membership.Status == MembershipStatuses.Active && Membership.EndDate is { } expiry)
{
    <p class="mt-3 text-sm font-semibold text-green-800">Còn @Math.Max(0, expiry.DayNumber - MembershipDisplay.Today.DayNumber + 1) ngày sử dụng</p>
}
else if (Membership.Status == MembershipStatuses.Expired)
{
    <p class="mt-3 text-sm font-semibold text-vfms-text-secondary">Còn 0 ngày sử dụng</p>
}

@code {
    [Parameter, EditorRequired] public MembershipSummaryResponse Membership { get; set; } = default!;

    private string ComponentLabel => Membership.ComponentType switch
    {
        "GYM" => "Gym",
        "YOGA" => "Yoga",
        "PT" => "Huấn luyện cá nhân (PT)",
        _ => Membership.ComponentType
    };
}
