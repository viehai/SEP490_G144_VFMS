@page "/"
@layout PublicLayout
@using VFMS.Client.Components.Memberships
@inject NavigationManager Navigation
@inject IJSRuntime JS

<PageTitle>VFMS - Kỷ Luật Thép & Đỉnh Cao Thể Lực</PageTitle>

<!-- Global Styles Scoped to Home for Brutal Minimalism, Marquee & Scroll Reveal -->
<style>
    .font-heading {
        font-family: 'Montserrat', sans-serif;
        text-transform: uppercase;
        letter-spacing: 0.05em;
    }

    .font-body {
        font-family: 'Inter', sans-serif;
    }

    /* Scroll Reveal Staggered Slide Up cho Thiết Bị */
    .equipment-reveal {
        opacity: 0;
        transform: translateY(20px);
        transition: opacity 0.4s ease-out, transform 0.4s ease-out;
        will-change: opacity, transform;
    }
    .equipment-reveal.revealed {
        opacity: 1;
        transform: translateY(0);
    }

    /* Infinite Marquee Animation - Không bị ngắt quãng */
    @@keyframes marquee {
        0% { transform: translateX(0%); }
        100% { transform: translateX(-50%); }
    }

    .animate-marquee {
        display: flex;
        width: max-content;
        animation: marquee 32s linear infinite;
    }

    .animate-marquee:hover {
        animation-play-state: paused;
    }

    /* Scroll Reveal Animation: Trượt nhẹ sang trái */
    .slide-reveal-right {
        opacity: 0;
        transform: translateX(30px);
        transition: opacity 0.8s ease-out, transform 0.8s ease-out;
        will-change: opacity, transform;
    }

    .slide-reveal-right.revealed {
        opacity: 1;
        transform: translateX(0);
    }
</style>

<div class="w-full max-w-full overflow-x-hidden bg-[#F7F4EC] text-[#383E43] font-body selection:bg-[#5F6F52] selection:text-white">

    <!-- ========================================================================= -->
    <!-- 1. HERO SECTION — Sage Athletic Minimalism, ảnh màu tự nhiên             -->
    <!-- ========================================================================= -->
    <section class="relative w-full h-screen min-h-[700px] flex items-center overflow-hidden bg-[#F7F4EC]">
        
        <!-- Background Image: màu tự nhiên, không filter grayscale/contrast/brightness -->
        <div class="absolute inset-0 z-0">
            <img src="/images/hero-bg.png"
                 alt="Victor Fitness Elite Training Facility"
                 class="w-full h-full object-cover object-center" />
            <!-- Warm Ivory gradient overlay từ trái sang — giúp text dễ đọc, không che ảnh -->
            <div class="absolute inset-0"
                 style="background: linear-gradient(90deg, rgba(247,244,236,0.98) 0%, rgba(247,244,236,0.90) 32%, rgba(247,244,236,0.55) 48%, rgba(247,244,236,0) 62%);">
            </div>
        </div>

        <!-- Hero Content: căn trái, tràn full chiều cao -->
        <div class="relative z-10 w-full max-w-6xl mx-auto px-6 sm:px-8 lg:px-12 flex flex-col justify-center">
            
            <!-- Eyebrow label -->
            <div class="inline-flex items-center gap-2 mb-6">
                <span class="w-5 h-px bg-[#5F6F52]"></span>
                <span class="font-heading text-xs font-bold tracking-widest text-[#5F6F52] uppercase">
                    V-FITNESS MANAGEMENT SYSTEM
                </span>
            </div>

            <!-- Main Headline -->
            <h1 class="font-heading font-black uppercase leading-tight tracking-tight mb-6 max-w-2xl">
                <span class="block text-4xl sm:text-6xl md:text-7xl lg:text-[5.5rem] text-[#383E43]">KỶ LUẬT TẠO NÊN</span>
                <span class="block text-4xl sm:text-6xl md:text-7xl lg:text-[5.5rem] text-[#5F6F52]">BẢN LĨNH THÉP</span>
            </h1>

            <!-- Subtext -->
            <p class="font-body text-base sm:text-lg text-[#69706A] font-normal max-w-xl mb-10 leading-relaxed">
                Hệ thống tập luyện và huấn luyện thể hình chuẩn hiệu suất cao. Không thỏa hiệp, không đường tắt — chỉ có sự kỷ luật, khoa học và kết quả đột phá.
            </p>

            <!-- CTA Buttons -->
            <div class="flex flex-col sm:flex-row items-start gap-3 w-full sm:w-auto">
                <!-- Primary CTA: Sage Green -->
                <button @onclick="ScrollToFeaturedClasses"
                        class="w-full sm:w-auto bg-[#5F6F52] hover:bg-[#4E5D44] text-white px-10 py-4 font-heading font-extrabold text-sm tracking-wider uppercase transition-colors duration-200 cursor-pointer rounded-lg">
                    KHÁM PHÁ CÁC LỚP HỌC
                </button>

                <!-- Secondary CTA: white/transparent, Sage border -->
                <a href="/auth/register"
                   class="w-full sm:w-auto bg-white hover:bg-[#E8EDE3] text-[#383E43] border border-[#5F6F52] px-10 py-4 font-heading font-extrabold text-sm tracking-wider uppercase transition-colors duration-200 text-center inline-block rounded-lg">
                    ĐĂNG KÝ HỘI VIÊN
                </a>
            </div>

            <!-- Stats Bar -->
            <div class="flex flex-wrap gap-8 sm:gap-12 mt-14 pt-8 border-t border-[#D8DED2] max-w-xl">
                <div>
                    <div class="font-heading text-2xl sm:text-3xl font-extrabold text-[#5F6F52]">100%</div>
                    <div class="font-body text-xs text-[#69706A] uppercase tracking-wider mt-1">Chuẩn Thiết Bị Olympic</div>
                </div>
                <div>
                    <div class="font-heading text-2xl sm:text-3xl font-extrabold text-[#5F6F52]">24/7</div>
                    <div class="font-body text-xs text-[#69706A] uppercase tracking-wider mt-1">Check-in FaceID &amp; QR</div>
                </div>
                <div>
                    <div class="font-heading text-2xl sm:text-3xl font-extrabold text-[#5F6F52]">50+</div>
                    <div class="font-body text-xs text-[#69706A] uppercase tracking-wider mt-1">HLV Chuyên Nghiệp</div>
                </div>
            </div>

        </div>

        <!-- Scroll Down Indicator -->
        <div class="absolute bottom-6 left-1/2 transform -translate-x-1/2 z-10 flex flex-col items-center">
            <span class="font-heading text-[10px] tracking-widest text-[#8A9089] uppercase mb-2">CUỘN XUỐNG</span>
            <div class="w-px h-8 bg-[#5F6F52]/50 animate-pulse"></div>
        </div>

    </section>

    <!-- ========================================================================= -->
    <!-- 2. FEATURED CLASSES SECTION — Sage Athletic Minimalism                   -->
    <!-- ========================================================================= -->
    <section id="featured-classes" class="w-full bg-[#F7F4EC] text-[#383E43] pt-16 sm:pt-20 pb-28 border-b border-[#D8DED2]">
        
        <!-- Infinite Marquee: Sage accent on ivory -->
        <div class="w-full max-w-full overflow-hidden bg-[#5F6F52] py-3 md:py-4 cursor-default select-none relative">
            <div class="animate-marquee whitespace-nowrap flex">
                <!-- Group 1 -->
                <div class="flex items-center gap-6 sm:gap-10 font-heading text-base sm:text-xl md:text-2xl font-black uppercase tracking-widest text-white pr-6 sm:pr-10 flex-shrink-0">
                    <span>GYM &amp; STRENGTH</span>
                    <span class="text-white/40 font-normal">—</span>
                    <span>YOGA STUDIO</span>
                    <span class="text-white/40 font-normal">—</span>
                    <span>PERSONAL TRAINER</span>
                    <span class="text-white/40 font-normal">—</span>
                    <span>HIIT</span>
                    <span class="text-white/40 font-normal">—</span>
                    <span>GYM &amp; STRENGTH</span>
                    <span class="text-white/40 font-normal">—</span>
                    <span>YOGA STUDIO</span>
                    <span class="text-white/40 font-normal">—</span>
                    <span>PERSONAL TRAINER</span>
                    <span class="text-white/40 font-normal">—</span>
                    <span>HIIT</span>
                    <span class="text-white/40 font-normal">—</span>
                </div>
                <!-- Group 2 (duplicate for seamless loop) -->
                <div class="flex items-center gap-6 sm:gap-10 font-heading text-base sm:text-xl md:text-2xl font-black uppercase tracking-widest text-white pr-6 sm:pr-10 flex-shrink-0" aria-hidden="true">
                    <span>GYM &amp; STRENGTH</span>
                    <span class="text-white/40 font-normal">—</span>
                    <span>YOGA STUDIO</span>
                    <span class="text-white/40 font-normal">—</span>
                    <span>PERSONAL TRAINER</span>
                    <span class="text-white/40 font-normal">—</span>
                    <span>HIIT</span>
                    <span class="text-white/40 font-normal">—</span>
                    <span>GYM &amp; STRENGTH</span>
                    <span class="text-white/40 font-normal">—</span>
                    <span>YOGA STUDIO</span>
                    <span class="text-white/40 font-normal">—</span>
                    <span>PERSONAL TRAINER</span>
                    <span class="text-white/40 font-normal">—</span>
                    <span>HIIT</span>
                    <span class="text-white/40 font-normal">—</span>
                </div>
            </div>
        </div>

        <div class="facility-map-section w-full px-4 sm:px-6 lg:px-8 py-16 mb-16">
            <div class="w-full max-w-[1650px] mx-auto">
                <header class="facility-intro">
                    <div>
                        <p class="facility-intro__eyebrow"><span aria-hidden="true"></span> VICTOR FITNESS / KHÔNG GIAN TẬP LUYỆN</p>
                        <h2>KHÁM PHÁ <br />PHÒNG TẬP</h2>
                    </div>
                    <p class="facility-intro__description">Làm quen với không gian Victor Fitness. Chọn một khu vực trên sơ đồ bên dưới để tìm hiểu thêm.</p>
                </header>
                <FacilityMap OnZoneAction="HandleFacilityZoneAction" />
            </div>
        </div>

        <!-- Equipment Showcase -->
        <section id="explore-equipment" class="w-full max-w-[1650px] mx-auto px-4 sm:px-6 lg:px-8 mb-24 relative">
            <!-- Watermark -->
            <div class="absolute top-0 sm:top-4 lg:top-8 right-0 sm:right-6 select-none pointer-events-none font-heading font-black text-6xl sm:text-8xl md:text-[9.5rem] lg:text-[13rem] text-[#E8EDE3] uppercase tracking-tighter leading-none z-0 overflow-hidden">
                STRENGTH
            </div>

            <!-- Section Header -->
            <div class="relative z-10 flex flex-col md:flex-row md:items-end justify-between mb-8 sm:mb-10 pb-6 border-b border-[#D8DED2]">
                <div>
                    <div class="flex items-center gap-2 mb-3">
                        <span class="w-2.5 h-2.5 bg-[#5F6F52] inline-block rounded-full"></span>
                        <span class="font-heading text-xs font-bold tracking-widest text-[#69706A] uppercase">
                            VFMS PRO EQUIPMENT
                        </span>
                    </div>
                    <h2 class="font-heading text-4xl sm:text-5xl lg:text-7xl font-black uppercase text-[#383E43] tracking-tighter leading-[0.95]">
                        THIẾT BỊ <br />
                        PHÒNG TẬP
                    </h2>
                </div>

                <p class="font-body text-xs sm:text-sm text-[#69706A] max-w-sm mt-4 md:mt-0 font-medium leading-relaxed text-left md:text-right">
                    Nhập khẩu tiêu chuẩn Olympic quốc tế, tối ưu từng góc chuyển động giải phẫu cơ bắp và hỗ trợ tải trọng nặng an toàn tuyệt đối.
                </p>
            </div>

            <!-- Category Filter Buttons -->
            <div class="relative z-10 flex flex-wrap items-center gap-2 sm:gap-3 mb-8 sm:mb-10">
                @foreach (var cat in EquipmentCategories)
                {
                    var isActive = SelectedEquipmentCategory == cat.Key;
                    <button type="button"
                            @onclick="() => SelectEquipmentCategory(cat.Key)"
                            class="font-heading text-xs sm:text-sm font-bold uppercase tracking-wider px-4 sm:px-6 py-2.5 sm:py-3 border rounded-lg cursor-pointer transition-colors duration-150 @(isActive ? "bg-[#5F6F52] text-white border-[#5F6F52]" : "bg-white text-[#383E43] border-[#D8DED2] hover:border-[#5F6F52] hover:text-[#5F6F52]")">
                        @cat.Label
                    </button>
                }
            </div>

            <!-- Equipment Grid -->
            <div class="relative z-10">
                <div id="equipment-grid" class="grid grid-cols-2 md:grid-cols-3 lg:grid-cols-4 gap-4 sm:gap-6">
                    @for (int i = 0; i < DisplayedEquipments.Count; i++)
                    {
                        var item = DisplayedEquipments[i];
                        var delay = (i % 4) * 120;
                        <div style="transition-delay: @(delay)ms;"
                             class="equipment-reveal relative aspect-square bg-white border border-[#D8DED2] overflow-hidden group select-none flex items-center justify-center p-6 sm:p-8 cursor-default rounded-xl hover:border-[#5F6F52] transition-colors">
                            
                            <!-- Equipment image: màu tự nhiên, nhẹ scale khi hover -->
                            <img src="@item.ImageUrl"
                                 alt="@item.Name"
                                 loading="lazy"
                                 class="w-full h-full object-contain group-hover:scale-105 transition-transform duration-300 ease-out pointer-events-none" />

                            <!-- Label: Sage nền nhạt, trượt lên từ dưới -->
                            <div class="absolute bottom-0 inset-x-0 bg-white/95 border-t border-[#D8DED2] px-3.5 py-3 translate-y-full group-hover:translate-y-0 transition-transform duration-200 ease-out z-20 pointer-events-none rounded-b-xl">
                                <span class="font-heading text-[10px] sm:text-[11px] font-bold text-[#5F6F52] uppercase tracking-wider block">
                                    @item.MuscleGroup
                                </span>
                                <h4 class="font-heading font-bold text-xs sm:text-sm uppercase tracking-tight text-[#383E43] truncate">
                                    @item.Name
                                </h4>
                            </div>
                        </div>
                    }
                </div>
            </div>

            <!-- View All Button -->
            <div class="relative z-10 mt-12 sm:mt-16 flex justify-center">
                <button type="button"
                        @onclick="ViewAllEquipments"
                        class="font-heading font-bold text-xs sm:text-sm uppercase tracking-widest px-8 sm:px-12 py-4 bg-[#5F6F52] hover:bg-[#4E5D44] text-white rounded-lg inline-flex items-center gap-3 transition-all duration-200 cursor-pointer">
                    <span>XEM TẤT CẢ THIẾT BỊ</span>
                    <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3"></path>
                    </svg>
                </button>
            </div>
        </section>

        <!-- Section Container for Featured Classes -->
        <div class="w-full max-w-[1650px] mx-auto px-4 sm:px-6 lg:px-8">
            
            <!-- Section Header -->
            <div class="flex flex-col md:flex-row md:items-end justify-between mb-12 pb-6 border-b border-[#D8DED2]">
                <div>
                    <div class="flex items-center gap-2 mb-3">
                        <span class="w-2.5 h-2.5 bg-[#5F6F52] inline-block rounded-full"></span>
                        <span class="font-heading text-xs font-bold tracking-widest text-[#69706A] uppercase">
                            VFMS SIGNATURE CURRICULUM
                        </span>
                    </div>
                    <h2 class="font-heading text-4xl sm:text-5xl lg:text-7xl font-black uppercase text-[#383E43] tracking-tighter leading-[0.95]">
                        CÁC LỚP HỌC <br />
                        NỔI BẬT
                    </h2>
                </div>
                
                <p class="font-body text-xs sm:text-sm text-[#69706A] max-w-sm mt-4 md:mt-0 font-normal leading-relaxed text-left md:text-right">
                    Được thiết kế dựa trên giáo trình thể lực cường độ cao, tối ưu hóa tăng cơ, đốt mỡ và tái tạo năng lượng thể chất toàn diện.
                </p>
            </div>

            <!-- Class Cards Grid: ảnh lớn, white surface, border nhẹ, radius 10px -->
            <div class="w-full overflow-hidden">
                <div id="classes-grid" class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-4 md:gap-5">
                    @for (int i = 0; i < FeaturedClasses.Count; i++)
                    {
                        var item = FeaturedClasses[i];
                        var delayStyle = $"transition-delay: {i * 250}ms;";

                        <div style="@delayStyle"
                             class="slide-reveal-right group relative w-full h-[68vh] min-h-[520px] max-h-[750px] overflow-hidden bg-[#EEF1EA] border border-[#D8DED2] hover:border-[#5F6F52] rounded-xl select-none transition-all duration-300">
                            
                            <!-- Ảnh màu tự nhiên, nhẹ scale khi hover -->
                            <img src="@item.ImageUrl"
                                 alt="@item.Title"
                                 class="w-full h-full object-cover object-center group-hover:scale-105 transition-all duration-700 ease-out pointer-events-none" />

                            <!-- Sage accent nhỏ ở góc trên -->
                            <div class="absolute top-3 left-3 z-10">
                                <span class="bg-[#5F6F52] text-white font-heading text-[10px] font-bold uppercase tracking-wider px-2 py-1 rounded-md">@item.Badge</span>
                            </div>

                            <!-- Info layer: xuất hiện khi hover -->
                            <div class="absolute inset-x-0 bottom-0 bg-white/95 backdrop-blur-sm border-t border-[#D8DED2] p-4 translate-y-full group-hover:translate-y-0 transition-transform duration-300 ease-out pointer-events-none rounded-b-xl">
                                <span class="text-[10px] font-bold text-[#5F6F52] uppercase tracking-widest block">@item.Category</span>
                                <h4 class="font-heading font-bold text-sm text-[#383E43] mt-0.5 truncate">@item.TitleShort</h4>
                                <p class="text-xs text-[#69706A] mt-1">@item.Duration · @item.Level</p>
                            </div>
                        </div>
                    }
                </div>
            </div>

            <!-- Bottom Information Banner -->
            <div class="mt-16 p-8 bg-white border border-[#D8DED2] rounded-xl flex flex-col md:flex-row items-center justify-between gap-6">
                <div>
                    <h4 class="font-heading text-lg font-extrabold text-[#383E43] uppercase tracking-wide">
                        CHƯA CHỌN ĐƯỢC LỘ TRÌNH PHÙ HỢP?
                    </h4>
                    <p class="font-body text-sm text-[#69706A] mt-1">
                        Hãy để đội ngũ chuyên gia VFMS kiểm tra thể trạng và thiết kế giáo án tập luyện chuyên biệt cho bạn.
                    </p>
                </div>
                <a href="#featured-classes"
                   class="bg-[#5F6F52] hover:bg-[#4E5D44] text-white px-8 py-3.5 font-heading font-bold text-xs uppercase tracking-widest transition-colors duration-200 whitespace-nowrap rounded-lg inline-block">
                    ĐẶT LỊCH TƯ VẤN MIỄN PHÍ
                </a>
            </div>

        </div>

    </section>

    <!-- ========================================================================= -->
    <!-- 3. PRICING & MEMBERSHIPS SECTION — Sage Athletic Minimalism               -->
    <!-- ========================================================================= -->
    <section id="pricing-memberships" class="w-full bg-white text-[#383E43] py-24 border-b border-[#D8DED2]">
        <div class="w-full max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
            
            <!-- Section Header -->
            <div class="flex flex-col md:flex-row md:items-end justify-between mb-12 pb-6 border-b border-[#D8DED2]">
                <div>
                    <div class="flex items-center gap-2 mb-3">
                        <span class="w-2.5 h-2.5 bg-[#5F6F52] inline-block rounded-full"></span>
                        <span class="font-heading text-xs font-bold tracking-widest text-[#69706A] uppercase">
                            VFMS PRICING &amp; MEMBERSHIP TIERS
                        </span>
                    </div>
                    <h2 class="font-heading text-4xl sm:text-5xl lg:text-6xl font-black uppercase text-[#383E43] tracking-tight">
                        GÓI THẺ &amp; LỊCH TẬP
                    </h2>
                </div>
                <p class="font-body text-xs sm:text-sm text-[#69706A] max-w-md mt-4 md:mt-0 font-normal leading-relaxed">
                    Minh bạch tuyệt đối, tự động bảo lưu trực tuyến theo quy chế và công khai lịch biểu huấn luyện cố định.
                </p>
            </div>

            <!-- 3 Tabs Navigation -->
            <div class="flex flex-wrap gap-3 mb-12">
                <button @onclick='() => ActivePricingTab = "GYM"'
                        class="px-6 sm:px-8 py-3.5 font-heading font-bold text-xs sm:text-sm uppercase tracking-wider border transition-all cursor-pointer rounded-lg @(ActivePricingTab == "GYM" ? "bg-[#5F6F52] text-white border-[#5F6F52]" : "bg-white text-[#383E43] border-[#D8DED2] hover:border-[#5F6F52]")">
                    GYM MEMBERSHIP
                </button>
                <button @onclick='() => ActivePricingTab = "YOGA"'
                        class="px-6 sm:px-8 py-3.5 font-heading font-bold text-xs sm:text-sm uppercase tracking-wider border transition-all cursor-pointer rounded-lg @(ActivePricingTab == "YOGA" ? "bg-[#5F6F52] text-white border-[#5F6F52]" : "bg-white text-[#383E43] border-[#D8DED2] hover:border-[#5F6F52]")">
                    YOGA STUDIO
                </button>
                <button @onclick='() => ActivePricingTab = "PT"'
                        class="px-6 sm:px-8 py-3.5 font-heading font-bold text-xs sm:text-sm uppercase tracking-wider border transition-all cursor-pointer rounded-lg @(ActivePricingTab == "PT" ? "bg-[#5F6F52] text-white border-[#5F6F52]" : "bg-white text-[#383E43] border-[#D8DED2] hover:border-[#5F6F52]")">
                    PERSONAL TRAINER
                </button>
            </div>

            <!-- TAB 1: GYM MEMBERSHIP -->
            @if (ActivePricingTab == "GYM")
            {
                <AuthorizeView Roles="Customer,Member">
                    <Authorized>
                        <MembershipPlanCatalog />
                    </Authorized>
                    <NotAuthorized>
                <p class="mb-5 font-body text-sm text-[#69706A]">
                    Các gói dưới đây dùng để minh họa. Khách hàng và hội viên có thể
                    <a class="font-bold underline text-[#5F6F52]" href="/auth/login">đăng nhập</a> để xem các gói hiện đang mở bán.
                </p>
                <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
                    
                    <!-- THẺ 1: 3 THÁNG -->
                    <div class="bg-white border border-[#D8DED2] p-8 flex flex-col justify-between rounded-xl hover:border-[#5F6F52] transition-colors">
                        <div>
                            <div class="pb-6 border-b border-[#D8DED2]">
                                <span class="font-heading text-xs font-bold uppercase tracking-widest text-[#69706A] block mb-1">GÓI CƠ BẢN</span>
                                <h3 class="font-heading text-2xl font-black uppercase text-[#383E43]">3 THÁNG</h3>
                                <p class="font-body text-xs text-[#69706A] mt-1">Xây dựng thói quen và rèn luyện thể lực nền tảng</p>
                            </div>

                            <div class="py-6 border-b border-[#EEF1EA]">
                                <div class="font-heading text-3xl sm:text-4xl font-black text-[#383E43]">
                                    2.400.000 <span class="text-lg font-bold text-[#5F6F52]">₫</span>
                                </div>
