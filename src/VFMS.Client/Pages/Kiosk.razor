@page "/kiosk"
@layout PublicLayout
@attribute [Authorize(Roles = "Staff,Manager,Customer,Member")]
@using Microsoft.AspNetCore.Authorization
@using VFMS.Contracts.CheckIn
@inject VfmsApiClient Api
@inject IJSRuntime JS
@implements IAsyncDisposable

<PageTitle>Kiosk check-in | Victor Fitness</PageTitle>

@* Entrance/exit kiosk (UC-44, UC-45). Staff and Manager can scan anyone; a Customer or Member only themselves (the API enforces it). *@
<div class="mx-auto max-w-6xl space-y-8 px-4 py-28 sm:px-6 font-['Inter',sans-serif] text-[#252525]">
    <header class="border-b-2 border-black pb-7">
        <p class="font-['Montserrat'] mb-3 text-[10px] font-bold tracking-[.18em] text-neutral-500">VFMS / KIOSK</p>
        <h1 class="font-['Montserrat'] text-3xl font-extrabold uppercase tracking-tight sm:text-4xl">Kiosk check-in<span>.</span></h1>
        <p class="mt-3 text-sm text-[#545454]">Quét khuôn mặt hoặc mã QR: lần quét khi đang ở ngoài là check-in, lần quét khi đang ở trong phòng tập là check-out.</p>
    </header>

    @if (_result is not null)
    {
        <div class="border-2 p-6 rounded-none @(_ok ? "border-emerald-700 bg-emerald-50" : "border-red-700 bg-red-50")" role="status">
            <p class="font-['Montserrat'] text-lg font-extrabold uppercase @(_ok ? "text-emerald-800" : "text-red-800")">@(_ok ? "Mở cổng" : "Từ chối")</p>
            <p class="mt-2 text-sm">@_result</p>
        </div>
    }

    <div class="grid gap-6 lg:grid-cols-[minmax(0,1fr)_320px]">
        <section class="space-y-4 border-2 border-black bg-white p-6 rounded-none">
            <h2 class="font-['Montserrat'] text-sm font-extrabold uppercase">FaceID</h2>
            <div class="relative aspect-[4/3] w-full max-w-xl overflow-hidden border-2 border-black bg-[#0A0A0A] rounded-none">
                <video @ref="_video" class="h-full w-full -scale-x-100 object-cover" playsinline muted></video>
                @if (!_cameraOn)
                {
                    <p class="absolute inset-0 flex items-center justify-center p-6 text-center text-xs text-neutral-300">Camera đang tắt</p>
                }
            </div>
            <div class="flex flex-wrap gap-2">
                @if (!_cameraOn)
                {
                    <button type="button" disabled="@_busy" class="bg-black px-6 py-3 text-xs font-bold uppercase text-white rounded-none disabled:opacity-40" @onclick="StartCamera">Bật camera</button>
                }
                else
                {
                    <button type="button" disabled="@_busy" class="bg-black px-6 py-3 text-xs font-bold uppercase text-white rounded-none disabled:opacity-40" @onclick="ScanFace">@(_busy ? "Đang quét…" : "Quét khuôn mặt")</button>
                    <button type="button" class="px-4 py-3 text-xs font-bold uppercase underline" @onclick="StopCamera">Tắt camera</button>
                }
            </div>
            <p class="text-xs text-neutral-500">Ảnh chỉ được xử lý trên thiết bị; chỉ mẫu 128 số được gửi lên máy chủ.</p>
        </section>

        <section class="space-y-4 border-2 border-black bg-white p-6 rounded-none">
            <h2 class="font-['Montserrat'] text-sm font-extrabold uppercase">Mã QR</h2>
            <label class="block text-xs font-semibold">Mã QR của hội viên
                <input class="mt-1 w-full border border-[#CFCFCF] px-3 py-2 font-mono text-xs rounded-none" @bind="_qr" @bind:event="oninput" placeholder="Dán mã từ ứng dụng hội viên" />
            </label>
            <div class="flex flex-wrap gap-2">
                <button type="button" disabled="@(_busy || string.IsNullOrWhiteSpace(_qr))" class="bg-black px-5 py-3 text-xs font-bold uppercase text-white rounded-none disabled:opacity-40" @onclick="() => Scan(new KioskScanRequest(null, _qr.Trim()))">Quét mã</button>
            </div>
            <p class="text-xs text-neutral-500">Mã QR dùng một lần và hết hạn sau 2 phút.</p>
        </section>
    </div>
</div>

@code {
    private ElementReference _video;
    private bool _cameraOn, _busy, _ok;
    private string _qr = string.Empty;
    private string? _result;

    private async Task StartCamera()
    {
        _busy = true;
        try
        {
            await JS.InvokeVoidAsync("import", "./js/face-capture.js");
            _cameraOn = await JS.InvokeAsync<bool>("vfmsFace.start", _video);
            _result = null;
        }
        catch (JSException) { Show(false, "Không mở được camera hoặc tải mô hình nhận diện. Hãy cấp quyền camera và thử lại."); }
        finally { _busy = false; }
    }

    private async Task ScanFace()
    {
        _busy = true;
        try
        {
            var descriptor = await JS.InvokeAsync<float[]?>("vfmsFace.capture", _video);
            if (descriptor is null)
                Show(false, "Không phát hiện khuôn mặt. Hãy nhìn thẳng vào camera và thử lại.");
            else
                await Scan(new KioskScanRequest(descriptor, null));
        }
        catch (JSException) { Show(false, "Không xử lý được ảnh. Vui lòng thử lại."); }
        finally { _busy = false; }
    }

    /// <summary>The API decides the direction: inside → check out, outside → check in.</summary>
    private async Task Scan(KioskScanRequest request)
    {
        _busy = true;
        try
        {
            var r = await Api.PostAsync<KioskScanResultResponse>("api/kiosk/scan", request);
            if (r.CheckIn is { } entry)
                Show(true, $"CHECK-IN. {entry.Message}{(entry.CompletedPtSessionId is null ? "" : " Buổi PT đã được ghi nhận hoàn thành.")}");
            else if (r.CheckOut is { } exit)
                Show(true, $"CHECK-OUT. Tạm biệt, {exit.MemberName}! Thời gian tập: {exit.MinutesInside / 60}h {exit.MinutesInside % 60}m.");
            _qr = string.Empty;
        }
        catch (ApiException ex) { Show(false, ex.Message); }
        finally { _busy = false; }
    }

    private async Task StopCamera()
    {
        _cameraOn = false;
        try { await JS.InvokeVoidAsync("vfmsFace.stop"); } catch (JSException) { }
    }

    private void Show(bool ok, string message) { _ok = ok; _result = message; }

    public async ValueTask DisposeAsync()
    {
        if (_cameraOn)
            try { await JS.InvokeVoidAsync("vfmsFace.stop"); } catch (JSException) { } catch (JSDisconnectedException) { }
    }
}
