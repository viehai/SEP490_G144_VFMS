@page "/manager/feedback"
@page "/staff/feedback"
@layout ManagerAdminLayout
@using Microsoft.AspNetCore.Authorization
@using VFMS.Client.Components.Operations
@using VFMS.Contracts.Common
@using VFMS.Contracts.Feedback
@attribute [Authorize(Roles = "Manager,Staff")]
@inject SystemAdministrationApiClient Api
@implements IDisposable

<PageTitle>Phản hồi khách hàng | Victor Fitness</PageTitle>

<div class="workspace-page space-y-6">
    <header class="border-b border-[#D8D1CD] pb-6">
        <p class="text-xs font-bold tracking-wider text-[#B83A3A]">VFMS / CUSTOMER FEEDBACK</p>
        <h1 class="mt-2 text-3xl font-extrabold text-[#242424]">Phản hồi khách hàng.</h1>
        <p class="mt-2 text-sm text-[#6F6966]">Xem đánh giá công khai và trả lời hội viên.</p>
    </header>

    @if (_notice is not null) { <p role="status" class="rounded-lg border border-emerald-300 bg-emerald-50 p-3 text-sm">@_notice</p> }
    @if (_error is not null) { <p role="alert" class="rounded-lg border border-red-300 bg-red-50 p-3 text-sm">@_error</p> }

    <form @onsubmit="ApplyFiltersAsync" @onsubmit:preventDefault class="flex flex-wrap items-end gap-3 rounded-xl border border-[#D8D1CD] bg-[#F8F5F2] p-4">
        <label class="text-xs font-semibold text-[#242424]">Tìm kiếm
            <input class="mt-1 block rounded-lg border border-[#D8D1CD] px-3 py-2 text-sm" @bind="_search" />
        </label>
        <label class="text-xs font-semibold text-[#242424]">Số sao
            <select class="mt-1 block rounded-lg border border-[#D8D1CD] px-3 py-2 text-sm" @bind="_rating">
                <option value="">Tất cả</option>
                @for (var rating = 5; rating >= 1; rating--)
                {
                    <option value="@rating">@rating sao</option>
                }
            </select>
        </label>
        <button type="submit" class="rounded-lg border border-[#C9C0BB] px-3 py-2 text-xs font-bold" disabled="@Busy">Lọc</button>
    </form>

    @if (_loading)
    {
        <p role="status">Đang tải phản hồi...</p>
    }
    else if (_page is { Items.Count: > 0 } page)
    {
        <div class="divide-y divide-[#D8D1CD] overflow-hidden rounded-xl border border-[#D8D1CD] bg-[#F8F5F2]">
            @foreach (var row in page.Items)
            {
                <article @key="row.Id" class="p-5">
                    <div class="flex flex-wrap items-start justify-between gap-3">
                        <div>
                            <p class="text-sm font-bold">@row.MemberName · @(row.PackageName ?? "Đánh giá phòng gym")</p>
                            <p class="mt-1 text-xs text-[#6F6966]">@row.CreatedAt.ToLocalTime().ToString("dd/MM/yyyy HH:mm")</p>
                            <p class="mt-2 text-sm text-[#B83A3A]">@Stars(row.Rating)</p>
                            <p class="mt-3 whitespace-pre-wrap text-sm">@(row.Comment ?? "Không có nội dung")</p>
                            @if (!string.IsNullOrWhiteSpace(row.ManagerReply))
                            {
                                <p class="mt-3 rounded-lg bg-[#F3EDEA] p-3 text-sm"><b>Phản hồi:</b> @row.ManagerReply</p>
                            }
                        </div>
                        <button type="button" class="rounded-lg border border-[#C9C0BB] px-3 py-2 text-xs font-bold"
                                disabled="@Busy" @onclick="() => BeginReply(row)">
                            @(string.IsNullOrWhiteSpace(row.ManagerReply) ? "Trả lời" : "Sửa trả lời")
                        </button>
                    </div>
                    @if (_editingId == row.Id)
                    {
                        <div class="mt-4 border-t border-[#D8D1CD] pt-4">
                            <label class="block text-xs font-semibold">Nội dung trả lời
                                <textarea class="mt-1 block w-full rounded-lg border border-[#D8D1CD] px-3 py-2 text-sm"
                                          rows="3" maxlength="1000" @bind="_reply"></textarea>
                            </label>
                            <div class="mt-2 flex gap-2">
                                <button type="button" class="rounded-lg bg-[#B83A3A] px-3 py-2 text-xs font-bold text-white"
                                        disabled="@Busy" @onclick="() => SaveReplyAsync(row)">Lưu trả lời</button>
                                <button type="button" class="rounded-lg border px-3 py-2 text-xs font-bold" @onclick="CancelReply">Hủy</button>
                            </div>
                        </div>
                    }
                </article>
            }
            @if (page.TotalCount > page.PageSize)
            {
                <Pager Page="page.Page" PageSize="page.PageSize" TotalCount="page.TotalCount"
                       Noun="đánh giá" Disabled="@Busy" OnPage="LoadAsync" />
            }
        </div>
    }
    else
    {
        <p>Không có đánh giá phù hợp.</p>
    }
</div>

@code {
    private readonly CancellationTokenSource _lifetime = new();
    private PagedResponse<FeedbackResponse>? _page;
    private string _search = "", _reply = "";
    private int? _rating, _editingId;
    private string? _notice, _error;
    private bool _loading, _working;
    private bool Busy => _loading || _working;

    protected override Task OnInitializedAsync() => LoadAsync(1);

    private async Task LoadAsync(int page)
    {
        _loading = true;
        try
        {
            _page = await Api.GetFeedbackAsync(new(
                string.IsNullOrWhiteSpace(_search) ? null : _search.Trim(),
                null, _rating, page, 10), _lifetime.Token);
        }
        catch (AuthApiException error) { _error = error.Message; }
        catch (OperationCanceledException) when (_lifetime.IsCancellationRequested) { }
        finally { _loading = false; }
    }

    private Task ApplyFiltersAsync() => LoadAsync(1);

    private void BeginReply(FeedbackResponse row)
    {
        _editingId = row.Id;
        _reply = row.ManagerReply ?? "";
        _error = null;
    }

    private void CancelReply() => _editingId = null;

    private async Task SaveReplyAsync(FeedbackResponse row)
    {
        if (string.IsNullOrWhiteSpace(_reply))
        {
            _error = "Vui lòng nhập nội dung trả lời.";
            return;
        }
        _working = true;
        _notice = _error = null;
        try
        {
            await Api.ReplyFeedbackAsync(row.Id, new(_reply.Trim()), _lifetime.Token);
            _editingId = null;
            _notice = "Đã gửi trả lời.";
            await LoadAsync(_page?.Page ?? 1);
        }
        catch (AuthApiException error) { _error = error.Message; }
        catch (OperationCanceledException) when (_lifetime.IsCancellationRequested) { }
        finally { _working = false; }
    }

    private static string Stars(int rating) => new string('★', rating) + new string('☆', 5 - rating);

    public void Dispose() { _lifetime.Cancel(); _lifetime.Dispose(); }
}
