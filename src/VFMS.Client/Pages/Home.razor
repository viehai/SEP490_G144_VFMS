        <!-- ===================================================================== -->
        <div class="w-full max-w-full overflow-hidden bg-[#0A0A0A] py-3 md:py-4 border-y-2 border-black cursor-default select-none relative">
            <div class="animate-marquee whitespace-nowrap flex">
                <!-- Group 1 -->
                <div class="flex items-center gap-6 sm:gap-10 font-heading text-base sm:text-xl md:text-2xl font-black uppercase tracking-widest text-white pr-6 sm:pr-10 flex-shrink-0">
                    <span class="hover:text-neutral-400 transition-colors">GYM &amp; STRENGTH</span>
                    <span class="text-neutral-600 font-normal">—</span>
                    <span class="hover:text-neutral-400 transition-colors">YOGA STUDIO</span>
                    <span class="text-neutral-600 font-normal">—</span>
                    <span class="hover:text-neutral-400 transition-colors">PERSONAL TRAINER</span>
                    <span class="text-neutral-600 font-normal">—</span>
                    <span class="hover:text-neutral-400 transition-colors">HIIT</span>
                    <span class="text-neutral-600 font-normal">—</span>
                    <span class="hover:text-neutral-400 transition-colors">GYM &amp; STRENGTH</span>
                    <span class="text-neutral-600 font-normal">—</span>
                    <span class="hover:text-neutral-400 transition-colors">YOGA STUDIO</span>
                    <span class="text-neutral-600 font-normal">—</span>
                    <span class="hover:text-neutral-400 transition-colors">PERSONAL TRAINER</span>
                    <span class="text-neutral-600 font-normal">—</span>
                    <span class="hover:text-neutral-400 transition-colors">HIIT</span>
                    <span class="text-neutral-600 font-normal">—</span>
                </div>
                <!-- Group 2 -->
                <div class="flex items-center gap-6 sm:gap-10 font-heading text-base sm:text-xl md:text-2xl font-black uppercase tracking-widest text-white pr-6 sm:pr-10 flex-shrink-0" aria-hidden="true">
                    <span class="hover:text-neutral-400 transition-colors">GYM &amp; STRENGTH</span>
                    <span class="text-neutral-600 font-normal">—</span>
                    <span class="hover:text-neutral-400 transition-colors">YOGA STUDIO</span>
                    <span class="text-neutral-600 font-normal">—</span>
                    <span class="hover:text-neutral-400 transition-colors">PERSONAL TRAINER</span>
                    <span class="text-neutral-600 font-normal">—</span>
                    <span class="hover:text-neutral-400 transition-colors">HIIT</span>
                    <span class="text-neutral-600 font-normal">—</span>
                    <span class="hover:text-neutral-400 transition-colors">GYM &amp; STRENGTH</span>
                    <span class="text-neutral-600 font-normal">—</span>
                    <span class="hover:text-neutral-400 transition-colors">YOGA STUDIO</span>
                    <span class="text-neutral-600 font-normal">—</span>
                    <span class="hover:text-neutral-400 transition-colors">PERSONAL TRAINER</span>
                    <span class="text-neutral-600 font-normal">—</span>
                    <span class="hover:text-neutral-400 transition-colors">HIIT</span>
                    <span class="text-neutral-600 font-normal">—</span>
                </div>
            </div>
        </div>

        <div class="facility-map-section w-full px-4 sm:px-6 lg:px-8 py-16 mb-16">
            <div class="w-full max-w-[1650px] mx-auto">
                <header class="facility-intro">
                    <div>
                        <p class="facility-intro__eyebrow"><span aria-hidden="true"></span> VICTOR FITNESS / KHÔNG GIAN TẬP LUYỆN</p>
                        <h2>KHÁM PHÁ <br />PHÒNG TẬP</h2>
                    </div>
                    <p class="facility-intro__description">Làm quen với không gian Victor Fitness. Chọn một khu vực trên sơ đồ bên dưới để tìm hiểu thêm.</p>
                </header>
