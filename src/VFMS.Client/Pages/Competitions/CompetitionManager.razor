@page "/manager/competitions"
@page "/staff/competitions"
@layout ManagerAdminLayout
@attribute [Microsoft.AspNetCore.Authorization.Authorize(Roles = "Manager,Staff")]
@using VFMS.Client.Components.Promotions
@using VFMS.Client.Components.Operations
@inject CompetitionApiClient Api
@inject IJSRuntime JS
@inject AuthenticationStateProvider AuthState

<PageTitle>Quản lý cuộc thi | Victor Fitness</PageTitle>

<div class="workspace-page space-y-8 font-['Inter',sans-serif] text-[#252525]">
    <header class="flex flex-col justify-between gap-5 border-b-2 border-black pb-7 md:flex-row md:items-end">
        <div>
            <p class="workspace-heading mb-3 text-[10px] font-bold tracking-[.18em] text-[#71717A]">VFMS / CUỘC THI</p>
            <h1 class="workspace-heading text-3xl font-extrabold uppercase tracking-tight sm:text-4xl">Quản lý cuộc thi<span class="text-[#6366F1]">.</span></h1>
        </div>
        <div class="flex flex-wrap gap-3">
            <button type="button" @onclick="ReloadAsync" disabled="@_loading" class="workspace-heading border border-black bg-white px-3 py-2 text-[10px] font-bold uppercase tracking-wider rounded-none">Làm mới ↻</button>
            @if (_isManager)
            {
            <button type="button" @onclick="() => OpenFormAsync(null)" class="workspace-heading border-2 border-black bg-black px-3 py-2 text-[10px] font-bold uppercase tracking-wider text-white rounded-none">+ Tạo cuộc thi</button>
            }
        </div>
    </header>

    @if (_error is not null && _panel is Panel.None)
    {
        <div class="border-2 border-[#EF4444] bg-red-50 p-4 text-sm text-red-800" role="alert">@_error</div>
    }

    @if (_showCreate)
    {
        <section class="border-2 border-black bg-white p-6 rounded-none" aria-labelledby="create-title">
            <h2 id="create-title" class="workspace-heading mb-5 text-sm font-extrabold uppercase tracking-wider">@(_replaceOnly ? "Thay voucher chưa thể trao" : _editingId.HasValue ? "Chỉnh sửa cuộc thi" : "Tạo cuộc thi mới")</h2>
            @if (!_replaceOnly)
            {
            <div class="grid gap-4 md:grid-cols-2">
                <div class="md:col-span-2">
                    <label for="c-name" class="workspace-heading mb-2 block text-[10px] font-bold uppercase tracking-wider">TÊN CUỘC THI *</label>
                    <input id="c-name" class="w-full border border-[#CFCFCF] px-3 py-2 text-sm" @bind="_formName" />
                </div>
                <div class="md:col-span-2">
                    <label for="c-desc" class="workspace-heading mb-2 block text-[10px] font-bold uppercase tracking-wider">MÔ TẢ</label>
                    <textarea id="c-desc" rows="2" class="w-full border border-[#CFCFCF] px-3 py-2 text-sm" @bind="_formDescription"></textarea>
                </div>
                <div>
                    <label for="c-reg-start" class="workspace-heading mb-2 block text-[10px] font-bold uppercase tracking-wider">BẮT ĐẦU ĐĂNG KÝ (UTC+7) *</label>
                    <input id="c-reg-start" type="datetime-local" class="w-full border border-[#CFCFCF] px-3 py-2 text-sm" @bind="_formRegistrationStart" />
                </div>
                <div>
                    <label for="c-reg-end" class="workspace-heading mb-2 block text-[10px] font-bold uppercase tracking-wider">KẾT THÚC ĐĂNG KÝ (UTC+7) *</label>
                    <input id="c-reg-end" type="datetime-local" class="w-full border border-[#CFCFCF] px-3 py-2 text-sm" @bind="_formRegistrationEnd" />
                </div>
                <div>
                    <label for="c-start" class="workspace-heading mb-2 block text-[10px] font-bold uppercase tracking-wider">BẮT ĐẦU THI (UTC+7) *</label>
                    <input id="c-start" type="datetime-local" class="w-full border border-[#CFCFCF] px-3 py-2 text-sm" @bind="_formStart" />
                </div>
                <div>
                    <label for="c-end" class="workspace-heading mb-2 block text-[10px] font-bold uppercase tracking-wider">KẾT THÚC THI (UTC+7) *</label>
                    <input id="c-end" type="datetime-local" class="w-full border border-[#CFCFCF] px-3 py-2 text-sm" @bind="_formEnd" />
                </div>
                <div>
                    <label for="c-max" class="workspace-heading mb-2 block text-[10px] font-bold uppercase tracking-wider">TỐI ĐA NGƯỜI THAM GIA</label>
                    <input id="c-max" type="number" min="1" class="w-full border border-[#CFCFCF] px-3 py-2 text-sm" @bind="_formMaxParticipants" />
                </div>
            </div>
                <div class="mt-4">
                    <label for="c-rules" class="workspace-heading mb-2 block text-[10px] font-bold uppercase tracking-wider">Thể lệ và cách tính điểm</label>
                    <textarea id="c-rules" rows="2" class="w-full border border-[#CFCFCF] px-3 py-2 text-sm" @bind="_formRules"></textarea>
                </div>
            }
            <CompetitionRewardEditor Rows="_rewardRows" EndUtc="ToUtc(_formEnd)" CompetitionId="_editingId" ReplaceOnly="_replaceOnly" ReadOnly="_published" />
            <div class="mt-6 flex flex-wrap gap-3">
                <button type="button" @onclick="CreateAsync" disabled="@_busy" class="workspace-heading border-2 border-black bg-black px-5 py-3 text-xs font-bold uppercase tracking-wider text-white disabled:opacity-50 rounded-none">@(_busy ? "Đang lưu…" : _editingId.HasValue ? "Lưu thay đổi" : "Tạo cuộc thi")</button>
                <button type="button" @onclick="() => _showCreate = false" class="workspace-heading border border-black bg-white px-5 py-3 text-xs font-bold uppercase tracking-wider rounded-none">Hủy</button>
            </div>
        </section>
    }

    <section class="rounded-2xl border border-[#D8DED2] bg-white p-5 shadow-sm sm:p-6" aria-labelledby="manager-competition-filter-title">
        <div class="mb-5">
            <h2 id="manager-competition-filter-title" class="workspace-heading text-sm font-extrabold text-[#383E43]">Lọc cuộc thi</h2>
            <p class="mt-1 text-xs text-[#69706A]">Tìm theo tên hoặc mô tả, hoặc chọn trạng thái. Cuộc thi không tự đổi trạng thái theo lịch; sau khi đến giờ bắt đầu, quản lý có thể chủ động kết thúc để duyệt kết quả.</p>
        </div>
        <form class="grid items-end gap-4 md:grid-cols-2 xl:grid-cols-[minmax(0,1.2fr)_minmax(0,1fr)_auto]" @onsubmit="ApplyFiltersAsync" @onsubmit:preventDefault>
            <div>
                <label for="manager-comp-search" class="workspace-heading mb-2 block text-[10px] font-bold uppercase tracking-wider text-[#69706A]">Tìm kiếm</label>
                <input id="manager-comp-search" class="w-full rounded-xl border border-[#D8DED2] bg-[#FAFAF8] px-4 py-3 text-sm text-[#383E43] placeholder:text-[#9AA098] focus:border-[#5F6F52] focus:bg-white focus:outline-none focus:ring-2 focus:ring-[#5F6F52]/15" @bind="_search" @bind:event="oninput" placeholder="Tên hoặc mô tả cuộc thi" />
            </div>
            <div>
                <label for="manager-comp-status" class="workspace-heading mb-2 block text-[10px] font-bold uppercase tracking-wider text-[#69706A]">Trạng thái</label>
                <select id="manager-comp-status" class="w-full rounded-xl border border-[#D8DED2] bg-[#FAFAF8] px-4 py-3 text-sm text-[#383E43] focus:border-[#5F6F52] focus:bg-white focus:outline-none focus:ring-2 focus:ring-[#5F6F52]/15" @bind="_status">
                    <option value="">Tất cả trạng thái</option>
                    <option value="Draft">Bản nháp</option>
                    <option value="Published">Đã phát hành</option>
                    <option value="Ongoing">Đang diễn ra</option>
                    <option value="Completed">Đã kết thúc</option>
                    <option value="Cancelled">Đã hủy</option>
                </select>
            </div>
            <div class="flex flex-wrap gap-2 md:col-span-2 xl:col-span-1">
                <button type="submit" disabled="@_loading" class="workspace-heading min-h-11 flex-1 rounded-xl bg-[#5F6F52] px-5 py-3 text-xs font-bold uppercase tracking-wider text-white transition-colors hover:bg-[#4E5D44] disabled:opacity-50">Lọc cuộc thi</button>
                <button type="button" @onclick="ClearFiltersAsync" disabled="@_loading" class="workspace-heading min-h-11 rounded-xl border border-[#D8DED2] bg-white px-4 py-3 text-xs font-bold text-[#383E43] transition-colors hover:bg-[#EEF1EA] disabled:opacity-50">Xóa lọc</button>
            </div>
        </form>
    </section>

    <section class="overflow-hidden rounded-2xl border border-[#D8DED2] bg-white shadow-sm" aria-labelledby="mgr-list-title" aria-live="polite">
        <div class="flex flex-wrap items-center justify-between gap-3 border-b border-[#D8DED2] bg-[#EEF1EA]/40 px-5 py-5 sm:px-6">
            <h2 id="mgr-list-title" class="workspace-heading text-sm font-extrabold uppercase tracking-wider">Danh sách cuộc thi</h2>
            <span class="text-xs text-[#71717A]">@_total mục</span>
        </div>
        @if (_loading)
        {
            <p role="status" class="px-6 py-10 text-center text-sm text-[#69706A]">Đang tải cuộc thi...</p>
        }
        else if (_items.Count == 0)
        {
            <p class="px-6 py-10 text-center text-sm text-[#71717A]">
                @(HasFilters ? "Không tìm thấy cuộc thi phù hợp với bộ lọc." : "Chưa có cuộc thi nào. Bấm nút Tạo cuộc thi để bắt đầu.")
            </p>
        }
        else
        {
            <div class="overflow-x-auto">
                <table class="workspace-table w-full min-w-[900px] table-fixed text-left text-sm">
                    <thead class="workspace-heading text-[10px] uppercase tracking-wider">
                        <tr><th class="w-[30%] px-4 py-4">Cuộc thi</th><th class="w-[18%] px-4 py-4">Thi</th><th class="w-[10%] px-4 py-4">Người</th><th class="w-[14%] px-4 py-4">Trạng thái</th><th class="w-[28%] px-4 py-4">Thao tác</th></tr>
                    </thead>
                    <tbody class="divide-y divide-[#EEF1EA]">
                        @foreach (var item in _items)
                        {
                            <tr class="hover:bg-[#FAFAF7]">
                                <th scope="row" class="break-words px-4 py-4 font-semibold">@item.Name</th>
                                <td class="whitespace-nowrap px-4 py-4 text-xs text-[#69706A]">@item.StartDate.ToLocalTime().ToString("dd/MM/yyyy") - @item.EndDate.ToLocalTime().ToString("dd/MM/yyyy")</td>
                                <td class="workspace-heading whitespace-nowrap px-4 py-4 text-xs font-bold">@item.ParticipantCount@(item.MaxParticipants is { } max ? $" / {max}" : "")</td>
                                <td class="px-4 py-4"><span class="@StatusClass(item.Status)">@CompetitionStatusLabel(item.Status)</span></td>
                                <td class="px-4 py-4">
                                    <div class="flex flex-wrap gap-2">
                                        @if (_isManager && (item.Status == "Draft" || item.Status == "Published" && item.StartDate > DateTime.UtcNow))
                                        {
                                            <button type="button" @onclick="() => OpenFormAsync(item.Id)" class="workspace-heading rounded-lg border px-2.5 py-1.5 text-[10px] font-bold uppercase">Chỉnh sửa</button>
                                        }
                                        @if (_isManager && item.Status == "Draft")
                                        {
                                            <button type="button" @onclick='() => PublishAsync(item.Id)' class="workspace-heading rounded-lg border border-[#A9B79D] bg-[#EEF1EA] px-2.5 py-1.5 text-[10px] font-bold uppercase text-[#4E5D44]">Phát hành</button>
                                        }
                                        @if (_isManager && item.Status is ("Draft" or "Published" or "Ongoing"))
                                        {
                                            <button type="button" @onclick='() => CancelAsync(item.Id)' disabled="@_busy" class="workspace-heading rounded-lg border border-red-200 bg-red-50 px-2.5 py-1.5 text-[10px] font-bold uppercase text-red-700 disabled:opacity-50">Hủy</button>
                                        }
                                        @if (_isManager && CanCompleteManually(item))
                                        {
                                            <button type="button" @onclick='() => CompleteAsync(item.Id)' disabled="@_busy" class="workspace-heading rounded-lg border border-amber-200 bg-amber-50 px-2.5 py-1.5 text-[10px] font-bold uppercase text-amber-800 disabled:opacity-50">Kết thúc</button>
                                        }
                                        <button type="button" @onclick='() => OpenParticipantsAsync(item.Id)' class="workspace-heading rounded-lg border border-[#D8DED2] bg-white px-2.5 py-1.5 text-[10px] font-bold uppercase text-[#383E43] hover:bg-[#EEF1EA]">Người tham gia</button>
                                        <button type="button" @onclick='() => OpenResultsAsync(item.Id)' class="workspace-heading rounded-lg bg-[#5F6F52] px-2.5 py-1.5 text-[10px] font-bold uppercase text-white hover:bg-[#4E5D44]">Kết quả</button>
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
            @if (_total > 0)
            {
                <Pager Page="_page" PageSize="PageSize" TotalCount="_total" Noun="cuộc thi" AriaLabel="Phân trang cuộc thi" Disabled="@(_loading || _busy)" OnPage="LoadPageAsync" />
            }
        }
    </section>

    @if (_panel is Panel.Participants)
    {
        <WorkspaceModal Open="true" Eyebrow="VFMS / MODULE 06 / UC-60" Title="@($"Người tham gia · {_selectedCompetitionName}")" OnClose="CloseDetailsAsync">
            @if (_notice is not null)
            {
                <div class="m-4 rounded-xl border border-emerald-200 bg-emerald-50 p-4 text-sm text-emerald-800" role="status">@_notice</div>
            }
            @if (_error is not null)
            {
                <div class="m-4 border-2 border-[#EF4444] bg-red-50 p-4 text-sm text-red-800" role="alert">@_error</div>
            }
            @if (_participants.Count == 0)
            {
                <p class="px-6 py-8 text-center text-sm text-[#71717A]">Chưa có người tham gia.</p>
            }
            else
            {
                <div class="overflow-x-auto">
                    <table class="workspace-table w-full min-w-[800px] text-left text-sm">
                        <thead class="workspace-heading bg-[#F7F7F7] text-[10px] uppercase tracking-wider">
                            <tr><th class="px-6 py-4">Hội viên</th><th class="px-6 py-4">Đăng ký</th><th class="px-6 py-4">Điểm</th><th class="px-6 py-4">Hạng</th><th class="px-6 py-4">Trạng thái</th><th class="px-6 py-4">Thao tác</th></tr>
                        </thead>
                        <tbody class="divide-y divide-[#CFCFCF]">
                            @foreach (var row in _participants)
                            {
                                <tr class="hover:bg-[#F7F7F7]">
                                    <th scope="row" class="px-6 py-5">
                                        <span class="block font-medium">@row.MemberName</span>
                                        <span class="mt-1 block text-xs text-[#71717A]">@row.MemberEmail</span>
                                    </th>
                                    <td class="px-6 py-5 text-xs text-[#545454]">@row.RegisteredAt.ToLocalTime().ToString("dd/MM/yyyy HH:mm")</td>
                                    <td class="workspace-heading px-6 py-5 text-xs font-bold">@(row.Score?.ToString("0.##") ?? "-")</td>
                                    <td class="workspace-heading px-6 py-5 text-xs font-bold">@(row.Rank?.ToString() ?? "-")</td>
                                    <td class="px-6 py-5"><span class="@StatusClass(row.Status)">@ParticipantStatusLabel(row.Status)</span></td>
                                    <td class="px-6 py-5">
                                        <div class="flex flex-wrap gap-2">
                                            @if (row.Status == "Disqualified")
                                            {
                                                <button type="button" @onclick='() => ReinstateAsync(row.Id)' class="workspace-heading border border-[#10B981] bg-emerald-50 px-2 py-1 text-[10px] font-bold uppercase text-[#047857] rounded-none">Khôi phục</button>
                                            }
                                            else if (row.Status != "Completed")
                                            {
                                                <button type="button" @onclick='() => DisqualifyAsync(row.Id)' class="workspace-heading border border-[#EF4444] bg-red-50 px-2 py-1 text-[10px] font-bold uppercase text-[#B91C1C] rounded-none">Loại</button>
                                            }
                                            @if (row.Status != "Completed" && row.Status != "Disqualified")
                                            {
                                                <button type="button" @onclick='() => OpenRecordResult(row)' class="workspace-heading border border-black px-2 py-1 text-[10px] font-bold uppercase rounded-none">Ghi điểm</button>
                                            }
                                            @if (_isManager && CanConfirmResult(row))
                                            {
                                                <button type="button" @onclick='() => ConfirmResultAsync(row.Id, row.Rank)' disabled="@_busy" class="workspace-heading rounded-lg bg-[#5F6F52] px-2.5 py-1.5 text-[10px] font-bold uppercase text-white hover:bg-[#4E5D44] disabled:opacity-50">Duyệt kết quả</button>
                                            }
                                        </div>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
        </WorkspaceModal>
    }

    @if (_panel is Panel.RecordResult)
    {
        <WorkspaceModal Open="true" Eyebrow="VFMS / MODULE 06 / UC-61" Title="@($"Ghi điểm · {_resultMemberName}")" OnClose="CloseDetailsAsync">
            @if (_error is not null)
            {
                <div class="m-4 border-2 border-[#EF4444] bg-red-50 p-4 text-sm text-red-800" role="alert">@_error</div>
            }
            <div class="grid gap-4 p-6 sm:grid-cols-2">
                <div>
                    <label for="competition-result-score" class="workspace-heading mb-2 block text-[10px] font-bold uppercase tracking-wider">ĐIỂM</label>
                    <InputNumber id="competition-result-score" @bind-Value="_resultScore" min="0" step="any" class="w-full border border-[#CFCFCF] px-3 py-2 text-sm" />
                </div>
                <div>
                    <label for="competition-result-rank" class="workspace-heading mb-2 block text-[10px] font-bold uppercase tracking-wider">HẠNG</label>
                    <InputNumber id="competition-result-rank" @bind-Value="_resultRank" min="1" class="w-full border border-[#CFCFCF] px-3 py-2 text-sm" />
                </div>
                <div class="sm:col-span-2">
                    <label for="competition-result-note" class="workspace-heading mb-2 block text-[10px] font-bold uppercase tracking-wider">GHI CHÚ</label>
                    <textarea id="competition-result-note" @bind="_resultNote" rows="3" class="w-full border border-[#CFCFCF] px-3 py-2 text-sm"></textarea>
                </div>
            </div>
            <div class="flex flex-wrap gap-3 border-t border-[#CFCFCF] px-6 py-4">
                <button type="button" @onclick="SaveResultAsync" disabled="@_busy" class="workspace-heading border-2 border-black bg-black px-5 py-3 text-xs font-bold uppercase tracking-wider text-white disabled:opacity-50">Lưu điểm ↗</button>
                <button type="button" @onclick="CloseDetailsAsync" class="workspace-heading border border-black bg-white px-5 py-3 text-xs font-bold uppercase tracking-wider">Hủy</button>
            </div>
        </WorkspaceModal>
    }

    @if (_panel is Panel.Results)
    {
        <WorkspaceModal Open="true" Eyebrow="VFMS / MODULE 06 / UC-61 · UC-62" Title="@($"Kết quả · {_selectedCompetitionName}")" OnClose="CloseDetailsAsync">
            @if (_notice is not null)
            {
                <div class="m-4 rounded-xl border border-emerald-200 bg-emerald-50 p-4 text-sm text-emerald-800" role="status">@_notice</div>
            }
            @if (_error is not null)
            {
                <div class="m-4 border-2 border-[#EF4444] bg-red-50 p-4 text-sm text-red-800" role="alert">@_error</div>
            }
            <div class="flex flex-wrap items-center justify-between gap-3 border-b border-[#D8DED2] bg-[#EEF1EA]/40 px-5 py-4 sm:px-6">
                <div>
                    <h3 class="workspace-heading text-sm font-extrabold uppercase tracking-wider">Bảng kết quả</h3>
                    @if (SelectedCompetitionStatus != "Completed")
                    {
                        <p class="mt-1 text-xs text-[#69706A]">Chỉ có thể duyệt sau khi cuộc thi kết thúc.</p>
                    }
                    else if (PendingUnrankedResultCount > 0 && PendingResultCount == 0)
                    {
                        <p class="mt-1 text-xs text-[#69706A]">@PendingUnrankedResultCount kết quả đang chờ bổ sung hạng trước khi duyệt.</p>
                    }
                    else if (PendingResultCount == 0)
                    {
                        <p class="mt-1 text-xs text-[#69706A]">Không còn kết quả có hạng cần duyệt.</p>
                    }
                    else
                    {
                        <p class="mt-1 text-xs text-[#69706A]">@PendingResultCount kết quả có hạng đang chờ duyệt.</p>
                        <p class="mt-1 max-w-2xl text-xs text-[#69706A]">Duyệt tất cả để xác nhận thứ hạng và cấp voucher cho những người đạt giải trong cùng một lần.</p>
                    }
                </div>
                @if (_isManager && _error != null && _selectedCompetitionId.HasValue && SelectedCompetitionStatus == "Completed")
                {
                    <button type="button" @onclick="() => OpenFormAsync(_selectedCompetitionId, true)" class="workspace-heading rounded-lg border px-4 py-2 text-xs font-bold">Đổi voucher chưa thể trao</button>
                }
                @if (_isManager)
                {
                <button type="button" @onclick='() => ConfirmAllAsync(_selectedCompetitionId!.Value)' disabled="@(!CanConfirmAllResults)" class="workspace-heading rounded-lg bg-[#5F6F52] px-4 py-2.5 text-[10px] font-bold uppercase tracking-wider text-white hover:bg-[#4E5D44] disabled:cursor-not-allowed disabled:opacity-50">Duyệt tất cả (@PendingResultCount)</button>
                }
            </div>
            @if (_leaderboard.Count == 0)
            {
                <p class="px-6 py-10 text-center text-sm text-[#69706A]">
                    @(_participants.Count == 0
                        ? "Chưa có người tham gia."
                        : "Chưa có kết quả được nhập. Vào Người tham gia để nhập điểm và hạng.")
                </p>
            }
            else
            {
                <div class="overflow-x-auto">
                    <table class="workspace-table w-full min-w-[760px] table-fixed text-left text-sm">
                        <thead class="workspace-heading text-[10px] uppercase tracking-wider">
                            <tr><th class="w-[8%] px-4 py-4">Hạng</th><th class="w-[20%] px-4 py-4">Hội viên</th><th class="w-[10%] px-4 py-4">Điểm</th><th class="w-[24%] px-4 py-4">Ghi chú</th><th class="w-[15%] px-4 py-4">Trạng thái</th><th class="w-[23%] px-4 py-4">Phần thưởng</th></tr>
                        </thead>
                        <tbody class="divide-y divide-[#EEF1EA]">
                            @foreach (var row in _leaderboard)
                            {
                                <tr class="hover:bg-[#FAFAF7]">
                                    <th scope="row" class="workspace-heading px-4 py-4 text-base font-extrabold text-[#5F6F52]">@(row.Rank?.ToString() ?? "-")</th>
                                    <td class="break-words px-4 py-4 font-medium">@row.MemberName</td>
                                    <td class="workspace-heading px-4 py-4 text-xs font-bold">@(row.Score?.ToString("0.##") ?? "-")</td>
                                    <td class="whitespace-pre-line break-words px-4 py-4 text-xs text-[#545454]">@(string.IsNullOrWhiteSpace(row.Note) ? "-" : row.Note)</td>
                                    <td class="px-4 py-4"><span class="@StatusClass(row.Status)">@ParticipantStatusLabel(row.Status)</span></td>
                                    <td class="break-words px-4 py-4 text-xs">
                                        @if (!string.IsNullOrWhiteSpace(row.PrizeName))
                                        {
                                            <span class="block font-semibold">@row.PrizeName</span>

                                        }
                                        else
                                        {
                                            <span class="text-[#71717A]">-</span>
                                        }
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
        </WorkspaceModal>
    }
</div>

@code {
    private enum Panel { None, Participants, RecordResult, Results }
    private const int PageSize = 8;

    private IReadOnlyCollection<CompetitionResponse> _items = [];
    private IReadOnlyCollection<CompetitionParticipantResponse> _participants = [];
    private IReadOnlyCollection<CompetitionLeaderboardEntry> _leaderboard = [];
    private int _total;
    private int _page = 1;
    private string _search = string.Empty;
    private string _status = string.Empty;
    private int? _selectedCompetitionId;
    private string _selectedCompetitionName = string.Empty;
    private Panel _panel = Panel.None;
    private bool _showCreate;
    private bool _busy;
    private bool _loading = true;
    private string? _error;
    private string? _notice;

    private int? _editingId;
    private bool _replaceOnly;
    private bool _published;
    private string? _formRules;
    private string? _formImage;
    private readonly List<CompetitionRewardEditor.RewardRow> _rewardRows = [];
    private string _formName = string.Empty;
    private string _formDescription = string.Empty;
    private DateTime _formRegistrationStart = DateTime.UtcNow;
    private DateTime _formRegistrationEnd = DateTime.UtcNow.AddDays(7);
    private DateTime _formStart = DateTime.UtcNow.AddDays(8);
    private DateTime _formEnd = DateTime.UtcNow.AddDays(9);
    private int? _formMaxParticipants;
    private int? _resultParticipantId;
    private string _resultMemberName = string.Empty;
    private decimal? _resultScore;
    private int? _resultRank;
    private string _resultNote = string.Empty;

    private string? SelectedCompetitionStatus =>
        _items.FirstOrDefault(item => item.Id == _selectedCompetitionId)?.Status;
    private int PendingResultCount =>
        _leaderboard.Count(result => result.Status != "Completed" && result.Rank.HasValue);
    private int PendingUnrankedResultCount =>
        _leaderboard.Count(result => result.Status != "Completed" && result.Rank is null);
    private bool CanConfirmAllResults =>
        !_busy && SelectedCompetitionStatus == "Completed" && PendingResultCount > 0;
    private bool HasFilters =>
        Blank(_search) is not null || Blank(_status) is not null;

    private bool _isManager;
    protected override async Task OnInitializedAsync()
    {
        _isManager = (await AuthState.GetAuthenticationStateAsync()).User.IsInRole("Manager");
        await LoadAsync();
    }

    private async Task LoadAsync()
    {
        await LoadPageAsync(_page);
    }

    private async Task LoadPageAsync(int page)
    {
        if (page < 1) return;
        _page = page;
        _loading = true;
        _error = null;
        try
        {
            var result = await Api.GetCompetitionsAsync(new CompetitionListRequest(
                Status: Blank(_status), Search: Blank(_search), Page: _page, PageSize: PageSize));
            var lastPage = PageCount(result.TotalCount);
            if (_page > lastPage)
            {
                _page = lastPage;
                result = await Api.GetCompetitionsAsync(new CompetitionListRequest(
                    Status: Blank(_status), Search: Blank(_search), Page: _page, PageSize: PageSize));
            }
            _items = result.Items;
            _total = result.TotalCount;
        }
        catch (Exception error) { _error = error.Message; }
        finally { _loading = false; }
    }

    private async Task ReloadAsync()
    {
        await LoadAsync();
        if (_selectedCompetitionId is { } id) await LoadDetailsAsync(id);
    }

    private Task ApplyFiltersAsync()
    {
        if (_loading) return Task.CompletedTask;
        _page = 1;
        return LoadAsync();
    }

    private Task ClearFiltersAsync()
    {
        _search = string.Empty;
        _status = string.Empty;
        return ApplyFiltersAsync();
    }

    private static DateTime ToUtc(DateTime gymTime) => DateTime.SpecifyKind(gymTime.AddHours(-7), DateTimeKind.Utc);

    private async Task OpenFormAsync(int? id, bool replaceOnly = false)
    {
        if (_busy) return;
        _busy = true;
        try
        {
            var competition = id.HasValue ? await Api.GetCompetitionAsync(id.Value) : null;
            _editingId = id;
            _replaceOnly = replaceOnly;
            _published = competition?.Status == "Published";
            _rewardRows.Clear();
            foreach (var prize in competition?.Prizes.Where(p => p.VoucherId.HasValue) ?? [])
                _rewardRows.Add(new() { Rank = prize.Rank, VoucherId = prize.VoucherId, Existing = prize.Reward, PrizeName = prize.PrizeName, Description = prize.Description });
            var now = DateTime.UtcNow;
            _formName = competition?.Name ?? "";
            _formDescription = competition?.Description ?? "";
            _formRules = competition?.Rules;
            _formImage = competition?.ImageUrl;
            _formRegistrationStart = PromotionFormModel.ToGymTime(competition?.RegistrationStart ?? now);
            _formRegistrationEnd = PromotionFormModel.ToGymTime(competition?.RegistrationEnd ?? now.AddDays(7));
            _formStart = PromotionFormModel.ToGymTime(competition?.StartDate ?? now.AddDays(8));
            _formEnd = PromotionFormModel.ToGymTime(competition?.EndDate ?? now.AddDays(9));
            _formMaxParticipants = competition?.MaxParticipants;
            _panel = Panel.None;
            _showCreate = true;
            _error = null;
        }
        catch (Exception error) { _error = error.Message; }
        finally { _busy = false; }
    }

    private async Task CreateAsync()
    {
        if (_busy) return;
        if (_rewardRows.Any(r => r.VoucherId == null || r.Rank < 1) || _rewardRows.GroupBy(r => r.Rank).Any(g => g.Count() > 1))
        {
            _error = "Chọn voucher và nhập một thứ hạng riêng cho mỗi giải.";
            return;
        }
        _busy = true;
        _error = null;
        try
        {
            var prizes = _rewardRows.Select(r => new CompetitionPrizeRequest(r.PrizeName ?? $"Giải hạng {r.Rank}", r.Rank, r.Description, r.VoucherId)).ToArray();
            var request = new CompetitionRequest(_formName.Trim(), ToUtc(_formRegistrationStart), ToUtc(_formRegistrationEnd),
                ToUtc(_formStart), ToUtc(_formEnd), Blank(_formDescription), Blank(_formRules), _formMaxParticipants, _formImage, prizes);
            if (_replaceOnly && _editingId is { } completed) await Api.ReplaceUnusableRewardsAsync(completed, prizes);
            else if (_editingId is { } editing) await Api.UpdateAsync(editing, request);
            else await Api.CreateAsync(request);
            _showCreate = false;
            _page = 1;
            await LoadAsync();
            if (_replaceOnly && _editingId.HasValue) await OpenResultsAsync(_editingId.Value);
        }
        catch (Exception error) { _error = error.Message; }
        finally { _busy = false; }
    }

    private async Task PublishAsync(int id)
    {
        try { await Api.PublishAsync(id); await LoadAsync(); _error = null; }
        catch (Exception error) { _error = error.Message; }
    }

    private async Task CancelAsync(int id)
    {
        if (_busy) return;
        var competition = _items.FirstOrDefault(item => item.Id == id);
        if (competition is null) return;

        _busy = true;
        _error = null;
        try
        {
            var confirmed = await JS.InvokeAsync<bool>("confirm",
                $"Hủy cuộc thi \"{competition.Name}\"? Thao tác này không thể hoàn tác.");
            if (!confirmed) return;

            await Api.CancelAsync(id);
            await LoadAsync();
        }
        catch (Exception error) { _error = error.Message; }
        finally { _busy = false; }
    }

    private async Task CompleteAsync(int id)
    {
        if (_busy) return;
        var competition = _items.FirstOrDefault(item => item.Id == id);
        if (competition is null) return;

        _busy = true;
        _error = null;
        try
        {
            var confirmed = await JS.InvokeAsync<bool>("confirm",
                $"Kết thúc cuộc thi \"{competition.Name}\"? Thao tác này không thể hoàn tác.");
            if (!confirmed) return;

            await Api.CompleteAsync(id);
            await LoadAsync();
        }
        catch (Exception error) { _error = error.Message; }
        finally { _busy = false; }
    }

    private async Task OpenParticipantsAsync(int id)
    {
        _error = null;
        _notice = null;
        _panel = Panel.Participants;
        await LoadDetailsAsync(id);
    }

    private async Task OpenResultsAsync(int id)
    {
        _error = null;
        _notice = null;
        _panel = Panel.Results;
        await LoadDetailsAsync(id);
    }

    private async Task LoadDetailsAsync(int id)
    {
        _selectedCompetitionId = id;
        _selectedCompetitionName = _items.FirstOrDefault(i => i.Id == id)?.Name ?? string.Empty;
        _participants = [];
        _leaderboard = [];
        _error = null;
        try
        {
            var participants = await Api.GetParticipantsAsync(new CompetitionParticipantListRequest(CompetitionId: id, PageSize: 100));
            _participants = participants.Items;
            _leaderboard = await Api.GetLeaderboardAsync(id);
            _error = null;
        }
        catch (Exception error) { _error = error.Message; }
    }

    private Task CloseDetailsAsync()
    {
        _panel = Panel.None;
        _selectedCompetitionId = null;
        _participants = [];
        _leaderboard = [];
        _notice = null;
        return Task.CompletedTask;
    }

    private async Task DisqualifyAsync(int joinId)
    {
        try { await Api.DisqualifyAsync(joinId); await RefreshSelectedAsync(); _error = null; }
        catch (Exception error) { _error = error.Message; }
    }

    private async Task ReinstateAsync(int joinId)
    {
        try { await Api.ReinstateAsync(joinId); await RefreshSelectedAsync(); _error = null; }
        catch (Exception error) { _error = error.Message; }
    }

    private void OpenRecordResult(CompetitionParticipantResponse participant)
    {
        _resultParticipantId = participant.Id;
        _resultMemberName = participant.MemberName;
        _resultScore = participant.Score;
        _resultRank = participant.Rank;
        _resultNote = participant.Note ?? string.Empty;
        _error = null;
        _notice = null;
        _panel = Panel.RecordResult;
    }

    private async Task SaveResultAsync()
    {
        if (_busy || _resultParticipantId is not { } joinId) return;
        if (_resultScore is null && _resultRank is null)
        {
            _notice = null;
            _error = "Vui lòng nhập điểm hoặc hạng trước khi lưu.";
            return;
        }

        _busy = true;
        _error = null;
        _notice = null;
        try
        {
            await Api.RecordResultAsync(joinId, new RecordCompetitionResultRequest(
                _resultScore,
                _resultRank,
                string.IsNullOrWhiteSpace(_resultNote) ? null : _resultNote.Trim()));
            _panel = Panel.Participants;
            await RefreshSelectedAsync();
            _notice = "Đã lưu điểm và hạng. Kết quả đang chờ quản lý duyệt.";
        }
        catch (Exception error) { _error = error.Message; }
        finally { _busy = false; }
    }

    private async Task ConfirmResultAsync(int joinId, int? rank)
    {
        var participant = _participants.FirstOrDefault(row => row.Id == joinId);
        if (_busy || participant is null || !CanConfirmResult(participant)) return;

        _busy = true;
        _error = null;
        _notice = null;
        try
        {
            await Api.ConfirmResultAsync(new ConfirmCompetitionResultRequest(joinId, Rank: rank));
            await RefreshSelectedAsync();
            _notice = "Đã duyệt kết quả.";
        }
        catch (Exception error) { _error = error.Message; }
        finally { _busy = false; }
    }

    private async Task ConfirmAllAsync(int competitionId)
    {
        if (_busy || !CanConfirmAllResults || competitionId != _selectedCompetitionId) return;

        _busy = true;
        _error = null;
        _notice = null;
        try
        {
            var count = await Api.ConfirmAllResultsAsync(competitionId);
            await RefreshSelectedAsync();
            _notice = $"Đã duyệt {count} kết quả.";
        }
        catch (Exception error) { _error = error.Message; }
        finally { _busy = false; }
    }

    private async Task RefreshSelectedAsync()
    {
        if (_selectedCompetitionId is { } id) await LoadDetailsAsync(id);
    }

    private static string StatusClass(string status) => status switch
    {
        "Published" => "inline-block border border-[#10B981] bg-emerald-50 px-2 py-1 text-[10px] font-bold uppercase text-[#047857] rounded-none",
        "Ongoing" => "inline-block border border-[#6366F1] bg-indigo-50 px-2 py-1 text-[10px] font-bold uppercase text-[#4338CA] rounded-none",
        "Completed" => "inline-block border border-[#CFCFCF] bg-[#F7F7F7] px-2 py-1 text-[10px] font-bold uppercase text-[#545454] rounded-none",
        "Cancelled" => "inline-block border border-[#EF4444] bg-red-50 px-2 py-1 text-[10px] font-bold uppercase text-[#B91C1C] rounded-none",
        "Disqualified" => "inline-block border border-[#EF4444] bg-red-50 px-2 py-1 text-[10px] font-bold uppercase text-[#B91C1C] rounded-none",
        _ => "inline-block border border-[#F59E0B] bg-amber-50 px-2 py-1 text-[10px] font-bold uppercase text-[#92400E] rounded-none"
    };

    private bool CanConfirmResult(CompetitionParticipantResponse participant) =>
        SelectedCompetitionStatus == "Completed"
        && participant.Status is not ("Completed" or "Disqualified")
        && participant.Rank.HasValue;

    private static string CompetitionStatusLabel(string status) => status switch
    {
        "Draft" => "Bản nháp",
        "Published" => "Đã phát hành",
        "Ongoing" => "Đang diễn ra",
        "Completed" => "Đã kết thúc",
        "Cancelled" => "Đã hủy",
        _ => status
    };

    private static string ParticipantStatusLabel(string status) => status switch
    {
        "Registered" => "Đã đăng ký",
        "Confirmed" => "Đã xác nhận",
        "Completed" => "Đã duyệt",
        "Disqualified" => "Đã loại",
        _ => status
    };

    private static int PageCount(int totalCount) =>
        Math.Max(1, (int)Math.Ceiling((double)totalCount / PageSize));

    private static bool CanCompleteManually(CompetitionResponse competition) =>
        competition.Status is "Published" or "Ongoing" &&
        DateTime.UtcNow >= DateTime.SpecifyKind(competition.StartDate, DateTimeKind.Utc);

    private static string? Blank(string? value) =>
        string.IsNullOrWhiteSpace(value) ? null : value.Trim();
